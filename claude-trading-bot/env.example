# claude-trading-bot environment template.
#
# run.py's default (see DEFAULT_ENV_FILE) reads this from
# /home/ayman01323/ClaudeServer/runtime/claude-trading-bot.env on the Google
# server -- a path the operator/GPT provisions directly, outside git. This
# file is a template for what needs to be there, not something run.py loads
# by this filename. Set CLAUDE_BOT_ENV_FILE to point at a local copy instead
# for off-server testing.
#
# Never commit real values, never paste them into chat or source.
#
# run.py refuses to start (fail closed) if any REQUIRED variable below is missing.
# It never falls back to the production bot's own .env for these — see README.md
# "Isolation design" for why that matters.

# --- Isolation (REQUIRED) ---
# Absolute paths, must NOT point inside the production CSVbot/ or data/ trees,
# and must NOT point inside the git-managed checkout (boot-trading-bot/...) at
# all: the sync workflow refuses to sync if `git status --porcelain` shows any
# local changes, and that check does not exclude untracked files -- CSV/SQLite
# runtime state written inside the checkout would silently block every future
# sync after this bot's first run. Keep them under the same operator-managed
# runtime/ area outside git instead.
CSV_DIR=/home/ayman01323/ClaudeServer/runtime/CSVbot
DATA_DIR=/home/ayman01323/ClaudeServer/runtime/data

# --- Telegram (REQUIRED) ---
# A dedicated bot token for this instance (create via @BotFather — do not reuse
# the production bot's token). Ask the operator which GitHub Secret / server
# secret location holds this; never paste the token itself into chat.
TELEGRAM_BOT_TOKEN=
# Chat id(s) that should receive Claude-bot reports. Comma-separated for multiple.
TELEGRAM_CHAT_IDS=

# --- Chain data providers (REQUIRED for whichever chains are authorised) ---
# Solana
SOLANA_RPC_URL=
SOLANA_WS_URL=
JUPITER_API_KEY=
# EVM RPC endpoints are CSV-driven (CSVbot/rpc_endpoints.csv), not env vars —
# populate that file for this instance's CSV_DIR once it exists.

# --- Token/pool safety providers (REQUIRED) ---
GOPLUS_ACCESS_TOKEN=
# RugCheck.xyz is used unauthenticated by learnerbot/solana_pool_risk_gate.py;
# no key currently required there.

# --- Hard risk engine (REQUIRED — see risk_engine_guard.py) ---
# All USD. run.py refuses to start LIVE mode if any of these are absent/invalid.
MAX_CAPITAL_USD=
MAX_POSITION_USD=
MAX_TOTAL_EXPOSURE_USD=
MAX_OPEN_POSITIONS=
MAX_DAILY_LOSS_USD=
MAX_DRAWDOWN_PCT=
MAX_SLIPPAGE_PCT=
MAX_PRICE_IMPACT_PCT=
MIN_POOL_LIQUIDITY_USD=

# --- Wallets ---
# Do NOT put a private key here. Wallets are created/imported through the bot's
# own encrypted wallet-store command flow once running (keyed to this instance's
# DATA_DIR, same mechanism production uses) — see README.md point 4.
#
# Identifies which row in this instance's isolated wallet-store CSV governs
# signing (see signing_interface.py). Any value matching Telegram-ID shape
# (digits, optionally one leading -) works — this bot is single-operator, not
# multi-tenant, so the exact number has no meaning beyond being a stable key.
# Until a signing key is actually provisioned for this id, SIGNER_READY stays
# false and broadcast stays unavailable, regardless of every other setting.
CLAUDE_BOT_WALLET_OWNER_ID=

# --- Optional ---
ETHERSCAN_API_KEY=
