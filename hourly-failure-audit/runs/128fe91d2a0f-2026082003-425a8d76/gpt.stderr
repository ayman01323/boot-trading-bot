.github/workflows/weekly-gpt-corrective-action.yml:323:      - name: Publish Copilot report and GPT master ledger to ai-reviews
.github/workflows/weekly-gpt-corrective-action.yml:330:          rm -rf /tmp/master-ai-reviews
.github/workflows/weekly-gpt-corrective-action.yml:331:          git worktree add --detach /tmp/master-ai-reviews origin/ai-reviews
.github/workflows/weekly-gpt-corrective-action.yml:332:          dest="/tmp/master-ai-reviews/weekly/runs/${SOURCE_SHA}"
.github/workflows/weekly-gpt-corrective-action.yml:333:          mkdir -p "$dest" /tmp/master-ai-reviews/weekly
.github/workflows/weekly-gpt-corrective-action.yml:334:          cp /tmp/copilot.json "$dest/copilot.json"
.github/workflows/weekly-gpt-corrective-action.yml:335:          cp /tmp/copilot.md "$dest/copilot.md"
.github/workflows/weekly-gpt-corrective-action.yml:343:            "copilot_report_pr":int("${REPORT_PR}"),
.github/workflows/weekly-gpt-corrective-action.yml:348:          cp "$dest/master_decision.json" /tmp/master-ai-reviews/weekly/latest_master_decision.json
.github/workflows/weekly-gpt-corrective-action.yml:349:          printf '%s\n' "$SOURCE_SHA" > /tmp/master-ai-reviews/weekly/latest_completed_source_commit.txt
.github/workflows/weekly-gpt-corrective-action.yml:350:          printf '%s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" > /tmp/master-ai-reviews/weekly/latest_completed_utc.txt
.github/workflows/weekly-gpt-corrective-action.yml:351:          cd /tmp/master-ai-reviews
.github/workflows/weekly-gpt-corrective-action.yml:357:            git fetch origin ai-reviews
.github/workflows/weekly-gpt-corrective-action.yml:358:            git rebase origin/ai-reviews
.github/workflows/weekly-gpt-corrective-action.yml:359:            git push origin HEAD:ai-reviews
.github/workflows/weekly-gpt-corrective-action.yml:372:          gh pr comment "$PR_NUMBER" --body "Three-agent weekly audit completed for \`${SOURCE_SHA}\`. GPT master status: **${STATUS}**. Deterministic policy-approved fixes: **${ACCEPTED}**. No automatic code implementation is allowed for this cycle. Master ledger is stored on the \`ai-reviews\` branch under \`weekly/runs/${SOURCE_SHA}/master_decision.json\`."
.github/workflows/weekly-gpt-corrective-action.yml:386:      - name: GPT implement only policy-approved fixes
.github/workflows/weekly-gpt-corrective-action.yml:418:          codex exec --sandbox workspace-write --ask-for-approval never --ephemeral "${model_args[@]}" - < /tmp/fix_prompt.txt
.github/workflows/weekly-gpt-corrective-action.yml:520:          GPT master status: **${MASTER_STATUS}**  
.github/workflows/weekly-gpt-corrective-action.yml:523:          This draft contains only policy-eligible fixes from the GPT master ledger on the \`ai-reviews\` branch:
.github/workflows/weekly-gpt-corrective-action.yml:527:          - GPT/Gemini/Copilot audited independently before synthesis.
.github/workflows/weekly-gpt-corrective-action.yml:528:          - GPT recorded ACCEPT / REJECT / DEFER with reasons.
.github/workflows/weekly-gpt-corrective-action.yml:535:          url="$(gh pr create --draft --base main --head "$BRANCH" --title "Weekly audited bot fixes ${SOURCE_SHA:0:12}" --body-file /tmp/corrective-pr.md)"
.github/workflows/weekly-gpt-corrective-action.yml:538:      - name: Record implementation no-op when GPT finds no supported patch
.github/workflows/weekly-gpt-corrective-action.yml:546:          gh pr comment "$PR_NUMBER" --body "GPT master policy allowed a corrective attempt for \`${SOURCE_SHA}\`, but the implementation agent found no supported code change within the approved scope. No patch was pushed or deployed."
.github/workflows/weekly-gpt-corrective-action.yml:548:      - name: Comment Copilot report PR with final weekly outcome
.github/workflows/weekly-gpt-corrective-action.yml:559:          body="Weekly three-agent audit completed for \`${SOURCE_SHA}\`. GPT master decision: **${STATUS}**. Policy-approved fixes: **${ACCEPTED}**."
.github/workflows/weekly-gpt-corrective-action.yml:561:          body="${body} Master ACCEPT/REJECT/DEFER ledger: \`ai-reviews:weekly/runs/${SOURCE_SHA}/master_decision.json\`. No automatic merge or deployment occurred."
.github/workflows/weekly-gpt-corrective-action.yml:562:          gh pr comment "$PR_NUMBER" --body "$body" || true
