   123	def handle_update(app, update):
   124	    cb = update.get("callback_query")
   125	    if cb:
   126	        tid = ((cb.get("message") or {}).get("chat") or {}).get("id")
   127	        data = str(cb.get("data") or "")
   128	        if data == "menu:aiops" or data.startswith("aiops:"):
   129	            if not _is_master(app, tid):
   130	                _answer(app, cb, "MASTER only")
   131	                return
   132	            _answer(app, cb)
   133	            state = snapshot_for_display(_ai._repo_root())
   134	            if data == "aiops:audit":
   135	                body = _ai._engineering_text(state)
   136	            elif data == "aiops:decision":
   137	                body = _ai._decision_text(state)
   138	            elif data == "aiops:strategy":
   139	                body = _ai._strategy_text(state)
   140	            elif data == "aiops:updates":
   141	                body = _ai._combined_text(state)
   142	            else:
   143	                body = _home_text(state)
   144	            _render(app, tid, body, cb)
   145	            return
   146	    return _PREV_HANDLE_UPDATE(app, update)
