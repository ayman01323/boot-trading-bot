    50	def _show(repo_root: Path, path: str) -> str | None:
    51	    try:
    52	        p = subprocess.run(
    53	            ["git", "-C", str(repo_root), "show", f"{AI_REVIEW_REF}:{path}"],
    54	            text=True,
    55	            capture_output=True,
    56	            timeout=12,
    57	            check=False,
    58	        )
    59	    except Exception:
    60	        return None
    61	    if p.returncode:
    62	        return None
    63	    return p.stdout
