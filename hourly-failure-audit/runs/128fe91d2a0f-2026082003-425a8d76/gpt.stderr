   153	def _command_set(commands):
   154	    out = []
   155	    seen = set()
   156	    for row in commands or []:
   157	        cmd = str((row or {}).get("command") or "").strip().lower()
   158	        if not cmd or cmd in seen:
   159	            continue
   160	        seen.add(cmd)
   161	        out.append({"command": cmd, "description": str((row or {}).get("description") or "")[:256]})
   162	    for cmd, desc in AI_MASTER_COMMANDS:
   163	        if cmd not in seen:
   164	            out.append({"command": cmd, "description": desc})
   165	            seen.add(cmd)
   166	    return out[:100]
   167	
