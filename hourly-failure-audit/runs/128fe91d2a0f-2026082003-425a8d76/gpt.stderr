    62	        return "<b>🧪 AI ENGINEERING AUDIT</b>\n\nNo engineering audit has been published yet."
    63	    counts = e.get("decision_counts") or {}
    64	    lines = [
    65	        "<b>🧪 AI ENGINEERING AUDIT</b>",
    66	        "",
    67	        f"Source: <code>{_safe(str(e.get('source_commit') or '')[:12])}</code>",
