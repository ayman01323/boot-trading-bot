   186	def build_loss_forensics(app, zip_path: str | Path, gpt_result: dict | None = None, *, hours: int = WINDOW_HOURS) -> dict:
   187	    now = int(time.time())
   188	    cutoff = now - max(1, int(hours)) * 3600
   189	    audit_metrics = {}
   190	    try:
   191	        audit_metrics = build_review_metrics(zip_path)
   192	    except Exception as exc:
   193	        audit_metrics = {"error": f"{type(exc).__name__}: {exc}"}
   194	
   195	    report = {
   196	        "schema_version": 1,
   197	        "generated_epoch": now,
   198	        "generated_utc": time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(now)),
   199	        "window_hours": int(hours),
   200	        "window_start_epoch": cutoff,
   201	        "source_audit_zip": Path(zip_path).name,
   202	        "privacy": (
   203	            "Sanitized operational report only. Telegram IDs, user wallet addresses, "
   204	            "leader-wallet addresses, private keys, seed phrases, encrypted signing material, "
   205	            "RPC credentials and passwords are excluded. Token mints and transaction signatures "
   206	            "are public blockchain identifiers and may be included."
   207	        ),
   208	        "audit_metrics": audit_metrics,
   209	        "solana_live": _position_report(app, cutoff),
   210	        "profit_control": _profit_control_report(app, cutoff),
   211	    }
   212	    if gpt_result:
   213	        report["server_gpt_review"] = {
   214	            "ok": bool(gpt_result.get("ok")),
   215	            "mode": str(gpt_result.get("mode") or ""),
   216	            "review": gpt_result.get("review"),
   217	            "error": str(gpt_result.get("error") or "")[:1200],
   218	        }
   219	    return report
   220	
   221	
   222	def _run(root: Path, argv: list[str], *, input_text: str | None = None, timeout: int = 30):
   223	    p = subprocess.run(
   224	        argv,
   225	        cwd=root,
   226	        text=True,
   227	        input=input_text,
   228	        capture_output=True,
   229	        timeout=timeout,
   230	        check=False,
   231	    )
   232	    output = ((p.stdout or "") + ("\n" + p.stderr if p.stderr else "")).strip()
   233	    return p.returncode, output
   234	
   235	
   236	def _publish_git(app, report: dict) -> dict:
   237	    root = Path(app.root)
   238	    text = json.dumps(report, indent=2, sort_keys=True, default=str) + "\n"
   239	
   240	    rc, blob = _run(root, ["git", "hash-object", "-w", "--stdin"], input_text=text, timeout=20)
   241	    if rc != 0:
   242	        return {"ok": False, "error": "hash-object: " + blob[:500]}
   243	    blob = blob.strip()
   244	
   245	    rc, tree = _run(
   246	        root,
   247	        ["git", "mktree"],
   248	        input_text=f"100644 blob {blob}\t{STATUS_FILE}\n",
   249	        timeout=20,
   250	    )
   251	    if rc != 0:
   252	        return {"ok": False, "error": "mktree: " + tree[:500]}
   253	    tree = tree.strip()
   254	
   255	    rc, remote = _run(
   256	        root,
   257	        ["git", "ls-remote", "--heads", "origin", f"refs/heads/{STATUS_BRANCH}"],
   258	        timeout=30,
   259	    )
   260	    parent = ""
   261	    if rc == 0 and remote.strip():
   262	        parent = remote.split()[0].strip()
   263	
   264	    args = ["git", "commit-tree", tree, "-m", f"BOOT sanitized loss forensics {report.get('generated_epoch')}"]
