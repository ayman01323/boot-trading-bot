===== /tmp/hourly-failure-evidence/gpt-master-strategy-action.yml
name: GPT Master Strategy Action

on:
  pull_request:
    types: [opened, synchronize, reopened]
    paths:
      - '.ai/strategy/copilot/*.json'
      - '.ai/strategy/copilot/*.md'
  workflow_dispatch:
    inputs:
      copilot_pr_number:
        description: 'Copilot strategy report PR number'
        required: false
        type: string

permissions:
  contents: write
  pull-requests: write
  issues: write

concurrency:
  group: gpt-master-strategy-action
  cancel-in-progress: false

jobs:
  adjudicate:
    if: github.event_name == 'workflow_dispatch' || github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 120

    steps:
      - name: Resolve Copilot strategy report PR
        id: pr
        env:
          GH_TOKEN: ${{ github.token }}
          INPUT_PR: ${{ inputs.copilot_pr_number }}
          EVENT_PR: ${{ github.event.pull_request.number }}
        shell: bash
        run: |
          set -euo pipefail
          pr="${EVENT_PR:-${INPUT_PR:-}}"
          test -n "$pr"
          head_sha="$(gh pr view "$pr" --json headRefOid --jq '.headRefOid')"
          cross="$(gh pr view "$pr" --json isCrossRepository --jq '.isCrossRepository')"
          if [[ "$cross" == "true" ]]; then echo 'Refusing fork report PR.' >&2; exit 2; fi
          echo "number=${pr}" >> "$GITHUB_OUTPUT"
          echo "head_sha=${head_sha}" >> "$GITHUB_OUTPUT"

      - uses: actions/checkout@v4
        with:
          ref: ${{ steps.pr.outputs.head_sha }}
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip
      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install synthesis and implementation tools
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt pytest
          npm install -g @openai/codex@latest
          codex --version

      - name: Refuse Copilot PR containing anything except its two strategy report files
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ steps.pr.outputs.number }}
        shell: bash
        run: |
          set -euo pipefail
          gh pr diff "$PR_NUMBER" --name-only > /tmp/copilot-strategy-files.txt
          python - <<'PY'
          import pathlib,sys
          files=[x.strip().replace('\\','/') for x in pathlib.Path('/tmp/copilot-strategy-files.txt').read_text().splitlines() if x.strip()]
          if len(files)!=2:
              print('Copilot strategy report PR must contain exactly two files.',*files,sep='\n',file=sys.stderr); raise SystemExit(2)
          if any(not p.startswith('.ai/strategy/copilot/') or pathlib.PurePosixPath(p).suffix not in {'.json','.md'} for p in files):
              print('Non-report file in Copilot strategy PR.',*files,sep='\n',file=sys.stderr); raise SystemExit(3)
          stems={str(pathlib.PurePosixPath(p).with_suffix('')) for p in files}
          if len(stems)!=1: raise SystemExit('Copilot JSON/Markdown report names do not match')
          PY

      - name: Locate and validate Copilot strategy report
        id: report
        shell: bash
        run: |
          set -euo pipefail
          mapfile -t reports < <(find .ai/strategy/copilot -maxdepth 1 -type f -name '*.json' -print | sort)
          [[ "${#reports[@]}" -eq 1 ]]
          report="${reports[0]}"
          python - <<PY > /tmp/copilot-meta.env
          import json
          p=json.load(open('$report'))
          print('CYCLE_ID='+str(p.get('cycle_id') or ''))
          print('SOURCE_SHA='+str(p.get('source_commit') or ''))
          print('EVIDENCE_SHA='+str(p.get('evidence_sha256') or ''))
          PY
          source /tmp/copilot-meta.env
          test -n "$CYCLE_ID"; test -n "$SOURCE_SHA"; test -n "$EVIDENCE_SHA"
          expected=".ai/strategy/copilot/${CYCLE_ID}.json"
          [[ "$report" == "$expected" && -f ".ai/strategy/copilot/${CYCLE_ID}.md" ]]
          python -m learnerbot.three_agent_strategy_contract validate-agent \
            --input "$report" --provider copilot --cycle-id "$CYCLE_ID" \
            --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
          cp "$report" /tmp/copilot-strategy.json
          cp ".ai/strategy/copilot/${CYCLE_ID}.md" /tmp/copilot-strategy.md
          echo "cycle_id=${CYCLE_ID}" >> "$GITHUB_OUTPUT"
          echo "source_sha=${SOURCE_SHA}" >> "$GITHUB_OUTPUT"
          echo "evidence_sha=${EVIDENCE_SHA}" >> "$GITHUB_OUTPUT"

      - name: Fetch matching GPT/Gemini reports and context
        shell: bash
        env:
          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
        run: |
          set -euo pipefail
          git fetch --force origin ai-reviews:refs/remotes/origin/ai-reviews
          root="strategy/runs/${CYCLE_ID}"
          for file in gpt.json gemini.json context.json; do git show "origin/ai-reviews:${root}/${file}" > "/tmp/${file}"; done
          python -m learnerbot.three_agent_strategy_contract validate-agent \
            --input /tmp/gpt.json --provider gpt --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
          python -m learnerbot.three_agent_strategy_contract validate-agent \
            --input /tmp/gemini.json --provider gemini --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
          python - <<'PY'
          import json,sys
          reports=[json.load(open('/tmp/gpt.json')),json.load(open('/tmp/gemini.json')),json.load(open('/tmp/copilot-strategy.json'))]
          bad=[x['provider'] for x in reports if x.get('status')=='INCOMPLETE']
          if bad:
              print('Incomplete independent strategy reports: '+','.join(bad),file=sys.stderr); raise SystemExit(3)
          PY

      - name: Check out exact reviewed strategy source
        shell: bash
        env:
          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
        run: |
          set -euo pipefail
          git fetch --force origin main:refs/remotes/origin/main
          git cat-file -e "${SOURCE_SHA}^{commit}"
          git checkout --detach "$SOURCE_SHA"
          git clean -fdx
          mkdir -p .strategy_master
          cp /tmp/gpt.json .strategy_master/gpt.json
          cp /tmp/gemini.json .strategy_master/gemini.json
          cp /tmp/copilot-strategy.json .strategy_master/copilot.json
          cp /tmp/context.json .strategy_master/context.json

      - name: GPT master strategy synthesis
        id: synth
        env:
          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          OPENAI_STRATEGY_SYNTH_MODEL: ${{ vars.OPENAI_STRATEGY_SYNTH_MODEL }}
          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
        shell: bash
        run: |
          set -euo pipefail
          test -n "${OPENAI_API_KEY:-}"
          cat > /tmp/strategy-master-prompt.txt <<'PROMPT'
          You are the MASTER adjudicator for three independent trading-strategy reviews. Read:
          .strategy_master/gpt.json, .strategy_master/gemini.json, .strategy_master/copilot.json and context.json,
          then inspect the exact checked-out source to verify claims.

          Consolidate equivalent proposals. For EVERY materially distinct proposal record ACCEPT, REJECT or DEFER.
          Do not use majority vote blindly: measured realised/shadow evidence and code truth outrank agent agreement.
          Reject unsupported profit claims, look-ahead, forced trading, cost-blind forecasting, duplicate strategies or
          recommendations that merely increase risk/capital. Defer when evidence is sparse or live/runtime proof is needed.

          An automatic implementation may only be a LOW/MEDIUM-risk SHADOW Strategy Lab change. Never authorise edits to
          live execution, Solana live signing, auto trader, wallets, secrets, deployment workflows, CSV live/risk settings,
          smart contracts or the live product universe. REPLACE/DORMANT/ASSET_REQUEST may be recommended but are not automatic
          code actions. Every accepted code action must list exact allowed Strategy Lab/SHADOW files and explicit tests.

          Write only .strategy_master/master_decision.json and .strategy_master/master_decision.md; no tracked changes.
          JSON shape:
          {
            "schema_version":1,"cycle_id":"CYCLE","source_commit":"SOURCE","evidence_sha256":"EVIDENCE",
            "status":"NO_ACTION|DRAFT_SHADOW_CHANGE|HUMAN_REVIEW_REQUIRED","summary":"...",
            "decisions":[{
              "finding_id":"stable id","source_proposal_ids":["gpt:id","gemini:id","copilot:id"],
              "action":"KEEP|IMPROVE|REWORK|SHADOW_MORE|REPLACE|DORMANT|NEW_SHADOW|ASSET_REQUEST|RESEARCH_MORE",
              "strategy":"...","disposition":"ACCEPT|REJECT|DEFER","reason":"why, tied to evidence/code",
              "confidence":0.0,"supporting_agents":["gpt","gemini","copilot"],
              "risk_class":"LOW|MEDIUM|HIGH|CRITICAL","shadow_only":true,
              "allowed_files":["exact Strategy Lab/SHADOW path"],"required_tests":["specific command/test"]
            }],
            "implementation_allowed":false,"live_auto_deploy":false,"draft_pr_only":true
          }
          PROMPT
          sed -i -e "s/CYCLE/${CYCLE_ID}/g" -e "s/SOURCE/${SOURCE_SHA}/g" -e "s/EVIDENCE/${EVIDENCE_SHA}/g" /tmp/strategy-master-prompt.txt
          model_args=()
          if [[ -n "${OPENAI_STRATEGY_SYNTH_MODEL:-}" ]]; then model_args=(-m "$OPENAI_STRATEGY_SYNTH_MODEL"); fi
          codex exec --sandbox workspace-write --ask-for-approval never --ephemeral "${model_args[@]}" - < /tmp/strategy-master-prompt.txt
          test -f .strategy_master/master_decision.json
          test -f .strategy_master/master_decision.md
          python - <<'PY'
          import subprocess,sys
          bad=[]
          for line in subprocess.check_output(['git','status','--porcelain'],text=True).splitlines():
              if line[:2]=='??' and line[3:].replace('\\','/').startswith('.strategy_master/'):
                  continue
              bad.append(line)
          if bad: print('GPT master changed out-of-scope files:',*bad,sep='\n',file=sys.stderr); raise SystemExit(3)
          PY

      - name: Apply deterministic strategy policy gate
        id: gate
        env:
          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
        shell: bash
        run: |
          set -euo pipefail
          python -m learnerbot.three_agent_strategy_contract gate-master \
            --input .strategy_master/master_decision.json --output .strategy_master/master_gated.json \
            --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA" | tee /tmp/strategy-gate.txt
          echo "allowed=$(grep '^implementation_allowed=' /tmp/strategy-gate.txt | cut -d= -f2)" >> "$GITHUB_OUTPUT"
          echo "status=$(grep '^status=' /tmp/strategy-gate.txt | cut -d= -f2-)" >> "$GITHUB_OUTPUT"
          echo "accepted=$(grep '^accepted=' /tmp/strategy-gate.txt | cut -d= -f2)" >> "$GITHUB_OUTPUT"

      - name: Publish all-three completion and GPT master ledger
        env:
          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
          MASTER_STATUS: ${{ steps.gate.outputs.status }}
          ACCEPTED: ${{ steps.gate.outputs.accepted }}
          COPILOT_PR: ${{ steps.pr.outputs.number }}
        shell: bash
        run: |
          set -euo pipefail
          rm -rf /tmp/strategy-master-reviews
          git worktree add --detach /tmp/strategy-master-reviews origin/ai-reviews
          dest="/tmp/strategy-master-reviews/strategy/runs/${CYCLE_ID}"
          cp /tmp/copilot-strategy.json "$dest/copilot.json"
          cp /tmp/copilot-strategy.md "$dest/copilot.md"
          cp .strategy_master/master_decision.json "$dest/master_decision_raw.json"
          cp .strategy_master/master_gated.json "$dest/master_decision.json"
          cp .strategy_master/master_decision.md "$dest/master_decision.md"
          cp .strategy_master/master_gated.json /tmp/strategy-master-reviews/strategy/latest_master_decision.json
          python - <<PY > "$dest/completion.json"
          import json
          print(json.dumps({"cycle_id":"${CYCLE_ID}","source_commit":"${SOURCE_SHA}","evidence_sha256":"${EVIDENCE_SHA}",
            "copilot_report_pr":int("${COPILOT_PR}"),"three_agent_reports_complete":True,"master_decision_available":True},indent=2,sort_keys=True))
          PY
          python - <<PY > /tmp/strategy-master-reviews/strategy/latest_status.json
          import json
          print(json.dumps({"available":True,"cycle_id":"${CYCLE_ID}","source_commit":"${SOURCE_SHA}",
            "evidence_sha256":"${EVIDENCE_SHA}","state":"MASTER_DECIDED","gpt":"DONE","gemini":"DONE","copilot":"DONE",
            "three_agent_reports_complete":True,"master_decision_available":True,"master_status":"${MASTER_STATUS}",
            "policy_accepted_count":int("${ACCEPTED}"),"change_pr_url":"","live_auto_deploy":False},indent=2,sort_keys=True))
          PY
