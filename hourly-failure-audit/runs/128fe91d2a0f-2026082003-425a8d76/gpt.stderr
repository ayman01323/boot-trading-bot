   184	def strategy_status(repo_root: Path) -> dict:
   185	    # The three-agent strategy pipeline publishes these paths. Until its first run,
   186	    # commands report WAITING rather than re-labelling the hourly Gemini-only review.
   187	    status = read_json(repo_root, "strategy/latest_status.json")
   188	    master = read_json(repo_root, "strategy/latest_master_decision.json")
   189	    if not status:
   190	        return {
   191	            "available": False,
   192	            "phase": "STRATEGY",
   193	            "gpt": "WAITING",
   194	            "gemini": "WAITING",
   195	            "copilot": "WAITING",
   196	            "three_agent_reports_complete": False,
   197	            "master_decision_available": False,
   198	            "state": "WAITING_FOR_THREE_AGENT_STRATEGY_CYCLE",
   199	        }
   200	    out = dict(status)
   201	    out.setdefault("phase", "STRATEGY")
   202	    out["master_decision_available"] = bool(master)
   203	    out["decision_counts"] = decision_counts(master)
   204	    return out
