     1	name: GPT Master Strategy Action
     2	
     3	on:
     4	  pull_request:
     5	    types: [opened, synchronize, reopened]
     6	    paths:
     7	      - '.ai/strategy/copilot/*.json'
     8	      - '.ai/strategy/copilot/*.md'
     9	  workflow_dispatch:
    10	    inputs:
    11	      copilot_pr_number:
    12	        description: 'Copilot strategy report PR number'
    13	        required: false
    14	        type: string
    15	
    16	permissions:
    17	  contents: write
    18	  pull-requests: write
    19	  issues: write
    20	
    21	concurrency:
    22	  group: gpt-master-strategy-action
    23	  cancel-in-progress: false
    24	
    25	jobs:
    26	  adjudicate:
    27	    if: github.event_name == 'workflow_dispatch' || github.event.pull_request.head.repo.full_name == github.repository
    28	    runs-on: ubuntu-latest
    29	    timeout-minutes: 120
    30	
    31	    steps:
    32	      - name: Resolve Copilot strategy report PR
    33	        id: pr
    34	        env:
    35	          GH_TOKEN: ${{ github.token }}
    36	          INPUT_PR: ${{ inputs.copilot_pr_number }}
    37	          EVENT_PR: ${{ github.event.pull_request.number }}
    38	        shell: bash
    39	        run: |
    40	          set -euo pipefail
    41	          pr="${EVENT_PR:-${INPUT_PR:-}}"
    42	          test -n "$pr"
    43	          head_sha="$(gh pr view "$pr" --json headRefOid --jq '.headRefOid')"
    44	          cross="$(gh pr view "$pr" --json isCrossRepository --jq '.isCrossRepository')"
    45	          if [[ "$cross" == "true" ]]; then echo 'Refusing fork report PR.' >&2; exit 2; fi
    46	          echo "number=${pr}" >> "$GITHUB_OUTPUT"
    47	          echo "head_sha=${head_sha}" >> "$GITHUB_OUTPUT"
    48	
    49	      - uses: actions/checkout@v4
    50	        with:
    51	          ref: ${{ steps.pr.outputs.head_sha }}
    52	          fetch-depth: 0
    53	      - uses: actions/setup-python@v5
    54	        with:
    55	          python-version: '3.11'
    56	          cache: pip
    57	      - uses: actions/setup-node@v4
    58	        with:
    59	          node-version: '22'
    60	
    61	      - name: Install synthesis and implementation tools
    62	        run: |
    63	          python -m pip install --upgrade pip
    64	          pip install -r requirements.txt pytest
    65	          npm install -g @openai/codex@latest
    66	          codex --version
    67	
    68	      - name: Refuse Copilot PR containing anything except its two strategy report files
    69	        env:
    70	          GH_TOKEN: ${{ github.token }}
    71	          PR_NUMBER: ${{ steps.pr.outputs.number }}
    72	        shell: bash
    73	        run: |
    74	          set -euo pipefail
    75	          gh pr diff "$PR_NUMBER" --name-only > /tmp/copilot-strategy-files.txt
    76	          python - <<'PY'
    77	          import pathlib,sys
    78	          files=[x.strip().replace('\\','/') for x in pathlib.Path('/tmp/copilot-strategy-files.txt').read_text().splitlines() if x.strip()]
    79	          if len(files)!=2:
    80	              print('Copilot strategy report PR must contain exactly two files.',*files,sep='\n',file=sys.stderr); raise SystemExit(2)
    81	          if any(not p.startswith('.ai/strategy/copilot/') or pathlib.PurePosixPath(p).suffix not in {'.json','.md'} for p in files):
    82	              print('Non-report file in Copilot strategy PR.',*files,sep='\n',file=sys.stderr); raise SystemExit(3)
    83	          stems={str(pathlib.PurePosixPath(p).with_suffix('')) for p in files}
    84	          if len(stems)!=1: raise SystemExit('Copilot JSON/Markdown report names do not match')
    85	          PY
    86	
    87	      - name: Locate and validate Copilot strategy report
    88	        id: report
    89	        shell: bash
    90	        run: |
    91	          set -euo pipefail
    92	          mapfile -t reports < <(find .ai/strategy/copilot -maxdepth 1 -type f -name '*.json' -print | sort)
    93	          [[ "${#reports[@]}" -eq 1 ]]
    94	          report="${reports[0]}"
    95	          python - <<PY > /tmp/copilot-meta.env
    96	          import json
    97	          p=json.load(open('$report'))
    98	          print('CYCLE_ID='+str(p.get('cycle_id') or ''))
    99	          print('SOURCE_SHA='+str(p.get('source_commit') or ''))
   100	          print('EVIDENCE_SHA='+str(p.get('evidence_sha256') or ''))
   101	          PY
   102	          source /tmp/copilot-meta.env
   103	          test -n "$CYCLE_ID"; test -n "$SOURCE_SHA"; test -n "$EVIDENCE_SHA"
   104	          expected=".ai/strategy/copilot/${CYCLE_ID}.json"
   105	          [[ "$report" == "$expected" && -f ".ai/strategy/copilot/${CYCLE_ID}.md" ]]
   106	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   107	            --input "$report" --provider copilot --cycle-id "$CYCLE_ID" \
   108	            --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   109	          cp "$report" /tmp/copilot-strategy.json
   110	          cp ".ai/strategy/copilot/${CYCLE_ID}.md" /tmp/copilot-strategy.md
   111	          echo "cycle_id=${CYCLE_ID}" >> "$GITHUB_OUTPUT"
   112	          echo "source_sha=${SOURCE_SHA}" >> "$GITHUB_OUTPUT"
   113	          echo "evidence_sha=${EVIDENCE_SHA}" >> "$GITHUB_OUTPUT"
   114	
   115	      - name: Fetch matching GPT/Gemini reports and context
   116	        shell: bash
   117	        env:
   118	          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
   119	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   120	          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
   121	        run: |
   122	          set -euo pipefail
   123	          git fetch --force origin ai-reviews:refs/remotes/origin/ai-reviews
   124	          root="strategy/runs/${CYCLE_ID}"
   125	          for file in gpt.json gemini.json context.json; do git show "origin/ai-reviews:${root}/${file}" > "/tmp/${file}"; done
   126	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   127	            --input /tmp/gpt.json --provider gpt --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   128	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   129	            --input /tmp/gemini.json --provider gemini --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   130	          python - <<'PY'
   131	          import json,sys
   132	          reports=[json.load(open('/tmp/gpt.json')),json.load(open('/tmp/gemini.json')),json.load(open('/tmp/copilot-strategy.json'))]
   133	          bad=[x['provider'] for x in reports if x.get('status')=='INCOMPLETE']
   134	          if bad:
   135	              print('Incomplete independent strategy reports: '+','.join(bad),file=sys.stderr); raise SystemExit(3)
   136	          PY
   137	
   138	      - name: Check out exact reviewed strategy source
   139	        shell: bash
   140	        env:
   141	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   142	        run: |
   143	          set -euo pipefail
   144	          git fetch --force origin main:refs/remotes/origin/main
   145	          git cat-file -e "${SOURCE_SHA}^{commit}"
   146	          git checkout --detach "$SOURCE_SHA"
   147	          git clean -fdx
   148	          mkdir -p .strategy_master
   149	          cp /tmp/gpt.json .strategy_master/gpt.json
   150	          cp /tmp/gemini.json .strategy_master/gemini.json
   151	          cp /tmp/copilot-strategy.json .strategy_master/copilot.json
   152	          cp /tmp/context.json .strategy_master/context.json
   153	
   154	      - name: GPT master strategy synthesis
   155	        id: synth
   156	        env:
   157	          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
   158	          OPENAI_STRATEGY_SYNTH_MODEL: ${{ vars.OPENAI_STRATEGY_SYNTH_MODEL }}
   159	          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
   160	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
