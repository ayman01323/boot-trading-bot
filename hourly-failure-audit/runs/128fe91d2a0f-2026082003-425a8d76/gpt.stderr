          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
        shell: bash
        run: |
          set -euo pipefail
          if [[ -z "${GEMINI_API_KEY:-}" ]]; then
            echo 'GEMINI_API_KEY_MISSING' > .strategy_cycle/gemini_error.txt
            exit 20
          fi
          sed 's/"provider":"PROVIDER"/"provider":"gemini"/' .strategy_cycle/prompt.txt > /tmp/gemini-prompt.txt
          cat >> /tmp/gemini-prompt.txt <<'EOF'
          Inspect read-only. End with exactly:
          STRATEGY_REVIEW_JSON_BEGIN
          {required JSON object}
          STRATEGY_REVIEW_JSON_END
          EOF
          set +e
          gemini --approval-mode=plan --skip-trust --model "$GEMINI_STRATEGY_MODEL" --output-format text \
            -p "$(cat /tmp/gemini-prompt.txt)" > .strategy_cycle/gemini_stdout.txt \
            2> >(tee .strategy_cycle/gemini_error.txt >&2)
          rc=$?
          set -e
          [[ $rc -eq 0 ]] || exit "$rc"
          python scripts/extract_strategy_report.py \
            --input .strategy_cycle/gemini_stdout.txt --output .strategy_cycle/gemini.json \
            --provider gemini --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
          python - <<'PY'
          import json
