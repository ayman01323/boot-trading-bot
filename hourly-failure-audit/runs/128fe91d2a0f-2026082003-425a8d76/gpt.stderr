    93	def engineering_status(repo_root: Path) -> dict:
    94	    source = read_text(repo_root, "weekly/latest_source_commit.txt") or ""
    95	    kickoff = read_text(repo_root, "weekly/latest_kickoff_utc.txt") or ""
    96	    completed_source = read_text(repo_root, "weekly/latest_completed_source_commit.txt") or ""
    97	    completed_utc = read_text(repo_root, "weekly/latest_completed_utc.txt") or ""
    98	    if not source:
    99	        return {
   100	            "available": False,
   101	            "phase": "ENGINEERING",
   102	            "source_commit": "",
   103	            "gpt": "WAITING",
   104	            "gemini": "WAITING",
   105	            "copilot": "WAITING",
   106	            "three_agent_reports_complete": False,
   107	            "master_decision_available": False,
   108	        }
   109	
   110	    run_root = f"weekly/runs/{source}"
   111	    gpt = read_json(repo_root, f"{run_root}/gpt.json")
   112	    gemini = read_json(repo_root, f"{run_root}/gemini.json")
   113	    copilot = read_json(repo_root, f"{run_root}/copilot.json")
   114	    completion = read_json(repo_root, f"{run_root}/completion.json") or {}
   115	    master = read_json(repo_root, f"{run_root}/master_decision.json")
   116	    action = read_json(repo_root, f"{run_root}/action_status.json") or {}
   117	
   118	    done = bool(
   119	        completed_source == source
   120	        and completion.get("three_agent_reports_complete") is True
   121	        and _agent_status(gpt) == "DONE"
   122	        and _agent_status(gemini) == "DONE"
   123	        and _agent_status(copilot) == "DONE"
   124	    )
   125	    return {
   126	        "available": True,
   127	        "phase": "ENGINEERING",
   128	        "source_commit": source,
   129	        "kickoff_utc": kickoff,
   130	        "completed_utc": completed_utc if completed_source == source else "",
   131	        "gpt": _agent_status(gpt),
   132	        "gemini": _agent_status(gemini),
   133	        "copilot": _agent_status(copilot),
   134	        "three_agent_reports_complete": done,
   135	        "master_decision_available": bool(master),
   136	        "master_status": str((master or {}).get("status") or "WAITING"),
   137	        "master_summary": str((master or {}).get("summary") or "")[:900],
   138	        "decision_counts": decision_counts(master),
   139	        "policy_accepted_count": int((master or {}).get("policy_accepted_count") or 0),
   140	        "implementation_allowed": bool((master or {}).get("implementation_allowed")),
   141	        "corrective_pr_url": str(action.get("corrective_pr_url") or ""),
   142	        "corrective_branch": str(action.get("corrective_branch") or ""),
   143	        "action_state": str(action.get("state") or ("MASTER_DECIDED" if master else "WAITING")),
   144	    }
   145	
   146	
   147	def decision_counts(master: dict | None) -> dict[str, int]:
   148	    out = {"ACCEPT": 0, "REJECT": 0, "DEFER": 0}
   149	    for row in (master or {}).get("decisions") or []:
   150	        value = str((row or {}).get("disposition") or "").upper()
   151	        if value in out:
   152	            out[value] += 1
   153	    return out
   154	
   155	
   156	def decision_rows(master: dict | None, disposition: str | None = None, *, limit: int = 8) -> list[dict]:
   157	    wanted = str(disposition or "").upper().strip()
   158	    rows = []
   159	    for raw in (master or {}).get("decisions") or []:
   160	        if not isinstance(raw, dict):
   161	            continue
   162	        d = str(raw.get("disposition") or "").upper()
   163	        if wanted and d != wanted:
   164	            continue
   165	        rows.append({
   166	            "id": str(raw.get("finding_id") or "")[:80],
   167	            "severity": str(raw.get("severity") or ""),
   168	            "title": str(raw.get("title") or "")[:240],
   169	            "disposition": d,
   170	            "reason": str(raw.get("reason") or "")[:700],
   171	            "confidence": raw.get("confidence"),
   172	            "policy_eligible": bool(raw.get("policy_eligible")),
   173	            "policy_reasons": [str(x)[:220] for x in (raw.get("policy_reasons") or [])[:4]],
   174	        })
   175	        if len(rows) >= max(1, int(limit)):
   176	            break
   177	    return rows
   178	
   179	
   180	def latest_master_decision(repo_root: Path) -> dict | None:
   181	    return read_json(repo_root, "weekly/latest_master_decision.json")
