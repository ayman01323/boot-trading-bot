    15	def master_chat_ids(csv_dir: Path) -> list[str]:
    16	    """Return ACTIVE MASTER Telegram IDs from the existing user registry."""
    17	    out: list[str] = []
    18	    for row in all_users(Path(csv_dir)):
    19	        tid = str(row.get("telegram_id") or "").strip()
    20	        if not tid or not tid.lstrip("-").isdigit():
    21	            continue
    22	        if str(row.get("role") or "USER").upper() != "MASTER":
    23	            continue
    24	        if str(row.get("status") or "").upper() != "ACTIVE":
    25	            continue
    26	        if tid not in out:
    27	            out.append(tid)
    28	    return out[:5]
