name: Hourly Three-Agent Strategy Cycle

on:
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:

permissions:
  contents: write
  issues: write
  pull-requests: read

concurrency:
  group: hourly-three-agent-strategy-cycle
  cancel-in-progress: false

jobs:
  review:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - name: Check out exact current main
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: pip

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install review tools
        shell: bash
        run: |
          set -euo pipefail
          python -m pip install --upgrade pip
          pip install -r requirements.txt pytest
          npm install -g @openai/codex@latest @google/gemini-cli@latest
          codex --version
          gemini --version

      - name: Provider credential preflight
        id: creds
        env:
          CODEX_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          COPILOT_ASSIGN_TOKEN: ${{ secrets.COPILOT_ASSIGN_TOKEN }}
        shell: bash
        run: |
          set -euo pipefail
          [[ -n "${CODEX_API_KEY:-}" ]] && echo 'openai=true' >> "$GITHUB_OUTPUT" || echo 'openai=false' >> "$GITHUB_OUTPUT"
          [[ -n "${GEMINI_API_KEY:-}" ]] && echo 'gemini=true' >> "$GITHUB_OUTPUT" || echo 'gemini=false' >> "$GITHUB_OUTPUT"
          [[ -n "${COPILOT_ASSIGN_TOKEN:-}" ]] && echo 'copilot_token=true' >> "$GITHUB_OUTPUT" || echo 'copilot_token=false' >> "$GITHUB_OUTPUT"
          echo "Codex API credential present: $([[ -n "${CODEX_API_KEY:-}" ]] && echo yes || echo no)"
          echo "Gemini credential present: $([[ -n "${GEMINI_API_KEY:-}" ]] && echo yes || echo no)"
          echo "Copilot assignment credential present: $([[ -n "${COPILOT_ASSIGN_TOKEN:-}" ]] && echo yes || echo no)"

      - name: Resolve source and freshest available evidence
        id: meta
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p .strategy_cycle
          SOURCE_SHA="$(git rev-parse HEAD)"
          EVIDENCE_SOURCE="architecture-only"
          EVIDENCE_FRESH="false"
          if git ls-remote --exit-code --heads origin audit-status >/dev/null 2>&1; then
            git fetch --force origin audit-status:refs/remotes/origin/audit-status
            if git show origin/audit-status:latest_loss_forensics.json > .strategy_cycle/evidence.json 2>/dev/null; then
              EVIDENCE_SOURCE="audit-status:latest_loss_forensics.json"
              age="$(python - <<'PY'
          import json,time
          p=json.load(open('.strategy_cycle/evidence.json'))
          t=int(p.get('generated_epoch') or 0)
          print(max(0,int(time.time())-t) if t else 10**9)
          PY
          )"
              if [[ "$age" -le 7200 ]]; then EVIDENCE_FRESH="true"; fi
            fi
          fi
          if [[ ! -s .strategy_cycle/evidence.json ]]; then
            python - "$SOURCE_SHA" <<'PY' > .strategy_cycle/evidence.json
          import json,sys
          print(json.dumps({
            'schema_version':1,
            'generated_epoch':0,
            'generated_utc':'',
            'evidence_status':'MISSING_RUNTIME_FORENSICS',
            'source_commit':sys.argv[1],
            'note':'No current sanitised runtime forensics branch was available. Review code/architecture, identify evidence gaps, and do not claim live profitability or canary readiness.'
          },indent=2,sort_keys=True))
          PY
          fi
          EVIDENCE_SHA="$(python - <<'PY'
          import hashlib,json
          p=json.load(open('.strategy_cycle/evidence.json'))
          raw=json.dumps(p,sort_keys=True,separators=(',',':'),default=str).encode()
          print(hashlib.sha256(raw).hexdigest())
          PY
          )"
          HOUR_KEY="$(date -u +'%Y%m%d%H')"
          CYCLE_ID="${SOURCE_SHA:0:12}-${HOUR_KEY}-${EVIDENCE_SHA:0:8}"
          echo "source_sha=$SOURCE_SHA" >> "$GITHUB_OUTPUT"
          echo "evidence_sha=$EVIDENCE_SHA" >> "$GITHUB_OUTPUT"
          echo "cycle_id=$CYCLE_ID" >> "$GITHUB_OUTPUT"
          echo "evidence_source=$EVIDENCE_SOURCE" >> "$GITHUB_OUTPUT"
          echo "evidence_fresh=$EVIDENCE_FRESH" >> "$GITHUB_OUTPUT"

      - name: Prepare common strategy prompt
        env:
          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
          CYCLE_ID: ${{ steps.meta.outputs.cycle_id }}
          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
          EVIDENCE_SOURCE: ${{ steps.meta.outputs.evidence_source }}
          EVIDENCE_FRESH: ${{ steps.meta.outputs.evidence_fresh }}
        shell: bash
        run: |
          cat > .strategy_cycle/prompt.txt <<EOF
          You are one of three INDEPENDENT strategy reviewers for a multi-chain automated trading bot.
          Inspect the entire checked-out repository and .strategy_cycle/evidence.json.

          Objective: durable money-weighted NET P&L after fees, slippage, price impact, gas/priority fees and execution failures.
          Never optimise raw win count and never force a trade without positive executable edge. Review Solana and EVM using
          chain-specific economics. Review current Strategy Lab families, profitable-wallet/route learning, forecasting,
          cross-venue arbitrage, momentum, mean reversion, flow acceleration, new-liquidity quality and learned-route replication.
          Explicitly classify negative outcomes as STRATEGY/MARKET versus EXECUTION/INFRASTRUCTURE so provider failures such as
          RPC/Jupiter rate limits are not mistaken for evidence that the trading hypothesis itself is bad.

          Runtime evidence source: ${EVIDENCE_SOURCE}; fresh-within-2h=${EVIDENCE_FRESH}.
          If fresh runtime evidence is unavailable, you MAY suggest code/SHADOW hypotheses but MUST NOT claim a strategy is
          profitable, canary-ready or live-ready. Explicitly list the missing evidence needed to promote it.

          REPORT ONLY. Do not edit tracked code, trade, deploy, change capital/risk/live settings, touch secrets/wallets/signing,
          auto-add assets, or weaken any execution/sellability/liquidity/simulation protection.

          Required JSON:
          {
            "schema_version":1,
            "provider":"PROVIDER",
            "cycle_id":"${CYCLE_ID}",
            "source_commit":"${SOURCE_SHA}",
            "evidence_sha256":"${EVIDENCE_SHA}",
            "scope":"THREE_AGENT_STRATEGY_REVIEW",
            "status":"HEALTHY|CHANGES_PROPOSED|INCOMPLETE",
            "summary":"...",
            "proposals":[{
              "id":"stable-id",
              "action":"KEEP|IMPROVE|REWORK|SHADOW_MORE|REPLACE|DORMANT|NEW_SHADOW|ASSET_REQUEST|RESEARCH_MORE",
              "strategy":"...",
              "chain_scope":["SOLANA","EVM"],
              "evidence":[{"path":"repository or JSON path","detail":"specific support"}],
              "rationale":"...",
              "expected_effect":"...",
              "downside_risk":"...",
              "shadow_test":"falsifiable test including costs and stop/failure condition",
              "minimum_observation":"...",
              "confidence":0.0,
              "suggested_files":["Strategy Lab/SHADOW files only"]
            }],
            "rejected_ideas":[{"idea":"...","reason":"..."}],
            "evidence_gaps":["..."],
            "review_only":true,
            "no_live_changes":true
          }
          Prefer no change over unsupported confidence.
          EOF

      - name: GPT independent strategy report
        id: gpt
        continue-on-error: true
        env:
          CODEX_API_KEY: ${{ secrets.OPENAI_API_KEY }}
          OPENAI_STRATEGY_AUDIT_MODEL: ${{ vars.OPENAI_STRATEGY_AUDIT_MODEL }}
          CYCLE_ID: ${{ steps.meta.outputs.cycle_id }}
          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
        shell: bash
        run: |
          set -euo pipefail
          if [[ -z "${CODEX_API_KEY:-}" ]]; then
            echo 'OPENAI_API_KEY_SOURCE_SECRET_MISSING' > .strategy_cycle/gpt_error.txt
            exit 20
          fi
          sed 's/"provider":"PROVIDER"/"provider":"gpt"/' .strategy_cycle/prompt.txt > /tmp/gpt-prompt.txt
          printf '\nWrite exactly .strategy_cycle/gpt.json and .strategy_cycle/gpt.md. Change no tracked file.\n' >> /tmp/gpt-prompt.txt
          model_args=()
          if [[ -n "${OPENAI_STRATEGY_AUDIT_MODEL:-}" ]]; then model_args=(-m "$OPENAI_STRATEGY_AUDIT_MODEL"); fi
          set +e
          codex --ask-for-approval never exec --sandbox workspace-write --ephemeral "${model_args[@]}" - < /tmp/gpt-prompt.txt \
            2> >(tee .strategy_cycle/gpt_error.txt >&2)
          rc=$?
          set -e
          [[ $rc -eq 0 ]] || exit "$rc"
          python -m learnerbot.three_agent_strategy_contract validate-agent \
            --input .strategy_cycle/gpt.json --provider gpt --cycle-id "$CYCLE_ID" \
            --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"

      - name: Recover GPT incomplete report
        if: steps.gpt.outcome != 'success'
        env:
          CYCLE_ID: ${{ steps.meta.outputs.cycle_id }}
          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
