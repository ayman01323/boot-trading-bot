    63	def _home_text(state: dict) -> str:
    64	    eng = (state or {}).get("engineering") or {}
    65	    strategy = (state or {}).get("strategy") or {}
    66	
    67	    def mark(value):
    68	        value = str(value or "WAITING").upper()
    69	        if value == "DONE":
    70	            return "✅"
    71	        if value == "INCOMPLETE":
    72	            return "⚠️"
    73	        return "⏳"
    74	
    75	    lines = [
    76	        "<b>🤖 AI REPORTS &amp; OPERATIONS</b>",
    77	        "━━━━━━━━━━━━━━━━━━━━",
    78	        "",
    79	        "<b>ENGINEERING</b>",
    80	    ]
    81	    if eng.get("available"):
    82	        lines += [
    83	            f"GPT {mark(eng.get('gpt'))}  Gemini {mark(eng.get('gemini'))}  Copilot {mark(eng.get('copilot'))}",
    84	            f"Master decision: <b>{html.escape(str(eng.get('master_status') or 'WAITING'))}</b>",
    85	        ]
    86	    else:
    87	        lines.append("⏳ No completed/published engineering cycle yet.")
    88	
    89	    lines += ["", "<b>STRATEGY — HOURLY</b>"]
    90	    if strategy.get("available"):
    91	        lines += [
    92	            f"GPT {mark(strategy.get('gpt'))}  Gemini {mark(strategy.get('gemini'))}  Copilot {mark(strategy.get('copilot'))}",
    93	            f"Cycle: <code>{html.escape(str(strategy.get('cycle_id') or '')[:80])}</code>",
    94	            f"Master decision: <b>{'AVAILABLE' if strategy.get('master_decision_available') else 'WAITING'}</b>",
    95	        ]
    96	    else:
    97	        lines.append("⏳ Waiting for the first published hourly three-agent strategy cycle.")
    98	
    99	    if not state.get("fetch_ok", True):
   100	        lines += ["", "⚠️ Latest ai-reviews fetch failed; showing cached state."]
   101	
   102	    lines += [
   103	        "",
   104	        "Tap a report below. GPT ACCEPT / REJECT / DEFER detail is under <b>GPT Decisions</b>.",
   105	    ]
   106	    return "\n".join(lines)
