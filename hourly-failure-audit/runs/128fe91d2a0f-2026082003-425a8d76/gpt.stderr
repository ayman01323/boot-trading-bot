    69	        f"Gemini: {_agent_icon(e.get('gemini'))} <b>{_safe(e.get('gemini'))}</b>",
    70	        f"Copilot: {_agent_icon(e.get('copilot'))} <b>{_safe(e.get('copilot'))}</b>",
    71	        f"All three complete: <b>{'YES' if e.get('three_agent_reports_complete') else 'NO'}</b>",
    72	    ]
    73	    if e.get("master_decision_available"):
    74	        lines += [
    75	            "",
    76	            f"GPT master: <b>{_safe(e.get('master_status'))}</b>",
    77	            f"ACCEPT <b>{counts.get('ACCEPT',0)}</b> | REJECT <b>{counts.get('REJECT',0)}</b> | DEFER <b>{counts.get('DEFER',0)}</b>",
    78	            f"Policy-approved fixes: <b>{int(e.get('policy_accepted_count') or 0)}</b>",
    79	        ]
    80	    if e.get("corrective_pr_url"):
    81	        lines += ["", f"Corrective draft PR: {_safe(e.get('corrective_pr_url'), 300)}"]
    82	    lines += ["", "Use <code>/aidecision</code> to see why GPT accepted, rejected or deferred findings."]
    83	    return "\n".join(lines)
