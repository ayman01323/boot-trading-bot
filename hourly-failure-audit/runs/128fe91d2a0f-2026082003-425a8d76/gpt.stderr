   169	def set_commands(token: str):
   170	    _PREV_SET_COMMANDS(token)
   171	    try:
   172	        csv_dir = _repo_root() / "CSVbot"
   173	        for row in all_users(csv_dir):
   174	            tid = str(row.get("telegram_id") or "").strip()
   175	            if not tid or not tid.lstrip("-").isdigit():
   176	                continue
   177	            if str(row.get("role") or "USER").upper() != "MASTER" or str(row.get("status") or "").upper() != "ACTIVE":
   178	                continue
   179	            scope = {"type": "chat", "chat_id": int(tid)}
   180	            current = _tg._json("getMyCommands", token, payload={"scope": scope}, timeout=15) or []
   181	            _tg._json("setMyCommands", token, payload={"commands": _command_set(current), "scope": scope}, timeout=15)
   182	    except Exception as exc:
   183	        print(f"[telegram-ai-ops-commands] {type(exc).__name__}: {exc}")
   184	
   185	
   186	def handle_update(app, update):
   187	    message = update.get("message") or {}
   188	    tid = (message.get("chat") or {}).get("id")
   189	    text = str(message.get("text") or "").strip()
   190	    if tid is not None and text.startswith("/"):
   191	        parts = text.split(maxsplit=1)
   192	        cmd = parts[0].split("@", 1)[0].lower()
   193	        arg = parts[1].strip() if len(parts) > 1 else ""
   194	        if cmd in {"/aiaudit", "/aiagents", "/aidecision", "/aistrategy", "/aiupdates"}:
   195	            try:
   196	                _ui._require_master(app, tid)
   197	            except Exception as exc:
   198	                _ui._send(app, tid, f"⚠️ {_safe(exc,250)}")
   199	                return
   200	            state = snapshot_for_display(_repo_root())
   201	            if cmd in {"/aiaudit", "/aiagents"}:
   202	                body = _engineering_text(state)
   203	            elif cmd == "/aidecision":
   204	                body = _decision_text(state, arg)
   205	            elif cmd == "/aistrategy":
   206	                body = _strategy_text(state)
   207	            else:
   208	                body = _combined_text(state)
   209	            if not state.get("fetch_ok"):
   210	                body += "\n\n⚠️ Latest ai-reviews fetch failed; showing the newest locally cached remote state."
   211	            _ui._send(app, tid, body)
   212	            return
   213	    return _PREV_HANDLE_UPDATE(app, update)
   214	
   215	
   216	def _watch_loop(app):
   217	    time.sleep(8)
   218	    state_file = _state_path(app)
   219	    previous = load_sent_state(state_file)
   220	    while True:
   221	        try:
   222	            current = snapshot_for_display(_repo_root())
   223	            # Do not publish git transport errors to Telegram repeatedly; keep them in logs.
   224	            if current.get("fetch_ok"):
   225	                for text in transition_messages(previous, current):
   226	                    masters = master_chat_ids(app.csv_dir)
   227	                    if masters and app.telegram_bot_token:
   228	                        _tg.send_to_chats(app.telegram_bot_token, masters, text, disable_notification=False)
   229	                save_sent_state(state_file, current)
   230	                previous = current
   231	            else:
   232	                print(f"[ai-ops-watcher] fetch failed: {current.get('fetch_detail')}")
   233	        except Exception as exc:
   234	            print(f"[ai-ops-watcher] {type(exc).__name__}: {exc}")
   235	        time.sleep(60)
   236	
   237	
   238	def _start_watcher(app):
   239	    global _THREAD_STARTED
   240	    with _THREAD_LOCK:
   241	        if _THREAD_STARTED:
   242	            return
   243	        if not getattr(app, "telegram_bot_token", ""):
   244	            return
   245	        thread = threading.Thread(target=_watch_loop, args=(app,), name="ai-ops-telegram-watcher", daemon=True)
   246	        thread.start()
   247	        _THREAD_STARTED = True
   248	        print("[ai-ops-watcher] started interval=60s master-role-dynamic=true")
