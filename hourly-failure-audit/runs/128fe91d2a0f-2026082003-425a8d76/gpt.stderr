    86	def _decision_text(state: dict, filter_name: str = "") -> str:
    87	    e = (state or {}).get("engineering") or {}
    88	    if not e.get("master_decision_available"):
    89	        return "<b>🧠 GPT MASTER DECISION</b>\n\nNot available yet. All three engineering reports must complete first."
    90	    master = latest_master_decision(_repo_root()) or {}
    91	    counts = e.get("decision_counts") or {}
    92	    wanted = str(filter_name or "").upper().strip()
    93	    if wanted not in {"ACCEPT", "REJECT", "DEFER"}:
    94	        wanted = ""
    95	    lines = [
    96	        "<b>🧠 GPT MASTER ENGINEERING DECISION</b>",
    97	        f"Status: <b>{_safe(e.get('master_status'))}</b>",
    98	        f"ACCEPT <b>{counts.get('ACCEPT',0)}</b> | REJECT <b>{counts.get('REJECT',0)}</b> | DEFER <b>{counts.get('DEFER',0)}</b>",
    99	        "",
   100	        _safe(e.get("master_summary") or "No summary supplied.", 800),
   101	    ]
   102	    rows = decision_rows(master, wanted or None, limit=8)
   103	    if rows:
   104	        lines.append("")
   105	        lines.append(f"<b>{_safe(wanted or 'Latest decisions')}:</b>")
   106	        for row in rows:
   107	            marker = {"ACCEPT": "✅", "REJECT": "❌", "DEFER": "⏸"}.get(row.get("disposition"), "•")
   108	            lines.append(
   109	                f"{marker} <b>{_safe(row.get('severity'))} {_safe(row.get('title'),220)}</b>\n"
   110	                f"Reason: {_safe(row.get('reason'),550)}"
   111	            )
   112	            if row.get("disposition") == "ACCEPT" and not row.get("policy_eligible"):
   113	                reasons = "; ".join(row.get("policy_reasons") or [])
   114	                lines.append(f"Policy override: {_safe(reasons,450)}")
   115	    lines += [
   116	        "",
   117	        "<i>GPT is not the final safety authority. The deterministic policy gate can block GPT, and accepted fixes still require tests and a draft PR.</i>",
   118	        "Filter with <code>/aidecision accept</code>, <code>/aidecision reject</code> or <code>/aidecision defer</code>.",
   119	    ]
   120	    return "\n".join(lines)
   121	
   122	
   123	def _strategy_text(state: dict) -> str:
   124	    s = (state or {}).get("strategy") or {}
   125	    if not s.get("available"):
   126	        return (
   127	            "<b>🔬 THREE-AGENT STRATEGY REVIEW</b>\n\n"
   128	            "Waiting for the first sequenced GPT + Gemini + Copilot strategy cycle. "
   129	            "The hourly Gemini-only research review is not counted as a three-agent completion."
   130	        )
   131	    counts = s.get("decision_counts") or {}
   132	    lines = [
   133	        "<b>🔬 THREE-AGENT STRATEGY REVIEW</b>",
   134	        "",
   135	        f"Cycle: <code>{_safe(s.get('cycle_id'),120)}</code>",
   136	        f"GPT: {_agent_icon(s.get('gpt'))} <b>{_safe(s.get('gpt'))}</b>",
   137	        f"Gemini: {_agent_icon(s.get('gemini'))} <b>{_safe(s.get('gemini'))}</b>",
   138	        f"Copilot: {_agent_icon(s.get('copilot'))} <b>{_safe(s.get('copilot'))}</b>",
   139	        f"All three complete: <b>{'YES' if s.get('three_agent_reports_complete') else 'NO'}</b>",
   140	    ]
   141	    if s.get("master_decision_available"):
   142	        lines += ["", f"ACCEPT {counts.get('ACCEPT',0)} | REJECT {counts.get('REJECT',0)} | DEFER {counts.get('DEFER',0)}"]
   143	    if s.get("change_pr_url"):
   144	        lines += ["", f"Strategy change draft PR: {_safe(s.get('change_pr_url'),300)}"]
   145	    lines += ["", "<i>New/changed strategies remain shadow-first and are never auto-deployed live by this review lane.</i>"]
   146	    return "\n".join(lines)
