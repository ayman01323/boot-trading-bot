   146	def _profit_control_report(app, cutoff: int) -> dict:
   147	    path = Path(app.data_dir) / "profit_control_loop.sqlite3"
   148	    if not path.exists():
   149	        return {"available": False}
   150	    conn = _readonly(path)
   151	    try:
   152	        out = {"available": True}
   153	        if _table_exists(conn, "control_state"):
   154	            out["state"] = {
   155	                str(r["key"]): str(r["value"])
   156	                for r in conn.execute("SELECT key,value FROM control_state").fetchall()
   157	            }
   158	        if _table_exists(conn, "control_runs"):
   159	            out["recent_runs"] = [
   160	                dict(r)
   161	                for r in conn.execute(
   162	                    """SELECT generated_at,profile,closed_trades,wins,losses,
   163	                              gross_profit_sol,gross_loss_sol,net_sol,profit_factor,
   164	                              profile_changed,previous_profile,gpt_status
   165	                       FROM control_runs
   166	                       WHERE generated_at>=?
   167	                       ORDER BY generated_at DESC LIMIT 48""",
   168	                    (int(cutoff),),
   169	                ).fetchall()
   170	            ]
   171	        if _table_exists(conn, "strategy_registry"):
   172	            out["strategy_registry"] = [
   173	                dict(r)
   174	                for r in conn.execute(
   175	                    """SELECT profile,hours_observed,closed_trades,wins,losses,
   176	                              gross_profit_sol,gross_loss_sol,net_sol,profit_factor,
   177	                              successful,last_used_at,updated_at
   178	                       FROM strategy_registry ORDER BY updated_at DESC"""
   179	                ).fetchall()
   180	            ]
   181	        return out
   182	    finally:
   183	        conn.close()
   184	
