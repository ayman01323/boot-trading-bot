    82	def _agent_status(report: dict | None) -> str:
    83	    if not report:
    84	        return "WAITING"
    85	    status = str(report.get("status") or "UNKNOWN").upper()
    86	    if status == "INCOMPLETE":
    87	        return "INCOMPLETE"
    88	    if status in {"CLEAN", "ISSUES_FOUND"}:
    89	        return "DONE"
    90	    return status
