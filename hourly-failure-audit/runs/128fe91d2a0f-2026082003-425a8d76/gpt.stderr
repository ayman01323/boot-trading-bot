name: Hourly Gemini Strategy Review

on:
  schedule:
    - cron: "23 * * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: hourly-gemini-strategy-review
  cancel-in-progress: false

jobs:
  review:
    name: Review latest sanitised trading evidence with Gemini
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Check out repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Fetch latest sanitised evidence
        id: source
        shell: bash
        run: |
          set -euo pipefail
          git fetch --force origin audit-status:audit-status
          git fetch --force origin ai-reviews:ai-reviews || true
          git show audit-status:latest_loss_forensics.json > /tmp/latest_loss_forensics.json

          python - <<'PY' > /tmp/source.env
          import hashlib, json, time
          p = '/tmp/latest_loss_forensics.json'
          report = json.load(open(p, encoding='utf-8'))
          canonical = json.dumps(report, sort_keys=True, separators=(',', ':'), default=str)
          print('SOURCE_HASH=' + hashlib.sha256(canonical.encode()).hexdigest())
          generated = int(report.get('generated_epoch') or 0)
          age = max(0, int(time.time()) - generated) if generated else 10**9
          print('SOURCE_AGE_SECONDS=' + str(age))
          PY
          source /tmp/source.env

          previous=""
          if git show ai-reviews:reviews/gemini/latest_source_sha256.txt > /tmp/previous_hash 2>/dev/null; then
            previous="$(tr -d '\r\n' < /tmp/previous_hash)"
          fi

          echo "source_hash=${SOURCE_HASH}" >> "$GITHUB_OUTPUT"
          if [[ "$SOURCE_AGE_SECONDS" -gt 14400 ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "skip_reason=source report older than 4 hours" >> "$GITHUB_OUTPUT"
          elif [[ -n "$previous" && "$previous" == "$SOURCE_HASH" ]]; then
            echo "skip=true" >> "$GITHUB_OUTPUT"
            echo "skip_reason=source report already reviewed by Gemini" >> "$GITHUB_OUTPUT"
          else
            echo "skip=false" >> "$GITHUB_OUTPUT"
            echo "skip_reason=" >> "$GITHUB_OUTPUT"
          fi

      - name: Call Gemini reviewer
        if: steps.source.outputs.skip != 'true'
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GEMINI_MODEL: ${{ vars.GEMINI_MODEL || 'gemini-3.1-pro-preview' }}
          SOURCE_HASH: ${{ steps.source.outputs.source_hash }}
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import json, os, urllib.request

          key = os.environ.get('GEMINI_API_KEY', '').strip()
          model = os.environ.get('GEMINI_MODEL', 'gemini-3.1-pro-preview').strip()
          if not key:
              raise SystemExit('GEMINI_API_KEY is not configured for GitHub Actions')

          report = json.load(open('/tmp/latest_loss_forensics.json', encoding='utf-8'))
          prompt = '''You are an independent quantitative reviewer and Strategy Laboratory researcher for an automated cryptocurrency trading system.
Use the supplied sanitised evidence as the primary truth. Optimise durable realised NET P&L after measured costs, not win count.
The Strategy Laboratory covers BOTH Solana and EVM. The same economic strategy family may be researched on both, but each chain requires its own executable quote, liquidity, sellability, fees/gas/priority cost, slippage, price impact, latency and MEV assumptions.

Push the learner beyond leader-wallet copying. Inspect profitable-wallet cohort summaries and learned strategy_patterns for behaviours repeated across multiple profitable wallets. A single profitable wallet is not proof. Prefer route/behaviour structures that remain positive after costs, have enough observations and can be falsified in SHADOW.

When evidence is missing, recommend specific research tools/sources. Preferred tools are Dune for public wallet/DEX cohort research, DEX Screener for pools/liquidity/flow, Etherscan V2 for EVM wallet histories, DefiLlama for chain/protocol regimes, Jupiter for Solana quote/route research, and GitHub public code search for READ-ONLY public bot architecture/strategy ideas. Never execute untrusted third-party repository code.

You may propose predictive strategies, but the forecast target must be positive NET edge after costs, not price-up/down alone. Require time-ordered validation with no lookahead, probability calibration, expected net edge, an abstain rule for uncertainty, and separate chain/regime results.

If evidence identifies an asset that is not in the current product universe, you may create an ASSET REQUEST only. It is not a live buy recommendation and not permission to enable the asset. State chain, asset identifier, symbol if known, evidence, reason, and required identity/liquidity/sellability/quote/simulation/risk checks.

Do not produce live trading instructions. Do not relax safety controls. Every new strategy or cross-chain port starts SHADOW. Return JSON only with this exact top-level structure:
{
  "status":"HEALTHY|WATCH|DEGRADED",
  "executive_summary":"...",
  "observed_facts":[{"fact":"...","evidence":"...","importance":"LOW|MEDIUM|HIGH"}],
  "recommendations":[{"title":"...","rationale":"...","downside_risk":"...","shadow_test":"...","minimum_evidence":"...","live_mode":false}],
  "research_tools_to_use":[{"tool":"...","purpose":"...","evidence_to_collect":"...","priority":"LOW|MEDIUM|HIGH"}],
  "cross_chain_portability":[{"strategy_or_pattern":"...","source_chain_type":"SOLANA|EVM|BOTH","target_chain_type":"SOLANA|EVM","reason":"...","chain_specific_changes":["..."],"shadow_test":"..."}],
  "forecast_experiments":[{"name":"...","target":"positive_net_edge_after_costs","horizon":"...","features":["..."],"validation":"...","trade_threshold":"...","abstain_rule":"...","shadow_test":"..."}],
  "new_strategy_hypotheses":[{
    "name":"...",
    "family":"...",
    "hypothesis":"...",
    "market_regime":"...",
    "entry_logic":"...",
    "exit_logic":"...",
    "data_required":["..."],
    "estimated_costs":"...",
    "failure_modes":["..."],
    "shadow_test":"...",
    "minimum_observation_windows":3,
    "minimum_trades":5,
    "falsification_conditions":["..."],
    "differentiation":"...",
    "chain_scope":["SOLANA","EVM"],
    "research_plan":["..."],
    "research_tools":["..."],
    "forecast":{},
    "asset_requests":[]
  }],
  "asset_requests":[{"chain":"SOLANA|EVM","asset":"...","symbol":"...","reason":"...","evidence":"...","required_checks":["identity","liquidity","sellability","quote/simulation","cost","risk"]}],
  "evidence_gaps":["..."],
  "no_live_changes":true
}
Limit new_strategy_hypotheses to at most 2 per review and asset_requests to only evidence-supported missing-universe cases.
SOURCE REPORT:\n''' + json.dumps(report, sort_keys=True, default=str)

          body = {
              'systemInstruction': {'parts': [{'text': 'Return valid JSON only. Never authorise live trading changes, automatic asset enablement, or execution of untrusted third-party code.'}]},
              'contents': [{'role': 'user', 'parts': [{'text': prompt}]}],
              'generationConfig': {'responseMimeType': 'application/json', 'temperature': 0.1},
          }
          url = f'https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent'
          req = urllib.request.Request(
              url,
              data=json.dumps(body).encode('utf-8'),
              headers={'Content-Type':'application/json','x-goog-api-key':key},
              method='POST',
          )
          with urllib.request.urlopen(req, timeout=120) as resp:
              payload = json.loads(resp.read().decode('utf-8'))
          text = ''.join(
              str(part.get('text') or '')
              for cand in payload.get('candidates') or []
              for part in ((cand.get('content') or {}).get('parts') or [])
              if isinstance(part, dict)
          ).strip()
          review = json.loads(text)
          if review.get('no_live_changes') is not True:
              raise SystemExit('Gemini review failed no_live_changes safety gate')
          for rec in review.get('recommendations') or []:
              if rec.get('live_mode') is not False:
                  raise SystemExit('Gemini recommendation attempted live_mode')
          if len(review.get('new_strategy_hypotheses') or []) > 2:
              raise SystemExit('Gemini proposed too many new strategies in one review')
          out = {
              'schema_version': 2,
              'provider': 'gemini',
              'model': model,
              'source_report_sha256': os.environ.get('SOURCE_HASH', ''),
              'review': review,
              'live_auto_deploy': False,
              'asset_auto_add': False,
              'mode': 'STRATEGY_LAB_RESEARCH_ONLY',
          }
          json.dump(out, open('/tmp/gemini_review.json','w',encoding='utf-8'), indent=2, sort_keys=True)
          print('Gemini Strategy Lab review completed safely.')
          PY

      - name: Publish Gemini review to ai-reviews branch
        if: steps.source.outputs.skip != 'true'
        shell: bash
        env:
          SOURCE_HASH: ${{ steps.source.outputs.source_hash }}
        run: |
          set -euo pipefail
          stamp="$(date -u +'%Y%m%d_%H%M%S')"
          git config user.name "gemini-strategy-review-bot"
          git config user.email "gemini-strategy-review-bot@users.noreply.github.com"
          git switch ai-reviews
          mkdir -p "reviews/gemini/runs/${stamp}" reviews/gemini
          cp /tmp/gemini_review.json "reviews/gemini/runs/${stamp}/review.json"
          cp /tmp/gemini_review.json reviews/gemini/latest.json
          printf '%s\n' "$SOURCE_HASH" > reviews/gemini/latest_source_sha256.txt
          printf '%s\n' "$stamp" > reviews/gemini/latest_run_utc.txt
          git add reviews/gemini
          if git diff --cached --quiet; then
            echo "No Gemini review changes to publish."
            exit 0
          fi
          git commit -m "Gemini strategy review ${stamp}"
          git push origin HEAD:ai-reviews

      - name: Explain skipped run
        if: steps.source.outputs.skip == 'true'
        run: echo "Gemini review skipped - ${{ steps.source.outputs.skip_reason }}"
