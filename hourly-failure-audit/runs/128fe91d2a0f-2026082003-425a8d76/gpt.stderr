    31	def fetch_ai_reviews(repo_root: Path, *, timeout: int = 25) -> tuple[bool, str]:
    32	    """Refresh only the sanitised ai-reviews remote ref; never switch the worktree."""
    33	    root = Path(repo_root)
    34	    try:
    35	        p = subprocess.run(
    36	            ["git", "-C", str(root), "fetch", "--quiet", "origin", f"ai-reviews:{AI_REVIEW_REF}"],
    37	            text=True,
    38	            capture_output=True,
    39	            timeout=max(5, int(timeout)),
    40	            check=False,
    41	        )
    42	    except Exception as exc:
    43	        return False, f"{type(exc).__name__}: {exc}"
    44	    if p.returncode:
    45	        detail = (p.stderr or p.stdout or "git fetch failed").strip()
    46	        return False, detail[:400]
    47	    return True, "OK"
    48	
