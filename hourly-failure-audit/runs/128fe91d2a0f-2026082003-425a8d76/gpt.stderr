    23	def _insert_ai_reports_button(rows: list[list[dict]]) -> list[list[dict]]:
    24	    if any(any(str(b.get("callback_data") or "") == "menu:aiops" for b in row) for row in rows):
    25	        return rows
    26	    insert_at = len(rows)
    27	    for i, row in enumerate(rows):
    28	        callbacks = {str(b.get("callback_data") or "") for b in row}
    29	        if "menu:report" in callbacks:
    30	            insert_at = i
    31	            break
    32	    rows.insert(insert_at, [{"text": "🤖 AI Reports", "callback_data": "menu:aiops"}])
    33	    return rows
