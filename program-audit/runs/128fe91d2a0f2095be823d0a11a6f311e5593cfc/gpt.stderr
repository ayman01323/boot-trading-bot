    37	def _recompose_execution_validation():
    38	    """Make final executor composition independent of earlier import-cache order.
    39	
    40	    Some Telegram/runtime modules can import the validation patch before the later
    41	    efficiency/atomic wrappers are installed.  The validation module deliberately
    42	    has an idempotency flag, so a later normal import will not re-run install().
    43	    At the final audited runtime boundary we know the exact intended inner stack;
    44	    re-bind those captured inner functions and then restore validation as the
    45	    authoritative outer BUY/SELL/swap layer before verifying the invariant.
    46	    """
    47	    _validation._PREV_SWAP = _efficiency.swap_with_cost_receipt
    48	    _validation._PREV_SELL = _atomic_fallback.sell_with_atomic_or_capped_legacy_fallback
    49	    _validation._PREV_BUY = _reserve._buy_with_simulated_reserve
    50	    _exec.SolanaLiveExecutor.swap = _validation._swap_amounts_authoritative
    51	    _exec.SolanaLiveExecutor.sell = _validation._sell_with_token_reconciliation
    52	    _exec.SolanaLiveExecutor.buy = _validation._buy_with_token_reconciliation
    53	    _exec.SolanaLiveExecutor._economic_validation_patch = True
    54	
    55	
    56	def install():
    57	    # This is intentionally a repair-then-verify boundary.  It does not weaken an
    58	    # invariant: it restores the one exact audited composition and then checks all
    59	    # identities below.  Any later displacement still fails closed.
    60	    _recompose_execution_validation()
    61	
    62	    checks = {
    63	        "solana_close": _live._close_live is _exit_circuit.close_live_guarded,
    64	        "solana_bound_close": _binding._close_bound_live is _exit_circuit.close_live_guarded,
    65	        "solana_exit_inner_efficiency": _exit_circuit._PREV_CLOSE is _efficiency.close_live_with_receipt_pnl,
    66	        "solana_rent_close_efficiency": _rent._close_live_rent_aware is _efficiency.close_live_with_receipt_pnl,
    67	        "solana_execution_efficiency_stack": _efficiency.execution_efficiency_stack_intact(),
    68	        "solana_order_fee_guard": _exec.SolanaLiveExecutor._order is _efficiency.order_with_economic_caps,
    69	        "solana_liquidity_fail_closed": _efficiency._validate_order is _liquidity_guard.validate_order_fail_closed_on_unknown_liquidity,
    70	        "solana_atomic_legacy_fallback": _efficiency.sell_with_atomic_account_close is _atomic_fallback.sell_with_atomic_or_capped_legacy_fallback,
    71	        "solana_atomic_build_rfq_excluded": _efficiency._build_atomic_swap is _atomic_fallback.build_atomic_swap_excluding_rfq,
    72	        "solana_swap_validation": _exec.SolanaLiveExecutor.swap is _validation._swap_amounts_authoritative,
    73	        "solana_swap_efficiency_inner": _validation._PREV_SWAP is _efficiency.swap_with_cost_receipt,
    74	        "solana_sell_validation": _exec.SolanaLiveExecutor.sell is _validation._sell_with_token_reconciliation,
    75	        "solana_sell_atomic_inner": _validation._PREV_SELL is _atomic_fallback.sell_with_atomic_or_capped_legacy_fallback,
    76	        "solana_buy_validation": _exec.SolanaLiveExecutor.buy is _validation._buy_with_token_reconciliation,
    77	        "solana_buy_reserve_inner": _validation._PREV_BUY is _reserve._buy_with_simulated_reserve,
    78	        "solana_simulation": _exec.SolanaLiveExecutor._simulate is _reserve._simulate_with_wallet_snapshot,
    79	        "solana_valuation": _sol.evaluate_position is _rent.evaluate_position_economic,
    80	        "solana_monitor_reconciliation_outer": _sol.monitor_positions is _exit_circuit._monitor_with_exit_reconciliation,
    81	        "solana_monitor_positions_inner": _exit_circuit._MONITOR_INNER is _live.monitor_positions,
    82	        "solana_reconciliation_hook": _sol.reconcile_pending_exit_circuits is _exit_circuit.reconcile_pending_exit_circuits,
    83	        "solana_leader_cursor": _sol.monitor_leaders is _cursor.monitor_leaders_reliable,
    84	        "solana_workers": _sol.start_workers is _workers.start_workers_reliable,
    85	        "solana_quote": _sol.jupiter_quote is _quote.jupiter_quote_executable,
    86	        "solana_preflight": _sol._validate_shadow_entry is _preflight.validate_entry_cached,
    87	        "solana_economic_gate": _live._economic_entry_gate is _overhead._economic_entry_gate_reconciled,
    88	        "solana_capacity": _live._open_live_count is _capacity._verified_open_live_count,
    89	        "solana_profit_epoch": _profit_guard._copied_metrics is _epoch._copied_metrics_with_cleanup,
    90	        "evm_leader_cursor": _sibot.poll_leader_blocks is _evm_reliability.poll_leader_blocks_reliable,
    91	        "transaction_audit_worker": _telegram_ui.start_menu_thread is _audit_worker.start_menu_thread_with_transaction_audit,
    92	        "profit_control_amount_objective": (
    93	            _profit_control._is_success is _amount_objective.is_success_amount_first
    94	            and _profit_control.MIN_SUCCESS_PROFIT_FACTOR == _amount_objective.MIN_AMOUNT_PROFIT_FACTOR
    95	        ),
    96	        "profit_control_settings_inner": _profit_first_live._PREV_SETTINGS is _profit_control.settings_with_profit_control,
    97	        "profit_first_live_settings": _sol.settings is _profit_first_live.settings_profit_first_live,
    98	        "profit_first_full_sell_inner": _partial_sell_guard._PREV_PROCESS is _profit_first_live.process_leader_event_profit_first,
    99	        "partial_sell_guard_inner": _positive_edge._PREV_PROCESS is _partial_sell_guard.process_leader_event_partial_profit_guard,
   100	        "partial_sell_hard_profit_floor": str(_partial_sell_guard._HARD_MIN_PARTIAL_NET_PCT) == "3.0",
   101	        "partial_sell_low_capital_floor": str(_partial_sell_guard._HARD_MIN_POSITION_ECONOMIC_VALUE_SOL) == "0.002",
   102	        "positive_edge_entry_gate": _sol.process_leader_event is _positive_edge.process_leader_event_positive_edge,
   103	        "platform_amount_target": _positive_edge._HARD_PLATFORM_TARGET_PF >= _amount_objective.MIN_AMOUNT_PROFIT_FACTOR,
   104	        "profit_control_leader_gate_inner": _positive_edge._PREV_COPIED_OK is _profit_control.copied_ok_with_profit_control,
   105	        "positive_edge_first_loss_quarantine": _profit_guard._copied_ok is _positive_edge.copied_ok_quarantine_first_loss,
   106	        "profit_control_hourly_loop": _profit_master_summary._PREV_HOURLY_REVIEW is _profit_control.run_hourly_gpt_review_with_control,
   107	        "profit_control_master_summary": _audit_worker.run_hourly_gpt_review is _profit_master_summary.run_hourly_review_with_master_control_summary,
   108	    }
   109	    failed = [name for name, ok in checks.items() if not ok]
   110	    if failed:
   111	        raise RuntimeError("Audited trading runtime invariant failed: " + ", ".join(failed))
   112	    print("[trading-runtime-invariant] OK audited_hooks=%d" % len(checks))
   113	
   114	
   115	install()
     1	from __future__ import annotations
     2	
     3	from pathlib import Path
     4	
     5	from . import telegram as _tg
     6	from . import telegram_ui as _ui
     7	from .user_registry import all_users
     8	
     9	_PREV_SET_COMMANDS = _ui.set_commands
    10	
    11	# Commands whose handlers are MASTER-only in telegram_ui.py, plus /autodeploy.
    12	MASTER_ONLY = {
    13	    "control", "platformlive", "platformauto", "adminusers", "admincode", "engine",
    14	    "setmax", "setprofit", "setcopy", "setedge", "setage", "setcanary", "setscore",
    15	    "alerts", "copy20", "signals", "wallets", "profit", "behaviours", "rankings",
    16	    "strategies", "report", "autodeploy",
    17	}
    18	
    19	# The blue Telegram command sheet is navigation, not the feature surface.
    20	# ACTIVE normal users use /menu and then the compact inline dashboard. Other
    21	# handlers remain callable when typed manually; they are merely hidden here.
    22	ACTIVE_USER_VISIBLE = ("menu",)
    23	ONBOARDING_VISIBLE = ("menu", "join", "activate", "fees")
    24	DEFAULT_VISIBLE = ("menu", "join", "activate")
    25	
    26	
    27	def _csv_dir() -> Path:
    28	    return Path(__file__).resolve().parents[1] / "CSVbot"
    29	
    30	
    31	def _dedupe(commands):
    32	    out = []
    33	    seen = set()
    34	    for row in commands or []:
    35	        cmd = str((row or {}).get("command") or "").strip().lower()
    36	        if not cmd or cmd in seen:
    37	            continue
    38	        seen.add(cmd)
    39	        out.append({"command": cmd, "description": str((row or {}).get("description") or "")[:256]})
    40	    return out
    41	
    42	
    43	def _visible(commands, names):
    44	    by_name = {x["command"]: x for x in _dedupe(commands)}
    45	    defaults = {
    46	        "menu": "Open main menu",
    47	        "join": "Register Telegram ID",
    48	        "activate": "Activate account with code",
    49	        "fees": "Show fee plan/status",
    50	    }
    51	    out = []
    52	    for name in names:
    53	        row = by_name.get(name)
    54	        if row is None:
    55	            row = {"command": name, "description": defaults[name]}
    56	        out.append(row)
    57	    return out
    58	
    59	
    60	def set_commands(token: str):
    61	    # Let every earlier feature patch contribute its commands first. MASTER
    62	    # retains that full union. The normal-user blue menu is intentionally much
    63	    # smaller than the command handlers available to the user.
    64	    _PREV_SET_COMMANDS(token)
    65	    current = _dedupe(_tg._json("getMyCommands", token, payload={}, timeout=15) or [])
    66	    if not any(x["command"] == "autodeploy" for x in current):
    67	        current.append({"command": "autodeploy", "description": "MASTER deployment status"})
    68	
    69	    non_master_commands = [
    70	        x for x in current
    71	        if x["command"] not in MASTER_ONLY and "MASTER" not in x["description"].upper()
    72	    ]
    73	    active_user_commands = _visible(non_master_commands, ACTIVE_USER_VISIBLE)
    74	    onboarding_commands = _visible(non_master_commands, ONBOARDING_VISIBLE)
    75	    default_commands = _visible(non_master_commands, DEFAULT_VISIBLE)
    76	    master_commands = _dedupe(current)
    77	
    78	    # Unknown/unregistered private chats need only onboarding commands.
    79	    _tg._json(
    80	        "setMyCommands", token,
    81	        payload={"commands": default_commands, "scope": {"type": "default"}},
    82	        timeout=15,
    83	    )
    84	    _tg._json(
    85	        "setMyCommands", token,
    86	        payload={"commands": default_commands, "scope": {"type": "all_private_chats"}},
    87	        timeout=15,
    88	    )
    89	
    90	    masters = 0
    91	    active_users = 0
    92	    onboarding_users = 0
    93	    for row in all_users(_csv_dir()):
    94	        tid = str(row.get("telegram_id") or "").strip()
    95	        if not tid or not tid.lstrip("-").isdigit():
    96	            continue
    97	        status = str(row.get("status") or "").upper()
    98	        if status == "SUSPENDED":
    99	            continue
   100	        is_master = str(row.get("role") or "USER").upper() == "MASTER"
   101	        if is_master:
   102	            scoped = master_commands
   103	            masters += 1
   104	        elif status == "ACTIVE":
   105	            scoped = active_user_commands
   106	            active_users += 1
   107	        else:
   108	            scoped = onboarding_commands
   109	            onboarding_users += 1
   110	        _tg._json(
   111	            "setMyCommands", token,
   112	            payload={
   113	                "commands": scoped,
   114	                "scope": {"type": "chat", "chat_id": int(tid)},
   115	            },
   116	            timeout=15,
   117	        )
   118	
   119	    print(
   120	        f"[telegram-command-scope] active_user_commands={len(active_user_commands)} "
   121	        f"onboarding_commands={len(onboarding_commands)} "
   122	        f"master_commands={len(master_commands)} masters={masters} "
   123	        f"active_users={active_users} onboarding_users={onboarding_users}"
   124	    )
   125	
   126	
   127	def install():
   128	    if getattr(_ui, "_telegram_command_scope_patch_installed", False):
   129	        return
   130	    _ui.set_commands = set_commands
   131	    _ui._telegram_command_scope_patch_installed = True
   132	
   133	
   134	install()
     1	from __future__ import annotations
     2	
     3	import csv
     4	import hashlib
     5	import os
     6	import secrets
     7	import time
     8	from pathlib import Path
     9	
    10	
    11	def _bool(v, default=False):
    12	    if v is None:
    13	        return default
    14	    return str(v).strip().lower() in {"1", "true", "yes", "on", "y"}
    15	
    16	
    17	def _rows(path: Path):
    18	    if not path.exists():
    19	        return []
    20	    with path.open("r", encoding="utf-8-sig", newline="") as f:
    21	        return list(csv.DictReader(f))
    22	
    23	
    24	def _atomic_write(path: Path, rows: list[dict], headers: list[str]):
    25	    path.parent.mkdir(parents=True, exist_ok=True)
    26	    tmp = path.with_suffix(path.suffix + ".tmp")
    27	    with tmp.open("w", encoding="utf-8", newline="") as f:
    28	        w = csv.DictWriter(f, fieldnames=headers)
    29	        w.writeheader()
    30	        w.writerows([{h: r.get(h, "") for h in headers} for r in rows])
    31	        f.flush(); os.fsync(f.fileno())
    32	    os.replace(tmp, path)
    33	
    34	
    35	USER_HEADERS = [
    36	    "telegram_id", "role", "status", "fee_plan_id", "label", "allowed_chains",
    37	    "max_wallets", "can_transfer", "can_manual_trade", "can_auto_trade",
    38	    "created_epoch", "activated_epoch", "notes",
    39	]
    40	
    41	ACTIVATION_HEADERS = [
    42	    "code_hash", "plan_id", "enabled", "max_uses", "uses", "expires_epoch", "notes"
    43	]
    44	
    45	USER_SETTING_HEADERS = ["telegram_id", "chain_id", "setting", "value", "description"]
    46	
    47	
    48	def users_path(csv_dir: Path) -> Path:
    49	    return Path(csv_dir) / "users.csv"
    50	
    51	
    52	def activation_codes_path(csv_dir: Path) -> Path:
    53	    return Path(csv_dir) / "activation_codes.csv"
    54	
    55	
    56	def user_settings_path(csv_dir: Path) -> Path:
    57	    return Path(csv_dir) / "user_trading_settings.csv"
    58	
    59	
    60	def ensure_master_seed(app):
    61	    """Seed the first legacy TELEGRAM_CHAT_IDS entry as MASTER only when users.csv has no rows."""
    62	    path = users_path(app.csv_dir)
    63	    rows = _rows(path)
    64	    if rows:
    65	        return
    66	    legacy = [str(x).strip() for x in getattr(app, "telegram_chat_ids", []) if str(x).strip()]
    67	    if not legacy:
    68	        _atomic_write(path, [], USER_HEADERS)
    69	        return
    70	    now = int(time.time()); rows=[]
    71	    for i, tid in enumerate(legacy):
    72	        master = i == 0
    73	        rows.append({
    74	            "telegram_id": tid, "role": "MASTER" if master else "USER", "status": "ACTIVE", "fee_plan_id": "MASTER" if master else "STANDARD",
    75	            "label": "Master" if master else f"Legacy User {tid}", "allowed_chains": "*", "max_wallets": "20" if master else "5", "can_transfer": "true",
    76	            "can_manual_trade": "true", "can_auto_trade": "true", "created_epoch": now,
    77	            "activated_epoch": now, "notes": "Migrated from TELEGRAM_CHAT_IDS; first entry is MASTER",
    78	        })
    79	    _atomic_write(path, rows, USER_HEADERS)
    80	
    81	
    82	def get_user(csv_dir: Path, telegram_id) -> dict | None:
    83	    tid = str(telegram_id)
    84	    for row in _rows(users_path(csv_dir)):
    85	        if str(row.get("telegram_id", "")).strip() == tid:
    86	            return row
    87	    return None
    88	
    89	
    90	def all_users(csv_dir: Path, *, enabled_only=False) -> list[dict]:
    91	    out = []
    92	    for row in _rows(users_path(csv_dir)):
    93	        if enabled_only and (row.get("status") or "").upper() not in {"ACTIVE", "PENDING"}:
    94	            continue
    95	        out.append(row)
    96	    return out
    97	
    98	
    99	def is_registered(csv_dir: Path, telegram_id) -> bool:
   100	    return get_user(csv_dir, telegram_id) is not None
   101	
   102	
   103	def is_active(csv_dir: Path, telegram_id) -> bool:
   104	    u = get_user(csv_dir, telegram_id)
   105	    return bool(u and (u.get("status") or "").upper() == "ACTIVE")
   106	
   107	
   108	def is_master(csv_dir: Path, telegram_id) -> bool:
   109	    u = get_user(csv_dir, telegram_id)
   110	    return bool(u and (u.get("role") or "USER").upper() == "MASTER" and (u.get("status") or "").upper() == "ACTIVE")
   111	
   112	
   113	def _allowed_chain(user: dict, chain_slug: str) -> bool:
   114	    raw = (user.get("allowed_chains") or "*").strip().lower()
   115	    if raw in {"", "*", "all"}:
   116	        return True
   117	    allowed = {x.strip() for x in raw.replace("|", ",").split(",") if x.strip()}
   118	    return chain_slug.lower() in allowed
   119	
   120	
   121	def require_user(csv_dir: Path, telegram_id, *, active=False, chain_slug: str | None = None) -> dict:
   122	    u = get_user(csv_dir, telegram_id)
   123	    if not u:
   124	        raise ValueError("Telegram ID is not registered. Use /join or /activate CODE.")
   125	    status = (u.get("status") or "").upper()
   126	    if status == "SUSPENDED":
   127	        raise ValueError("This Telegram user is suspended.")
   128	    if active and status != "ACTIVE":
   129	        raise ValueError("Account is not active. Complete the activation fee or use an activation code.")
   130	    if chain_slug and not _allowed_chain(u, chain_slug):
   131	        raise ValueError(f"Your account is not permitted to use chain {chain_slug}.")
   132	    return u
   133	
   134	
   135	def join_user(csv_dir: Path, telegram_id, default_plan_id="STANDARD") -> dict:
   136	    tid = str(telegram_id)
   137	    existing = get_user(csv_dir, tid)
   138	    if existing:
   139	        return existing
   140	    rows = _rows(users_path(csv_dir)); now = int(time.time())
   141	    row = {
   142	        "telegram_id": tid, "role": "USER", "status": "PENDING", "fee_plan_id": default_plan_id,
   143	        "label": f"User {tid}", "allowed_chains": "*", "max_wallets": "5", "can_transfer": "true",
   144	        "can_manual_trade": "true", "can_auto_trade": "true", "created_epoch": now,
   145	        "activated_epoch": "", "notes": "Self-registered via Telegram /join",
   146	    }
   147	    rows.append(row); _atomic_write(users_path(csv_dir), rows, USER_HEADERS)
   148	    return row
   149	
   150	
   151	def update_user(csv_dir: Path, telegram_id, **updates) -> dict:
   152	    tid = str(telegram_id); path = users_path(csv_dir); rows = _rows(path); found = None
   153	    for row in rows:
   154	        if str(row.get("telegram_id", "")).strip() == tid:
   155	            for k, v in updates.items():
   156	                if k in USER_HEADERS:
   157	                    row[k] = str(v)
   158	            found = row
   159	            break
   160	    if found is None:
   161	        raise ValueError("User not found")
   162	    _atomic_write(path, rows, USER_HEADERS)
   163	    return found
   164	
   165	
   166	def activate_user(csv_dir: Path, telegram_id, plan_id: str | None = None, note=""):
   167	    updates = {"status": "ACTIVE", "activated_epoch": int(time.time())}
   168	    if plan_id:
   169	        updates["fee_plan_id"] = plan_id
   170	    if note:
   171	        updates["notes"] = note
   172	    return update_user(csv_dir, telegram_id, **updates)
   173	
   174	
   175	def _code_hash(code: str) -> str:
   176	    return hashlib.sha256(str(code).strip().encode("utf-8")).hexdigest()
   177	
   178	
   179	def redeem_activation_code(csv_dir: Path, telegram_id, code: str) -> dict:
   180	    code = str(code or "").strip()
   181	    if not code:
   182	        raise ValueError("Activation code is empty")
   183	    path = activation_codes_path(csv_dir); rows = _rows(path); now = int(time.time()); target = None
   184	    h = _code_hash(code)
   185	    for row in rows:
   186	        if (row.get("code_hash") or "").strip().lower() != h:
   187	            continue
   188	        if not _bool(row.get("enabled"), True):
   189	            raise ValueError("Activation code is disabled")
   190	        expires = int(float(row.get("expires_epoch") or 0))
   191	        if expires and now > expires:
   192	            raise ValueError("Activation code has expired")
   193	        max_uses = int(float(row.get("max_uses") or 1)); uses = int(float(row.get("uses") or 0))
   194	        if max_uses > 0 and uses >= max_uses:
   195	            raise ValueError("Activation code has reached its usage limit")
   196	        row["uses"] = str(uses + 1); target = row; break
   197	    if target is None:
   198	        raise ValueError("Activation code is invalid")
   199	    _atomic_write(path, rows, ACTIVATION_HEADERS)
   200	    plan_id = target.get("plan_id") or "STANDARD"
   201	    plan_ok = any((r.get("plan_id") or "").strip() == plan_id and _bool(r.get("enabled"), True) for r in _rows(Path(csv_dir)/"fee_plans.csv"))
   202	    if not plan_ok:
   203	        raise ValueError("Activation code points to a missing or disabled fee plan")
   204	    if not get_user(csv_dir, telegram_id):
   205	        join_user(csv_dir, telegram_id, plan_id)
   206	    return activate_user(csv_dir, telegram_id, plan_id, "Activated by code")
   207	
   208	
   209	def create_activation_code(csv_dir: Path, plan_id="STANDARD", max_uses=1, expires_epoch=0, notes="") -> str:
   210	    code = secrets.token_urlsafe(9).replace("-", "").replace("_", "")[:12].upper()
   211	    path = activation_codes_path(csv_dir); rows = _rows(path)
   212	    rows.append({"code_hash": _code_hash(code), "plan_id": plan_id, "enabled": "true", "max_uses": max_uses,
   213	                 "uses": 0, "expires_epoch": expires_epoch or "", "notes": notes})
   214	    _atomic_write(path, rows, ACTIVATION_HEADERS)
   215	    return code
   216	
   217	
   218	def user_setting(csv_dir: Path, telegram_id, chain_id: int, setting: str, default=None):
   219	    tid = str(telegram_id); value = default
   220	    rows = _rows(user_settings_path(csv_dir))
   221	    # User global first, then user+chain override.
   222	    for row in rows:
   223	        if str(row.get("telegram_id", "")).strip() != tid:
   224	            continue
   225	        scope = str(row.get("chain_id", "*")).strip()
   226	        if scope in {"", "*", "0"} and (row.get("setting") or "").strip() == setting:
   227	            value = row.get("value", default)
   228	    for row in rows:
   229	        if str(row.get("telegram_id", "")).strip() != tid:
   230	            continue
   231	        if str(row.get("chain_id", "")).strip() == str(chain_id) and (row.get("setting") or "").strip() == setting:
   232	            value = row.get("value", default)
   233	    return value
   234	
   235	
   236	def set_user_setting(csv_dir: Path, telegram_id, setting: str, value, *, chain_id="*", description=""):
   237	    path = user_settings_path(csv_dir); rows = _rows(path); tid = str(telegram_id); scope = str(chain_id); found = False
   238	    for row in rows:
   239	        if str(row.get("telegram_id", "")).strip() == tid and str(row.get("chain_id", "*")).strip() == scope and (row.get("setting") or "").strip() == setting:
   240	            row["value"] = str(value); 
   241	            if description: row["description"] = description
   242	            found = True; break
   243	    if not found:
   244	        rows.append({"telegram_id": tid, "chain_id": scope, "setting": setting, "value": value, "description": description})
   245	    _atomic_write(path, rows, USER_SETTING_HEADERS)
   246	
   247	
   248	def user_bool(csv_dir: Path, telegram_id, chain_id: int, setting: str, default=False) -> bool:
   249	    return _bool(user_setting(csv_dir, telegram_id, chain_id, setting, "true" if default else "false"), default)

