   225	    if: >-
   226	      github.event_name == 'pull_request' &&
   227	      github.head_ref == 'agent/server-diagnostics' &&
   228	      github.event.pull_request.head.repo.full_name == github.repository
   229	    runs-on: [self-hosted, linux, x64, boot-vps]
   230	    timeout-minutes: 5
   231	    steps:
   232	      - name: Current status
   233	        shell: bash
