   211	def _close_bound_live(app, tid, position, fraction: Decimal, reason: str):
   212	    executor, actual = _resolve_executor(app, tid, position)
   213	    old_raw = max(1, _sol._int(position.get("token_amount_raw"), 0))
   214	    f = max(Decimal("0.0001"), min(Decimal(1), Decimal(str(fraction))))
   215	    planned = max(1, int(Decimal(old_raw) * f))
   216	    sell_raw = min(planned, int(actual))
   217	    if sell_raw <= 0:
   218	        _quarantine(app, position, "resolved wallet has no sellable matching token")
   219	
   220	    trade = executor.sell(position["mint"], sell_raw)
   221	    out_lamports = int(trade.get("totalOutputAmount") or trade.get("outputAmountResult") or 0)
   222	    delta_raw = trade.get("wallet_delta_lamports")
   223	    try:
   224	        delta = int(delta_raw) if delta_raw is not None else 0
   225	    except Exception:
   226	        delta = 0
   227	    cfg = _sol.settings(app)
   228	    if delta > 0:
   229	        proceeds = Decimal(delta) / Decimal(1_000_000_000)
   230	    else:
   231	        proceeds = Decimal(out_lamports) / Decimal(1_000_000_000) - _sol._dec(cfg.get("estimated_exit_fee_sol"), ".00002")
   232	
   233	    old_cost = _sol._dec(position.get("entry_cost_sol"), 0)
   234	    cost_fraction = old_cost * Decimal(sell_raw) / Decimal(old_raw)
   235	    net = proceeds - cost_fraction
   236	    remaining = max(0, old_raw - sell_raw)
   237	    remaining_cost = max(Decimal(0), old_cost - cost_fraction)
   238	    closed = remaining <= max(1, int(old_raw * .001)) or f >= Decimal("0.999")
   239	    realised = _sol._dec(position.get("realised_net_sol"), 0) + net
   240	    now = int(time.time())
   241	    sig = str(trade.get("signature") or "")
   242	    with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   243	        conn.execute(
   244	            """UPDATE positions SET token_amount_raw=?,entry_cost_sol=?,realised_net_sol=?,exit_signature=?,exit_reason=?,closed_at=?,
   245	                                    status=?,leader_exit_pending=?,updated_at=? WHERE position_id=?""",
   246	            (str(0 if closed else remaining), str(0 if closed else remaining_cost), str(realised), sig, reason,
   247	             now if closed else None, "CLOSED" if closed else "OPEN", 0 if closed else int(position.get("leader_exit_pending") or 0), now, position["position_id"]),
   248	        )
   249	        conn.commit()
   250	    _live._notify(
   251	        app,
   252	        tid,
   253	        f"✅ <b>Solana LIVE SELL confirmed</b>\n"
   254	        f"Reason: <code>{reason}</code>\n"
   255	        f"Wallet: <code>{executor.address[:8]}…{executor.address[-6:]}</code>\n"
   256	        f"Received wallet delta: <b>{proceeds:.9f} SOL</b>\n"
   257	        f"Net on sold portion: <b>{net:+.9f} SOL</b>\n"
   258	        f"TX: <code>{sig}</code>",
   259	    )
   260	    return {"closed": closed, "net_sol": net, "signature": sig, "reason": reason, "trade": trade}
   261	
