   194	def load_kv_scoped(path:Path,chain_id:int):
   195	    out={}
   196	    rows=_rows(path)
   197	    for row in rows:
   198	        scope=(row.get("chain_id") or "*").strip()
   199	        if scope in {"","*","0"}:
   200	            k=(row.get("setting") or "").strip();
   201	            if k: out[k]=(row.get("value") or "").strip()
   202	    for row in rows:
   203	        if (row.get("chain_id") or "").strip()==str(chain_id):
   204	            k=(row.get("setting") or "").strip();
   205	            if k: out[k]=(row.get("value") or "").strip()
   206	    return out
