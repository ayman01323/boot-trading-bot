    16	def reset_fault_count(app, tid):
    17	    key = f"solana_live_landed_fault_count:{tid}"
    18	    with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
    19	        _sol._set_state(conn, key, "0")
