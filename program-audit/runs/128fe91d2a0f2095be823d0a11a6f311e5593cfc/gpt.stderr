    57	def _required_pre_fee_min(plan: dict, requested_user_net: Decimal) -> Decimal:
    58	    """Convert the user's retained-net floor to a pre-platform-fee floor.
    59	
    60	    A zero-profit-share account must not inherit a fee-settlement gas reserve.
    61	    The old behaviour added the reserve even to MASTER/STANDARD 0% plans, which
    62	    could make tiny test trades mathematically impossible.
    63	    """
    64	    bps=_dec(plan.get("profit_share_bps") or 0);fraction=bps/Decimal(10000)
    65	    if fraction<=0:return requested_user_net
    66	    if fraction>=Decimal("0.95"):fraction=Decimal("0.95")
    67	    settlement=max(Decimal(0),_dec(plan.get("fee_settlement_gas_reserve_base") or "0"))
    68	    return (requested_user_net+settlement)/(Decimal(1)-fraction)
