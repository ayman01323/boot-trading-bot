    62	class SolanaLiveExecutor:
    63	    def __init__(self, app, telegram_id):
    64	        self.app = app
    65	        self.telegram_id = str(telegram_id)
    66	        self.store = SolanaWalletStore(app.csv_dir, app.data_dir)
    67	        self.meta = self.store.get_meta(self.telegram_id)
    68	        if not self.store.has_private_key(self.telegram_id, self.meta.get("wallet_id")):
    69	            raise SolanaLiveError("Active Solana wallet has no encrypted signing key")
    70	        self.address = str(self.meta.get("address") or "")
    71	        self.keypair = self.store.keypair_bytes(self.telegram_id, self.meta.get("wallet_id"))
