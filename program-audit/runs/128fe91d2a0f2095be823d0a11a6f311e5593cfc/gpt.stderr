   140	    def swap(self, input_mint: str, output_mint: str, amount_raw: int) -> dict:
   141	        # A pre-execution wallet snapshot is mandatory. This lets the caller account
   142	        # for the real SOL cash movement rather than a tiny fixed fee estimate.
