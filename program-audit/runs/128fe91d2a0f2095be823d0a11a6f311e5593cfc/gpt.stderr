   259	            tail -n 160 /var/log/boot-github-deploy.log
   260	          else
.github/workflows/deploy-vps.yml
     1	name: Deploy BOOT to VPS
     2	
     3	on:
     4	  push:
     5	    branches: [main]
     6	  pull_request:
     7	    branches: [main]
     8	  workflow_dispatch:
     9	
    10	permissions:
    11	  contents: write
    12	
    13	concurrency:
    14	  group: boot-vps-deploy
    15	  cancel-in-progress: true
    16	
    17	jobs:
    18	  probe:
    19	    name: Record deployment request
    20	    if: >-
    21	      github.event_name != 'pull_request' ||
    22	      (github.head_ref == 'agent/deploy-current-main' &&
    23	       github.event.pull_request.head.repo.full_name == github.repository)
    24	    runs-on: ubuntu-latest
    25	    timeout-minutes: 3
    26	    env:
    27	      TARGET_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.sha }}
    28	    steps:
    29	      - name: Publish waiting-for-runner marker
    30	        shell: bash
    31	        env:
    32	          GH_TOKEN: ${{ github.token }}
    33	        run: |
    34	          set -euo pipefail
    35	          cat > /tmp/boot-deploy-probe.txt <<EOF
    36	          requested_sha=${TARGET_SHA}
    37	          state=waiting_for_self_hosted_runner
    38	          run_id=${GITHUB_RUN_ID}
    39	          utc=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
    40	          EOF
    41	          api="https://api.github.com/repos/${GITHUB_REPOSITORY}/contents/diagnostics/latest-probe.txt"
    42	          current="$(curl -fsS -H "Authorization: Bearer ${GH_TOKEN}" -H 'Accept: application/vnd.github+json' "${api}?ref=server-diagnostics" || true)"
    43	          existing_sha="$(printf '%s' "$current" | python3 -c 'import json,sys; s=sys.stdin.read().strip(); print((json.loads(s).get("sha") if s else "") or "")' 2>/dev/null || true)"
    44	          encoded="$(base64 -w0 /tmp/boot-deploy-probe.txt)"
    45	          if [[ -n "$existing_sha" ]]; then
    46	            payload="$(python3 - "$encoded" "$existing_sha" <<'PY'
    47	          import json,sys
    48	          print(json.dumps({"message":"Update VPS deployment probe","content":sys.argv[1],"sha":sys.argv[2],"branch":"server-diagnostics"}))
    49	          PY
    50	          )"
    51	          else
    52	            payload="$(python3 - "$encoded" <<'PY'
    53	          import json,sys
    54	          print(json.dumps({"message":"Create VPS deployment probe","content":sys.argv[1],"branch":"server-diagnostics"}))
    55	          PY
    56	          )"
    57	          fi
    58	          curl -fsS -X PUT \
    59	            -H "Authorization: Bearer ${GH_TOKEN}" \
    60	            -H 'Accept: application/vnd.github+json' \
    61	            -H 'X-GitHub-Api-Version: 2022-11-28' \
    62	            "$api" -d "$payload" >/dev/null
    63	
    64	  deploy:
    65	    name: Deploy exact main commit
    66	    if: >-
    67	      github.event_name != 'pull_request' ||
    68	      (github.head_ref == 'agent/deploy-current-main' &&
    69	       github.event.pull_request.head.repo.full_name == github.repository)
    70	    needs: probe
    71	    runs-on: [self-hosted, linux, x64, boot-vps]
    72	    timeout-minutes: 20
    73	    env:
    74	      TARGET_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.sha }}
    75	    steps:
    76	      - name: Deploy through restricted root wrapper
    77	        id: deploy
    78	        shell: bash
    79	        run: |
    80	          set +e
    81	          sudo /usr/local/sbin/deploy-boot-trading-bot "${TARGET_SHA}" 2>&1 | tee /tmp/boot-deploy-output.txt
    82	          code=${PIPESTATUS[0]}
    83	          echo "exit_code=$code" >> "$GITHUB_OUTPUT"
    84	          exit "$code"
    85	
    86	      - name: Server status
    87	        id: status
    88	        if: always()
    89	        shell: bash
    90	        run: |
    91	          set +e
    92	          sudo /usr/local/sbin/status-boot-trading-bot 2>&1 | tee /tmp/boot-server-status.txt
    93	          code=${PIPESTATUS[0]}
    94	          echo "exit_code=$code" >> "$GITHUB_OUTPUT"
    95	          exit 0
    96	
    97	      - name: Build and publish machine-readable deployment attestation
    98	        id: attestation
    99	        if: always()
   100	        shell: bash
   101	        env:
   102	          GH_TOKEN: ${{ github.token }}
   103	          DEPLOY_OUTCOME: ${{ steps.deploy.outcome }}
   104	          DEPLOY_EXIT: ${{ steps.deploy.outputs.exit_code }}
   105	          STATUS_EXIT: ${{ steps.status.outputs.exit_code }}
   106	        run: |
   107	          set +e
   108	          # The runner has passwordless access to the restricted status wrapper. Poll it
   109	          # briefly so the restarted Telegram menu has time to register and verify the
   110	          # MASTER command scopes against Telegram's own getMyCommands endpoint.
   111	          cp /tmp/boot-server-status.txt /tmp/boot-attest-status.txt 2>/dev/null || true
   112	          for _ in 1 2 3 4 5 6; do
   113	            sudo /usr/local/sbin/status-boot-trading-bot > /tmp/boot-attest-status.txt 2>&1 || true
   114	            if grep -q '\[telegram-ai-ops-commands\] verified=' /tmp/boot-attest-status.txt; then
   115	              break
   116	            fi
   117	            sleep 3
   118	          done
   119	
   120	          python3 - "$TARGET_SHA" "${DEPLOY_OUTCOME:-unknown}" "${DEPLOY_EXIT:-}" "${STATUS_EXIT:-}" <<'PY' > /tmp/boot-deploy-attestation.json
   121	          import json,re,sys,time
   122	          expected, deploy_outcome, deploy_exit, status_exit = sys.argv[1:5]
   123	          try:
   124	              text=open('/tmp/boot-attest-status.txt',encoding='utf-8',errors='replace').read()
   125	          except Exception:
   126	              text=''
   127	          sha_match_obj=re.search(r'(?m)^sha:\s*([0-9a-fA-F]{40})\s*$',text)
   128	          deployed=(sha_match_obj.group(1).lower() if sha_match_obj else '')
   129	          service_ok=bool(re.search(r'Active:\s+active \(running\)',text,re.I))
   130	          watcher_ok='[ai-ops-watcher] started' in text
   131	          markers=re.findall(r'\[telegram-ai-ops-commands\]\s+verified=(true|false)\s+masters=(\d+)\s+expected=([^\s]+)\s+missing=([^\s]+)',text,re.I)
   132	          telegram_verified=False
   133	          master_count=0
   134	          expected_commands=[]
   135	          missing='marker-not-found'
   136	          if markers:
   137	              verified, count, commands, missing=markers[-1]
   138	              telegram_verified=verified.lower()=='true'
   139	              master_count=int(count)
   140	              expected_commands=[x for x in commands.split(',') if x]
   141	          required={'aiaudit','aidecision','aistrategy','aiupdates'}
   142	          command_code_ok=required.issubset(set(expected_commands))
   143	          sha_ok=(deployed==expected.lower())
   144	          deployment_ok=(deploy_outcome=='success' and str(deploy_exit)=='0' and sha_ok and service_ok and watcher_ok)
   145	          full_ok=(deployment_ok and command_code_ok and telegram_verified and master_count>0)
   146	          print(json.dumps({
   147	              'schema_version':2,
   148	              'generated_at':int(time.time()),
   149	              'expected_sha':expected,
   150	              'deployed_sha':deployed,
   151	              'sha_match':sha_ok,
   152	              'deploy_outcome':deploy_outcome,
   153	              'deploy_exit':deploy_exit,
   154	              'status_exit':status_exit,
   155	              'service_status_ok':service_ok,
   156	              'ai_ops_watcher_started':watcher_ok,
   157	              'ai_master_commands_code_ok':command_code_ok,
   158	              'telegram_command_verification':{
   159	                  'attempted':bool(markers),
   160	                  'verified':telegram_verified,
   161	                  'master_count':master_count,
   162	                  'expected_commands':expected_commands,
   163	                  'missing':missing,
   164	                  'detail':'verified via running service getMyCommands startup self-check' if telegram_verified else 'startup verification marker missing or reported failure',
   165	              },
   166	              'deployment_attested':deployment_ok,
   167	              'full_telegram_attestation':full_ok,
   168	              'workflow_run_id':__import__('os').environ.get('GITHUB_RUN_ID',''),
   169	              'workflow_event':__import__('os').environ.get('GITHUB_EVENT_NAME',''),
   170	          },indent=2,sort_keys=True))
   171	          PY
   172	          attest_rc="$(python3 - <<'PY'
   173	          import json
   174	          d=json.load(open('/tmp/boot-deploy-attestation.json',encoding='utf-8'))
   175	          print(0 if d.get('full_telegram_attestation') else (1 if d.get('deployment_attested') else 2))
   176	          PY
   177	          )"
   178	          python3 - "$attest_rc" <<'PY'
   179	          import json,sys
   180	          p='/tmp/boot-deploy-attestation.json'
   181	          d=json.load(open(p,encoding='utf-8'))
   182	          d['attestation_exit']=int(sys.argv[1])
   183	          open(p,'w',encoding='utf-8').write(json.dumps(d,indent=2,sort_keys=True)+'\n')
   184	          PY
   185	
   186	          api="https://api.github.com/repos/${GITHUB_REPOSITORY}/contents/diagnostics/latest-deploy-attestation.json"
   187	          current="$(curl -fsS -H "Authorization: Bearer ${GH_TOKEN}" -H 'Accept: application/vnd.github+json' "${api}?ref=server-diagnostics" || true)"
   188	          existing_sha="$(printf '%s' "$current" | python3 -c 'import json,sys; s=sys.stdin.read().strip(); print((json.loads(s).get("sha") if s else "") or "")' 2>/dev/null || true)"
   189	          encoded="$(base64 -w0 /tmp/boot-deploy-attestation.json)"
   190	          if [[ -n "$existing_sha" ]]; then
   191	            payload="$(python3 - "$encoded" "$existing_sha" <<'PY'
   192	          import json,sys
   193	          print(json.dumps({"message":"Update VPS deployment attestation","content":sys.argv[1],"sha":sys.argv[2],"branch":"server-diagnostics"}))
   194	          PY
   195	          )"
   196	          else
   197	            payload="$(python3 - "$encoded" <<'PY'
   198	          import json,sys
   199	          print(json.dumps({"message":"Create VPS deployment attestation","content":sys.argv[1],"branch":"server-diagnostics"}))
   200	          PY
   201	          )"
   202	          fi
   203	          curl -fsS -X PUT \
   204	            -H "Authorization: Bearer ${GH_TOKEN}" \
   205	            -H 'Accept: application/vnd.github+json' \
   206	            -H 'X-GitHub-Api-Version: 2022-11-28' \
   207	            "$api" -d "$payload" >/dev/null
   208	          echo "attestation_exit=${attest_rc}" >> "$GITHUB_OUTPUT"
   209	          cat /tmp/boot-deploy-attestation.json
   210	          exit 0
   211	
   212	      - name: Publish private deployment diagnostic
   213	        if: always()
   214	        shell: bash
   215	        env:
   216	          GH_TOKEN: ${{ github.token }}
   217	          DEPLOY_OUTCOME: ${{ steps.deploy.outcome }}
   218	          DEPLOY_EXIT: ${{ steps.deploy.outputs.exit_code }}
   219	        run: |
   220	          set -euo pipefail
   221	          {
   222	            echo "requested_sha=${TARGET_SHA}"
   223	            echo "deploy_outcome=${DEPLOY_OUTCOME:-unknown}"
   224	            echo "deploy_exit=${DEPLOY_EXIT:-unknown}"
   225	            echo "run_id=${GITHUB_RUN_ID}"
   226	            echo "utc=$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
   227	            echo
   228	            echo "=== DEPLOY OUTPUT (tail) ==="
   229	            tail -n 120 /tmp/boot-deploy-output.txt 2>/dev/null || true
   230	            echo
   231	            echo "=== SERVER STATUS ==="
   232	            cat /tmp/boot-attest-status.txt 2>/dev/null || cat /tmp/boot-server-status.txt 2>/dev/null || true
   233	          } > /tmp/boot-deploy-diagnostic.txt
   234	
   235	          api="https://api.github.com/repos/${GITHUB_REPOSITORY}/contents/diagnostics/latest-deploy.txt"
   236	          current="$(curl -fsS -H "Authorization: Bearer ${GH_TOKEN}" -H 'Accept: application/vnd.github+json' "${api}?ref=server-diagnostics" || true)"
   237	          existing_sha="$(printf '%s' "$current" | python3 -c 'import json,sys; s=sys.stdin.read().strip(); print((json.loads(s).get("sha") if s else "") or "")' 2>/dev/null || true)"
   238	          encoded="$(base64 -w0 /tmp/boot-deploy-diagnostic.txt)"
   239	          if [[ -n "$existing_sha" ]]; then
   240	            payload="$(python3 - "$encoded" "$existing_sha" <<'PY'
   241	          import json,sys
   242	          print(json.dumps({"message":"Update VPS deployment diagnostic","content":sys.argv[1],"sha":sys.argv[2],"branch":"server-diagnostics"}))
   243	          PY
   244	          )"
   245	          else
   246	            payload="$(python3 - "$encoded" <<'PY'
   247	          import json,sys
   248	          print(json.dumps({"message":"Create VPS deployment diagnostic","content":sys.argv[1],"branch":"server-diagnostics"}))
   249	          PY
   250	          )"
   251	          fi
   252	          curl -fsS -X PUT \
   253	            -H "Authorization: Bearer ${GH_TOKEN}" \
   254	            -H 'Accept: application/vnd.github+json' \
   255	            -H 'X-GitHub-Api-Version: 2022-11-28' \
   256	            "$api" -d "$payload" >/dev/null
   257	
   258	      - name: Mark probe finished
   259	        if: always()
   260	        shell: bash
.github/workflows/gpt-master-strategy-action.yml
     1	name: GPT Master Strategy Action
     2	
     3	on:
     4	  pull_request:
     5	    types: [opened, synchronize, reopened]
     6	    paths:
     7	      - '.ai/strategy/copilot/*.json'
     8	      - '.ai/strategy/copilot/*.md'
     9	  workflow_dispatch:
    10	    inputs:
    11	      copilot_pr_number:
    12	        description: 'Copilot strategy report PR number'
    13	        required: false
    14	        type: string
    15	
    16	permissions:
    17	  contents: write
    18	  pull-requests: write
    19	  issues: write
    20	
    21	concurrency:
    22	  group: gpt-master-strategy-action
    23	  cancel-in-progress: false
    24	
    25	jobs:
    26	  adjudicate:
    27	    if: github.event_name == 'workflow_dispatch' || github.event.pull_request.head.repo.full_name == github.repository
    28	    runs-on: ubuntu-latest
    29	    timeout-minutes: 120
    30	
    31	    steps:
    32	      - name: Resolve Copilot strategy report PR
    33	        id: pr
    34	        env:
    35	          GH_TOKEN: ${{ github.token }}
    36	          INPUT_PR: ${{ inputs.copilot_pr_number }}
    37	          EVENT_PR: ${{ github.event.pull_request.number }}
    38	        shell: bash
    39	        run: |
    40	          set -euo pipefail
    41	          pr="${EVENT_PR:-${INPUT_PR:-}}"
    42	          test -n "$pr"
    43	          head_sha="$(gh pr view "$pr" --json headRefOid --jq '.headRefOid')"
    44	          cross="$(gh pr view "$pr" --json isCrossRepository --jq '.isCrossRepository')"
    45	          if [[ "$cross" == "true" ]]; then echo 'Refusing fork report PR.' >&2; exit 2; fi
    46	          echo "number=${pr}" >> "$GITHUB_OUTPUT"
    47	          echo "head_sha=${head_sha}" >> "$GITHUB_OUTPUT"
    48	
    49	      - uses: actions/checkout@v4
    50	        with:
    51	          ref: ${{ steps.pr.outputs.head_sha }}
    52	          fetch-depth: 0
    53	      - uses: actions/setup-python@v5
    54	        with:
    55	          python-version: '3.11'
    56	          cache: pip
    57	      - uses: actions/setup-node@v4
    58	        with:
    59	          node-version: '22'
    60	
    61	      - name: Install synthesis and implementation tools
    62	        run: |
    63	          python -m pip install --upgrade pip
    64	          pip install -r requirements.txt pytest
    65	          npm install -g @openai/codex@latest
    66	          codex --version
    67	
    68	      - name: Refuse Copilot PR containing anything except its two strategy report files
    69	        env:
    70	          GH_TOKEN: ${{ github.token }}
    71	          PR_NUMBER: ${{ steps.pr.outputs.number }}
    72	        shell: bash
    73	        run: |
    74	          set -euo pipefail
    75	          gh pr diff "$PR_NUMBER" --name-only > /tmp/copilot-strategy-files.txt
    76	          python - <<'PY'
    77	          import pathlib,sys
    78	          files=[x.strip().replace('\\','/') for x in pathlib.Path('/tmp/copilot-strategy-files.txt').read_text().splitlines() if x.strip()]
    79	          if len(files)!=2:
    80	              print('Copilot strategy report PR must contain exactly two files.',*files,sep='\n',file=sys.stderr); raise SystemExit(2)
    81	          if any(not p.startswith('.ai/strategy/copilot/') or pathlib.PurePosixPath(p).suffix not in {'.json','.md'} for p in files):
    82	              print('Non-report file in Copilot strategy PR.',*files,sep='\n',file=sys.stderr); raise SystemExit(3)
    83	          stems={str(pathlib.PurePosixPath(p).with_suffix('')) for p in files}
    84	          if len(stems)!=1: raise SystemExit('Copilot JSON/Markdown report names do not match')
    85	          PY
    86	
    87	      - name: Locate and validate Copilot strategy report
    88	        id: report
    89	        shell: bash
    90	        run: |
    91	          set -euo pipefail
    92	          mapfile -t reports < <(find .ai/strategy/copilot -maxdepth 1 -type f -name '*.json' -print | sort)
    93	          [[ "${#reports[@]}" -eq 1 ]]
    94	          report="${reports[0]}"
    95	          python - <<PY > /tmp/copilot-meta.env
    96	          import json
    97	          p=json.load(open('$report'))
    98	          print('CYCLE_ID='+str(p.get('cycle_id') or ''))
    99	          print('SOURCE_SHA='+str(p.get('source_commit') or ''))
   100	          print('EVIDENCE_SHA='+str(p.get('evidence_sha256') or ''))
   101	          PY
   102	          source /tmp/copilot-meta.env
   103	          test -n "$CYCLE_ID"; test -n "$SOURCE_SHA"; test -n "$EVIDENCE_SHA"
   104	          expected=".ai/strategy/copilot/${CYCLE_ID}.json"
   105	          [[ "$report" == "$expected" && -f ".ai/strategy/copilot/${CYCLE_ID}.md" ]]
   106	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   107	            --input "$report" --provider copilot --cycle-id "$CYCLE_ID" \
   108	            --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   109	          cp "$report" /tmp/copilot-strategy.json
   110	          cp ".ai/strategy/copilot/${CYCLE_ID}.md" /tmp/copilot-strategy.md
   111	          echo "cycle_id=${CYCLE_ID}" >> "$GITHUB_OUTPUT"
   112	          echo "source_sha=${SOURCE_SHA}" >> "$GITHUB_OUTPUT"
   113	          echo "evidence_sha=${EVIDENCE_SHA}" >> "$GITHUB_OUTPUT"
   114	
   115	      - name: Fetch matching GPT/Gemini reports and context
   116	        shell: bash
   117	        env:
   118	          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
   119	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   120	          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
   121	        run: |
   122	          set -euo pipefail
   123	          git fetch --force origin ai-reviews:refs/remotes/origin/ai-reviews
   124	          root="strategy/runs/${CYCLE_ID}"
   125	          for file in gpt.json gemini.json context.json; do git show "origin/ai-reviews:${root}/${file}" > "/tmp/${file}"; done
   126	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   127	            --input /tmp/gpt.json --provider gpt --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   128	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   129	            --input /tmp/gemini.json --provider gemini --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   130	          python - <<'PY'
   131	          import json,sys
   132	          reports=[json.load(open('/tmp/gpt.json')),json.load(open('/tmp/gemini.json')),json.load(open('/tmp/copilot-strategy.json'))]
   133	          bad=[x['provider'] for x in reports if x.get('status')=='INCOMPLETE']
   134	          if bad:
   135	              print('Incomplete independent strategy reports: '+','.join(bad),file=sys.stderr); raise SystemExit(3)
   136	          PY
   137	
   138	      - name: Check out exact reviewed strategy source
   139	        shell: bash
   140	        env:
   141	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   142	        run: |
   143	          set -euo pipefail
   144	          git fetch --force origin main:refs/remotes/origin/main
   145	          git cat-file -e "${SOURCE_SHA}^{commit}"
   146	          git checkout --detach "$SOURCE_SHA"
   147	          git clean -fdx
   148	          mkdir -p .strategy_master
   149	          cp /tmp/gpt.json .strategy_master/gpt.json
   150	          cp /tmp/gemini.json .strategy_master/gemini.json
   151	          cp /tmp/copilot-strategy.json .strategy_master/copilot.json
   152	          cp /tmp/context.json .strategy_master/context.json
   153	
   154	      - name: GPT master strategy synthesis
   155	        id: synth
   156	        env:
   157	          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
   158	          OPENAI_STRATEGY_SYNTH_MODEL: ${{ vars.OPENAI_STRATEGY_SYNTH_MODEL }}
   159	          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
   160	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   161	          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
   162	        shell: bash
   163	        run: |
   164	          set -euo pipefail
   165	          test -n "${OPENAI_API_KEY:-}"
   166	          cat > /tmp/strategy-master-prompt.txt <<'PROMPT'
   167	          You are the MASTER adjudicator for three independent trading-strategy reviews. Read:
   168	          .strategy_master/gpt.json, .strategy_master/gemini.json, .strategy_master/copilot.json and context.json,
   169	          then inspect the exact checked-out source to verify claims.
   170	
   171	          Consolidate equivalent proposals. For EVERY materially distinct proposal record ACCEPT, REJECT or DEFER.
   172	          Do not use majority vote blindly: measured realised/shadow evidence and code truth outrank agent agreement.
   173	          Reject unsupported profit claims, look-ahead, forced trading, cost-blind forecasting, duplicate strategies or
   174	          recommendations that merely increase risk/capital. Defer when evidence is sparse or live/runtime proof is needed.
   175	
   176	          An automatic implementation may only be a LOW/MEDIUM-risk SHADOW Strategy Lab change. Never authorise edits to
   177	          live execution, Solana live signing, auto trader, wallets, secrets, deployment workflows, CSV live/risk settings,
   178	          smart contracts or the live product universe. REPLACE/DORMANT/ASSET_REQUEST may be recommended but are not automatic
   179	          code actions. Every accepted code action must list exact allowed Strategy Lab/SHADOW files and explicit tests.
   180	
   181	          Write only .strategy_master/master_decision.json and .strategy_master/master_decision.md; no tracked changes.
   182	          JSON shape:
   183	          {
   184	            "schema_version":1,"cycle_id":"CYCLE","source_commit":"SOURCE","evidence_sha256":"EVIDENCE",
   185	            "status":"NO_ACTION|DRAFT_SHADOW_CHANGE|HUMAN_REVIEW_REQUIRED","summary":"...",
   186	            "decisions":[{
   187	              "finding_id":"stable id","source_proposal_ids":["gpt:id","gemini:id","copilot:id"],
   188	              "action":"KEEP|IMPROVE|REWORK|SHADOW_MORE|REPLACE|DORMANT|NEW_SHADOW|ASSET_REQUEST|RESEARCH_MORE",
   189	              "strategy":"...","disposition":"ACCEPT|REJECT|DEFER","reason":"why, tied to evidence/code",
   190	              "confidence":0.0,"supporting_agents":["gpt","gemini","copilot"],
   191	              "risk_class":"LOW|MEDIUM|HIGH|CRITICAL","shadow_only":true,
   192	              "allowed_files":["exact Strategy Lab/SHADOW path"],"required_tests":["specific command/test"]
   193	            }],
   194	            "implementation_allowed":false,"live_auto_deploy":false,"draft_pr_only":true
   195	          }
   196	          PROMPT
   197	          sed -i -e "s/CYCLE/${CYCLE_ID}/g" -e "s/SOURCE/${SOURCE_SHA}/g" -e "s/EVIDENCE/${EVIDENCE_SHA}/g" /tmp/strategy-master-prompt.txt
   198	          model_args=()
   199	          if [[ -n "${OPENAI_STRATEGY_SYNTH_MODEL:-}" ]]; then model_args=(-m "$OPENAI_STRATEGY_SYNTH_MODEL"); fi
   200	          codex exec --sandbox workspace-write --ask-for-approval never --ephemeral "${model_args[@]}" - < /tmp/strategy-master-prompt.txt
   201	          test -f .strategy_master/master_decision.json
   202	          test -f .strategy_master/master_decision.md
   203	          python - <<'PY'
   204	          import subprocess,sys
   205	          bad=[]
   206	          for line in subprocess.check_output(['git','status','--porcelain'],text=True).splitlines():
   207	              if line[:2]=='??' and line[3:].replace('\\','/').startswith('.strategy_master/'):
   208	                  continue
   209	              bad.append(line)
   210	          if bad: print('GPT master changed out-of-scope files:',*bad,sep='\n',file=sys.stderr); raise SystemExit(3)
   211	          PY
   212	
   213	      - name: Apply deterministic strategy policy gate
   214	        id: gate
   215	        env:
   216	          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
   217	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   218	          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
   219	        shell: bash
   220	        run: |
   221	          set -euo pipefail
   222	          python -m learnerbot.three_agent_strategy_contract gate-master \
   223	            --input .strategy_master/master_decision.json --output .strategy_master/master_gated.json \
   224	            --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA" | tee /tmp/strategy-gate.txt
   225	          echo "allowed=$(grep '^implementation_allowed=' /tmp/strategy-gate.txt | cut -d= -f2)" >> "$GITHUB_OUTPUT"
   226	          echo "status=$(grep '^status=' /tmp/strategy-gate.txt | cut -d= -f2-)" >> "$GITHUB_OUTPUT"
   227	          echo "accepted=$(grep '^accepted=' /tmp/strategy-gate.txt | cut -d= -f2)" >> "$GITHUB_OUTPUT"
   228	
   229	      - name: Publish all-three completion and GPT master ledger
   230	        env:
   231	          CYCLE_ID: ${{ steps.report.outputs.cycle_id }}
   232	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   233	          EVIDENCE_SHA: ${{ steps.report.outputs.evidence_sha }}
   234	          MASTER_STATUS: ${{ steps.gate.outputs.status }}
   235	          ACCEPTED: ${{ steps.gate.outputs.accepted }}
   236	          COPILOT_PR: ${{ steps.pr.outputs.number }}
   237	        shell: bash
   238	        run: |
   239	          set -euo pipefail
   240	          rm -rf /tmp/strategy-master-reviews
   241	          git worktree add --detach /tmp/strategy-master-reviews origin/ai-reviews
   242	          dest="/tmp/strategy-master-reviews/strategy/runs/${CYCLE_ID}"
   243	          cp /tmp/copilot-strategy.json "$dest/copilot.json"
   244	          cp /tmp/copilot-strategy.md "$dest/copilot.md"
   245	          cp .strategy_master/master_decision.json "$dest/master_decision_raw.json"
   246	          cp .strategy_master/master_gated.json "$dest/master_decision.json"
   247	          cp .strategy_master/master_decision.md "$dest/master_decision.md"
   248	          cp .strategy_master/master_gated.json /tmp/strategy-master-reviews/strategy/latest_master_decision.json
   249	          python - <<PY > "$dest/completion.json"
   250	          import json
   251	          print(json.dumps({"cycle_id":"${CYCLE_ID}","source_commit":"${SOURCE_SHA}","evidence_sha256":"${EVIDENCE_SHA}",
   252	            "copilot_report_pr":int("${COPILOT_PR}"),"three_agent_reports_complete":True,"master_decision_available":True},indent=2,sort_keys=True))
   253	          PY
   254	          python - <<PY > /tmp/strategy-master-reviews/strategy/latest_status.json
   255	          import json
   256	          print(json.dumps({"available":True,"cycle_id":"${CYCLE_ID}","source_commit":"${SOURCE_SHA}",
   257	            "evidence_sha256":"${EVIDENCE_SHA}","state":"MASTER_DECIDED","gpt":"DONE","gemini":"DONE","copilot":"DONE",
   258	            "three_agent_reports_complete":True,"master_decision_available":True,"master_status":"${MASTER_STATUS}",
   259	            "policy_accepted_count":int("${ACCEPTED}"),"change_pr_url":"","live_auto_deploy":False},indent=2,sort_keys=True))
   260	          PY
.github/workflows/hourly-gemini-strategy-review.yml
     1	name: Hourly Gemini Strategy Review
     2	
     3	on:
     4	  schedule:
     5	    - cron: "23 * * * *"
     6	  workflow_dispatch:
     7	
     8	permissions:
     9	  contents: write
    10	
    11	concurrency:
    12	  group: hourly-gemini-strategy-review
    13	  cancel-in-progress: false
    14	
    15	jobs:
    16	  review:
    17	    name: Review latest sanitised trading evidence with Gemini
    18	    runs-on: ubuntu-latest
    19	    timeout-minutes: 15
    20	
    21	    steps:
    22	      - name: Check out repository
    23	        uses: actions/checkout@v4
    24	        with:
    25	          fetch-depth: 0
    26	
    27	      - name: Set up Python
    28	        uses: actions/setup-python@v5
    29	        with:
    30	          python-version: "3.12"
    31	
    32	      - name: Fetch latest sanitised evidence
    33	        id: source
    34	        shell: bash
    35	        run: |
    36	          set -euo pipefail
    37	          git fetch --force origin audit-status:audit-status
    38	          git fetch --force origin ai-reviews:ai-reviews || true
    39	          git show audit-status:latest_loss_forensics.json > /tmp/latest_loss_forensics.json
    40	
    41	          python - <<'PY' > /tmp/source.env
    42	          import hashlib, json, time
    43	          p = '/tmp/latest_loss_forensics.json'
    44	          report = json.load(open(p, encoding='utf-8'))
    45	          canonical = json.dumps(report, sort_keys=True, separators=(',', ':'), default=str)
    46	          print('SOURCE_HASH=' + hashlib.sha256(canonical.encode()).hexdigest())
    47	          generated = int(report.get('generated_epoch') or 0)
    48	          age = max(0, int(time.time()) - generated) if generated else 10**9
    49	          print('SOURCE_AGE_SECONDS=' + str(age))
    50	          PY
    51	          source /tmp/source.env
    52	
    53	          previous=""
    54	          if git show ai-reviews:reviews/gemini/latest_source_sha256.txt > /tmp/previous_hash 2>/dev/null; then
    55	            previous="$(tr -d '\r\n' < /tmp/previous_hash)"
    56	          fi
    57	
    58	          echo "source_hash=${SOURCE_HASH}" >> "$GITHUB_OUTPUT"
    59	          if [[ "$SOURCE_AGE_SECONDS" -gt 14400 ]]; then
    60	            echo "skip=true" >> "$GITHUB_OUTPUT"
    61	            echo "skip_reason=source report older than 4 hours" >> "$GITHUB_OUTPUT"
    62	          elif [[ -n "$previous" && "$previous" == "$SOURCE_HASH" ]]; then
    63	            echo "skip=true" >> "$GITHUB_OUTPUT"
    64	            echo "skip_reason=source report already reviewed by Gemini" >> "$GITHUB_OUTPUT"
    65	          else
    66	            echo "skip=false" >> "$GITHUB_OUTPUT"
    67	            echo "skip_reason=" >> "$GITHUB_OUTPUT"
    68	          fi
    69	
    70	      - name: Call Gemini reviewer
    71	        if: steps.source.outputs.skip != 'true'
    72	        env:
    73	          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
    74	          GEMINI_MODEL: ${{ vars.GEMINI_MODEL || 'gemini-3.1-pro-preview' }}
    75	          SOURCE_HASH: ${{ steps.source.outputs.source_hash }}
    76	        shell: bash
    77	        run: |
    78	          set -euo pipefail
    79	          python - <<'PY'
    80	          import json, os, urllib.request
    81	
    82	          key = os.environ.get('GEMINI_API_KEY', '').strip()
    83	          model = os.environ.get('GEMINI_MODEL', 'gemini-3.1-pro-preview').strip()
    84	          if not key:
    85	              raise SystemExit('GEMINI_API_KEY is not configured for GitHub Actions')
    86	
    87	          report = json.load(open('/tmp/latest_loss_forensics.json', encoding='utf-8'))
    88	          prompt = '''You are an independent quantitative reviewer and Strategy Laboratory researcher for an automated cryptocurrency trading system.
    89	Use the supplied sanitised evidence as the primary truth. Optimise durable realised NET P&L after measured costs, not win count.
    90	The Strategy Laboratory covers BOTH Solana and EVM. The same economic strategy family may be researched on both, but each chain requires its own executable quote, liquidity, sellability, fees/gas/priority cost, slippage, price impact, latency and MEV assumptions.
    91	
    92	Push the learner beyond leader-wallet copying. Inspect profitable-wallet cohort summaries and learned strategy_patterns for behaviours repeated across multiple profitable wallets. A single profitable wallet is not proof. Prefer route/behaviour structures that remain positive after costs, have enough observations and can be falsified in SHADOW.
    93	
    94	When evidence is missing, recommend specific research tools/sources. Preferred tools are Dune for public wallet/DEX cohort research, DEX Screener for pools/liquidity/flow, Etherscan V2 for EVM wallet histories, DefiLlama for chain/protocol regimes, Jupiter for Solana quote/route research, and GitHub public code search for READ-ONLY public bot architecture/strategy ideas. Never execute untrusted third-party repository code.
    95	
    96	You may propose predictive strategies, but the forecast target must be positive NET edge after costs, not price-up/down alone. Require time-ordered validation with no lookahead, probability calibration, expected net edge, an abstain rule for uncertainty, and separate chain/regime results.
    97	
    98	If evidence identifies an asset that is not in the current product universe, you may create an ASSET REQUEST only. It is not a live buy recommendation and not permission to enable the asset. State chain, asset identifier, symbol if known, evidence, reason, and required identity/liquidity/sellability/quote/simulation/risk checks.
    99	
   100	Do not produce live trading instructions. Do not relax safety controls. Every new strategy or cross-chain port starts SHADOW. Return JSON only with this exact top-level structure:
   101	{
   102	  "status":"HEALTHY|WATCH|DEGRADED",
   103	  "executive_summary":"...",
   104	  "observed_facts":[{"fact":"...","evidence":"...","importance":"LOW|MEDIUM|HIGH"}],
   105	  "recommendations":[{"title":"...","rationale":"...","downside_risk":"...","shadow_test":"...","minimum_evidence":"...","live_mode":false}],
   106	  "research_tools_to_use":[{"tool":"...","purpose":"...","evidence_to_collect":"...","priority":"LOW|MEDIUM|HIGH"}],
   107	  "cross_chain_portability":[{"strategy_or_pattern":"...","source_chain_type":"SOLANA|EVM|BOTH","target_chain_type":"SOLANA|EVM","reason":"...","chain_specific_changes":["..."],"shadow_test":"..."}],
   108	  "forecast_experiments":[{"name":"...","target":"positive_net_edge_after_costs","horizon":"...","features":["..."],"validation":"...","trade_threshold":"...","abstain_rule":"...","shadow_test":"..."}],
   109	  "new_strategy_hypotheses":[{
   110	    "name":"...",
   111	    "family":"...",
   112	    "hypothesis":"...",
   113	    "market_regime":"...",
   114	    "entry_logic":"...",
   115	    "exit_logic":"...",
   116	    "data_required":["..."],
   117	    "estimated_costs":"...",
   118	    "failure_modes":["..."],
   119	    "shadow_test":"...",
   120	    "minimum_observation_windows":3,
   121	    "minimum_trades":5,
   122	    "falsification_conditions":["..."],
   123	    "differentiation":"...",
   124	    "chain_scope":["SOLANA","EVM"],
   125	    "research_plan":["..."],
   126	    "research_tools":["..."],
   127	    "forecast":{},
   128	    "asset_requests":[]
   129	  }],
   130	  "asset_requests":[{"chain":"SOLANA|EVM","asset":"...","symbol":"...","reason":"...","evidence":"...","required_checks":["identity","liquidity","sellability","quote/simulation","cost","risk"]}],
   131	  "evidence_gaps":["..."],
   132	  "no_live_changes":true
   133	}
   134	Limit new_strategy_hypotheses to at most 2 per review and asset_requests to only evidence-supported missing-universe cases.
   135	SOURCE REPORT:\n''' + json.dumps(report, sort_keys=True, default=str)
   136	
   137	          body = {
   138	              'systemInstruction': {'parts': [{'text': 'Return valid JSON only. Never authorise live trading changes, automatic asset enablement, or execution of untrusted third-party code.'}]},
   139	              'contents': [{'role': 'user', 'parts': [{'text': prompt}]}],
   140	              'generationConfig': {'responseMimeType': 'application/json', 'temperature': 0.1},
   141	          }
   142	          url = f'https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent'
   143	          req = urllib.request.Request(
   144	              url,
   145	              data=json.dumps(body).encode('utf-8'),
   146	              headers={'Content-Type':'application/json','x-goog-api-key':key},
   147	              method='POST',
   148	          )
   149	          with urllib.request.urlopen(req, timeout=120) as resp:
   150	              payload = json.loads(resp.read().decode('utf-8'))
   151	          text = ''.join(
   152	              str(part.get('text') or '')
   153	              for cand in payload.get('candidates') or []
   154	              for part in ((cand.get('content') or {}).get('parts') or [])
   155	              if isinstance(part, dict)
   156	          ).strip()
   157	          review = json.loads(text)
   158	          if review.get('no_live_changes') is not True:
   159	              raise SystemExit('Gemini review failed no_live_changes safety gate')
   160	          for rec in review.get('recommendations') or []:
   161	              if rec.get('live_mode') is not False:
   162	                  raise SystemExit('Gemini recommendation attempted live_mode')
   163	          if len(review.get('new_strategy_hypotheses') or []) > 2:
   164	              raise SystemExit('Gemini proposed too many new strategies in one review')
   165	          out = {
   166	              'schema_version': 2,
   167	              'provider': 'gemini',
   168	              'model': model,
   169	              'source_report_sha256': os.environ.get('SOURCE_HASH', ''),
   170	              'review': review,
   171	              'live_auto_deploy': False,
   172	              'asset_auto_add': False,
   173	              'mode': 'STRATEGY_LAB_RESEARCH_ONLY',
   174	          }
   175	          json.dump(out, open('/tmp/gemini_review.json','w',encoding='utf-8'), indent=2, sort_keys=True)
   176	          print('Gemini Strategy Lab review completed safely.')
   177	          PY
   178	
   179	      - name: Publish Gemini review to ai-reviews branch
   180	        if: steps.source.outputs.skip != 'true'
   181	        shell: bash
   182	        env:
   183	          SOURCE_HASH: ${{ steps.source.outputs.source_hash }}
   184	        run: |
   185	          set -euo pipefail
   186	          stamp="$(date -u +'%Y%m%d_%H%M%S')"
   187	          git config user.name "gemini-strategy-review-bot"
   188	          git config user.email "gemini-strategy-review-bot@users.noreply.github.com"
   189	          git switch ai-reviews
   190	          mkdir -p "reviews/gemini/runs/${stamp}" reviews/gemini
   191	          cp /tmp/gemini_review.json "reviews/gemini/runs/${stamp}/review.json"
   192	          cp /tmp/gemini_review.json reviews/gemini/latest.json
   193	          printf '%s\n' "$SOURCE_HASH" > reviews/gemini/latest_source_sha256.txt
   194	          printf '%s\n' "$stamp" > reviews/gemini/latest_run_utc.txt
   195	          git add reviews/gemini
   196	          if git diff --cached --quiet; then
   197	            echo "No Gemini review changes to publish."
   198	            exit 0
   199	          fi
   200	          git commit -m "Gemini strategy review ${stamp}"
   201	          git push origin HEAD:ai-reviews
   202	
   203	      - name: Explain skipped run
   204	        if: steps.source.outputs.skip == 'true'
   205	        run: echo "Gemini review skipped - ${{ steps.source.outputs.skip_reason }}"
.github/workflows/hourly-three-agent-strategy-cycle.yml
     1	name: Hourly Three-Agent Strategy Cycle
     2	
     3	on:
     4	  schedule:
     5	    - cron: '17 * * * *'
     6	  workflow_dispatch:
     7	
     8	permissions:
     9	  contents: write
    10	  issues: write
    11	  pull-requests: read
    12	
    13	concurrency:
    14	  group: hourly-three-agent-strategy-cycle
    15	  cancel-in-progress: false
    16	
    17	jobs:
    18	  review:
    19	    runs-on: ubuntu-latest
    20	    timeout-minutes: 90
    21	    steps:
    22	      - name: Check out exact current main
    23	        uses: actions/checkout@v4
    24	        with:
    25	          ref: main
    26	          fetch-depth: 0
    27	
    28	      - uses: actions/setup-python@v5
    29	        with:
    30	          python-version: '3.11'
    31	          cache: pip
    32	
    33	      - uses: actions/setup-node@v4
    34	        with:
    35	          node-version: '22'
    36	
    37	      - name: Install review tools
    38	        shell: bash
    39	        run: |
    40	          set -euo pipefail
    41	          python -m pip install --upgrade pip
    42	          pip install -r requirements.txt pytest
    43	          npm install -g @openai/codex@latest @google/gemini-cli@latest
    44	          codex --version
    45	          gemini --version
    46	
    47	      - name: Provider credential preflight
    48	        id: creds
    49	        env:
    50	          CODEX_API_KEY: ${{ secrets.OPENAI_API_KEY }}
    51	          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
    52	          COPILOT_ASSIGN_TOKEN: ${{ secrets.COPILOT_ASSIGN_TOKEN }}
    53	        shell: bash
    54	        run: |
    55	          set -euo pipefail
    56	          [[ -n "${CODEX_API_KEY:-}" ]] && echo 'openai=true' >> "$GITHUB_OUTPUT" || echo 'openai=false' >> "$GITHUB_OUTPUT"
    57	          [[ -n "${GEMINI_API_KEY:-}" ]] && echo 'gemini=true' >> "$GITHUB_OUTPUT" || echo 'gemini=false' >> "$GITHUB_OUTPUT"
    58	          [[ -n "${COPILOT_ASSIGN_TOKEN:-}" ]] && echo 'copilot_token=true' >> "$GITHUB_OUTPUT" || echo 'copilot_token=false' >> "$GITHUB_OUTPUT"
    59	          echo "Codex API credential present: $([[ -n "${CODEX_API_KEY:-}" ]] && echo yes || echo no)"
    60	          echo "Gemini credential present: $([[ -n "${GEMINI_API_KEY:-}" ]] && echo yes || echo no)"
    61	          echo "Copilot assignment credential present: $([[ -n "${COPILOT_ASSIGN_TOKEN:-}" ]] && echo yes || echo no)"
    62	
    63	      - name: Resolve source and freshest available evidence
    64	        id: meta
    65	        shell: bash
    66	        run: |
    67	          set -euo pipefail
    68	          mkdir -p .strategy_cycle
    69	          SOURCE_SHA="$(git rev-parse HEAD)"
    70	          EVIDENCE_SOURCE="architecture-only"
    71	          EVIDENCE_FRESH="false"
    72	          if git ls-remote --exit-code --heads origin audit-status >/dev/null 2>&1; then
    73	            git fetch --force origin audit-status:refs/remotes/origin/audit-status
    74	            if git show origin/audit-status:latest_loss_forensics.json > .strategy_cycle/evidence.json 2>/dev/null; then
    75	              EVIDENCE_SOURCE="audit-status:latest_loss_forensics.json"
    76	              age="$(python - <<'PY'
    77	          import json,time
    78	          p=json.load(open('.strategy_cycle/evidence.json'))
    79	          t=int(p.get('generated_epoch') or 0)
    80	          print(max(0,int(time.time())-t) if t else 10**9)
    81	          PY
    82	          )"
    83	              if [[ "$age" -le 7200 ]]; then EVIDENCE_FRESH="true"; fi
    84	            fi
    85	          fi
    86	          if [[ ! -s .strategy_cycle/evidence.json ]]; then
    87	            python - "$SOURCE_SHA" <<'PY' > .strategy_cycle/evidence.json
    88	          import json,sys
    89	          print(json.dumps({
    90	            'schema_version':1,
    91	            'generated_epoch':0,
    92	            'generated_utc':'',
    93	            'evidence_status':'MISSING_RUNTIME_FORENSICS',
    94	            'source_commit':sys.argv[1],
    95	            'note':'No current sanitised runtime forensics branch was available. Review code/architecture, identify evidence gaps, and do not claim live profitability or canary readiness.'
    96	          },indent=2,sort_keys=True))
    97	          PY
    98	          fi
    99	          EVIDENCE_SHA="$(python - <<'PY'
   100	          import hashlib,json
   101	          p=json.load(open('.strategy_cycle/evidence.json'))
   102	          raw=json.dumps(p,sort_keys=True,separators=(',',':'),default=str).encode()
   103	          print(hashlib.sha256(raw).hexdigest())
   104	          PY
   105	          )"
   106	          HOUR_KEY="$(date -u +'%Y%m%d%H')"
   107	          CYCLE_ID="${SOURCE_SHA:0:12}-${HOUR_KEY}-${EVIDENCE_SHA:0:8}"
   108	          echo "source_sha=$SOURCE_SHA" >> "$GITHUB_OUTPUT"
   109	          echo "evidence_sha=$EVIDENCE_SHA" >> "$GITHUB_OUTPUT"
   110	          echo "cycle_id=$CYCLE_ID" >> "$GITHUB_OUTPUT"
   111	          echo "evidence_source=$EVIDENCE_SOURCE" >> "$GITHUB_OUTPUT"
   112	          echo "evidence_fresh=$EVIDENCE_FRESH" >> "$GITHUB_OUTPUT"
   113	
   114	      - name: Prepare common strategy prompt
   115	        env:
   116	          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
   117	          CYCLE_ID: ${{ steps.meta.outputs.cycle_id }}
   118	          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
   119	          EVIDENCE_SOURCE: ${{ steps.meta.outputs.evidence_source }}
   120	          EVIDENCE_FRESH: ${{ steps.meta.outputs.evidence_fresh }}
   121	        shell: bash
   122	        run: |
   123	          cat > .strategy_cycle/prompt.txt <<EOF
   124	          You are one of three INDEPENDENT strategy reviewers for a multi-chain automated trading bot.
   125	          Inspect the entire checked-out repository and .strategy_cycle/evidence.json.
   126	
   127	          Objective: durable money-weighted NET P&L after fees, slippage, price impact, gas/priority fees and execution failures.
   128	          Never optimise raw win count and never force a trade without positive executable edge. Review Solana and EVM using
   129	          chain-specific economics. Review current Strategy Lab families, profitable-wallet/route learning, forecasting,
   130	          cross-venue arbitrage, momentum, mean reversion, flow acceleration, new-liquidity quality and learned-route replication.
   131	          Explicitly classify negative outcomes as STRATEGY/MARKET versus EXECUTION/INFRASTRUCTURE so provider failures such as
   132	          RPC/Jupiter rate limits are not mistaken for evidence that the trading hypothesis itself is bad.
   133	
   134	          Runtime evidence source: ${EVIDENCE_SOURCE}; fresh-within-2h=${EVIDENCE_FRESH}.
   135	          If fresh runtime evidence is unavailable, you MAY suggest code/SHADOW hypotheses but MUST NOT claim a strategy is
   136	          profitable, canary-ready or live-ready. Explicitly list the missing evidence needed to promote it.
   137	
   138	          REPORT ONLY. Do not edit tracked code, trade, deploy, change capital/risk/live settings, touch secrets/wallets/signing,
   139	          auto-add assets, or weaken any execution/sellability/liquidity/simulation protection.
   140	
   141	          Required JSON:
   142	          {
   143	            "schema_version":1,
   144	            "provider":"PROVIDER",
   145	            "cycle_id":"${CYCLE_ID}",
   146	            "source_commit":"${SOURCE_SHA}",
   147	            "evidence_sha256":"${EVIDENCE_SHA}",
   148	            "scope":"THREE_AGENT_STRATEGY_REVIEW",
   149	            "status":"HEALTHY|CHANGES_PROPOSED|INCOMPLETE",
   150	            "summary":"...",
   151	            "proposals":[{
   152	              "id":"stable-id",
   153	              "action":"KEEP|IMPROVE|REWORK|SHADOW_MORE|REPLACE|DORMANT|NEW_SHADOW|ASSET_REQUEST|RESEARCH_MORE",
   154	              "strategy":"...",
   155	              "chain_scope":["SOLANA","EVM"],
   156	              "evidence":[{"path":"repository or JSON path","detail":"specific support"}],
   157	              "rationale":"...",
   158	              "expected_effect":"...",
   159	              "downside_risk":"...",
   160	              "shadow_test":"falsifiable test including costs and stop/failure condition",
   161	              "minimum_observation":"...",
   162	              "confidence":0.0,
   163	              "suggested_files":["Strategy Lab/SHADOW files only"]
   164	            }],
   165	            "rejected_ideas":[{"idea":"...","reason":"..."}],
   166	            "evidence_gaps":["..."],
   167	            "review_only":true,
   168	            "no_live_changes":true
   169	          }
   170	          Prefer no change over unsupported confidence.
   171	          EOF
   172	
   173	      - name: GPT independent strategy report
   174	        id: gpt
   175	        continue-on-error: true
   176	        env:
   177	          CODEX_API_KEY: ${{ secrets.OPENAI_API_KEY }}
   178	          OPENAI_STRATEGY_AUDIT_MODEL: ${{ vars.OPENAI_STRATEGY_AUDIT_MODEL }}
   179	          CYCLE_ID: ${{ steps.meta.outputs.cycle_id }}
   180	          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
   181	          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
   182	        shell: bash
   183	        run: |
   184	          set -euo pipefail
   185	          if [[ -z "${CODEX_API_KEY:-}" ]]; then
   186	            echo 'OPENAI_API_KEY_SOURCE_SECRET_MISSING' > .strategy_cycle/gpt_error.txt
   187	            exit 20
   188	          fi
   189	          sed 's/"provider":"PROVIDER"/"provider":"gpt"/' .strategy_cycle/prompt.txt > /tmp/gpt-prompt.txt
   190	          printf '\nWrite exactly .strategy_cycle/gpt.json and .strategy_cycle/gpt.md. Change no tracked file.\n' >> /tmp/gpt-prompt.txt
   191	          model_args=()
   192	          if [[ -n "${OPENAI_STRATEGY_AUDIT_MODEL:-}" ]]; then model_args=(-m "$OPENAI_STRATEGY_AUDIT_MODEL"); fi
   193	          set +e
   194	          codex --ask-for-approval never exec --sandbox workspace-write --ephemeral "${model_args[@]}" - < /tmp/gpt-prompt.txt \
   195	            2> >(tee .strategy_cycle/gpt_error.txt >&2)
   196	          rc=$?
   197	          set -e
   198	          [[ $rc -eq 0 ]] || exit "$rc"
   199	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   200	            --input .strategy_cycle/gpt.json --provider gpt --cycle-id "$CYCLE_ID" \
   201	            --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   202	
   203	      - name: Recover GPT incomplete report
   204	        if: steps.gpt.outcome != 'success'
   205	        env:
   206	          CYCLE_ID: ${{ steps.meta.outputs.cycle_id }}
   207	          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
   208	          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
   209	          OPENAI_PRESENT: ${{ steps.creds.outputs.openai }}
   210	        shell: bash
   211	        run: |
   212	          git restore --source=HEAD --staged --worktree . || true
   213	          mkdir -p .strategy_cycle
   214	          python - <<'PY'
   215	          import json,os,re,pathlib
   216	          pth=pathlib.Path('.strategy_cycle/gpt_error.txt')
   217	          raw=pth.read_text(errors='replace')[-1800:] if pth.exists() else ''
   218	          raw=re.sub(r'(sk|sess)-[A-Za-z0-9_-]{8,}', '<redacted>', raw)
   219	          reason='OpenAI/Codex API credential missing' if os.environ.get('OPENAI_PRESENT')!='true' else (raw.strip() or 'GPT step failed without stderr')
   220	          p={'schema_version':1,'provider':'gpt','cycle_id':os.environ['CYCLE_ID'],'source_commit':os.environ['SOURCE_SHA'],'evidence_sha256':os.environ['EVIDENCE_SHA'],'scope':'THREE_AGENT_STRATEGY_REVIEW','status':'INCOMPLETE','summary':'GPT report failed.','proposals':[],'rejected_ideas':[],'evidence_gaps':[reason[:1500]],'review_only':True,'no_live_changes':True}
   221	          pathlib.Path('.strategy_cycle/gpt.json').write_text(json.dumps(p,indent=2,sort_keys=True)+'\n')
   222	          pathlib.Path('.strategy_cycle/gpt.md').write_text('# GPT strategy review\n\nINCOMPLETE\n\n'+reason[:1500]+'\n')
   223	          PY
   224	
   225	      - name: Gemini independent strategy report
   226	        id: gemini
   227	        continue-on-error: true
   228	        env:
   229	          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
   230	          GEMINI_STRATEGY_MODEL: ${{ vars.GEMINI_STRATEGY_MODEL || 'gemini-3.1-pro-preview' }}
   231	          GEMINI_CLI_TRUST_WORKSPACE: 'true'
   232	          CYCLE_ID: ${{ steps.meta.outputs.cycle_id }}
   233	          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
   234	          EVIDENCE_SHA: ${{ steps.meta.outputs.evidence_sha }}
   235	        shell: bash
   236	        run: |
   237	          set -euo pipefail
   238	          if [[ -z "${GEMINI_API_KEY:-}" ]]; then
   239	            echo 'GEMINI_API_KEY_MISSING' > .strategy_cycle/gemini_error.txt
   240	            exit 20
   241	          fi
   242	          sed 's/"provider":"PROVIDER"/"provider":"gemini"/' .strategy_cycle/prompt.txt > /tmp/gemini-prompt.txt
   243	          cat >> /tmp/gemini-prompt.txt <<'EOF'
   244	          Inspect read-only. End with exactly:
   245	          STRATEGY_REVIEW_JSON_BEGIN
   246	          {required JSON object}
   247	          STRATEGY_REVIEW_JSON_END
   248	          EOF
   249	          set +e
   250	          gemini --approval-mode=plan --skip-trust --model "$GEMINI_STRATEGY_MODEL" --output-format text \
   251	            -p "$(cat /tmp/gemini-prompt.txt)" > .strategy_cycle/gemini_stdout.txt \
   252	            2> >(tee .strategy_cycle/gemini_error.txt >&2)
   253	          rc=$?
   254	          set -e
   255	          [[ $rc -eq 0 ]] || exit "$rc"
   256	          python scripts/extract_strategy_report.py \
   257	            --input .strategy_cycle/gemini_stdout.txt --output .strategy_cycle/gemini.json \
   258	            --provider gemini --cycle-id "$CYCLE_ID" --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   259	          python - <<'PY'
   260	          import json
.github/workflows/install-rclone-vps.yml
     1	name: Install rclone on BOOT VPS
     2	
     3	on:
     4	  push:
     5	    branches: [main]
     6	    paths:
     7	      - .github/workflows/install-rclone-vps.yml
     8	  workflow_dispatch:
     9	
    10	permissions:
    11	  contents: read
    12	  statuses: write
    13	
    14	concurrency:
    15	  group: boot-vps-rclone-install
    16	  cancel-in-progress: false
    17	
    18	jobs:
    19	  install:
    20	    name: Install and verify rclone
    21	    runs-on: [self-hosted, linux, x64, boot-vps]
    22	    timeout-minutes: 10
    23	    steps:
    24	      - name: Install rclone if missing
    25	        shell: bash
    26	        run: |
    27	          set -euo pipefail
    28	
    29	          echo "Runner user: $(id -un)"
    30	          echo "Kernel: $(uname -srmo)"
    31	
    32	          if command -v rclone >/dev/null 2>&1; then
    33	            echo "rclone is already installed"
    34	            rclone version
    35	            exit 0
    36	          fi
    37	
    38	          installer="$(mktemp)"
    39	          trap 'rm -f "$installer"' EXIT
    40	          curl -fsSL https://rclone.org/install.sh -o "$installer"
    41	
    42	          if [ "$(id -u)" -eq 0 ]; then
    43	            bash "$installer"
    44	          else
    45	            sudo -n bash "$installer"
    46	          fi
    47	
    48	          command -v rclone
    49	          rclone version
    50	
    51	      - name: Show config location
    52	        shell: bash
    53	        run: |
    54	          set -euo pipefail
    55	          rclone config file
    56	
    57	      - name: Report rclone install status
    58	        if: always()
    59	        shell: bash
    60	        env:
    61	          GH_TOKEN: ${{ github.token }}
    62	          REPO: ${{ github.repository }}
    63	          SHA: ${{ github.sha }}
    64	          JOB_STATUS: ${{ job.status }}
    65	        run: |
    66	          set -euo pipefail
    67	
    68	          if [ "$JOB_STATUS" = "success" ]; then
    69	            api_state="success"
    70	          else
    71	            api_state="failure"
    72	          fi
    73	
    74	          if command -v rclone >/dev/null 2>&1; then
    75	            version="$(rclone version | head -n 1 | tr -d '\r')"
    76	          else
    77	            version="rclone unavailable"
    78	          fi
    79	
    80	          export API_STATE="$api_state"
    81	          export DESCRIPTION="$version; job=$JOB_STATUS"
    82	          python3 - <<'PY' > /tmp/rclone-status.json
    83	import json
    84	import os
    85	print(json.dumps({
    86	    "state": os.environ["API_STATE"],
    87	    "context": "server/rclone-install",
    88	    "description": os.environ["DESCRIPTION"][:140],
    89	}))
    90	PY
    91	
    92	          curl -fsS \
    93	            -X POST \
    94	            -H "Authorization: Bearer $GH_TOKEN" \
    95	            -H "Accept: application/vnd.github+json" \
    96	            -H "X-GitHub-Api-Version: 2022-11-28" \
    97	            "https://api.github.com/repos/$REPO/statuses/$SHA" \
    98	            --data-binary @/tmp/rclone-status.json
.github/workflows/server-ops.yml
     1	name: BOOT Server Operations
     2	
     3	on:
     4	  workflow_dispatch:
     5	    inputs:
     6	      operation:
     7	        description: Safe server operation
     8	        required: true
     9	        type: choice
    10	        default: status
    11	        options:
    12	          - status
    13	          - deploy_main
    14	          - restart_learnerbot
    15	          - wallet_balance
    16	      wallet:
    17	        description: 0x wallet address (wallet_balance only)
    18	        required: false
    19	        type: string
    20	
    21	permissions:
    22	  contents: read
    23	
    24	concurrency:
    25	  group: boot-vps-operations
    26	  cancel-in-progress: false
    27	
    28	jobs:
    29	  operate:
    30	    runs-on: [self-hosted, linux, x64, boot-vps]
    31	    timeout-minutes: 20
    32	    steps:
    33	      - name: Status
    34	        if: inputs.operation == 'status'
    35	        run: sudo /usr/local/sbin/status-boot-trading-bot
    36	
    37	      - name: Deploy current main
    38	        if: inputs.operation == 'deploy_main'
    39	        run: sudo /usr/local/sbin/deploy-boot-trading-bot "${GITHUB_SHA}"
    40	
    41	      - name: Status after deploy attempt
    42	        if: always() && inputs.operation == 'deploy_main'
    43	        run: sudo /usr/local/sbin/status-boot-trading-bot
    44	
    45	      - name: Restart learnerbot
    46	        if: inputs.operation == 'restart_learnerbot'
    47	        run: sudo /usr/local/sbin/restart-boot-trading-bot
    48	
    49	      - name: Validate wallet input
    50	        if: inputs.operation == 'wallet_balance'
    51	        shell: bash
    52	        env:
    53	          WALLET: ${{ inputs.wallet }}
    54	        run: |
    55	          set -euo pipefail
    56	          if [[ ! "$WALLET" =~ ^0x[0-9A-Fa-f]{40}$ ]]; then
    57	            echo 'wallet_balance requires a valid 0x EVM address' >&2
    58	            exit 2
    59	          fi
    60	          sudo /usr/local/sbin/check-boot-wallet "$WALLET"
