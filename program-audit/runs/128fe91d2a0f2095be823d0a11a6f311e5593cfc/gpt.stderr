    56	      - 'tests/test_strategy_lab_cross_chain_research.py'
    57	      - 'tests/test_cross_chain_strategy_signals.py'
    58	      - 'tests/test_market_feature_shadow_executor.py'
    59	      - 'tests/test_three_agent_strategy_contract.py'
    60	      - 'tests/test_strategy_canary.py'
