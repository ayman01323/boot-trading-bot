   151	def _landed_fault_count(app, tid):
   152	    with closing(_sol.connect(app)) as conn:
   153	        _ensure_live_safety_schema(conn)
   154	        return int(conn.execute(
   155	            "SELECT COUNT(*) n FROM live_execution_attempts WHERE telegram_id=? AND status='LANDED_INVALID_OUTPUT'",
   156	            (str(tid),),
   157	        ).fetchone()["n"])
   158	
   159	
   160	def _record_execution_fault(app, tid, cfg, message):
   161	    count = _landed_fault_count(app, tid)
   162	    threshold = max(1, _sol._int(cfg.get("live_no_output_disable_after"), 2))
   163	    if count >= threshold:
   164	        set_user_setting(
   165	            app.csv_dir, tid, "solana_live_enabled", "false",
   166	            chain_id=_sol.SOLANA_CHAIN_ID,
   167	            description="Automatically disabled after repeated landed-but-invalid Solana executions",
   168	        )
   169	        _notify(
   170	            app, tid,
   171	            f"🛑 <b>Solana LIVE automatically disabled</b>\n"
   172	            f"Landed-but-invalid execution faults: <b>{count}</b> (limit {threshold}).\n"
   173	            f"Last fault: <code>{str(message)[:450]}</code>\n"
   174	            "No new Solana LIVE entries will be submitted until you explicitly re-arm LIVE after investigation.",
   175	        )
   176	        return True
   177	    _notify(
   178	        app, tid,
   179	        f"⚠️ <b>Solana LIVE execution fault {count}/{threshold}</b>\n"
   180	        f"<code>{str(message)[:500]}</code>\n"
   181	        "This leader signal is permanently deduplicated and will not be submitted again.",
   182	    )
   183	    return False
   184	
   185	
   186	def _recent_buy_overhead_sol(app, tid):
   187	    """Return the median-like middle recent observed BUY overhead, if reconcilable."""
   188	    values = []
   189	    with closing(_sol.connect(app)) as conn:
   190	        _ensure_live_safety_schema(conn)
   191	        rows = conn.execute(
   192	            """SELECT input_raw,wallet_delta_lamports FROM live_execution_attempts
   193	               WHERE telegram_id=? AND action='BUY' AND status='EXECUTED'
   194	               ORDER BY created_at DESC LIMIT 7""",
   195	            (str(tid),),
   196	        ).fetchall()
   197	    for row in rows:
   198	        try:
   199	            inp = int(row["input_raw"] or 0)
   200	            delta = int(row["wallet_delta_lamports"] or 0)
   201	        except Exception:
   202	            continue
   203	        if inp > 0 and delta < 0:
   204	            overhead = max(0, -delta - inp)
   205	            values.append(Decimal(overhead) / Decimal(1_000_000_000))
   206	    if not values:
   207	        return Decimal(0)
   208	    values.sort()
   209	    return values[len(values) // 2]
   210	
   211	
   212	def _economic_entry_gate(app, tid, allocation, cfg):
   213	    minimum = max(Decimal("0.0001"), _sol._dec(cfg.get("live_min_economic_trade_sol"), "0.0005"))
   214	    if Decimal(allocation) < minimum:
   215	        return False, f"LIVE allocation {allocation} SOL is below economic minimum {minimum} SOL"
   216	    overhead = _recent_buy_overhead_sol(app, tid)
   217	    max_pct = max(Decimal(0), _sol._dec(cfg.get("live_max_observed_overhead_pct"), 35))
   218	    if overhead > 0 and Decimal(allocation) > 0:
   219	        pct = overhead * Decimal(100) / Decimal(allocation)
   220	        if pct > max_pct:
   221	            return False, f"recent actual execution overhead {overhead:.9f} SOL is {pct:.1f}% of trade size (limit {max_pct}%)"
   222	    return True, "ok"
   223	
   224	
   225	def _open_live_count(app, tid):
   226	    with closing(_sol.connect(app)) as conn:
   227	        return int(conn.execute("SELECT COUNT(*) n FROM positions WHERE telegram_id=? AND status='OPEN' AND mode='LIVE'", (str(tid),)).fetchone()["n"])
   228	
   229	
   230	def _insert_live_position(app, tid, rank, event, trade, allocation, cfg):
   231	    now = int(time.time())
   232	    pid = hashlib.sha256(f"solana-live|{tid}|{event['leader_wallet']}|{event['mint']}|{event['signature']}".encode()).hexdigest()[:32]
   233	    out_raw = int(trade.get("totalOutputAmount") or trade.get("outputAmountResult") or (trade.get("order") or {}).get("outAmount") or 0)
   234	    if out_raw <= 0:
   235	        raise SolanaLiveError("LIVE BUY confirmed but Jupiter returned no output token amount")
   236	    input_lamports = int(trade.get("totalInputAmount") or trade.get("inputAmountResult") or int(Decimal(str(allocation)) * Decimal(1_000_000_000)))
   237	    delta_raw = trade.get("wallet_delta_lamports")
   238	    try:
   239	        delta = int(delta_raw) if delta_raw is not None else 0
   240	    except Exception:
   241	        delta = 0
   242	    if delta < 0:
   243	        # Actual wallet cash spend includes network/priority fees and temporary
   244	        # account funding. Any later rent refund is naturally reflected in the
   245	        # actual exit wallet delta, so the round trip reconciles in cash terms.
   246	        entry_cost = Decimal(-delta) / Decimal(1_000_000_000)
   247	    else:
   248	        entry_cost = Decimal(input_lamports) / Decimal(1_000_000_000) + _sol._dec(cfg.get("estimated_entry_fee_sol"), ".00002")
   249	    tx = str(trade.get("signature") or "")
   250	    with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   251	        conn.execute(
   252	            """INSERT OR IGNORE INTO positions(position_id,telegram_id,leader_wallet,leader_rank,mint,mode,status,token_amount_raw,
   253	                                                entry_cost_sol,entry_ts,leader_buy_signature,leader_entry_sol,leader_entry_token_raw,
   254	                                                signal_count,current_exit_sol,unrealised_net_sol,unrealised_pct,peak_unrealised_pct,
   255	                                                leader_exit_pending,realised_net_sol,exit_signature,updated_at)
   256	               VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
   257	            (pid, str(tid), event["leader_wallet"], rank, event["mint"], "LIVE", "OPEN", str(out_raw),
   258	             str(entry_cost), now, event["signature"], str(event["sol_amount"]), str(event["token_amount_raw"]),
   259	             1, "0", "0", 0.0, 0.0, 0, "0", tx, now),
   260	        )
   261	        conn.commit()
   262	    return pid, out_raw, entry_cost
   263	
   264	
   265	def _close_live(app, tid, position, fraction: Decimal, reason: str):
   266	    executor = SolanaLiveExecutor(app, tid)
   267	    old_raw = max(1, _sol._int(position.get("token_amount_raw"), 0))
   268	    f = max(Decimal("0.0001"), min(Decimal(1), Decimal(str(fraction))))
   269	    planned = max(1, int(Decimal(old_raw) * f))
   270	    actual = executor.token_balance_raw(position["mint"])
   271	    sell_raw = min(planned, actual)
   272	    if sell_raw <= 0:
   273	        raise SolanaLiveError("LIVE exit cannot execute because the wallet holds no matching token")
   274	    trade = executor.sell(position["mint"], sell_raw)
   275	    out_lamports = int(trade.get("totalOutputAmount") or trade.get("outputAmountResult") or 0)
   276	    delta_raw = trade.get("wallet_delta_lamports")
   277	    try:
   278	        delta = int(delta_raw) if delta_raw is not None else 0
   279	    except Exception:
   280	        delta = 0
   281	    cfg = _sol.settings(app)
   282	    if delta > 0:
   283	        proceeds = Decimal(delta) / Decimal(1_000_000_000)
   284	    else:
   285	        proceeds = Decimal(out_lamports) / Decimal(1_000_000_000) - _sol._dec(cfg.get("estimated_exit_fee_sol"), ".00002")
   286	    old_cost = _sol._dec(position.get("entry_cost_sol"), 0)
   287	    cost_fraction = old_cost * Decimal(sell_raw) / Decimal(old_raw)
   288	    net = proceeds - cost_fraction
   289	    remaining = max(0, old_raw - sell_raw)
   290	    remaining_cost = max(Decimal(0), old_cost - cost_fraction)
   291	    closed = remaining <= max(1, int(old_raw * .001)) or f >= Decimal("0.999")
   292	    realised = _sol._dec(position.get("realised_net_sol"), 0) + net
   293	    now = int(time.time())
   294	    sig = str(trade.get("signature") or "")
   295	    with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   296	        conn.execute(
   297	            """UPDATE positions SET token_amount_raw=?,entry_cost_sol=?,realised_net_sol=?,exit_signature=?,exit_reason=?,closed_at=?,
   298	                                    status=?,leader_exit_pending=?,updated_at=? WHERE position_id=?""",
   299	            (str(0 if closed else remaining), str(0 if closed else remaining_cost), str(realised), sig, reason,
   300	             now if closed else None, "CLOSED" if closed else "OPEN", 0 if closed else int(position.get("leader_exit_pending") or 0), now, position["position_id"]),
   301	        )
   302	        conn.commit()
   303	    _notify(app, tid, f"✅ <b>Solana LIVE SELL confirmed</b>\nReason: <code>{reason}</code>\nReceived wallet delta: <b>{proceeds:.9f} SOL</b>\nNet on sold portion: <b>{net:+.9f} SOL</b>\nTX: <code>{sig}</code>")
   304	    return {"closed": closed, "net_sol": net, "signature": sig, "reason": reason, "trade": trade}
   305	
   306	
   307	def process_leader_event(app, event: dict):
   308	    """LIVE-only Solana entry path with durable one-attempt signal deduplication."""
   309	    cfg = _sol.settings(app)
   310	    actions = []
   311	    for u in all_users(app.csv_dir, enabled_only=True):
   312	        tid = str(u.get("telegram_id") or "")
   313	        if not tid or not live_enabled(app, tid):
   314	            continue
   315	        if not _sol._sibot._bool(_sol._sibot.user_settings(app, tid, 0).get("enabled"), False):
   316	            continue
   317	        rank = _sol._leader_rank(app, tid, event["leader_wallet"])
   318	        if rank is None:
   319	            continue
   320	        if event["action"] == "BUY":
   321	            max_positions = max(1, min(5, _sol._int(cfg.get("live_max_positions"), 1)))
   322	            if _open_live_count(app, tid) >= max_positions or _sol._open_position(app, tid, event["mint"]):
   323	                actions.append({"telegram_id": tid, "action": "SKIP", "reason": "LIVE position limit/already held"})
   324	                continue
   325	            allocation, reserve = live_limits(app, tid, cfg)
   326	            try:
   327	                ok, reason, _ = _sol._validate_shadow_entry(app, event, allocation, cfg)
   328	                if not ok:
   329	                    actions.append({"telegram_id": tid, "action": "REJECT", "reason": reason})
   330	                    continue
   331	                ok, reason = _economic_entry_gate(app, tid, allocation, cfg)
   332	                if not ok:
   333	                    actions.append({"telegram_id": tid, "action": "REJECT", "reason": reason})
   334	                    continue
   335	                executor = SolanaLiveExecutor(app, tid)
   336	                # Pre-check funding before claiming the signal so a simple funding
   337	                # deficiency does not permanently consume the execution attempt.
   338	                need = int((allocation + reserve) * Decimal(1_000_000_000))
   339	                if executor.native_balance_lamports() < need:
   340	                    actions.append({"telegram_id": tid, "action": "REJECT", "reason": "insufficient SOL for trade plus reserve"})
   341	                    continue
   342	                claimed, attempt_key = _claim_attempt(app, tid, event)
   343	                if not claimed:
   344	                    actions.append({"telegram_id": tid, "action": "SKIP", "reason": "duplicate leader signal already attempted"})
   345	                    continue
   346	                try:
   347	                    trade = executor.buy(event["mint"], allocation, reserve)
   348	                    _update_attempt(app, attempt_key, "EXECUTED", trade)
   349	                    pid, out_raw, entry_cost = _insert_live_position(app, tid, rank, event, trade, allocation, cfg)
   350	                    sig = str(trade.get("signature") or "")
   351	                    _notify(app, tid, f"🚀 <b>Solana LIVE BUY confirmed</b>\nActual wallet spend: <b>{entry_cost:.9f} SOL</b>\nToken: <code>{event['mint']}</code>\nReceived raw: <code>{out_raw}</code>\nTX: <code>{sig}</code>")
   352	                    actions.append({"telegram_id": tid, "action": "BUY", "position_id": pid, "mode": "LIVE", "signature": sig})
   353	                except SolanaLivePostExecutionError as exc:
   354	                    _update_attempt(app, attempt_key, "LANDED_INVALID_OUTPUT", exc.result, str(exc))
   355	                    _record_execution_fault(app, tid, cfg, exc)
   356	                    actions.append({"telegram_id": tid, "action": "REJECT", "reason": str(exc), "signature": exc.signature})
   357	                except Exception as exc:
   358	                    _update_attempt(app, attempt_key, "FAILED_NO_RETRY", None, str(exc))
   359	                    _notify(app, tid, f"🚨 <b>Solana LIVE BUY blocked</b>\n<code>{type(exc).__name__}: {str(exc)[:500]}</code>\nThis exact leader signal will not be retried automatically.")
   360	                    actions.append({"telegram_id": tid, "action": "REJECT", "reason": str(exc)})
   361	            except Exception as exc:
   362	                _notify(app, tid, f"🚨 <b>Solana LIVE BUY preflight blocked</b>\n<code>{type(exc).__name__}: {str(exc)[:500]}</code>")
   363	                actions.append({"telegram_id": tid, "action": "REJECT", "reason": str(exc)})
   364	        elif event["action"] == "SELL":
   365	            with closing(_sol.connect(app)) as conn:
   366	                rows = [dict(r) for r in conn.execute(
   367	                    "SELECT * FROM positions WHERE telegram_id=? AND leader_wallet=? AND mint=? AND status='OPEN' AND mode='LIVE'",
   368	                    (tid, event["leader_wallet"], event["mint"]),
   369	                ).fetchall()]
   370	            for p in rows:
   371	                full = _sol._float(event.get("sell_pct"), 100) >= 99
   372	                fraction = Decimal(1) if full else max(Decimal("0.0001"), min(Decimal(1), _sol._dec(event.get("sell_pct"), 100) / Decimal(100)))
   373	                if not full and not _sol._bool(cfg.get("mirror_partial_sells"), True):
   374	                    continue
   375	                try:
   376	                    ev = _sol.evaluate_position(app, p, fraction)
   377	                    min_profit = _sol._dec(_sol._sibot.user_settings(app, tid, 0).get("min_exit_profit_pct"), ".10")
   378	                    stop = _sol._dec(cfg.get("stop_loss_pct"), 10)
   379	                    if ev["net_pct"] >= min_profit or ev["net_pct"] <= -stop:
   380	                        claimed, attempt_key = _claim_attempt(app, tid, event)
   381	                        if not claimed:
   382	                            actions.append({"telegram_id": tid, "action": "SKIP", "reason": "duplicate leader SELL signal already attempted"})
   383	                            continue
   384	                        try:
   385	                            result = _close_live(app, tid, p, fraction, "SOLANA_LEADER_PARTIAL_SELL" if not full else "SOLANA_LEADER_SELL")
   386	                            _update_attempt(app, attempt_key, "EXECUTED", result.get("trade"))
   387	                            actions.append({"telegram_id": tid, "action": "SELL", "position_id": p["position_id"], "signature": result.get("signature")})
   388	                        except SolanaLivePostExecutionError as exc:
   389	                            _update_attempt(app, attempt_key, "LANDED_INVALID_OUTPUT", exc.result, str(exc))
   390	                            _record_execution_fault(app, tid, cfg, exc)
   391	                            actions.append({"telegram_id": tid, "action": "REJECT", "reason": str(exc), "signature": exc.signature})
   392	                        except Exception as exc:
   393	                            _update_attempt(app, attempt_key, "FAILED_NO_RETRY", None, str(exc))
   394	                            raise
   395	                    else:
   396	                        with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   397	                            conn.execute("UPDATE positions SET leader_exit_pending=1,updated_at=? WHERE position_id=?", (int(time.time()), p["position_id"]))
   398	                            conn.commit()
   399	                        actions.append({"telegram_id": tid, "action": "EXIT_PENDING", "position_id": p["position_id"]})
   400	                except Exception as exc:
   401	                    _notify(app, tid, f"🚨 <b>Solana LIVE exit warning</b>\n<code>{type(exc).__name__}: {str(exc)[:500]}</code>")
   402	    return actions
   403	
   404	
   405	def monitor_positions(app):
   406	    cfg = _sol.settings(app)
   407	    now = int(time.time())
   408	    with closing(_sol.connect(app)) as conn:
   409	        rows = [dict(r) for r in conn.execute("SELECT * FROM positions WHERE status='OPEN' AND mode='LIVE' ORDER BY updated_at").fetchall()]
   410	    for p in rows:
   411	        tid = str(p.get("telegram_id") or "")
   412	        if not live_enabled(app, tid):
   413	            continue
   414	        try:
   415	            ev = _sol.evaluate_position(app, p)
   416	        except Exception:
   417	            continue
   418	        current = _sol._dec(ev["net_pct"])
   419	        peak = max(_sol._dec(p.get("peak_unrealised_pct"), 0), current)
   420	        with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   421	            conn.execute(
   422	                "UPDATE positions SET current_exit_sol=?,unrealised_net_sol=?,unrealised_pct=?,peak_unrealised_pct=?,updated_at=? WHERE position_id=?",
   423	                (str(ev["proceeds_sol"]), str(ev["net_sol"]), float(current), float(peak), now, p["position_id"]),
   424	            )
   425	            conn.commit()
   426	        reason = None
   427	        if int(p.get("leader_exit_pending") or 0) and current <= -_sol._dec(cfg.get("leader_exit_loss_cap_pct"), "2.5"):
   428	            reason = "SOLANA_LEADER_EXIT_LOSS_CAP"
   429	        elif peak >= _sol._dec(cfg.get("break_even_trigger_pct"), 5) and current <= _sol._dec(cfg.get("break_even_floor_pct"), ".10"):
   430	            reason = "SOLANA_BREAK_EVEN_PROTECT"
   431	        elif peak >= _sol._dec(cfg.get("trailing_trigger_pct"), 10):
   432	            floor = max(_sol._dec(cfg.get("break_even_floor_pct"), ".10"), peak - _sol._dec(cfg.get("trailing_gap_pct"), 5))
   433	            if current <= floor:
   434	                reason = "SOLANA_TRAILING_PROFIT_PROTECT"
   435	        if reason is None and current <= -_sol._dec(cfg.get("stop_loss_pct"), 10):
   436	            reason = "SOLANA_STOP_LOSS"
   437	        if reason is None and current >= _sol._dec(cfg.get("take_profit_pct"), 25):
   438	            reason = "SOLANA_TAKE_PROFIT"
   439	        age_h = Decimal(max(0, now - _sol._int(p.get("entry_ts"), now))) / Decimal(3600)
   440	        if reason is None and age_h >= _sol._dec(cfg.get("max_hold_hours"), 24) and current > 0:
   441	            reason = "SOLANA_MAX_HOLD_PROFIT"
   442	        if reason:
   443	            try:
   444	                fresh = dict(p)
   445	                fresh["peak_unrealised_pct"] = float(peak)
   446	                _close_live(app, tid, fresh, Decimal(1), reason)
   447	            except SolanaLivePostExecutionError as exc:
   448	                # Monitor exits have no leader-signature dedupe key, so the global
   449	                # landed-fault circuit breaker is the backstop. Two such faults turn
   450	                # LIVE off and stop further monitor submissions for this user.
   451	                _record_execution_fault(app, tid, cfg, exc)
   452	                _notify(app, tid, f"🚨 <b>Solana LIVE emergency exit landed without valid economic output</b>\n<code>{str(exc)[:450]}</code>")
   453	            except Exception as exc:
   454	                _notify(app, tid, f"🚨 <b>Solana LIVE emergency-exit warning</b>\nReason: <code>{reason}</code>\n<code>{type(exc).__name__}: {str(exc)[:450]}</code>")
   455	    _sol.export_csv(app)
   456	
   457	
   458	def install():
   459	    _sol.process_leader_event = process_leader_event
   460	    _sol.monitor_positions = monitor_positions
   461	
   462	
   463	install()
   430	    raw_in = _i(result.get("totalInputAmount") or result.get("inputAmountResult"), amount_raw)
   431	    raw_out = _i(result.get("totalOutputAmount") or result.get("outputAmountResult"), 0)
   432	    rent_paid = max(0, _i(order.get("rentFeeLamports"), result.get("rent_paid_lamports") or 0))
   433	    rent_reclaimed = max(0, _i(result.get("rent_reclaimed_lamports"), 0))
   434	    wallet_delta = result.get("wallet_delta_lamports")
   435	    wallet_delta_text = "" if wallet_delta is None else str(_i(wallet_delta, 0))
   436	    now = int(time.time())
   437	
   438	    details = {
   439	        "fee_cap_lamports": order.get("_fee_cap_lamports"),
   440	        "total_fee_equiv_lamports": order.get("_total_fee_equiv_lamports"),
   441	        "wallet_balance_reconciled": result.get("wallet_balance_reconciled"),
   442	        "swap_events_present": result.get("swap_events_present"),
   443	        "economic_validation": result.get("economic_validation"),
   444	        "atomic_source_account": result.get("atomic_source_account"),
   445	    }
   446	    try:
   447	        with _sol._DB_LOCK, closing(_sol.connect(executor.app)) as conn:
   448	            _ensure(conn)
   449	            conn.execute(
   450	                """INSERT INTO live_execution_receipts(
   451	                     signature,created_at,telegram_id,wallet_id,wallet_address,action,source,input_mint,output_mint,
   452	                     raw_input_amount,raw_output_amount,trade_value_lamports,network_fee_lamports,base_fee_lamports,
   453	                     priority_fee_lamports,jito_tip_lamports,priority_tip_quote_lamports,platform_fee_bps,
   454	                     platform_fee_amount,platform_fee_mint,rent_paid_lamports,rent_reclaimed_lamports,
   455	                     wallet_delta_lamports,net_execution_pnl_lamports,slippage_bps,price_impact_bps,route_hops,
   456	                     atomic_token_account_close,reused_existing_output_token_account,router,details_json,updated_at
   457	                   ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
   458	                   ON CONFLICT(signature) DO UPDATE SET
   459	                     raw_input_amount=excluded.raw_input_amount,raw_output_amount=excluded.raw_output_amount,
   460	                     network_fee_lamports=excluded.network_fee_lamports,base_fee_lamports=excluded.base_fee_lamports,
   461	                     priority_fee_lamports=excluded.priority_fee_lamports,jito_tip_lamports=excluded.jito_tip_lamports,
   462	                     priority_tip_quote_lamports=excluded.priority_tip_quote_lamports,
   463	                     platform_fee_bps=excluded.platform_fee_bps,platform_fee_amount=excluded.platform_fee_amount,
   464	                     platform_fee_mint=excluded.platform_fee_mint,rent_paid_lamports=excluded.rent_paid_lamports,
   465	                     rent_reclaimed_lamports=excluded.rent_reclaimed_lamports,wallet_delta_lamports=excluded.wallet_delta_lamports,
   466	                     net_execution_pnl_lamports=COALESCE(excluded.net_execution_pnl_lamports,live_execution_receipts.net_execution_pnl_lamports),
   467	                     atomic_token_account_close=excluded.atomic_token_account_close,
   468	                     reused_existing_output_token_account=excluded.reused_existing_output_token_account,
   469	                     details_json=excluded.details_json,updated_at=excluded.updated_at""",
   470	                (
   471	                    signature, now, str(executor.telegram_id), str(getattr(executor, "wallet_id", "")),
   472	                    str(executor.address), _action(input_mint, output_mint), str(source), str(input_mint), str(output_mint),
   473	                    str(raw_in), str(raw_out), str(trade_value), str(network_fee), str(base_fee), str(priority_fee),
   474	                    str(jito_tip), str(quoted_priority_tip), str(fee_bps or ""), str(fee_amount or ""), str(fee_mint),
   475	                    str(rent_paid), str(rent_reclaimed), wallet_delta_text,
   476	                    None if net_execution_pnl_lamports is None else str(int(net_execution_pnl_lamports)),
   477	                    str(_i(order.get("slippageBps"), 0)), str(price_impact), int(hops),
   478	                    1 if atomic_close else 0, 1 if reused_output_account else 0, str(order.get("router") or source),
   479	                    json.dumps(details, separators=(",", ":"), default=str), now,
   480	                ),
   481	            )
   482	            conn.commit()
   483	    except Exception as exc:
   484	        print("[solana-exec-receipt]", type(exc).__name__, str(exc)[:300])
   485	        return None
   486	    return signature
   487	
   488	
   489	def _receipt_row(app, signature: str):
   490	    try:
   491	        with closing(_sol.connect(app)) as conn:
   492	            _ensure(conn)
   493	            row = conn.execute("SELECT * FROM live_execution_receipts WHERE signature=?", (str(signature),)).fetchone()
   494	            return dict(row) if row else None
   495	    except Exception:
   496	        return None
   497	
   498	
   499	def _update_receipt_pnl(app, signature: str, net_sol) -> None:
   500	    if not signature:
   501	        return
   502	    lamports = int((_d(net_sol, 0) * LAMPORTS_PER_SOL).to_integral_value())
   503	    try:
   504	        with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   505	            _ensure(conn)
   506	            conn.execute(
   507	                "UPDATE live_execution_receipts SET net_execution_pnl_lamports=?,updated_at=? WHERE signature=?",
   508	                (str(lamports), int(time.time()), str(signature)),
   509	            )
   510	            conn.commit()
   511	    except Exception:
   512	        pass
   513	
   514	
   515	def _notify_receipt(app, tid: str, signature: str):
   516	    row = _receipt_row(app, signature)
   517	    if not row:
   518	        return
   519	    def sol(key):
   520	        return _d(row.get(key), 0) / LAMPORTS_PER_SOL
   521	    pnl_raw = row.get("net_execution_pnl_lamports")
   522	    pnl_line = "Net execution P&L: <b>pending position close</b>" if pnl_raw in (None, "") else f"Net execution P&L: <b>{sol('net_execution_pnl_lamports'):+.9f} SOL</b>"
   523	    platform = str(row.get("platform_fee_amount") or "0")
   524	    platform_mint = str(row.get("platform_fee_mint") or "")
   525	    _live._notify(
   526	        app,
   527	        tid,
   528	        "🧾 <b>Solana execution receipt</b>\n"
   529	        f"Action: <b>{row.get('action')}</b> • {'ATOMIC CLOSE' if int(row.get('atomic_token_account_close') or 0) else row.get('source')}\n"
   530	        f"Raw swap: <code>{row.get('raw_input_amount')}</code> → <code>{row.get('raw_output_amount')}</code>\n"
   531	        f"Network fee: <b>{sol('network_fee_lamports'):.9f} SOL</b>\n"
   532	        f"• Base: {sol('base_fee_lamports'):.9f} SOL\n"
   533	        f"• Priority: {sol('priority_fee_lamports'):.9f} SOL\n"
   534	        f"• Explicit Jito tip: {sol('jito_tip_lamports'):.9f} SOL\n"
   535	        f"Router/platform fee: <code>{platform}</code>{(' ' + platform_mint[:8] + '…') if platform_mint else ''}\n"
   536	        f"Rent paid: {sol('rent_paid_lamports'):.9f} SOL • reclaimed: {sol('rent_reclaimed_lamports'):.9f} SOL\n"
   537	        f"Impact/slippage: {row.get('price_impact_bps')} / {row.get('slippage_bps')} bps\n"
   538	        f"{pnl_line}\n"
   539	        f"TX: <code>{signature}</code>",
   540	    )
