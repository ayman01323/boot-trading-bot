  1239	def performance(app, telegram_id) -> dict:
  1240	    chains = {c.chain_id: c for c in load_chains(app, enabled_only=False)}
  1241	    by_chain = defaultdict(lambda: {"realised": Decimal(0), "fees": Decimal(0), "unrealised": Decimal(0), "live_trades": 0, "shadow_trades": 0})
  1242	    with closing(connect(app)) as conn:
  1243	        rows = conn.execute("SELECT * FROM positions WHERE telegram_id=?", (str(telegram_id),)).fetchall()
  1244	    for r in rows:
  1245	        a = by_chain[int(r["chain_id"])]
  1246	        if str(r["mode"]).upper() == "LIVE":
  1247	            a["realised"] += _dec(r["realised_user_net_native"], 0); a["fees"] += _dec(r["profit_fee_native"], 0)
  1248	            if r["status"] == "CLOSED": a["live_trades"] += 1
  1249	            if r["status"] == "OPEN": a["unrealised"] += _dec(r["unrealised_net_native"], 0)
  1250	        else:
  1251	            if r["status"] == "CLOSED": a["shadow_trades"] += 1
  1252	    return {"by_chain": {cid: {**v, "chain_slug": chains[cid].slug if cid in chains else str(cid), "native_symbol": chains[cid].native_symbol if cid in chains else "NATIVE"} for cid, v in by_chain.items()}}
