  1288	def start_workers(app):
  1289	    global _WORKERS_STARTED
  1290	    with _WORKER_LOCK:
  1291	        if _WORKERS_STARTED:
  1292	            return
  1293	        _WORKERS_STARTED = True
  1294	    ensure_settings(app); connect(app).close()
  1295	    threading.Thread(target=_history_worker, args=(app,), daemon=True, name="sibot-history").start()
  1296	    threading.Thread(target=_live_worker, args=(app,), daemon=True, name="sibot-live").start()
  1297	    print("[sibot] SiBot/SiMo research, leader monitor and position monitor started")
