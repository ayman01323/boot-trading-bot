    48	def auto_state(csv_dir: Path, telegram_id=None) -> dict:
    49	    rows=_rows(Path(csv_dir)/"auto"/"auto_trade_execution.csv");now=int(time.time())
    50	    if telegram_id is not None: rows=[r for r in rows if str(r.get("telegram_id","")).strip()==str(telegram_id)]
    51	    recent=[r for r in rows if now-int(float(r.get("timestamp_epoch") or 0))<=3600]
    52	    broadcasts=[r for r in recent if r.get("status") in {"BROADCAST","SUCCESS","SUCCESS_FEE_PENDING","FAILED","FEE_PENDING"}]
    53	    gas=sum(_dec(r.get("expected_gas_base"),0) for r in broadcasts);last_ts=max([int(float(r.get("timestamp_epoch") or 0)) for r in rows] or [0])
    54	    return {"hour_trades":len(broadcasts),"hour_expected_gas":gas,"last_ts":last_ts,"recent":rows[-10:]}
