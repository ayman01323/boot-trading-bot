    12	_PREV_ORDER = _eff.order_with_economic_caps
    13	
    14	
    15	def _response_error_text(response) -> str:
    16	    """Return Jupiter's useful error body without echoing the full request URL."""
    17	    if response is None:
    18	        return "no response body"
    19	    try:
    20	        payload = response.json()
    21	    except Exception:
    22	        payload = None
    23	    if isinstance(payload, dict):
    24	        useful = {
    25	            key: payload.get(key)
    26	            for key in ("requestId", "error", "errorCode", "errorMessage", "message")
    27	            if payload.get(key) not in (None, "")
    28	        }
    29	        if useful:
    30	            return json.dumps(useful, separators=(",", ":"), default=str)[:900]
    31	    try:
    32	        text = str(response.text or "").strip()
    33	    except Exception:
    34	        text = ""
    35	    return (text or "empty response body")[:900]
    36	
    37	
    38	def _get_json(executor, params: dict, *, context: str) -> dict:
    39	    response = requests.get(
    40	        f"{_exec.JUPITER_BASE}/order",
    41	        params=params,
    42	        headers=_eff._headers(executor),
    43	        timeout=30,
    44	    )
    45	    # Real requests.Response objects always expose status_code.  Defaulting to 200
    46	    # keeps compatibility with the repository's older lightweight response mocks,
    47	    # which only implement json()/raise_for_status().
    48	    status = int(getattr(response, "status_code", 200) or 200)
    49	    if status >= 400:
    50	        raise _exec.SolanaLiveError(
    51	            f"Jupiter {context} HTTP {status}: {_response_error_text(response)}"
    52	        )
    53	    try:
    54	        data = response.json()
    55	    except Exception as exc:
    56	        raise _exec.SolanaLiveError(
    57	            f"Jupiter {context} returned invalid JSON (HTTP {status})"
    58	        ) from exc
    59	    return dict(data or {})
    60	
    61	
    62	def request_quote_with_error_body(executor, input_mint: str, output_mint: str, amount_raw: int, slippage_bps: int) -> dict:
    63	    params = {
    64	        "inputMint": str(input_mint),
    65	        "outputMint": str(output_mint),
    66	        "amount": str(int(amount_raw)),
    67	        "slippageBps": str(int(slippage_bps)),
    68	        # Keep the audited single-wallet-signer route universe.  Do not silently
    69	        # widen emergency exits to JupiterZ/RFQ, which can require another signer.
    70	        "excludeRouters": "jupiterz",
    71	    }
    72	    data = _get_json(executor, params, context="quote")
    73	    if data.get("errorCode") or _eff._i(data.get("outAmount") or data.get("outputAmount"), 0) <= 0:
    74	        raise _exec.SolanaLiveError(
    75	            "Jupiter quote failed: "
    76	            + str(data.get("errorMessage") or data.get("error") or data.get("errorCode") or "no positive output")
    77	        )
    78	    return data
    79	
    80	
    81	def order_with_http400_recovery(self, input_mint: str, output_mint: str, amount_raw: int) -> dict:
    82	    """Build the same economically capped order, but recover safely from bad manual fee requests.
    83	
    84	    Jupiter documents ``broadcastFeeType`` as relevant only when a priority fee or
    85	    Jito tip is supplied.  The previous code sent ``broadcastFeeType=maxCap`` even
    86	    when the dynamic fee budget left no priority/tip allowance.  This replacement
    87	    omits that orphan parameter, preserves the configured slippage and RFQ exclusion,
    88	    and retries one HTTP-400 order once without manual fee overrides.  The returned
    89	    order still passes the existing fee/impact/rent validation before it can be signed.
    90	    """
    91	    if int(amount_raw) <= 0:
    92	        raise _exec.SolanaLiveError("Swap amount must be positive")
    93	
    94	    cfg = _eff._cfg(self.app)
    95	    slippage_bps = max(1, min(10_000, _eff._i(cfg.get("live_order_slippage_bps"), 50)))
    96	
    97	    quote = None
    98	    if str(output_mint) == str(_sol.WSOL_MINT) and str(input_mint) != str(_sol.WSOL_MINT):
    99	        quote = request_quote_with_error_body(self, input_mint, output_mint, amount_raw, slippage_bps)
   100	
   101	    trade_value = _eff._trade_value_for_order(input_mint, output_mint, amount_raw, quote)
   102	    if trade_value <= 0:
   103	        raise _exec.SolanaLiveError("Cannot establish SOL trade value for economic fee cap")
   104	    fee_cap = _eff.dynamic_fee_cap_lamports(cfg, trade_value)
   105	
   106	    platform_hint = _eff._platform_fee_equivalent(quote or {}, trade_value)
   107	    explicit_jito = 0
   108	    if _eff._bool(cfg.get("live_enable_jito_tip"), False):
   109	        explicit_jito = min(
   110	            max(0, _eff._i(cfg.get("live_max_jito_tip_lamports"), 1000)),
   111	            max(0, fee_cap - _eff.DEFAULT_BASE_FEE_LAMPORTS - platform_hint),
   112	        )
   113	        if explicit_jito < 1000:
   114	            explicit_jito = 0
   115	
   116	    priority_cap = max(
   117	        0,
   118	        fee_cap - _eff.DEFAULT_BASE_FEE_LAMPORTS - platform_hint - explicit_jito,
   119	    )
   120	
   121	    base_params = {
   122	        "inputMint": str(input_mint),
   123	        "outputMint": str(output_mint),
   124	        "amount": str(int(amount_raw)),
   125	        "taker": self.address,
   126	        "excludeRouters": "jupiterz",
   127	        "slippageBps": str(slippage_bps),
   128	    }
   129	    params = dict(base_params)
   130	    if priority_cap > 0:
   131	        params["priorityFeeLamports"] = str(int(priority_cap))
   132	    if explicit_jito >= 1000:
   133	        params["jitoTipLamports"] = str(int(explicit_jito))
   134	    # Only send a fee-cap strategy when there is an actual manual fee/tip value.
   135	    if "priorityFeeLamports" in params or "jitoTipLamports" in params:
   136	        params["broadcastFeeType"] = "maxCap"
   137	
   138	    try:
   139	        order = _get_json(self, params, context="order")
   140	        recovered = False
   141	        first_error = ""
   142	    except _exec.SolanaLiveError as exc:
   143	        # Only retry the class of request this patch can safely simplify: a Jupiter
   144	        # HTTP 400 from an order carrying manual fee controls.  No slippage widening,
   145	        # RFQ enabling, amount change, or duplicate broadcast occurs here.
   146	        if "HTTP 400:" not in str(exc) or params == base_params:
   147	            raise
   148	        first_error = str(exc)
   149	        order = _get_json(self, base_params, context="order safe-retry")
   150	        recovered = True
   151	
   152	    order = _eff._validate_order(
   153	        self,
   154	        order,
   155	        input_mint,
   156	        output_mint,
   157	        amount_raw,
   158	        trade_value,
   159	        fee_cap,
   160	        cfg,
   161	    )
   162	    order["_requested_priority_fee_cap_lamports"] = int(priority_cap if not recovered else 0)
   163	    order["_requested_jito_tip_lamports"] = int(explicit_jito if not recovered else 0)
   164	    order["_jupiter_http400_safe_retry"] = bool(recovered)
   165	    if recovered:
   166	        order["_jupiter_first_order_error"] = first_error[:900]
   167	    return order
   168	
