   208	def load_dex_registry(csv_dir:Path,chain_id:int):
   209	    out=[]
   210	    for row in _rows(csv_dir/"dex_registry.csv"):
   211	        if not _bool(row.get("enabled"),False): continue
   212	        if (row.get("chain_id") or "").strip()!=str(chain_id): continue
   213	        out.append(row)
