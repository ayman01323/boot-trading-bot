   126	class LiveTrader:
   127	    """Local signer for explicit Telegram trades.
   128	
   129	    v2.2.1 keeps signing separate from historical copy-after-mining behaviour and scopes signing wallets by Telegram owner.
   130	    The private key is read only from LIVE_WALLET_PRIVATE_KEY in the server environment.
   131	    It is never read from Telegram or written to CSV/logs.
   132	    """
   133	
   134	    def __init__(self, app: AppSettings, chain_slug: str, *, telegram_id=None, wallet_id=None, private_key=None, require_wallet=True, router_override=None):
   135	        self.app = app
   136	        self.telegram_id = None if telegram_id is None else str(telegram_id)
   137	        self.wallet_id = wallet_id
   138	        self.chain = next((c for c in load_chains(app, enabled_only=False) if c.slug == chain_slug.lower()), None)
   139	        if not self.chain:
   140	            raise LiveTradingError(f"Unknown chain: {chain_slug}")
   141	        if not self.chain.enabled:
   142	            raise LiveTradingError(f"Chain is disabled in CSVbot/chains.csv: {self.chain.name}")
   143	        if self.chain.chain_id not in V2_ROUTERS:
   144	            raise LiveTradingError(f"Live V2 execution is not configured for {self.chain.name}")
   145	        if not self.chain.rpc_urls:
   146	            raise LiveTradingError(f"No enabled RPC endpoint for {self.chain.name}")
   147	        self.settings = load_kv_scoped(app.csv_dir / "live_trading_settings.csv", self.chain.chain_id)
   148	        if self.telegram_id is not None:
   149	            # Per-user settings override platform defaults without modifying other users.
   150	            for _k in ["manual_buy_enabled","manual_sell_enabled","require_confirm_word","max_native_input_per_trade","slippage_bps","deadline_seconds","gas_limit_multiplier","gas_bid_multiplier","min_native_gas_reserve"]:
   151	                _v = user_setting(app.csv_dir, self.telegram_id, self.chain.chain_id, _k, None)
   152	                if _v is not None:
   153	                    self.settings[_k] = str(_v)
   154	        self.w3 = Web3(
   155	            Web3.HTTPProvider(
   156	                self.chain.rpc_urls[0],
   157	                request_kwargs={"timeout": 20},
   158	            )
   159	        )
   160	
   161	        if self.chain.chain_id in {56, 137}:
   162	            self.w3.middleware_onion.inject(ExtraDataToPOAMiddleware, layer=0)
   163	
   164	        if not self.w3.is_connected():
   165	            raise LiveTradingError(f"Cannot connect to {self.chain.name} RPC")
   166	        rpc_chain = int(self.w3.eth.chain_id)
   167	        if rpc_chain != self.chain.chain_id:
   168	            raise LiveTradingError(f"RPC chain mismatch: expected {self.chain.chain_id}, got {rpc_chain}")
   169	        self.account = None
   170	        self.address = None
   171	        if private_key is not None:
   172	            key = str(private_key).strip()
   173	        elif self.telegram_id is not None:
   174	            try:
   175	                key = MultiWalletStore(app.data_dir, app.csv_dir).private_key_hex(self.telegram_id, self.wallet_id)
   176	                self.wallet_id = MultiWalletStore(app.data_dir, app.csv_dir).get_meta(self.telegram_id, self.wallet_id)["wallet_id"]
   177	            except Exception as exc:
   178	                if require_wallet:
   179	                    raise LiveTradingError("No valid wallet is configured for this Telegram user") from exc
   180	                key = None
   181	        else:
   182	            try:
   183	                key = live_wallet_key(app)
   184	            except Exception as exc:
   185	                if require_wallet:
   186	                    raise LiveTradingError("No valid live wallet is configured on the server") from exc
   187	                key = None
   188	        if key:
   189	            try:
   190	                self.account = self.w3.eth.account.from_key(key)
   191	                self.address = Web3.to_checksum_address(self.account.address)
   192	            except Exception as exc:
   193	                raise LiveTradingError("Configured wallet private key is invalid") from exc
   194	        configured_router = (self.settings.get("router_address") or "").strip()
   195	        if router_override:
   196	            override = Web3.to_checksum_address(router_override)
   197	            allowed = {
   198	                (r.get("router") or "").strip().lower()
   199	                for r in load_dex_registry(app.csv_dir, self.chain.chain_id)
   200	                if (r.get("version") or "").strip().upper() == "V2"
   201	            }
   202	            if override.lower() not in allowed:
   203	                raise LiveTradingError("Router override is not an enabled V2 venue in CSVbot/dex_registry.csv")
   204	            self.router_address = override
   205	        else:
   206	            self.router_address = Web3.to_checksum_address(configured_router or V2_ROUTERS[self.chain.chain_id])
   207	        if not self.w3.eth.get_code(self.router_address):
   208	            raise LiveTradingError(f"V2 router has no contract code: {self.router_address}")
   209	        self.router = self.w3.eth.contract(address=self.router_address, abi=V2_ROUTER_ABI)
   210	        self.wrapped = Web3.to_checksum_address(self.chain.wrapped_base_address)
   211	
   212	    def _require_enabled(self, side: str):
   213	        if not _bool(self.settings.get("trading_enabled"), False):
   214	            raise LiveTradingError("Platform LIVE trading gate is OFF. MASTER must enable it.")
   215	        if self.telegram_id is not None:
   216	            from .user_registry import user_bool
   217	            if not user_bool(self.app.csv_dir, self.telegram_id, self.chain.chain_id, "live_trading_enabled", False):
   218	                raise LiveTradingError("Your LIVE trading switch is OFF. Use /live on CONFIRM.")
   219	        if side == "BUY" and not _bool(self.settings.get("manual_buy_enabled"), True):
   220	            raise LiveTradingError("Manual BUY is disabled in live_trading_settings.csv")
   221	        if side == "SELL" and not _bool(self.settings.get("manual_sell_enabled"), True):
   222	            raise LiveTradingError("Manual SELL is disabled in live_trading_settings.csv")
   223	
   224	    def _confirm(self, confirm: str):
   225	        if _bool(self.settings.get("require_confirm_word"), True) and str(confirm).strip().upper() != "CONFIRM":
   226	            raise LiveTradingError("Add CONFIRM at the end of the Telegram command")
   227	
   228	    def _token(self, address: str):
   229	        try:
   230	            a = Web3.to_checksum_address(address)
   231	        except Exception as exc:
   232	            raise LiveTradingError("Token must be a valid 0x contract address") from exc
   233	        if a == self.wrapped:
   234	            raise LiveTradingError("Use a token other than the wrapped native asset")
   235	        code = self.w3.eth.get_code(a)
   236	        if not code:
   237	            raise LiveTradingError("Token address has no contract code on this chain")
   238	        c = self.w3.eth.contract(address=a, abi=ERC20_ABI)
   239	        try:
   240	            dec = int(c.functions.decimals().call())
   241	        except Exception:
   242	            dec = 18
   243	        try:
   244	            sym = str(c.functions.symbol().call())[:24]
   245	        except Exception:
   246	            sym = a[:10]
   247	        return a, c, dec, sym
   248	
   249	    def _slippage_bps(self) -> int:
   250	        try:
   251	            bps = int(float(self.settings.get("slippage_bps", "500")))
   252	        except Exception:
   253	            bps = 500
   254	        if not (1 <= bps <= 5000):
   255	            raise LiveTradingError("slippage_bps must be between 1 and 5000")
   256	        return bps
   257	
   258	    def _deadline(self):
   259	        try:
   260	            seconds = int(self.settings.get("deadline_seconds", "120"))
   261	        except Exception:
   262	            seconds = 120
   263	        seconds = max(30, min(900, seconds))
   264	        return int(time.time()) + seconds
   265	
   266	    def _gas_bid_multiplier(self) -> float:
   267	        """Multiplier applied to the fee *price*, not the gas limit.
   268	
   269	        A value above 1.0 increases the priority fee on EIP-1559 style chains and
   270	        the gasPrice on legacy-style fee markets.  It is deliberately bounded so
   271	        a CSV/user typo cannot create an unbounded fee bid.
   272	        """
   273	        try:
   274	            mult = float(self.settings.get("gas_bid_multiplier", "1.25"))
   275	        except Exception:
   276	            mult = 1.25
   277	        if not (1.0 <= mult <= 3.0):
   278	            raise LiveTradingError("gas_bid_multiplier must be between 1.0 and 3.0")
   279	        return mult
   280	
   281	    def _fee_fields(self, tx: dict) -> dict:
   282	        latest = self.w3.eth.get_block("latest")
   283	        base_fee = latest.get("baseFeePerGas")
   284	        bid_mult = self._gas_bid_multiplier()
   285	        if base_fee is not None:
   286	            try:
   287	                suggested_priority = int(self.w3.eth.max_priority_fee)
   288	            except Exception:
   289	                suggested_priority = max(1_000_000_000, int(base_fee) // 20)
   290	            priority = max(1, int(suggested_priority * bid_mult))
   291	            tx["maxPriorityFeePerGas"] = priority
   292	            # Keep a 2x base-fee headroom while bidding the boosted priority fee.
   293	            # simulate_cycle() uses these same fee fields in its gas/profit gate.
   294	            tx["maxFeePerGas"] = int(base_fee) * 2 + priority
   295	        else:
   296	            tx["gasPrice"] = max(1, int(int(self.w3.eth.gas_price) * bid_mult))
   297	        return tx
   298	
   299	    def _base_tx(self, value=0):
   300	        if not self.address or self.account is None:
   301	            raise LiveTradingError("This operation requires a signing wallet")
   302	        tx = {
   303	            "from": self.address,
   304	            "nonce": self.w3.eth.get_transaction_count(self.address, "pending"),
   305	            "chainId": self.chain.chain_id,
   306	            "value": int(value),
   307	        }
   308	        return self._fee_fields(tx)
   309	
   310	    def _sign_send(self, tx: dict) -> str:
   311	        if self.account is None:
   312	            raise LiveTradingError("This operation requires a signing wallet")
   313	        signed = self.account.sign_transaction(tx)
   314	        raw = getattr(signed, "raw_transaction", None) or getattr(signed, "rawTransaction", None)
   315	        txh = self.w3.eth.send_raw_transaction(raw)
   316	        return txh.hex()
   317	
   318	    def _with_gas(self, fn, tx: dict):
   319	        try:
   320	            gas = int(fn.estimate_gas(tx))
   321	        except Exception as exc:
   322	            raise LiveTradingError(f"Transaction simulation/gas estimate failed: {exc}") from exc
   323	        try:
   324	            mult = float(self.settings.get("gas_limit_multiplier", "1.20"))
   325	        except Exception:
   326	            mult = 1.20
   327	        tx["gas"] = max(80_000, int(gas * max(1.0, min(2.0, mult))))
   328	        return tx
   329	
   330	    def native_balance(self) -> Decimal:
   331	        return Decimal(self.w3.eth.get_balance(self.address)) / Decimal(10**18)
   332	
   333	    def token_balance(self, token: str):
   334	        a, c, dec, sym = self._token(token)
   335	        raw = int(c.functions.balanceOf(self.address).call())
   336	        return a, c, dec, sym, raw, Decimal(raw) / Decimal(10**dec)
   337	
   338	    def status(self) -> dict:
   339	        return {
   340	            "chain": self.chain.slug,
   341	            "name": self.chain.name,
   342	            "wallet": self.address,
   343	            "native_symbol": self.chain.native_symbol,
   344	            "native_balance": self.native_balance(),
   345	            "router": self.router_address,
   346	            "enabled": _bool(self.settings.get("trading_enabled"), False),
   347	            "slippage_bps": self._slippage_bps(),
   348	            "gas_bid_multiplier": self._gas_bid_multiplier(),
   349	        }
   350	
   351	    def quote_buy(self, token: str, amount_native) -> Quote:
   352	        amount = _dec(amount_native, "Buy amount")
   353	        token_a, _, dec, sym = self._token(token)
   354	        amount_wei = int(amount * Decimal(10**18))
   355	        try:
   356	            amounts = self.router.functions.getAmountsOut(amount_wei, [self.wrapped, token_a]).call()
   357	        except Exception as exc:
   358	            raise LiveTradingError("No direct PancakeSwap V2 route/quote from wrapped native asset to this token") from exc
   359	        expected = int(amounts[-1]); bps = self._slippage_bps(); minimum = expected * (10_000 - bps) // 10_000
   360	        return Quote(self.chain.slug,"BUY",token_a,sym,dec,f"{amount:f}",f"{Decimal(expected)/Decimal(10**dec):f}",f"{Decimal(minimum)/Decimal(10**dec):f}",bps,self.router_address)
   361	
   362	    def quote_sell(self, token: str, amount_spec: str) -> tuple[Quote,int]:
   363	        token_a, c, dec, sym, balance_raw, balance = self.token_balance(token)
   364	        spec = str(amount_spec).strip()
   365	        if spec.endswith("%"):
   366	            try: pct = Decimal(spec[:-1])
   367	            except Exception as exc: raise LiveTradingError("Sell percentage must look like 25%, 50% or 100%") from exc
   368	            if not (pct > 0 and pct <= 100): raise LiveTradingError("Sell percentage must be above 0 and at most 100%")
   369	            amount_raw = int(Decimal(balance_raw) * pct / Decimal(100))
   370	            amount_human = Decimal(amount_raw) / Decimal(10**dec)
   371	        else:
   372	            amount_human = _dec(spec, "Sell amount")
   373	            amount_raw = int(amount_human * Decimal(10**dec))
   374	        if amount_raw <= 0 or amount_raw > balance_raw:
   375	            raise LiveTradingError(f"Insufficient {sym} balance; wallet has {balance:f}")
   376	        try:
   377	            amounts = self.router.functions.getAmountsOut(amount_raw,[token_a,self.wrapped]).call()
   378	        except Exception as exc:
   379	            raise LiveTradingError("No direct PancakeSwap V2 sell quote from this token to wrapped native asset") from exc
   380	        expected = int(amounts[-1]); bps=self._slippage_bps(); minimum=expected*(10_000-bps)//10_000
   381	        q=Quote(self.chain.slug,"SELL",token_a,sym,dec,f"{amount_human:f}",f"{Decimal(expected)/Decimal(10**18):f}",f"{Decimal(minimum)/Decimal(10**18):f}",bps,self.router_address)
   382	        return q, amount_raw
   383	
   384	    def buy(self, token: str, amount_native, confirm: str) -> dict:
   385	        self._require_enabled("BUY"); self._confirm(confirm)
   386	        q = self.quote_buy(token, amount_native)
   387	        amount = _dec(amount_native,"Buy amount")
   388	        try: max_input = Decimal(self.settings.get("max_native_input_per_trade","0.05"))
   389	        except Exception: max_input = Decimal("0.05")
   390	        if amount > max_input:
   391	            raise LiveTradingError(f"Buy exceeds max_native_input_per_trade={max_input} {self.chain.native_symbol}")
   392	        try: reserve = Decimal(self.settings.get("min_native_gas_reserve","0.005"))
   393	        except Exception: reserve=Decimal("0.005")
   394	        if self.native_balance() < amount + reserve:
   395	            raise LiveTradingError(f"Keep at least {reserve} {self.chain.native_symbol} as gas reserve")
   396	        token_a=Web3.to_checksum_address(q.token); amount_wei=int(amount*Decimal(10**18)); min_out=int(Decimal(q.minimum_out_human)*Decimal(10**q.token_decimals))
   397	        fn=self.router.functions.swapExactETHForTokensSupportingFeeOnTransferTokens(min_out,[self.wrapped,token_a],self.address,self._deadline())
   398	        tx=self._base_tx(value=amount_wei); tx=self._with_gas(fn,tx); built=fn.build_transaction(tx)
   399	        tx_hash=self._sign_send(built)
   400	        self._audit("BUY",token_a,q.token_symbol,q.amount_in_human,q.expected_out_human,q.minimum_out_human,tx_hash,"BROADCAST")
   401	        return {"tx_hash":tx_hash,"quote":q,"explorer":f"{self.chain.explorer_url}/tx/{tx_hash}"}
   402	
   403	    def _send_approval(self, token_contract, amount_raw: int, spender=None) -> str:
   404	        spender=Web3.to_checksum_address(spender or self.router_address)
   405	        fn=token_contract.functions.approve(spender,amount_raw)
   406	        tx=self._base_tx();tx=self._with_gas(fn,tx);built=fn.build_transaction(tx);txh=self._sign_send(built)
   407	        try:
   408	            receipt=self.w3.eth.wait_for_transaction_receipt(txh,timeout=120,poll_latency=2)
   409	        except Exception as exc:
   410	            raise LiveTradingError(f"Approval broadcast {txh} but confirmation timed out; check explorer before retrying") from exc
   411	        if int(receipt.status)!=1:raise LiveTradingError(f"Token approval failed: {txh}")
   412	        return txh
   413	
   414	    def _ensure_approval(self, token_contract, token_address, amount_raw: int) -> str | None:
   415	        allowance=int(token_contract.functions.allowance(self.address,self.router_address).call())
   416	        if allowance>=amount_raw:return None
   417	        # Some ERC-20s require allowance to be reset to zero before a new non-zero value.
   418	        if allowance>0:self._send_approval(token_contract,0)
   419	        return self._send_approval(token_contract,amount_raw)
   420	
   421	    def sell(self, token: str, amount_spec: str, confirm: str) -> dict:
   422	        self._require_enabled("SELL");self._confirm(confirm)
   423	        q,amount_raw=self.quote_sell(token,amount_spec)
   424	        token_a,c,dec,sym,_,_=self.token_balance(token)
   425	        approval_hash=self._ensure_approval(c,token_a,amount_raw)
   426	        min_out=int(Decimal(q.minimum_out_human)*Decimal(10**18))
   427	        fn=self.router.functions.swapExactTokensForETHSupportingFeeOnTransferTokens(amount_raw,min_out,[token_a,self.wrapped],self.address,self._deadline())
   428	        tx=self._base_tx();tx=self._with_gas(fn,tx);built=fn.build_transaction(tx);tx_hash=self._sign_send(built)
   429	        self._audit("SELL",token_a,sym,q.amount_in_human,q.expected_out_human,q.minimum_out_human,tx_hash,"BROADCAST",approval_hash or "")
   430	        return {"tx_hash":tx_hash,"approval_hash":approval_hash,"quote":q,"explorer":f"{self.chain.explorer_url}/tx/{tx_hash}"}
   431	
   432	    def wrapped_balance(self) -> Decimal:
   433	        c = self.w3.eth.contract(address=self.wrapped, abi=ERC20_ABI)
   434	        raw = int(c.functions.balanceOf(self.address).call())
   435	        return Decimal(raw) / Decimal(10**18)
   436	
   437	    def wrap_native(self, amount_native, confirm: str = "CONFIRM") -> dict:
   438	        self._confirm(confirm)
   439	        amount = _dec(amount_native, "Wrap amount")
   440	        try: reserve = Decimal(self.settings.get("min_native_gas_reserve", "0.005"))
   441	        except Exception: reserve = Decimal("0.005")
   442	        if self.native_balance() < amount + reserve:
   443	            raise LiveTradingError(f"Insufficient {self.chain.native_symbol}; keep {reserve} for gas")
   444	        c = self.w3.eth.contract(address=self.wrapped, abi=ERC20_ABI)
   445	        fn = c.functions.deposit()
   446	        tx = self._base_tx(value=int(amount * Decimal(10**18)))
   447	        tx = self._with_gas(fn, tx)
   448	        txh = self._sign_send(fn.build_transaction(tx))
   449	        return {"tx_hash": txh, "explorer": f"{self.chain.explorer_url}/tx/{txh}"}
   450	
   451	    def _auto_execution_routers(self) -> list[str]:
   452	        """Enabled bounded-approval routers. Cross-DEX/shadow venues are deliberately excluded."""
   453	        out=[self.router_address]
   454	        for r in load_dex_registry(self.app.csv_dir,self.chain.chain_id):
   455	            if not _bool(r.get("auto_execute"), (r.get("version") or "").strip().upper()=="V2"):
   456	                continue
   457	            if (r.get("version") or "").strip().upper() not in {"V2","V3"}:continue
   458	            a=(r.get("router") or "").strip()
   459	            if Web3.is_address(a):
   460	                a=Web3.to_checksum_address(a)
   461	                if a not in out:out.append(a)
   462	        return out
   463	
   464	    def approve_wrapped_cap_for(self, spender, amount_native, confirm: str = "CONFIRM") -> dict:
   465	        self._confirm(confirm);spender=Web3.to_checksum_address(spender);amount=_dec(amount_native,"Approval amount");raw=int(amount*Decimal(10**18));c=self.w3.eth.contract(address=self.wrapped,abi=ERC20_ABI)
   466	        current=int(c.functions.allowance(self.address,spender).call());txh=None
   467	        if current!=raw:
   468	            if current>0:self._send_approval(c,0,spender)
   469	            txh=self._send_approval(c,raw,spender)
   470	        return {"approval_hash":txh,"allowance":amount,"spender":spender}
   471	
   472	    def prepare_auto(self, amount_native, confirm: str = "CONFIRM") -> dict:
   473	        """Wrap capital and exact-approve every enabled LIVE V2/V3 router; never unlimited."""
   474	        self._confirm(confirm);amount=_dec(amount_native,"Auto capital");wrap_hash=None;current=self.wrapped_balance()
   475	        if current<amount:
   476	            needed=amount-current;r=self.wrap_native(needed,"CONFIRM");wrap_hash=r["tx_hash"]
   477	            try:receipt=self.w3.eth.wait_for_transaction_receipt(wrap_hash,timeout=120,poll_latency=2)
   478	            except Exception as exc:raise LiveTradingError(f"Wrap broadcast {wrap_hash} but confirmation timed out") from exc
   479	            if int(receipt.status)!=1:raise LiveTradingError(f"Wrapped-native funding failed: {wrap_hash}")
   480	        approvals=[]
   481	        for spender in self._auto_execution_routers():
   482	            approvals.append(self.approve_wrapped_cap_for(spender,amount,"CONFIRM"))
   483	        return {"wrap_hash":wrap_hash,"approval_hash":next((x.get("approval_hash") for x in approvals if x.get("approval_hash")),None),"approvals":approvals,"prepared_amount":amount,"wrapped_balance":self.wrapped_balance()}
   484	
   485	    def approve_wrapped_cap(self, amount_native, confirm: str = "CONFIRM") -> dict:
   486	        return self.approve_wrapped_cap_for(self.router_address,amount_native,confirm)
   487	
   488	    def cycle_quote(self, path: list[str], amount_native) -> dict:
   489	        amount = _dec(amount_native, "Cycle input")
   490	        if len(path) < 3 or len(path) > 8:
   491	            raise LiveTradingError("Cycle path must contain 3 to 8 addresses including wrapped-native start/end")
   492	        try:
   493	            pp = [Web3.to_checksum_address(x) for x in path]
   494	        except Exception as exc:
   495	            raise LiveTradingError("Cycle path contains an invalid address") from exc
   496	        if pp[0] != self.wrapped or pp[-1] != self.wrapped:
   497	            raise LiveTradingError("Cycle path must start and end with the wrapped native token")
   498	        amount_raw = int(amount * Decimal(10**18))
   499	        try:
   500	            amounts = self.router.functions.getAmountsOut(amount_raw, pp).call()
   501	        except Exception as exc:
   502	            raise LiveTradingError("Exact V2 route quote failed; one or more pools may not exist") from exc
   503	        out_raw = int(amounts[-1])
   504	        return {
   505	            "path": pp, "amount_in_raw": amount_raw, "amount_out_raw": out_raw,
   506	            "amount_in": amount, "amount_out": Decimal(out_raw) / Decimal(10**18),
   507	            "gross_profit": Decimal(out_raw - amount_raw) / Decimal(10**18),
   508	        }
   509	
   510	    def simulate_cycle(self, path: list[str], amount_native, min_net_profit_native) -> dict:
   511	        q = self.cycle_quote(path, amount_native)
   512	        min_profit = Decimal(str(min_net_profit_native))
   513	        if min_profit < 0:
   514	            raise LiveTradingError("Minimum net profit cannot be negative")
   515	        wrapped_c = self.w3.eth.contract(address=self.wrapped, abi=ERC20_ABI)
   516	        bal = int(wrapped_c.functions.balanceOf(self.address).call())
   517	        allowance = int(wrapped_c.functions.allowance(self.address, self.router_address).call())
   518	        prepared = bal >= q["amount_in_raw"] and allowance >= q["amount_in_raw"]
   519	        if not prepared:
   520	            return {**q, "prepared": False, "simulation_ok": False, "gas": 0, "gas_cost_base": Decimal(0), "min_out_raw": 0, "reason": "wallet needs WBNB/WETH capital and router allowance; use /autoprep"}
   521	        fn0 = self.router.functions.swapExactTokensForTokensSupportingFeeOnTransferTokens(
   522	            q["amount_in_raw"], q["amount_in_raw"], q["path"], self.address, self._deadline()
   523	        )
   524	        tx0 = self._base_tx()
   525	        try:
   526	            gas0 = int(fn0.estimate_gas(tx0))
   527	        except Exception as exc:
   528	            return {**q, "prepared": True, "simulation_ok": False, "gas": 0, "gas_cost_base": Decimal(0), "min_out_raw": 0, "reason": f"route simulation failed: {exc}"}
   529	        fee_per_gas = int(tx0.get("maxFeePerGas") or tx0.get("gasPrice") or self.w3.eth.gas_price)
   530	        # Reserve 30% above estimated gas at maxFeePerGas/gasPrice. This reserve is
   531	        # part of the output floor, so a route cannot deliberately execute unless
   532	        # it repays capital + conservative gas reserve + configured minimum net.
   533	        reserve_gas_units = int(gas0 * 1.30)
   534	        gas_cost = Decimal(reserve_gas_units) * Decimal(fee_per_gas) / Decimal(10**18)
   535	        min_out = q["amount_in_raw"] + int((gas_cost + min_profit) * Decimal(10**18))
   536	        if q["amount_out_raw"] <= min_out:
   537	            return {**q, "prepared": True, "simulation_ok": False, "gas": gas0, "gas_cost_base": gas_cost, "min_out_raw": min_out, "reason": "quoted gross edge does not cover conservative gas reserve plus minimum net profit"}
   538	        fn = self.router.functions.swapExactTokensForTokensSupportingFeeOnTransferTokens(
   539	            q["amount_in_raw"], min_out, q["path"], self.address, self._deadline()
   540	        )
   541	        try:
   542	            gas = int(fn.estimate_gas(self._base_tx()))
   543	        except Exception as exc:
   544	            return {**q, "prepared": True, "simulation_ok": False, "gas": gas0, "gas_cost_base": gas_cost, "min_out_raw": min_out, "reason": f"profit-protected simulation failed: {exc}"}
   545	        if gas > gas0:
   546	            reserve_gas_units = int(gas * 1.30)
   547	            gas_cost = Decimal(reserve_gas_units) * Decimal(fee_per_gas) / Decimal(10**18)
   548	            min_out = q["amount_in_raw"] + int((gas_cost + min_profit) * Decimal(10**18))
   549	            if q["amount_out_raw"] <= min_out:
   550	                return {**q, "prepared": True, "simulation_ok": False, "gas": gas, "gas_cost_base": gas_cost, "min_out_raw": min_out, "reason": "re-estimated gas reserve removes the net-profit edge"}
   551	            fn = self.router.functions.swapExactTokensForTokensSupportingFeeOnTransferTokens(
   552	                q["amount_in_raw"], min_out, q["path"], self.address, self._deadline()
   553	            )
   554	            try:
   555	                gas = int(fn.estimate_gas(self._base_tx()))
   556	            except Exception as exc:
   557	                return {**q, "prepared": True, "simulation_ok": False, "gas": gas, "gas_cost_base": gas_cost, "min_out_raw": min_out, "reason": f"final profit-protected simulation failed: {exc}"}
   558	        return {**q, "prepared": True, "simulation_ok": True, "gas": gas, "gas_cost_base": gas_cost, "min_out_raw": min_out, "reason": "PASS"}
   559	
   560	    def _prebroadcast_cycle(self, path: list[str], amount_native, min_net_profit_native) -> tuple[dict, dict]:
   561	        """Build and locally execute the exact transaction immediately before signing.
   562	
   563	        This is a mandatory fail-closed gate for AUTO cycles.  It deliberately repeats
   564	        the wallet-specific quote/gas simulation, then executes the *exact built
   565	        transaction* through eth_call.  eth_call does not broadcast or change chain
   566	        state.  Any revert/RPC simulation failure prevents signing.
   567	        """
   568	        sim = self.simulate_cycle(path, amount_native, min_net_profit_native)
   569	        if not sim.get("simulation_ok"):
   570	            raise LiveTradingError(sim.get("reason") or "Cycle simulation failed")
   571	
   572	        fn = self.router.functions.swapExactTokensForTokensSupportingFeeOnTransferTokens(
   573	            sim["amount_in_raw"], sim["min_out_raw"], sim["path"], self.address, self._deadline()
   574	        )
   575	        tx = self._base_tx()
   576	        tx["gas"] = max(100000, int(sim["gas"] * 1.15))
   577	        built = fn.build_transaction(tx)
   578	
   579	        # RPC eth_call transaction objects do not need signing metadata.  Keep only
   580	        # fields relevant to EVM execution for widest node compatibility.
   581	        call_keys = {
   582	            "from", "to", "gas", "gasPrice", "maxFeePerGas",
   583	            "maxPriorityFeePerGas", "value", "data", "accessList", "type"
   584	        }
   585	        call_tx = {k: v for k, v in built.items() if k in call_keys}
   586	        try:
   587	            self.w3.eth.call(call_tx)
   588	        except Exception as exc:
   589	            try:
   590	                self._audit(
   591	                    "AUTO_PREFLIGHT", ">".join(sim["path"]), "ROUTE",
   592	                    str(sim["amount_in"]), str(sim["amount_out"]),
   593	                    str(Decimal(sim["min_out_raw"]) / Decimal(10**18)),
   594	                    "", "REJECTED"
   595	                )
   596	            except Exception:
   597	                pass
   598	            raise LiveTradingError(f"Mandatory pre-broadcast eth_call simulation failed: {exc}") from exc
   599	
   600	        self._audit(
   601	            "AUTO_PREFLIGHT", ">".join(sim["path"]), "ROUTE",
   602	            str(sim["amount_in"]), str(sim["amount_out"]),
   603	            str(Decimal(sim["min_out_raw"]) / Decimal(10**18)),
   604	            "", "PASS"
   605	        )
   606	        return {**sim, "preflight_call_ok": True}, built
   607	
   608	    def preflight_cycle(self, path: list[str], amount_native, min_net_profit_native) -> dict:
   609	        """Public no-broadcast AUTO preflight using the same gate as execute_cycle."""
   610	        sim, _ = self._prebroadcast_cycle(path, amount_native, min_net_profit_native)
   611	        return sim
   612	
   613	    def execute_cycle(self, path: list[str], amount_native, min_net_profit_native, confirm: str = "CONFIRM") -> dict:
   614	        self._require_enabled("BUY")
   615	        self._confirm(confirm)
   616	
   617	        # Mandatory final simulation occurs here, immediately before _sign_send.
   618	        # The caller may already have simulated once; AUTO therefore gets both the
   619	        # selection-time simulation and this final exact-transaction preflight.
   620	        sim, built = self._prebroadcast_cycle(path, amount_native, min_net_profit_native)
   621	        txh = self._sign_send(built)
   622	        self._audit(
   623	            "AUTO_CYCLE", ">".join(sim["path"]), "ROUTE",
   624	            str(sim["amount_in"]), str(sim["amount_out"]),
   625	            str(Decimal(sim["min_out_raw"]) / Decimal(10**18)),
   626	            txh, "BROADCAST"
   627	        )
   628	        return {**sim, "tx_hash": txh, "explorer": f"{self.chain.explorer_url}/tx/{txh}"}
   629	
   630	    def _v3_venue(self, router_address, quoter_address, *, require_auto=False) -> dict:
   631	        router=Web3.to_checksum_address(router_address);quoter=Web3.to_checksum_address(quoter_address)
   632	        for r in load_dex_registry(self.app.csv_dir,self.chain.chain_id):
   633	            if (r.get("version") or "").strip().upper()!="V3":continue
   634	            if (r.get("router") or "").strip().lower()!=router.lower():continue
   635	            if (r.get("quoter") or "").strip().lower()!=quoter.lower():continue
   636	            if require_auto and not _bool(r.get("auto_execute"),False):
   637	                raise LiveTradingError("This V3 venue is scan-only; automatic signing is disabled")
   638	            return r
   639	        raise LiveTradingError("V3 router/quoter is not an enabled venue in CSVbot/dex_registry.csv")
   640	
   641	    def v3_cycle_quote(self, path: list[str], fees: list[int], amount_native, router_address, quoter_address) -> dict:
   642	        amount=_dec(amount_native,"V3 cycle input")
   643	        if len(path)<3 or len(path)>8:raise LiveTradingError("V3 cycle path must contain 3 to 8 addresses")
   644	        pp=[Web3.to_checksum_address(x) for x in path]
   645	        if pp[0]!=self.wrapped or pp[-1]!=self.wrapped:raise LiveTradingError("V3 cycle must start and end with wrapped native")
   646	        ff=[int(x) for x in fees]
   647	        if len(ff)!=len(pp)-1:raise LiveTradingError("V3 route fee count does not match hops")
   648	        self._v3_venue(router_address,quoter_address,require_auto=False)
   649	        router=Web3.to_checksum_address(router_address);quoter=Web3.to_checksum_address(quoter_address)
   650	        if not self.w3.eth.get_code(router) or not self.w3.eth.get_code(quoter):raise LiveTradingError("V3 router/quoter has no contract code")
   651	        packed=_encode_v3_path(pp,ff);raw=int(amount*Decimal(10**18));qc=self.w3.eth.contract(address=quoter,abi=V3_QUOTER_ABI)
   652	        try:res=qc.functions.quoteExactInput(packed,raw).call()
   653	        except Exception as exc:raise LiveTradingError(f"Exact V3 route quote failed: {exc}") from exc
   654	        out_raw=int(res[0] if isinstance(res,(list,tuple)) else res)
   655	        return {"path":pp,"fees":ff,"packed_path":packed,"router_address":router,"quoter_address":quoter,"amount_in_raw":raw,"amount_out_raw":out_raw,"amount_in":amount,"amount_out":Decimal(out_raw)/Decimal(10**18),"gross_profit":Decimal(out_raw-raw)/Decimal(10**18),"quoter_gas":int(res[3]) if isinstance(res,(list,tuple)) and len(res)>3 else 0}
   656	
   657	    def simulate_v3_cycle(self, path:list[str], fees:list[int], amount_native, min_net_profit_native, router_address, quoter_address) -> dict:
   658	        q=self.v3_cycle_quote(path,fees,amount_native,router_address,quoter_address);min_profit=Decimal(str(min_net_profit_native))
   659	        if min_profit<0:raise LiveTradingError("Minimum net profit cannot be negative")
   660	        router=Web3.to_checksum_address(router_address);wrapped_c=self.w3.eth.contract(address=self.wrapped,abi=ERC20_ABI);bal=int(wrapped_c.functions.balanceOf(self.address).call());allowance=int(wrapped_c.functions.allowance(self.address,router).call());prepared=bal>=q["amount_in_raw"] and allowance>=q["amount_in_raw"]
   661	        if not prepared:return {**q,"prepared":False,"simulation_ok":False,"gas":0,"gas_cost_base":Decimal(0),"min_out_raw":0,"reason":"wallet needs wrapped capital and V3 router allowance; use /autoprep again"}
   662	        rc=self.w3.eth.contract(address=router,abi=V3_ROUTER_ABI)
   663	        def fn_for(min_out):return rc.functions.exactInput((q["packed_path"],self.address,self._deadline(),q["amount_in_raw"],int(min_out)))
   664	        tx0=self._base_tx();fn0=fn_for(q["amount_in_raw"])
   665	        try:gas0=int(fn0.estimate_gas(tx0))
   666	        except Exception as exc:return {**q,"prepared":True,"simulation_ok":False,"gas":0,"gas_cost_base":Decimal(0),"min_out_raw":0,"reason":f"V3 route simulation failed: {exc}"}
   667	        fee_per_gas=int(tx0.get("maxFeePerGas") or tx0.get("gasPrice") or self.w3.eth.gas_price);reserve_units=int(gas0*1.30);gas_cost=Decimal(reserve_units)*Decimal(fee_per_gas)/Decimal(10**18);min_out=q["amount_in_raw"]+int((gas_cost+min_profit)*Decimal(10**18))
   668	        if q["amount_out_raw"]<=min_out:return {**q,"prepared":True,"simulation_ok":False,"gas":gas0,"gas_cost_base":gas_cost,"min_out_raw":min_out,"reason":"V3 quoted edge does not cover conservative gas reserve plus minimum net profit"}
   669	        fn=fn_for(min_out)
   670	        try:gas=int(fn.estimate_gas(self._base_tx()))
   671	        except Exception as exc:return {**q,"prepared":True,"simulation_ok":False,"gas":gas0,"gas_cost_base":gas_cost,"min_out_raw":min_out,"reason":f"V3 profit-protected simulation failed: {exc}"}
   672	        if gas>gas0:
   673	            reserve_units=int(gas*1.30);gas_cost=Decimal(reserve_units)*Decimal(fee_per_gas)/Decimal(10**18);min_out=q["amount_in_raw"]+int((gas_cost+min_profit)*Decimal(10**18))
   674	            if q["amount_out_raw"]<=min_out:return {**q,"prepared":True,"simulation_ok":False,"gas":gas,"gas_cost_base":gas_cost,"min_out_raw":min_out,"reason":"V3 re-estimated gas reserve removes the net-profit edge"}
   675	            fn=fn_for(min_out)
   676	            try:gas=int(fn.estimate_gas(self._base_tx()))
   677	            except Exception as exc:return {**q,"prepared":True,"simulation_ok":False,"gas":gas,"gas_cost_base":gas_cost,"min_out_raw":min_out,"reason":f"V3 final simulation failed: {exc}"}
   678	        return {**q,"prepared":True,"simulation_ok":True,"gas":gas,"gas_cost_base":gas_cost,"min_out_raw":min_out,"reason":"PASS"}
   679	
   680	    def _prebroadcast_v3_cycle(self,path,fees,amount_native,min_net_profit_native,router_address,quoter_address):
   681	        self._v3_venue(router_address,quoter_address,require_auto=True);sim=self.simulate_v3_cycle(path,fees,amount_native,min_net_profit_native,router_address,quoter_address)
   682	        if not sim.get("simulation_ok"):raise LiveTradingError(sim.get("reason") or "V3 simulation failed")
   683	        rc=self.w3.eth.contract(address=Web3.to_checksum_address(router_address),abi=V3_ROUTER_ABI);fn=rc.functions.exactInput((sim["packed_path"],self.address,self._deadline(),sim["amount_in_raw"],sim["min_out_raw"]));tx=self._base_tx();tx["gas"]=max(120000,int(sim["gas"]*1.15));built=fn.build_transaction(tx);keys={"from","to","gas","gasPrice","maxFeePerGas","maxPriorityFeePerGas","value","data","accessList","type"};call_tx={k:v for k,v in built.items() if k in keys}
   684	        try:self.w3.eth.call(call_tx)
   685	        except Exception as exc:
   686	            try:self._audit("AUTO_PREFLIGHT_V3",">".join(sim["path"]),"V3_ROUTE",str(sim["amount_in"]),str(sim["amount_out"]),str(Decimal(sim["min_out_raw"])/Decimal(10**18)),"","REJECTED")
   687	            except Exception:pass
   688	            raise LiveTradingError(f"Mandatory V3 pre-broadcast eth_call failed: {exc}") from exc
   689	        self._audit("AUTO_PREFLIGHT_V3",">".join(sim["path"]),"V3_ROUTE",str(sim["amount_in"]),str(sim["amount_out"]),str(Decimal(sim["min_out_raw"])/Decimal(10**18)),"","PASS");return {**sim,"preflight_call_ok":True},built
   690	
   691	    def execute_v3_cycle(self,path,fees,amount_native,min_net_profit_native,router_address,quoter_address,confirm="CONFIRM") -> dict:
   692	        self._require_enabled("BUY");self._confirm(confirm);sim,built=self._prebroadcast_v3_cycle(path,fees,amount_native,min_net_profit_native,router_address,quoter_address);txh=self._sign_send(built);self._audit("AUTO_CYCLE_V3",">".join(sim["path"]),"V3_ROUTE",str(sim["amount_in"]),str(sim["amount_out"]),str(Decimal(sim["min_out_raw"])/Decimal(10**18)),txh,"BROADCAST");return {**sim,"tx_hash":txh,"explorer":f"{self.chain.explorer_url}/tx/{txh}"}
   693	
   694	    def transfer_native(self, to_address: str, amount_native, confirm: str = "CONFIRM") -> dict:
   695	        self._confirm(confirm)
   696	        if not self.address:
   697	            raise LiveTradingError("No signing wallet")
   698	        try:
   699	            to = Web3.to_checksum_address(to_address)
   700	        except Exception as exc:
   701	            raise LiveTradingError("Destination must be a valid 0x address") from exc
   702	        amount = _dec(amount_native, "Transfer amount")
   703	        try: reserve = Decimal(self.settings.get("min_native_gas_reserve", "0.005"))
   704	        except Exception: reserve = Decimal("0.005")
   705	        if self.native_balance() < amount + reserve:
   706	            raise LiveTradingError(f"Insufficient {self.chain.native_symbol}; keep {reserve} for gas")
   707	        tx = self._base_tx(value=int(amount * Decimal(10**18)))
   708	        try:
   709	            gas = int(self.w3.eth.estimate_gas(tx))
   710	        except Exception:
   711	            gas = 21000
   712	        tx["gas"] = max(21000, int(gas * 1.10))
   713	        txh = self._sign_send(tx)
   714	        self._audit("TRANSFER_NATIVE", to, self.chain.native_symbol, str(amount), str(amount), str(amount), txh, "BROADCAST")
   715	        return {"tx_hash":txh,"amount":amount,"to":to,"explorer":f"{self.chain.explorer_url}/tx/{txh}"}
   716	
   717	    def transfer_token(self, token: str, to_address: str, amount_spec: str, confirm: str = "CONFIRM") -> dict:
   718	        self._confirm(confirm)
   719	        try: to = Web3.to_checksum_address(to_address)
   720	        except Exception as exc: raise LiveTradingError("Destination must be a valid 0x address") from exc
   721	        token_a,c,dec,sym,raw,bal = self.token_balance(token)
   722	        spec=str(amount_spec).strip()
   723	        if spec.endswith("%"):
   724	            try: pct=Decimal(spec[:-1])
   725	            except Exception as exc: raise LiveTradingError("Token percentage is invalid") from exc
   726	            if pct<=0 or pct>100: raise LiveTradingError("Token percentage must be >0 and <=100")
   727	            amount_raw=int(Decimal(raw)*pct/Decimal(100))
   728	        else:
   729	            amount=_dec(spec,"Token transfer amount"); amount_raw=int(amount*Decimal(10**dec))
   730	        if amount_raw<=0 or amount_raw>raw: raise LiveTradingError("Insufficient token balance")
   731	        fn=c.functions.transfer(to,amount_raw);tx=self._base_tx();tx=self._with_gas(fn,tx);txh=self._sign_send(fn.build_transaction(tx))
   732	        human=Decimal(amount_raw)/Decimal(10**dec)
   733	        self._audit("TRANSFER_TOKEN",token_a,sym,str(human),str(human),str(human),txh,"BROADCAST")
   734	        return {"tx_hash":txh,"amount":human,"symbol":sym,"to":to,"explorer":f"{self.chain.explorer_url}/tx/{txh}"}
   735	
   736	    def transfer_wrapped_raw(self, to_address: str, amount_raw: int) -> str:
   737	        if amount_raw <= 0: raise LiveTradingError("Fee amount must be positive")
   738	        to=Web3.to_checksum_address(to_address);c=self.w3.eth.contract(address=self.wrapped,abi=ERC20_ABI)
   739	        fn=c.functions.transfer(to,int(amount_raw));tx=self._base_tx();tx=self._with_gas(fn,tx);return self._sign_send(fn.build_transaction(tx))
   740	
   741	    def tx_status(self, tx_hash: str) -> dict:
   742	        try:
   743	            h=Web3.to_hex(hexstr=tx_hash)
   744	            receipt=self.w3.eth.get_transaction_receipt(h)
   745	            return {"found":True,"status":"SUCCESS" if int(receipt.status)==1 else "FAILED","block":receipt.blockNumber,"explorer":f"{self.chain.explorer_url}/tx/{tx_hash}"}
   746	        except Exception:
   747	            return {"found":False,"status":"PENDING_OR_UNKNOWN","explorer":f"{self.chain.explorer_url}/tx/{tx_hash}"}
   748	
   749	    def _audit(self, side, token, symbol, amount_in, expected_out, minimum_out, tx_hash, status, approval_hash=""):
   750	        fields=["timestamp_epoch","telegram_id","wallet_id","chain_id","chain_slug","wallet","side","token","symbol","amount_in","expected_out","minimum_out","router","tx_hash","approval_hash","status"]
   751	        _atomic_append(self.app.csv_dir/"auto"/"live_trade_audit.csv",{
   752	            "timestamp_epoch":int(time.time()),"telegram_id":self.telegram_id or "LEGACY","wallet_id":self.wallet_id or "LEGACY","chain_id":self.chain.chain_id,"chain_slug":self.chain.slug,"wallet":self.address or "","side":side,"token":token,"symbol":symbol,"amount_in":amount_in,"expected_out":expected_out,"minimum_out":minimum_out,"router":self.router_address,"tx_hash":tx_hash,"approval_hash":approval_hash,"status":status,
   753	        },fields)
   754	
