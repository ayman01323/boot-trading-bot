    94	            tests/test_telegram_multi_wallet_manager.py \
    95	            tests/test_telegram_solana_chains.py \
    96	            tests/test_telegram_solana_everywhere.py \
    97	            tests/test_live_reporting_all_chains.py \
    98	            tests/test_telegram_solana_send.py \
    99	            tests/test_telegram_usd_everywhere.py \
   100	            tests/test_telegram_order_usd.py \
   101	            tests/test_sibot_profit_guard.py \
   102	            tests/test_solana_profit_guard.py \
   103	            tests/test_sibot_evm_worker_reliability.py \
   104	            tests/test_polygon_focus.py \
   105	            tests/test_telegram_capital_readiness.py \
   106	            tests/test_solana_balanced_frequency.py \
   107	            tests/test_telegram_roles_and_command_scope.py \
   108	            tests/test_telegram_user_menu_compact.py \
   109	            tests/test_user_report_loss_alerts.py
   110	
   111	      - name: Legacy full suite when runtime CSV fixtures are present
   112	        shell: bash
   113	        run: |
   114	          set -euo pipefail
   115	          if [[ -f CSVbot/chains.csv && -f CSVbot/auto_trading_settings.csv && -f CSVbot/live_trading_settings.csv && -f CSVbot/dex_registry.csv ]]; then
   116	            pytest -x -vv
   117	          else
   118	            echo "Skipping legacy config-bound tests: runtime CSVbot fixtures are not stored in this GitHub checkout."
   119	          fi
   120	
   121	      - name: Optional Gemini connectivity check
   122	        env:
   123	          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
   124	        shell: bash
   125	        run: |
   126	          set -euo pipefail
   127	          if [ -z "${GEMINI_API_KEY:-}" ]; then
   128	            echo "Skipping Gemini call: GEMINI_API_KEY is not available in this run context."
   129	            exit 0
   130	          fi
   131	          python - <<'PY'
   132	          import os
   133	          import sys
   134	          import json
   135	          import urllib.request
   136	
   137	          api_key = os.environ.get("GEMINI_API_KEY", "").strip()
   138	          url = (
   139	              "https://generativelanguage.googleapis.com/v1beta/models/"
   140	              "gemini-3.1-pro-preview:generateContent?key=" + api_key
   141	          )
   142	          payload = {
   143	              "contents": [
   144	                  {"parts": [{"text": "Reply with exactly: BOOT_GEMINI_OK"}]}
   145	              ],
   146	              "generationConfig": {"temperature": 0}
   147	          }
   148	
   149	          data = json.dumps(payload).encode("utf-8")
   150	          req = urllib.request.Request(
   151	              url,
   152	              data=data,
   153	              headers={"Content-Type": "application/json"},
   154	              method="POST",
   155	          )
   156	
   157	          with urllib.request.urlopen(req, timeout=30) as resp:
   158	              body = json.loads(resp.read().decode("utf-8"))
   159	
   160	          try:
   161	              text = body["candidates"][0]["content"]["parts"][0]["text"].strip()
   162	          except Exception:
   163	              print("Unexpected Gemini response:")
   164	              print(json.dumps(body, indent=2))
   165	              sys.exit(2)
   166	
   167	          if text != "BOOT_GEMINI_OK":
   168	              print("Unexpected Gemini text:", repr(text))
   169	              sys.exit(2)
   170	
   171	          print("Gemini connectivity OK")
   172	          PY
   173	
   174	  deploy_current_main:
   175	    name: Deploy current main to VPS
   176	    needs: test
   177	    if: >-
   178	      github.event_name == 'pull_request' &&
   179	      github.head_ref == 'agent/deploy-current-main' &&
   180	      github.event.pull_request.head.repo.full_name == github.repository
   181	    runs-on: [self-hosted, linux, x64, boot-vps]
   182	    timeout-minutes: 20
   183	    steps:
   184	      - name: Deploy tested current main
   185	        shell: bash
   186	        env:
   187	          TARGET_SHA: ${{ github.event.pull_request.base.sha }}
   188	        run: |
   189	          set -euo pipefail
   190	          sudo /usr/local/sbin/deploy-boot-trading-bot "$TARGET_SHA"
   191	
   192	      - name: Server status
   193	        if: always()
   194	        shell: bash
   195	        run: sudo /usr/local/sbin/status-boot-trading-bot
   196	
   197	      - name: Captured learnerbot startup exception
   198	        if: always()
   199	        shell: bash
   200	        run: |
   201	          if [[ -r /tmp/learnerbot-startup-error.txt ]]; then
   202	            cat /tmp/learnerbot-startup-error.txt
   203	          else
   204	            echo "no readable /tmp/learnerbot-startup-error.txt"
   205	          fi
   206	
   207	      - name: Recent learnerbot journal after deploy attempt
   208	        if: always()
   209	        shell: bash
   210	        run: |
   211	          journalctl -u learnerbot.service --since '10 minutes ago' -n 350 --no-pager || true
   212	
   213	      - name: Deployment wrapper log tail
   214	        if: always()
   215	        shell: bash
   216	        run: |
   217	          if [[ -r /var/log/boot-github-deploy.log ]]; then
   218	            tail -n 120 /var/log/boot-github-deploy.log
   219	          else
   220	            echo "deploy log is not readable by github-runner"
   221	          fi
