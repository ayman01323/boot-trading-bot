   171	def load_scoring_weights(csv_dir:Path, chain_id=None):
   172	    defaults={"tx_count":20.0,"tx_rate":25.0,"repeat_to":20.0,"repeat_selector":20.0,"zero_value":10.0,"builder":5.0}
   173	    global_rows=[]; chain_rows=[]
   174	    for row in _rows(csv_dir/"scoring_weights.csv"):
   175	        scope=(row.get("chain_id") or "*").strip()
   176	        if scope in {"","*","0"}: global_rows.append(row)
   177	        elif chain_id is not None and scope==str(chain_id): chain_rows.append(row)
   178	    for row in global_rows+chain_rows:
   179	        f=(row.get("feature") or "").strip()
   180	        if f in defaults:
   181	            try: defaults[f]=float(row.get("weight") or defaults[f])
   182	            except: pass
   183	    return defaults
