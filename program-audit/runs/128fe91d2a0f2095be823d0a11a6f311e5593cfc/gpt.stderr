    71	def _user_exec_config(app, tid, chain_id):
    72	    global_cfg=load_kv_scoped(Path(app.csv_dir)/"auto_trading_settings.csv",chain_id)
    73	    def us(name,default):return user_setting(app.csv_dir,tid,chain_id,name,default)
    74	    return {
    75	        "auto_on": user_bool(app.csv_dir,tid,chain_id,"auto_trading_enabled",False),
    76	        "live_on": user_bool(app.csv_dir,tid,chain_id,"live_trading_enabled",False),
    77	        "mode": str(us("recommendation_mode","SHADOW")).upper(),
    78	        "input": _dec(us("auto_input_base",global_cfg.get("auto_input_base","0.005")),"0.005"),
    79	        "max_input": _dec(us("max_auto_input_base",global_cfg.get("max_auto_input_base","0.05")),"0.05"),
    80	        "min_user_net": _dec(us("min_net_profit_base",global_cfg.get("min_net_profit_base","0.0002")),"0.0002"),
    81	        "max_hour": max(1,int(float(us("max_auto_trades_per_hour",global_cfg.get("max_auto_trades_per_hour","5"))))),
    82	        "cooldown": max(1,int(float(us("cooldown_seconds",global_cfg.get("cooldown_seconds","20"))))),
    83	        "max_gas_hour": _dec(us("max_auto_expected_gas_per_hour_base",global_cfg.get("max_auto_expected_gas_per_hour_base","0.02")),"0.02"),
    84	    }
