    69	
    70	def _bool(v, default=False):
    71	    if v is None:
    72	        return default
    73	    return str(v).strip().lower() in {"1", "true", "yes", "on", "y"}
    74	
    75	
    76	def _int(v, default=0):
    77	    try:
    78	        return int(float(v))
    79	    except Exception:
    80	        return int(default)
    81	
    82	
    83	def _float(v, default=0.0):
    84	    try:
    85	        return float(v)
    86	    except Exception:
    87	        return float(default)
    88	
    89	
    90	def _dec(v, default="0"):
    91	    try:
    92	        return Decimal(str(v))
    93	    except (InvalidOperation, ValueError, TypeError):
    94	        return Decimal(str(default))
    95	
    96	
    97	def settings_path(app) -> Path:
    98	    return Path(app.csv_dir) / "solana_settings.csv"
    99	
   100	
   101	def ensure_settings(app) -> Path:
   102	    path = settings_path(app)
   103	    headers = ["setting", "value", "description"]
   104	    rows = _sibot._rows(path)
   105	    known = {str(r.get("setting") or "").strip() for r in rows}
   106	    changed = False
   107	    for key, (value, description) in DEFAULTS.items():
   108	        if key not in known:
   109	            rows.append({"setting": key, "value": value, "description": description})
   110	            changed = True
   111	    if changed or not path.exists():
   112	        _sibot._atomic_csv(path, rows, headers)
   113	    return path
   114	
   115	
   116	def settings(app) -> dict:
   117	    ensure_settings(app)
   118	    out = {}
   119	    for r in _sibot._rows(settings_path(app)):
   120	        key = str(r.get("setting") or "").strip()
   121	        if key:
   122	            out[key] = str(r.get("value") or "").strip()
   123	    if os.getenv("SOLANA_RPC_URL", "").strip():
   124	        out["rpc_url"] = os.getenv("SOLANA_RPC_URL", "").strip()
   125	    if os.getenv("SOLANA_EXPLORER_URL", "").strip():
   126	        out["explorer_url"] = os.getenv("SOLANA_EXPLORER_URL", "").strip()
   127	    return out
   128	
   129	
   130	def db_path(app) -> Path:
   131	    return Path(app.data_dir) / "solana_sibot.sqlite3"
   132	
   133	
   134	SCHEMA = r"""
   135	CREATE TABLE IF NOT EXISTS candidates(
   136	  wallet TEXT PRIMARY KEY,
   137	  first_seen INTEGER NOT NULL,
   138	  last_seen INTEGER NOT NULL,
   139	  swap_events INTEGER NOT NULL DEFAULT 0,
   140	  last_signature TEXT,
   141	  updated_at INTEGER NOT NULL
   142	);
   143	CREATE INDEX IF NOT EXISTS idx_sol_candidates ON candidates(swap_events DESC,last_seen DESC);
   144	
   145	CREATE TABLE IF NOT EXISTS history_status(
   146	  wallet TEXT PRIMARY KEY,
   147	  fetched_at INTEGER NOT NULL,
   148	  coverage_start_ts INTEGER,
   149	  coverage_end_ts INTEGER,
   150	  signatures INTEGER NOT NULL DEFAULT 0,
   151	  swaps INTEGER NOT NULL DEFAULT 0,
   152	  closed_trades INTEGER NOT NULL DEFAULT 0,
   153	  truncated INTEGER NOT NULL DEFAULT 0,
   154	  error TEXT
   155	);
   156	
   157	CREATE TABLE IF NOT EXISTS trades(
   158	  trade_id TEXT PRIMARY KEY,
   159	  wallet TEXT NOT NULL,
   160	  mint TEXT NOT NULL,
   161	  decimals INTEGER NOT NULL,
   162	  buy_signature TEXT NOT NULL,
   163	  sell_signature TEXT NOT NULL,
   164	  buy_ts INTEGER NOT NULL,
   165	  sell_ts INTEGER NOT NULL,
   166	  token_amount_raw TEXT NOT NULL,
   167	  cost_sol TEXT NOT NULL,
   168	  proceeds_sol TEXT NOT NULL,
   169	  net_sol TEXT NOT NULL,
   170	  hold_seconds INTEGER NOT NULL,
   171	  source TEXT NOT NULL,
   172	  updated_at INTEGER NOT NULL
   173	);
   174	CREATE INDEX IF NOT EXISTS idx_sol_trades_rank ON trades(wallet,sell_ts);
   175	
   176	CREATE TABLE IF NOT EXISTS rankings(
   177	  telegram_id TEXT NOT NULL,
   178	  lookback_days INTEGER NOT NULL,
   179	  rank INTEGER NOT NULL,
   180	  wallet TEXT NOT NULL,
   181	  gross_profit_sol TEXT NOT NULL,
   182	  gross_loss_sol TEXT NOT NULL,
   183	  net_profit_sol TEXT NOT NULL,
   184	  wins INTEGER NOT NULL,
   185	  losses INTEGER NOT NULL,
   186	  closed_trades INTEGER NOT NULL,
   187	  win_rate REAL NOT NULL,
   188	  updated_at INTEGER NOT NULL,
   189	  PRIMARY KEY(telegram_id,wallet)
   190	);
   191	CREATE INDEX IF NOT EXISTS idx_sol_rankings ON rankings(telegram_id,rank);
   192	
   193	CREATE TABLE IF NOT EXISTS leaders(
   194	  telegram_id TEXT NOT NULL,
   195	  rank INTEGER NOT NULL,
   196	  wallet TEXT NOT NULL,
   197	  net_profit_sol TEXT NOT NULL,
   198	  win_rate REAL NOT NULL,
   199	  closed_trades INTEGER NOT NULL,
   200	  selected_at INTEGER NOT NULL,
   201	  updated_at INTEGER NOT NULL,
   202	  PRIMARY KEY(telegram_id,wallet)
   203	);
   204	CREATE INDEX IF NOT EXISTS idx_sol_leaders ON leaders(wallet);
   205	
   206	CREATE TABLE IF NOT EXISTS leader_events(
   207	  event_id TEXT PRIMARY KEY,
   208	  leader_wallet TEXT NOT NULL,
   209	  signature TEXT NOT NULL,
   210	  action TEXT NOT NULL,
   211	  mint TEXT NOT NULL,
   212	  decimals INTEGER NOT NULL,
   213	  token_amount_raw TEXT NOT NULL,
   214	  sol_amount TEXT NOT NULL,
   215	  sell_pct REAL,
   216	  slot INTEGER NOT NULL,
   217	  event_ts INTEGER NOT NULL,
   218	  created_at INTEGER NOT NULL
   219	);
   220	CREATE INDEX IF NOT EXISTS idx_sol_events ON leader_events(leader_wallet,event_ts);
   221	
   222	CREATE TABLE IF NOT EXISTS positions(
   223	  position_id TEXT PRIMARY KEY,
   224	  telegram_id TEXT NOT NULL,
   225	  leader_wallet TEXT NOT NULL,
   226	  leader_rank INTEGER,
   227	  mint TEXT NOT NULL,
   228	  mode TEXT NOT NULL,
   229	  status TEXT NOT NULL,
   230	  token_amount_raw TEXT NOT NULL,
   231	  entry_cost_sol TEXT NOT NULL,
   232	  entry_ts INTEGER NOT NULL,
   233	  leader_buy_signature TEXT,
   234	  leader_entry_sol TEXT,
   235	  leader_entry_token_raw TEXT,
   236	  signal_count INTEGER NOT NULL DEFAULT 1,
   237	  current_exit_sol TEXT NOT NULL DEFAULT '0',
   238	  unrealised_net_sol TEXT NOT NULL DEFAULT '0',
   239	  unrealised_pct REAL NOT NULL DEFAULT 0,
   240	  peak_unrealised_pct REAL NOT NULL DEFAULT 0,
   241	  leader_exit_pending INTEGER NOT NULL DEFAULT 0,
   242	  realised_net_sol TEXT NOT NULL DEFAULT '0',
   243	  exit_signature TEXT,
   244	  exit_reason TEXT,
   245	  closed_at INTEGER,
   246	  updated_at INTEGER NOT NULL
   247	);
   248	CREATE INDEX IF NOT EXISTS idx_sol_positions ON positions(telegram_id,status,mint);
   249	
   250	CREATE TABLE IF NOT EXISTS state(
   251	  key TEXT PRIMARY KEY,
   252	  value TEXT
   253	);
   254	"""
   255	
   256	
   257	def connect(app):
   258	    p = db_path(app)
   259	    p.parent.mkdir(parents=True, exist_ok=True)
   260	    conn = sqlite3.connect(p, timeout=30.0)
