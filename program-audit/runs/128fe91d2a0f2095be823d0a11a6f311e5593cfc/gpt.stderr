   124	def load_chains(app:AppSettings, enabled_only=False):
   125	    endpoints={}
   126	    for row in _rows(app.csv_dir/"rpc_endpoints.csv"):
   127	        if not _bool(row.get("enabled"),True): continue
   128	        try: cid=int((row.get("chain_id") or "0").strip())
   129	        except: continue
   130	        url=(row.get("url") or "").strip()
   131	        if not url: continue
   132	        try: pri=int(row.get("priority") or 999)
   133	        except: pri=999
   134	        endpoints.setdefault(cid,[]).append((pri,url))
   135	    out=[]
   136	    for row in _rows(app.csv_dir/"chains.csv"):
   137	        try: cid=int((row.get("chain_id") or "0").strip())
   138	        except: continue
   139	        enabled=_bool(row.get("enabled"),False)
   140	        if enabled_only and not enabled: continue
   141	        urls=[u for _,u in sorted(endpoints.get(cid,[]))]
   142	        c=ChainConfig(
   143	            chain_id=cid,slug=(row.get("slug") or str(cid)).strip().lower(),name=(row.get("name") or str(cid)).strip(),
   144	            type=(row.get("type") or "EVM").strip().upper(),enabled=enabled,
   145	            explorer_url=(row.get("explorer_url") or "").strip().rstrip('/'),native_symbol=(row.get("native_symbol") or "NATIVE").strip(),
   146	            wrapped_base_symbol=(row.get("wrapped_base_symbol") or "").strip(),wrapped_base_address=(row.get("wrapped_base_address") or "").strip().lower(),
   147	            finality_lag_blocks=int(row.get("finality_lag_blocks") or 3),scan_blocks_per_cycle=int(row.get("scan_blocks_per_cycle") or 10),rpc_urls=urls,
   148	        )
   149	        out.append(c)
   150	    return out
