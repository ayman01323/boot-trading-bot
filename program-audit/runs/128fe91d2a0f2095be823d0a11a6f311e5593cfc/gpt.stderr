    47	    "max_entry_deterioration_pct": ("2", "Maximum worse current entry versus the observed leader entry"),
    48	    "estimated_entry_fee_sol": ("0.00002", "Conservative estimated Solana entry network/priority fee for SHADOW PnL"),
    49	    "estimated_exit_fee_sol": ("0.00002", "Conservative estimated Solana exit network/priority fee for SHADOW PnL"),
    50	    "stop_loss_pct": ("10", "Independent Solana SHADOW stop loss"),
    51	    "take_profit_pct": ("25", "Independent Solana SHADOW take profit"),
    52	    "leader_exit_loss_cap_pct": ("2.5", "Maximum tolerated loss after the Solana leader has exited"),
    53	    "break_even_trigger_pct": ("5", "Solana SHADOW break-even protection activation"),
    54	    "break_even_floor_pct": ("0.10", "Solana SHADOW net floor after break-even activation"),
    55	    "trailing_trigger_pct": ("10", "Solana SHADOW trailing-profit activation"),
    56	    "trailing_gap_pct": ("5", "Solana SHADOW maximum give-back from peak"),
    57	    "max_hold_hours": ("24", "Close old profitable Solana SHADOW positions"),
    58	    "mirror_partial_sells": ("true", "Mirror the Solana leader's observed partial sell fraction"),
    59	    "jupiter_order_url": (DEFAULT_JUPITER_ORDER, "Jupiter Swap V2 order endpoint used for quote-only SHADOW valuation"),
    60	}
