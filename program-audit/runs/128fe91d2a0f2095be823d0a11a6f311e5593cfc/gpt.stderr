   245	    PRIMARY KEY(wallet, kind)
   246	);
   247	
   248	CREATE TABLE IF NOT EXISTS app_state (
   249	    key TEXT PRIMARY KEY,
   250	    value TEXT
   251	);
   252	"""
   253	
   254	def connect(db_path: Path) -> sqlite3.Connection:
   255	    """Open a SQLite connection tuned for concurrent scanner + Telegram reads.
   256	
   257	    - waits up to 30s instead of immediately failing on a short writer lock;
   258	    - uses WAL mode so readers do not normally block the scanner writer;
   259	    - retries one-time schema/WAL initialization if another connection is busy.
   260	    """
   261	    import time
   262	
   263	    db_path.parent.mkdir(parents=True, exist_ok=True)
   264	    conn = sqlite3.connect(db_path, timeout=30.0)
   265	    conn.row_factory = sqlite3.Row
   266	    conn.execute("PRAGMA busy_timeout=30000")
   267	    conn.execute("PRAGMA foreign_keys=ON")
   268	
   269	    last_exc = None
   270	    for attempt in range(8):
   271	        try:
   272	            mode = conn.execute("PRAGMA journal_mode").fetchone()[0]
   273	            if str(mode).lower() != "wal":
   274	                conn.execute("PRAGMA journal_mode=WAL")
   275	            conn.execute("PRAGMA synchronous=NORMAL")
   276	            conn.executescript(SCHEMA)
   277	            return conn
   278	        except sqlite3.OperationalError as exc:
   279	            last_exc = exc
   280	            if "locked" not in str(exc).lower() and "busy" not in str(exc).lower():
   281	                conn.close()
   282	                raise
   283	            time.sleep(0.25 * (attempt + 1))
   284	
   285	    conn.close()
   286	    raise last_exc if last_exc is not None else RuntimeError("SQLite initialization failed")
   287	
   288	def get_state(conn: sqlite3.Connection, key: str, default: Optional[str] = None) -> Optional[str]:
   289	    row = conn.execute("SELECT value FROM app_state WHERE key=?", (key,)).fetchone()
   290	    return row["value"] if row else default
   291	
   292	def set_state(conn: sqlite3.Connection, key: str, value: str) -> None:
   293	    conn.execute(
   294	        "INSERT INTO app_state(key,value) VALUES(?,?) "
   295	        "ON CONFLICT(key) DO UPDATE SET value=excluded.value",
   296	        (key, value),
   297	    )
   298	    conn.commit()

