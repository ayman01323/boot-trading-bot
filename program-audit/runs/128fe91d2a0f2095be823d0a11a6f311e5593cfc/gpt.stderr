     1	from __future__ import annotations
     2	
     3	import hashlib
     4	import time
     5	from .config import load_addresses
     6	
     7	def _builder_payment(conn, wallet, block_number, tx_index, builders):
     8	    if not builders:
     9	        return 0.0
    10	    rows = conn.execute(
    11	        """SELECT to_addr,value_wei FROM transactions
    12	           WHERE from_addr=? AND block_number=? AND tx_index>?
    13	           ORDER BY tx_index LIMIT 3""",
    14	        (wallet, block_number, tx_index),
    15	    ).fetchall()
    16	    return sum(
    17	        int(r["value_wei"]) / 1e18
    18	        for r in rows
    19	        if (r["to_addr"] or "") in builders
    20	    )
    21	
    22	def _ordered_unique(seq):
    23	    out = []
    24	    seen = set()
    25	    for x in seq:
    26	        if x not in seen:
    27	            seen.add(x)
    28	            out.append(x)
    29	    return out
    30	
    31	def analyse_tx(conn, settings, wallet, tx_hash, executor):
    32	    tx = conn.execute("SELECT * FROM transactions WHERE tx_hash=?", (tx_hash,)).fetchone()
    33	    if not tx:
    34	        raise ValueError("Unknown transaction")
    35	
    36	    cluster = {wallet.lower()}
    37	    if executor:
    38	        cluster.add(executor.lower())
    39	
    40	    transfers = conn.execute(
    41	        """SELECT tr.*,m.symbol,m.decimals
    42	           FROM token_transfers tr
    43	           LEFT JOIN token_meta m ON m.token=tr.token
    44	           WHERE tr.tx_hash=?
    45	           ORDER BY tr.log_index""",
    46	        (tx_hash,),
    47	    ).fetchall()
    48	
    49	    deltas = {}
    50	    token_info = {}
    51	    token_order = []
    52	    wrapped_in = False
    53	    wrapped_out = False
    54	
    55	    for tr in transfers:
    56	        token = tr["token"]
    57	        token_order.append(token)
    58	        symbol = tr["symbol"] or token[:10]
    59	        decimals = int(tr["decimals"] if tr["decimals"] is not None else 18)
    60	        token_info[token] = (symbol, decimals)
    61	        amount = int(tr["raw_amount"])
    62	        frm = tr["from_addr"]
    63	        to = tr["to_addr"]
    64	
    65	        if symbol.upper() == settings.wrapped_base_symbol.upper():
    66	            if frm in cluster and to not in cluster:
    67	                wrapped_out = True
    68	            elif to in cluster and frm not in cluster:
    69	                wrapped_in = True
    70	
    71	        if frm in cluster and to not in cluster:
    72	            deltas[token] = deltas.get(token, 0) - amount
    73	        elif to in cluster and frm not in cluster:
    74	            deltas[token] = deltas.get(token, 0) + amount
    75	
    76	    gas_price = int(tx["effective_gas_price_wei"] or tx["gas_price_wei"] or 0)
    77	    gas_native = (int(tx["gas_used"] or 0) * gas_price) / 1e18
    78	    builders = load_addresses(settings.csv_dir, "builders.csv", settings.chain_id)
    79	    builder_native = _builder_payment(
    80	        conn, wallet, int(tx["block_number"]), int(tx["tx_index"] or 0), builders
    81	    )
    82	
    83	    positive_tokens = []
    84	    wrapped_delta = None
    85	    wrapped_token = None
    86	    wrapped_symbol = settings.wrapped_base_symbol
    87	
    88	    for token, raw in deltas.items():
    89	        symbol, decimals = token_info[token]
    90	        unit = raw / (10 ** decimals)
    91	        if unit > 0:
    92	            positive_tokens.append((token, symbol, decimals, unit))
    93	        if symbol.upper() == settings.wrapped_base_symbol.upper():
    94	            wrapped_delta = unit
    95	            wrapped_token = token
    96	            wrapped_symbol = symbol
    97	
    98	    proof = "NO_POSITIVE_DELTA"
    99	    base_token = None
   100	    base_symbol = None
   101	    gross = 0.0
   102	    net = None
   103	    net_usd = None
   104	
   105	    # Strongest profit/loss evidence: wrapped base crossed the wallet/executor
   106	    # boundary in BOTH directions in the same transaction. This is a much
   107	    # better closed-cycle signal than counting a simple wrapped-base inflow.
   108	    if wrapped_delta is not None and wrapped_in and wrapped_out:
   109	        base_token = wrapped_token
   110	        base_symbol = wrapped_symbol
   111	        gross = float(wrapped_delta)
   112	        net = gross - gas_native - builder_native
   113	        proof = "PROVEN_WRAPPED_BASE"
   114	        if settings.native_usd is not None:
   115	            net_usd = net * settings.native_usd
   116	    elif wrapped_delta is not None and wrapped_delta > 0:
   117	        base_token = wrapped_token
   118	        base_symbol = wrapped_symbol
   119	        gross = float(wrapped_delta)
   120	        net = None
   121	        proof = "WRAPPED_BASE_INFLOW_ONLY"
   122	    elif wrapped_delta is not None and wrapped_delta < 0:
   123	        base_token = wrapped_token
   124	        base_symbol = wrapped_symbol
   125	        gross = float(wrapped_delta)
   126	        net = None
   127	        proof = "WRAPPED_BASE_OUTFLOW_ONLY"
   128	    elif positive_tokens:
   129	        base_token, base_symbol, _, gross = max(positive_tokens, key=lambda x: x[3])
   130	        net = gross
   131	        proof = "TOKEN_DELTA_ONLY"
   132	    elif int(tx["value_wei"] or 0) > 0:
   133	        proof = "INCOMPLETE_NATIVE_TRACE"
   134	
   135	    route_tokens = _ordered_unique(token_order)
   136	    route_fingerprint = (
   137	        f"{(executor or tx['to_addr'] or '')}|{tx['selector']}|"
   138	        + ">".join(route_tokens[:12])
   139	    )
   140	    pattern_id = hashlib.sha256(route_fingerprint.encode()).hexdigest()[:20]
   141	    unique_tokens = len(set(route_tokens))
   142	
   143	    if proof == "PROVEN_WRAPPED_BASE" and unique_tokens >= 3:
   144	        classification = "TRIANGULAR_OR_MULTI_HOP_ARBITRAGE_CANDIDATE"
   145	    elif proof == "PROVEN_WRAPPED_BASE" and unique_tokens >= 2:
   146	        classification = "TWO_ASSET_ARBITRAGE_CANDIDATE"
   147	    elif proof == "WRAPPED_BASE_OUTFLOW_ONLY" and positive_tokens:
   148	        classification = "TOKEN_BUY_OR_ENTRY_CANDIDATE"
   149	    elif proof == "WRAPPED_BASE_INFLOW_ONLY":
   150	        classification = "TOKEN_SALE_OR_EXIT_CANDIDATE"
   151	    elif unique_tokens >= 2 and tx["selector"] != "0x":
   152	        classification = "AUTOMATED_EXECUTOR_PATTERN"
   153	    elif transfers:
   154	        classification = "TRANSFER_OR_TREASURY_PATTERN"
   155	    else:
   156	        classification = "NO_TOKEN_FLOW"
   157	
   158	    now = int(time.time())
   159	    conn.execute(
   160	        """INSERT INTO profit_evidence(
   161	             tx_hash,wallet,executor,base_token,base_symbol,gross_delta,
   162	             gas_bnb,builder_payment_bnb,net_base,net_usd,proof_quality,
   163	             classification,route_fingerprint,created_at
   164	           ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)
   165	           ON CONFLICT(tx_hash,wallet) DO UPDATE SET
   166	             executor=excluded.executor,
   167	             base_token=excluded.base_token,
   168	             base_symbol=excluded.base_symbol,
   169	             gross_delta=excluded.gross_delta,
   170	             gas_bnb=excluded.gas_bnb,
   171	             builder_payment_bnb=excluded.builder_payment_bnb,
   172	             net_base=excluded.net_base,
   173	             net_usd=excluded.net_usd,
   174	             proof_quality=excluded.proof_quality,
   175	             classification=excluded.classification,
   176	             route_fingerprint=excluded.route_fingerprint,
   177	             created_at=excluded.created_at""",
   178	        (
   179	            tx_hash, wallet, executor, base_token, base_symbol, gross,
   180	            gas_native, builder_native, net, net_usd, proof,
   181	            classification, route_fingerprint, now,
   182	        ),
   183	    )
   184	    conn.commit()
   185	    return {
   186	        "tx_hash": tx_hash,
   187	        "pattern_id": pattern_id,
   188	        "proof_quality": proof,
   189	        "classification": classification,
   190	        "base_symbol": base_symbol,
   191	        "gross_delta": gross,
   192	        "net_base": net,
   193	        "net_usd": net_usd,
   194	        "route_fingerprint": route_fingerprint,
   195	    }
     1	from __future__ import annotations
