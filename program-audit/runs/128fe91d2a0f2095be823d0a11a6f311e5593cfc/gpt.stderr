   100	    def _order(self, input_mint: str, output_mint: str, amount_raw: int) -> dict:
   101	        if int(amount_raw) <= 0:
   102	            raise SolanaLiveError("Swap amount must be positive")
   103	        params = {
   104	            "inputMint": str(input_mint),
   105	            "outputMint": str(output_mint),
   106	            "amount": str(int(amount_raw)),
   107	            "taker": self.address,
   108	            # Local simulation + single signer is mandatory for the first LIVE path.
   109	            "excludeRouters": "jupiterz",
   110	        }
   111	        r = requests.get(f"{JUPITER_BASE}/order", params=params, headers=self._headers(), timeout=30)
   112	        r.raise_for_status()
   113	        order = r.json()
   114	        if order.get("errorCode") or not order.get("transaction"):
   115	            raise SolanaLiveError(f"Jupiter order failed: {order.get('errorMessage') or order.get('errorCode') or 'no transaction'}")
   116	        if str(order.get("router") or "").lower() == "jupiterz":
   117	            raise SolanaLiveError("JupiterZ/RFQ is disabled for the LIVE canary path")
   118	        if not order.get("requestId"):
   119	            raise SolanaLiveError("Jupiter order returned no requestId")
   120	        # Reject an explicitly zero quote before signing/broadcasting. Missing fields
   121	        # are tolerated because Jupiter response shapes can evolve; post-execute
