    62	_WORKER_STARTED = False
    63	_WORKER_LOCK = threading.Lock()
    64	_DB_LOCK = threading.RLock()
    65	_JUPITER_LOCK = threading.Lock()
    66	_LAST_JUPITER_CALL = 0.0
    67	_REFRESH_NOW = set()
