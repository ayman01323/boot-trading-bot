    91	def _eligible_scanner_candidate(r: dict) -> bool:
    92	    """Require every scanner-side safety gate explicitly before wallet simulation.
    93	
    94	    Missing fields fail closed.  This prevents stale/diagnostic/rejected rows from
    95	    reaching the per-user simulation and signing path merely because a historical
    96	    CSV used permissive defaults.
    97	    """
    98	    required_true = (
    99	        "enabled",
   100	        "scanner_exact",
   101	        "source_verified",
   102	        "exact_quote_ok",
   103	        "liquidity_ok",
   104	        "route_approved",
   105	        "whole_route_approved",
   106	    )
   107	    return all(_bool(r.get(k), False) for k in required_true)
