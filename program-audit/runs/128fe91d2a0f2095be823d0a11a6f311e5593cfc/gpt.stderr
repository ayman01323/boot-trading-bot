   110	def execute_best_live_opportunity(app, opportunities: list[dict]) -> list[dict]:
   111	    """Execute at most one fresh route per eligible user per cycle.
   112	
   113	    The platform switch in auto_trading_settings.csv is a global emergency/admin gate.
   114	    Every Telegram user then needs their own LIVE + ARMED + AUTOTRADE settings.
   115	    """
   116	    platform=load_kv_scoped(Path(app.csv_dir)/"auto_trading_settings.csv",0)
   117	    if not _bool(platform.get("auto_trading_enabled","false"),False):return []
   118	    store=MultiWalletStore(app.data_dir,app.csv_dir);events=[];now=int(time.time())
   119	    base_candidates=[r for r in opportunities if _eligible_scanner_candidate(r)]
   120	    qstates={}
   121	    def not_quarantined(r):
   122	        cid=str(r.get("chain_id") or "")
   123	        if cid not in qstates:qstates[cid]=quarantine_state(app.csv_dir,cid,now)
   124	        path=[x for x in str(r.get("route_path") or "").split(">") if x]
   125	        blocked,_=route_or_token_blocked(qstates[cid],str(r.get("route_id") or ""),path)
   126	        return not blocked
   127	    base_candidates=[r for r in base_candidates if not_quarantined(r)]
   128	    def product_approved(r):
   129	        path=[x for x in str(r.get("route_path") or "").split(">") if x]
   130	        policy=route_product_policy(app.csv_dir,r.get("chain_id") or "",path)
   131	        return bool(policy.get("auto_trade"))
   132	    base_candidates=[r for r in base_candidates if product_approved(r)]
   133	    base_candidates.sort(key=_candidate_score,reverse=True)
   134	    for u in all_users(app.csv_dir,enabled_only=True):
   135	        if (u.get("status") or "").upper()!="ACTIVE" or not _bool(u.get("can_auto_trade"),True):continue
   136	        tid=str(u.get("telegram_id") or "").strip()
   137	        if not tid or not store.has_wallet(tid):continue
   138	        try:meta=store.get_meta(tid)
   139	        except Exception:continue
   140	        # Choose the strongest route that passes this user's limits and wallet-specific simulation.
   141	        chosen=None;chosen_sim=None;chosen_cfg=None;chosen_trader=None;chosen_plan=None
   142	        for r in base_candidates:
   143	            chain_slug=str(r.get("chain_slug") or "").strip().lower()
   144	            if not chain_slug:continue
   145	            route_kind=str(r.get("route_kind") or "V2_CYCLE").upper()
   146	            if route_kind.startswith("CROSS_") or str(r.get("execution_mode") or "").upper().startswith("SHADOW"):
   147	                continue
   148	            try:
   149	                require_user(app.csv_dir,tid,active=True,chain_slug=chain_slug)
   150	                trader=LiveTrader(app,chain_slug,telegram_id=tid,wallet_id=meta["wallet_id"],router_override=((r.get("router_address") or None) if route_kind=="V2_CYCLE" else None))
   151	            except Exception:continue
   152	            cfg=_user_exec_config(app,tid,trader.chain.chain_id)
   153	            if not (cfg["auto_on"] and cfg["live_on"] and cfg["mode"]=="ARMED"):continue
   154	            st=auto_state(app.csv_dir,tid)
   155	            if st["hour_trades"]>=cfg["max_hour"] or st["hour_expected_gas"]>=cfg["max_gas_hour"] or now-st["last_ts"]<cfg["cooldown"]:continue
   156	            amount=min(cfg["input"],cfg["max_input"])
   157	            if amount<=0:continue
   158	            plan=user_fee_plan(app.csv_dir,tid) or {}
   159	            if _dec(plan.get("profit_share_bps") or 0)>0 and not master_wallet(app.csv_dir,trader.chain.chain_id):
   160	                continue
   161	            pre_fee_min=_required_pre_fee_min(plan,cfg["min_user_net"])
   162	            path=[x for x in (r.get("route_path") or "").split(">") if x]
   163	            try:
   164	                if route_kind=="V3_CYCLE":
   165	                    fees=[int(x) for x in str(r.get("route_fees") or "").split(">") if str(x).strip()]
   166	                    sim=trader.simulate_v3_cycle(path,fees,amount,pre_fee_min,r.get("router_address"),r.get("quoter_address"))
   167	                else:
   168	                    sim=trader.simulate_cycle(path,amount,pre_fee_min)
   169	                _append_simulation(app.csv_dir,{
   170	                    "timestamp_epoch":int(time.time()),"telegram_id":tid,"wallet_id":meta.get("wallet_id",""),
   171	                    "chain_id":trader.chain.chain_id,"chain_slug":trader.chain.slug,"route_id":r.get("route_id",""),
   172	                    "route_path":r.get("route_path",""),"input_base":str(amount),"min_net_profit_base":str(pre_fee_min),
   173	                    "gross_profit_base":str(sim.get("gross_profit",0)),"gas_cost_base":str(sim.get("gas_cost_base",0)),
   174	                    "simulation_ok":str(bool(sim.get("simulation_ok"))).lower(),"reason":str(sim.get("reason") or "")[:500],
   175	                })
   176	            except Exception as exc:
   177	                _append_simulation(app.csv_dir,{
   178	                    "timestamp_epoch":int(time.time()),"telegram_id":tid,"wallet_id":meta.get("wallet_id",""),
   179	                    "chain_id":trader.chain.chain_id,"chain_slug":trader.chain.slug,"route_id":r.get("route_id",""),
   180	                    "route_path":r.get("route_path",""),"input_base":str(amount),"min_net_profit_base":str(pre_fee_min),
   181	                    "gross_profit_base":"","gas_cost_base":"","simulation_ok":"false",
   182	                    "reason":f"{type(exc).__name__}: {str(exc)[:450]}",
   183	                })
   184	                continue
   185	            if not sim.get("simulation_ok"):
   186	                if route_kind=="V2_CYCLE":
   187	                    record_execution_mismatch(app.csv_dir,trader.chain.chain_id,r.get("route_id", ""),path,str(sim.get("reason") or ""))
   188	                continue
   189	            chosen=(r,path,amount,pre_fee_min,route_kind);chosen_sim=sim;chosen_cfg=cfg;chosen_trader=trader;chosen_plan=plan;break
   190	        if not chosen:continue
   191	        r,path,amount,pre_fee_min,route_kind=chosen;trader=chosen_trader;plan=chosen_plan;log_path=Path(app.csv_dir)/"auto"/"auto_trade_execution.csv"
   192	        before_wrapped=trader.wrapped_balance()
   193	        try:
   194	            if route_kind=="V3_CYCLE":
   195	                fees=[int(x) for x in str(r.get("route_fees") or "").split(">") if str(x).strip()]
   196	                result=trader.execute_v3_cycle(path,fees,amount,pre_fee_min,r.get("router_address"),r.get("quoter_address"),"CONFIRM")
   197	            else:
   198	                result=trader.execute_cycle(path,amount,pre_fee_min,"CONFIRM")
   199	            txh=result["tx_hash"]
   200	            try:receipt=trader.w3.eth.wait_for_transaction_receipt(txh,timeout=180,poll_latency=2)
   201	            except Exception as exc:raise RuntimeError(f"cycle broadcast {txh} but receipt timed out") from exc
   202	            if int(receipt.status)!=1:raise RuntimeError(f"cycle transaction failed: {txh}")
   203	            after_wrapped=trader.wrapped_balance();gas_price=int(getattr(receipt,"effectiveGasPrice",0) or receipt.get("effectiveGasPrice",0) or 0);gas_used=int(getattr(receipt,"gasUsed",0) or receipt.get("gasUsed",0) or 0)
   204	            actual_gas=Decimal(gas_price*gas_used)/Decimal(10**18);realised=(after_wrapped-before_wrapped)-actual_gas
   205	            fee=profit_share_amount(app.csv_dir,tid,realised);fee_tx="";master=master_wallet(app.csv_dir,trader.chain.chain_id);fee_status="NONE";fee_note=""
   206	            if fee>0 and master:
   207	                raw=int(fee*Decimal(10**18))
   208	                if raw>0:
   209	                    try:
   210	                        fee_tx=trader.transfer_wrapped_raw(master,raw);fee_status="BROADCAST"
   211	                        ledger(app.csv_dir,{"telegram_id":tid,"wallet_id":meta["wallet_id"],"chain_id":trader.chain.chain_id,"fee_type":"PROFIT_SHARE","plan_id":u.get("fee_plan_id") or "","gross_profit_base":str(after_wrapped-before_wrapped),"gas_cost_base":str(actual_gas),"net_profit_base":str(realised),"fee_amount_base":str(fee),"fee_asset":trader.chain.wrapped_base_symbol,"master_address":master,"tx_hash":fee_tx,"status":"BROADCAST","note":"Fee calculated only on positive realised cycle net after actual cycle gas"})
   212	                    except Exception as fee_exc:
   213	                        fee_status="PENDING";fee_note=f"profit fee settlement failed: {type(fee_exc).__name__}: {str(fee_exc)[:200]}"
   214	                        ledger(app.csv_dir,{"telegram_id":tid,"wallet_id":meta["wallet_id"],"chain_id":trader.chain.chain_id,"fee_type":"PROFIT_SHARE","plan_id":u.get("fee_plan_id") or "","gross_profit_base":str(after_wrapped-before_wrapped),"gas_cost_base":str(actual_gas),"net_profit_base":str(realised),"fee_amount_base":str(fee),"fee_asset":trader.chain.wrapped_base_symbol,"master_address":master,"tx_hash":"","status":"PENDING","note":fee_note})
   215	            status="SUCCESS_FEE_PENDING" if fee_status=="PENDING" else "SUCCESS"
   216	            row={"timestamp_epoch":now,"telegram_id":tid,"wallet_id":meta["wallet_id"],"chain_id":trader.chain.chain_id,"chain_slug":trader.chain.slug,"route_id":r.get("route_id"),"route_path":r.get("route_path"),"input_base":str(amount),"expected_gross_base":str(chosen_sim.get("gross_profit",0)),"expected_gas_base":str(chosen_sim.get("gas_cost_base",0)),"expected_net_base":str(_dec(chosen_sim.get("gross_profit"),0)-_dec(chosen_sim.get("gas_cost_base"),0)),"realised_net_base":str(realised),"profit_fee_base":str(fee),"fee_tx_hash":fee_tx,"tx_hash":txh,"status":status,"note":"user-specific fresh re-quote/simulation + receipt-confirmed realised P&L"+(" | "+fee_note if fee_note else "")}
