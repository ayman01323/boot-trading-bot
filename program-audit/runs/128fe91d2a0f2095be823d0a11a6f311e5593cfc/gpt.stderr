  1270	def _live_worker(app):
  1271	    last_positions = 0; last_rank = 0
  1272	    while True:
  1273	        now = int(time.time())
  1274	        try:
  1275	            if _bool(platform_settings(app, 0).get("platform_enabled"), True):
  1276	                if now - last_rank >= max(30, _int(platform_settings(app, 0).get("ranking_refresh_seconds"), 120)):
  1277	                    refresh_all_rankings(app); last_rank = now
  1278	                for c in load_chains(app, enabled_only=True):
  1279	                    try: poll_leader_blocks(app, c)
  1280	                    except Exception as exc: print(f"[sibot-monitor:{c.slug}]", type(exc).__name__, exc)
  1281	                if now - last_positions >= max(3, _int(platform_settings(app, 0).get("position_interval_seconds"), 10)):
  1282	                    monitor_positions(app); last_positions = now
  1283	        except Exception as exc:
  1284	            print("[sibot-live]", type(exc).__name__, exc)
  1285	        time.sleep(max(1, _int(platform_settings(app, 0).get("monitor_interval_seconds"), 3)))
