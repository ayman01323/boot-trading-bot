   520	            return {**q, "prepared": False, "simulation_ok": False, "gas": 0, "gas_cost_base": Decimal(0), "min_out_raw": 0, "reason": "wallet needs WBNB/WETH capital and router allowance; use /autoprep"}
   521	        fn0 = self.router.functions.swapExactTokensForTokensSupportingFeeOnTransferTokens(
