.github/workflows/ai-review-pipeline-ci.yml
     1	name: AI Review Pipeline Tests
     2	
     3	on:
     4	  pull_request:
     5	    paths:
     6	      - '.github/workflows/hourly-three-agent-strategy-cycle.yml'
     7	      - '.github/workflows/ai-review-pipeline-ci.yml'
     8	      - 'tests/test_hourly_three_agent_workflow_contract.py'
     9	  workflow_dispatch:
    10	
    11	permissions:
    12	  contents: read
    13	
    14	jobs:
    15	  pipeline:
    16	    runs-on: ubuntu-latest
    17	    timeout-minutes: 15
    18	    steps:
    19	      - uses: actions/checkout@v4
    20	      - uses: actions/setup-python@v5
    21	        with:
    22	          python-version: '3.11'
    23	      - uses: actions/setup-node@v4
    24	        with:
    25	          node-version: '22'
    26	
    27	      - name: Install test dependency
    28	        run: python -m pip install pytest
    29	
    30	      - name: Workflow contract tests
    31	        run: pytest -q tests/test_hourly_three_agent_workflow_contract.py
    32	
    33	      - name: Install current provider CLIs
    34	        run: |
    35	          npm install -g @openai/codex@latest @google/gemini-cli@latest
    36	          codex --version
    37	          gemini --version
    38	
    39	      - name: Verify GPT credential and Codex non-interactive invocation
    40	        id: gpt
    41	        continue-on-error: true
    42	        env:
    43	          CODEX_API_KEY: ${{ secrets.OPENAI_API_KEY }}
    44	          OPENAI_STRATEGY_AUDIT_MODEL: ${{ vars.OPENAI_STRATEGY_AUDIT_MODEL }}
    45	        shell: bash
    46	        run: |
    47	          set -euo pipefail
    48	          if [[ -z "${CODEX_API_KEY:-}" ]]; then
    49	            echo 'OPENAI_API_KEY source secret is missing from repository Actions secrets.' >&2
    50	            exit 20
    51	          fi
    52	          model_args=()
    53	          if [[ -n "${OPENAI_STRATEGY_AUDIT_MODEL:-}" ]]; then model_args=(-m "$OPENAI_STRATEGY_AUDIT_MODEL"); fi
    54	          printf 'Inspect nothing. Reply with exactly AI_PIPELINE_GPT_OK and do not run tools.\n' |
    55	            codex --ask-for-approval never exec --sandbox read-only --ephemeral "${model_args[@]}" - > /tmp/codex-smoke.txt
    56	          grep -q 'AI_PIPELINE_GPT_OK' /tmp/codex-smoke.txt
    57	
    58	      - name: Verify Gemini credential and read-only invocation
    59	        id: gemini
    60	        continue-on-error: true
    61	        env:
    62	          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
    63	          GEMINI_STRATEGY_MODEL: ${{ vars.GEMINI_STRATEGY_MODEL || 'gemini-3.1-pro-preview' }}
    64	          GEMINI_CLI_TRUST_WORKSPACE: 'true'
    65	        shell: bash
    66	        run: |
    67	          set -euo pipefail
    68	          if [[ -z "${GEMINI_API_KEY:-}" ]]; then
    69	            echo 'GEMINI_API_KEY is missing from repository Actions secrets.' >&2
    70	            exit 20
    71	          fi
    72	          gemini --approval-mode=plan --skip-trust --model "$GEMINI_STRATEGY_MODEL" --output-format text \
    73	            -p 'Inspect nothing. Reply with exactly AI_PIPELINE_GEMINI_OK and do not run tools.' > /tmp/gemini-smoke.txt
    74	          grep -q 'AI_PIPELINE_GEMINI_OK' /tmp/gemini-smoke.txt
    75	
    76	      - name: Copilot assignment credential status
    77	        env:
    78	          COPILOT_ASSIGN_TOKEN: ${{ secrets.COPILOT_ASSIGN_TOKEN }}
    79	        shell: bash
    80	        run: |
    81	          if [[ -n "${COPILOT_ASSIGN_TOKEN:-}" ]]; then
    82	            echo 'COPILOT_ASSIGN_TOKEN is configured.'
    83	          else
    84	            echo 'WARNING: COPILOT_ASSIGN_TOKEN is not configured; hourly cycles will publish BLOCKED_COPILOT_AUTH until Copilot is assigned by a user-scoped token or manually.'
    85	          fi
    86	
    87	      - name: Require both model providers to work
    88	        env:
    89	          GPT_OUTCOME: ${{ steps.gpt.outcome }}
    90	          GEMINI_OUTCOME: ${{ steps.gemini.outcome }}
    91	        shell: bash
    92	        run: |
    93	          set -euo pipefail
    94	          echo "GPT smoke outcome: ${GPT_OUTCOME}"
    95	          echo "Gemini smoke outcome: ${GEMINI_OUTCOME}"
    96	          [[ "$GPT_OUTCOME" == 'success' ]]
    97	          [[ "$GEMINI_OUTCOME" == 'success' ]]
.github/workflows/backup-google-drive.yml
     1	name: Backup BOOT to Google Drive
     2	# Manual trigger: 2026-08-18T22:25:42Z
     3	
     4	on:
     5	  push:
     6	    branches: [main]
     7	    paths:
     8	      - .github/workflows/backup-google-drive.yml
     9	  workflow_dispatch:
    10	
    11	permissions:
    12	  contents: read
    13	  statuses: write
    14	
    15	concurrency:
    16	  group: boot-vps-google-drive-backup
    17	  cancel-in-progress: false
    18	
    19	jobs:
    20	  backup:
    21	    name: Encrypted full VPS bot backup
    22	    runs-on: [self-hosted, linux, x64, boot-vps]
    23	    timeout-minutes: 60
    24	    steps:
    25	      - name: Mark backup pending
    26	        shell: bash
    27	        env:
    28	          GH_TOKEN: ${{ github.token }}
    29	        run: |
    30	          set -euo pipefail
    31	          curl -fsS -X POST \
    32	            -H "Authorization: Bearer $GH_TOKEN" \
    33	            -H "Accept: application/vnd.github+json" \
    34	            -H "X-GitHub-Api-Version: 2022-11-28" \
    35	            "https://api.github.com/repos/${GITHUB_REPOSITORY}/statuses/${GITHUB_SHA}" \
    36	            -d '{"state":"pending","context":"server/google-drive-backup","description":"Preparing encrypted VPS backup"}' >/dev/null
    37	
    38	      - name: Create and upload encrypted backup
    39	        id: backup
    40	        shell: bash
    41	        run: |
    42	          set -euo pipefail
    43	
    44	          SOURCE="/root/multichain-learning-bot-v2.2-fast-direct-market"
    45	          CONFIG="/root/.config/rclone/rclone.conf"
    46	          RECOVERY="/root/.config/rclone/BOOT-BACKUP-RECOVERY.txt"
    47	          DEST="botbackup:full-server-backups"
    48	          STAMP="$(date -u +%Y-%m-%d_%H-%M-%SZ)"
    49	          ARCHIVE="/tmp/boot-trading-bot-${STAMP}.tar.gz"
    50	          CHECKSUM="${ARCHIVE}.sha256"
    51	          SERVICE="learnerbot.service"
    52	          STOPPED=0
    53	
    54	          cleanup() {
    55	            rc=$?
    56	            if [ "$STOPPED" -eq 1 ]; then
    57	              sudo -n systemctl start "$SERVICE" || true
    58	            fi
    59	            if [ "$rc" -eq 0 ]; then
    60	              rm -f "$ARCHIVE" "$CHECKSUM"
    61	            fi
    62	            exit "$rc"
    63	          }
    64	          trap cleanup EXIT
    65	
    66	          command -v rclone >/dev/null 2>&1 || { echo "rclone is not installed" >&2; exit 20; }
    67	          command -v openssl >/dev/null 2>&1 || { echo "openssl is not installed" >&2; exit 21; }
    68	          sudo -n test -d "$SOURCE" || { echo "Bot source folder not found: $SOURCE" >&2; exit 22; }
    69	          sudo -n test -f "$CONFIG" || { echo "Missing rclone config: $CONFIG" >&2; echo "Copy your Windows rclone.conf to /root/.config/rclone/rclone.conf first." >&2; exit 23; }
    70	
    71	          REMOTES="$(sudo -n rclone --config "$CONFIG" listremotes)"
    72	          printf '%s\n' "$REMOTES"
    73	          grep -qx 'gdrive:' <<<"$REMOTES" || { echo "Server rclone config does not contain gdrive:" >&2; exit 24; }
    74	
    75	          if ! grep -qx 'botbackup:' <<<"$REMOTES"; then
    76	            echo "Creating encrypted botbackup: remote over gdrive:BOOT-BACKUPS"
    77	            PASS1="$(openssl rand -hex 32)"
    78	            PASS2="$(openssl rand -hex 32)"
    79	            sudo -n rclone --config "$CONFIG" config create botbackup crypt \
    80	              --obscure \
    81	              remote gdrive:BOOT-BACKUPS \
    82	              filename_encryption standard \
    83	              directory_name_encryption true \
    84	              password "$PASS1" \
    85	              password2 "$PASS2"
    86	
    87	            umask 077
    88	            REC_TMP="$(mktemp)"
    89	            cat > "$REC_TMP" <<EOF
    90	BOOT Google Drive encrypted backup recovery information
    91	Created UTC: $STAMP
    92	
    93	Rclone crypt remote: botbackup:
    94	Underlying remote: gdrive:BOOT-BACKUPS
    95	filename_encryption: standard
    96	directory_name_encryption: true
    97	password: $PASS1
    98	password2: $PASS2
    99	
   100	IMPORTANT: Download this file from the VPS with WinSCP and store it offline.
   101	Without these values (or the rclone.conf that contains them), the encrypted backup cannot be decrypted after loss of the VPS.
   102	EOF
   103	            sudo -n install -m 600 "$REC_TMP" "$RECOVERY"
   104	            rm -f "$REC_TMP"
   105	            unset PASS1 PASS2
   106	            echo "Created root-only recovery file: $RECOVERY"
   107	          else
   108	            echo "Encrypted botbackup: remote already exists; reusing it."
   109	          fi
   110	
   111	          sudo -n rclone --config "$CONFIG" lsd botbackup: >/dev/null
   112	
   113	          echo "Stopping $SERVICE for a consistent archive"
   114	          sudo -n systemctl stop "$SERVICE"
   115	          STOPPED=1
   116	
   117	          sudo -n tar -C /root -czf "$ARCHIVE" multichain-learning-bot-v2.2-fast-direct-market
   118	          sudo -n chown "$(id -u):$(id -g)" "$ARCHIVE"
   119	          sha256sum "$ARCHIVE" > "$CHECKSUM"
   120	          SIZE="$(stat -c%s "$ARCHIVE")"
   121	          echo "Archive: $ARCHIVE"
   122	          echo "Bytes: $SIZE"
   123	
   124	          echo "Restarting $SERVICE before upload"
   125	          sudo -n systemctl start "$SERVICE"
   126	          STOPPED=0
   127	          sudo -n systemctl is-active --quiet "$SERVICE"
   128	
   129	          rclone --config "$CONFIG" copyto "$ARCHIVE" "$DEST/$(basename "$ARCHIVE")" --progress
   130	          rclone --config "$CONFIG" copyto "$CHECKSUM" "$DEST/$(basename "$CHECKSUM")" --progress
   131	
   132	          REMOTE_SIZE="$(rclone --config "$CONFIG" lsjson "$DEST/$(basename "$ARCHIVE")" --stat | python3 -c 'import json,sys; print(json.load(sys.stdin)["Size"])')"
   133	          test "$REMOTE_SIZE" = "$SIZE"
   134	
   135	          echo "Backup verified: $DEST/$(basename "$ARCHIVE")"
   136	          echo "backup_name=$(basename "$ARCHIVE")" >> "$GITHUB_OUTPUT"
   137	
   138	      - name: Report backup result
   139	        if: always()
   140	        shell: bash
   141	        env:
   142	          GH_TOKEN: ${{ github.token }}
   143	          JOB_STATUS: ${{ job.status }}
   144	          BACKUP_NAME: ${{ steps.backup.outputs.backup_name }}
   145	        run: |
   146	          set -euo pipefail
   147	          if [ "$JOB_STATUS" = "success" ]; then
   148	            STATE="success"
   149	            DESC="Encrypted Google Drive backup verified"
   150	          else
   151	            STATE="failure"
   152	            DESC="Google Drive backup failed; inspect workflow log"
   153	          fi
   154	          curl -fsS -X POST \
   155	            -H "Authorization: Bearer $GH_TOKEN" \
   156	            -H "Accept: application/vnd.github+json" \
   157	            -H "X-GitHub-Api-Version: 2022-11-28" \
   158	            "https://api.github.com/repos/${GITHUB_REPOSITORY}/statuses/${GITHUB_SHA}" \
   159	            -d "{\"state\":\"$STATE\",\"context\":\"server/google-drive-backup\",\"description\":\"$DESC\"}" >/dev/null
   160	          echo "$DESC ${BACKUP_NAME:-}"
