   202	def _insert_with_wallet_binding(app, tid, rank, event, trade, allocation, cfg):
   203	    pid, out_raw, entry_cost = _PREV_INSERT(app, tid, rank, event, trade, allocation, cfg)
   204	    wallet_id = str((trade or {}).get("wallet_id") or "")
   205	    address = str((trade or {}).get("wallet_address") or "")
   206	    if wallet_id and address:
   207	        _bind(app, pid, tid, wallet_id, address, "ENTRY")
   208	    return pid, out_raw, entry_cost
