   160	def load_addresses(csv_dir:Path, filename:str, chain_id=None):
   161	    out={}
   162	    for row in _rows(csv_dir/filename):
   163	        if not _bool(row.get("enabled"),True): continue
   164	        scope=(row.get("chain_id") or "*").strip()
   165	        if chain_id is not None and scope not in {"","*","0",str(chain_id)}: continue
   166	        address=(row.get("address") or "").strip().lower()
   167	        name=(row.get("name") or row.get("label") or address).strip()
   168	        if address.startswith("0x") and len(address)==42: out[address]=name
   169	    return out
