   216	def resolve_dex_label(csv_dir:Path, chain_id:int, address=None):
   217	    if not address:return None
   218	    a=address.lower()
   219	    for row in load_dex_registry(csv_dir,chain_id):
   220	        for field in ('router','factory'):
   221	            if (row.get(field) or '').strip().lower()==a:
   222	                name=(row.get('dex_name') or '').strip(); version=(row.get('version') or '').strip()
   223	                return f"{name} {version}".strip()
   224	    return None
   225	
   226	def token_override(csv_dir:Path,chain_id:int,address:str):
   227	    a=(address or '').lower()
   228	    for row in _rows(csv_dir/'tokens.csv'):
   229	        if not _bool(row.get('enabled'),True):continue
   230	        if (row.get('chain_id') or '').strip()!=str(chain_id):continue
   231	        if (row.get('address') or '').strip().lower()!=a:continue
   232	        try:dec=int(row.get('decimals') or 18)
   233	        except:dec=18
   234	        return ((row.get('symbol') or a[:10]).strip(),dec)
   235	    return None
     1	from __future__ import annotations
     2	from typing import Optional
     3	
     4	import itertools
     5	import time
     6	from typing import Any
     7	import requests
     8	
     9	class RPCError(RuntimeError):
    10	    pass
    11	
    12	class RPCClient:
    13	    def __init__(self, urls: list[str], timeout: float = 15, delay_ms: int = 35):
    14	        if not urls:
    15	            raise ValueError("At least one EVM RPC URL is required")
    16	        self.urls = urls
    17	        self.timeout = timeout
    18	        self.delay = max(0, delay_ms) / 1000.0
    19	        self._counter = itertools.count(1)
    20	        self._url_index = 0
    21	        self.session = requests.Session()
    22	
    23	    def _next_urls(self):
    24	        for i in range(len(self.urls)):
    25	            yield self.urls[(self._url_index + i) % len(self.urls)]
    26	
    27	    def call(self, method: str, params: list[Any]) -> Any:
    28	        last_error = None
    29	        for url in self._next_urls():
    30	            if self.delay:
    31	                time.sleep(self.delay)
    32	            payload = {
    33	                "jsonrpc": "2.0",
    34	                "id": next(self._counter),
    35	                "method": method,
    36	                "params": params,
    37	            }
    38	            try:
    39	                r = self.session.post(url, json=payload, timeout=self.timeout)
    40	                r.raise_for_status()
    41	                data = r.json()
    42	                if "error" in data:
    43	                    raise RPCError(f"{method}: {data['error']}")
    44	                self._url_index = self.urls.index(url)
    45	                return data.get("result")
    46	            except Exception as exc:
    47	                last_error = exc
    48	                continue
    49	        raise RPCError(f"All RPC endpoints failed for {method}: {last_error}")
    50	
    51	    def latest_block(self) -> int:
    52	        return int(self.call("eth_blockNumber", []), 16)
    53	
    54	    def block(self, number: int, full_transactions: bool = True) -> dict:
    55	        result = self.call("eth_getBlockByNumber", [hex(number), full_transactions])
    56	        if not result:
    57	            raise RPCError(f"Block {number} not found")
    58	        return result
    59	
    60	    def receipt(self, tx_hash: str) -> Optional[dict]:
    61	        return self.call("eth_getTransactionReceipt", [tx_hash])
    62	
    63	    def code(self, address: str, block: str = "latest") -> str:
    64	        return self.call("eth_getCode", [address, block]) or "0x"
    65	
    66	    def eth_call(self, to: str, data: str, block: str = "latest") -> str:
    67	        return self.call("eth_call", [{"to": to, "data": data}, block]) or "0x"
     1	from __future__ import annotations
     2	
     3	import csv
     4	import hashlib
     5	import os
     6	import time
     7	from pathlib import Path
     8	
     9	
    10	def _rows(path: Path):
    11	    if not path.exists():
    12	        return []
    13	    with path.open('r', encoding='utf-8-sig', newline='') as f:
    14	        return list(csv.DictReader(f))
    15	
    16	
    17	def _write(path: Path, rows: list[dict], fieldnames: list[str]):
    18	    path.parent.mkdir(parents=True, exist_ok=True)
    19	    tmp = path.with_suffix(path.suffix + '.tmp')
    20	    with tmp.open('w', encoding='utf-8', newline='') as f:
    21	        w = csv.DictWriter(f, fieldnames=fieldnames)
    22	        w.writeheader()
    23	        w.writerows([{k: row.get(k, '') for k in fieldnames} for row in rows])
    24	        f.flush(); os.fsync(f.fileno())
    25	    os.replace(tmp, path)
    26	
    27	
    28	def queue_armed_recommendations(app, recommendations: list[dict]) -> dict:
    29	    """Queue eligible ARMED recommendations for a separate local executor.
    30	
    31	    Security boundary: this function NEVER signs, approves, broadcasts, withdraws,
    32	    or reads a private key. It only creates a local queue row.
    33	    """
    34	    op = app.operator_settings()
    35	    queue_enabled = str(op.get('execution_queue_enabled', 'true')).strip().lower() in {'1','true','yes','on'}
    36	    path = Path(app.csv_dir) / 'auto' / 'execution_queue.csv'
    37	    fieldnames = [
    38	        'queue_id','recommendation_id','chain_id','chain_slug','wallet','behaviour','route_id',
    39	        'recommended_input_base','minimum_expected_profit_base','status','created_at','updated_at','note'
    40	    ]
    41	    rows = _rows(path)
    42	    existing = {r.get('recommendation_id') for r in rows}
    43	    added = 0
    44	    if queue_enabled:
    45	        now = int(time.time())
    46	        for rec in recommendations:
    47	            if (rec.get('recommendation_mode') or '').upper() != 'ARMED':
    48	                continue
    49	            if rec.get('action') != 'IN':
    50	                continue
    51	            rid = str(rec.get('recommendation_id') or '')
    52	            if not rid or rid in existing:
    53	                continue
    54	            qid = hashlib.sha256(f"{rid}|{now}".encode()).hexdigest()[:24]
    55	            rows.append({
    56	                'queue_id': qid,
    57	                'recommendation_id': rid,
    58	                'chain_id': rec.get('chain_id',''),
    59	                'chain_slug': rec.get('chain_slug',''),
    60	                'wallet': rec.get('wallet',''),
    61	                'behaviour': rec.get('behaviour',''),
    62	                'route_id': rec.get('route_id',''),
    63	                'recommended_input_base': rec.get('recommended_input_base',''),
    64	                'minimum_expected_profit_base': rec.get('conservative_net_profit_base',''),
    65	                'status': 'PENDING_LOCAL_EXECUTOR',
    66	                'created_at': now,
    67	                'updated_at': now,
    68	                'note': 'Historical queue rows are never auto-signed. v2.2 auto execution uses only fresh scanner routes that are re-quoted and re-simulated immediately before signing.',
    69	            })
    70	            existing.add(rid); added += 1
    71	    if rows or not path.exists():
    72	        _write(path, rows[-5000:], fieldnames)
    73	    return {'added': added, 'total': len(rows), 'path': str(path), 'enabled': queue_enabled}
    74	
    75	
    76	def queue_summary(csv_dir: Path) -> dict:
    77	    path = Path(csv_dir) / 'auto' / 'execution_queue.csv'
    78	    rows = _rows(path)
    79	    pending = [r for r in rows if (r.get('status') or '') == 'PENDING_LOCAL_EXECUTOR']
    80	    return {'path': path, 'total': len(rows), 'pending': len(pending), 'recent': rows[-10:]}

