    39	def sign_versioned_transaction(raw_transaction: bytes, keypair_bytes: bytes) -> bytes:
    40	    """Sign exactly one-wallet-signer Jupiter v0 transaction without changing its message."""
    41	    tx = VersionedTransaction.from_bytes(bytes(raw_transaction))
    42	    kp = Keypair.from_bytes(bytes(keypair_bytes))
    43	    message = tx.message
    44	    keys = list(message.account_keys)
    45	    required = int(message.header.num_required_signatures)
    46	    signer_keys = keys[:required]
    47	    matches = [i for i, key in enumerate(signer_keys) if key == kp.pubkey()]
    48	    if len(matches) != 1:
    49	        raise SolanaLiveError("Active Solana wallet is not the required transaction signer")
    50	    # Canary path excludes JupiterZ/RFQ. Reject unexpected multi-signer orders rather
    51	    # than risking an incomplete or incorrectly modified transaction.
    52	    if required != 1:
    53	        raise SolanaLiveError(f"LIVE canary refuses a transaction requiring {required} signers")
    54	    sigs = list(tx.signatures)
    55	    while len(sigs) < required:
    56	        sigs.append(Signature.default())
    57	    sigs[matches[0]] = kp.sign_message(to_bytes_versioned(message))
    58	    tx.signatures = sigs
    59	    return bytes(tx)
