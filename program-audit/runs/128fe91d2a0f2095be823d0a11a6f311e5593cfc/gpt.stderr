    26	def _rows(path: Path):
    27	    if not path.exists(): return []
    28	    with path.open("r", encoding="utf-8-sig", newline="") as f:return list(csv.DictReader(f))
    29	
    30	def _append(path: Path, row: dict):
    31	    headers=["timestamp_epoch","telegram_id","wallet_id","chain_id","chain_slug","route_id","route_path","input_base","expected_gross_base","expected_gas_base","expected_net_base","realised_net_base","profit_fee_base","fee_tx_hash","tx_hash","status","note"]
    32	    rows=_rows(path);rows.append(row);rows=rows[-10000:];path.parent.mkdir(parents=True,exist_ok=True);tmp=path.with_suffix(path.suffix+".tmp")
    33	    with tmp.open("w",encoding="utf-8",newline="") as f:
    34	        w=csv.DictWriter(f,fieldnames=headers);w.writeheader();w.writerows([{h:r.get(h,"") for h in headers} for r in rows]);f.flush();os.fsync(f.fileno())
    35	    os.replace(tmp,path)
    36	
    37	
    38	def _append_simulation(csv_dir: Path, row: dict):
    39	    """Append a bounded no-broadcast wallet simulation audit row."""
    40	    path=Path(csv_dir)/"auto"/"auto_trade_simulations.csv"
    41	    headers=["timestamp_epoch","telegram_id","wallet_id","chain_id","chain_slug","route_id","route_path","input_base","min_net_profit_base","gross_profit_base","gas_cost_base","simulation_ok","reason"]
    42	    rows=_rows(path);rows.append(row);rows=rows[-10000:];path.parent.mkdir(parents=True,exist_ok=True);tmp=path.with_suffix(path.suffix+".tmp")
    43	    with tmp.open("w",encoding="utf-8",newline="") as f:
    44	        w=csv.DictWriter(f,fieldnames=headers);w.writeheader();w.writerows([{h:r.get(h,"") for h in headers} for r in rows]);f.flush();os.fsync(f.fileno())
    45	    os.replace(tmp,path)
    46	
