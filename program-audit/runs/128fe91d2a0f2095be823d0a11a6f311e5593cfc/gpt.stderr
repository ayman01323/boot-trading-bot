    88	def _ensure_live_safety_schema(conn):
    89	    conn.executescript(_LIVE_SAFETY_SCHEMA)
    90	
    91	
    92	def _attempt_key(tid, event):
    93	    raw = "|".join([
    94	        str(tid),
    95	        str(event.get("leader_wallet") or ""),
    96	        str(event.get("signature") or ""),
    97	        str(event.get("mint") or ""),
    98	        str(event.get("action") or "").upper(),
    99	    ])
   100	    return hashlib.sha256(raw.encode()).hexdigest()
   101	
   102	
   103	def _claim_attempt(app, tid, event):
   104	    """Atomically reserve one chain attempt for a user+leader signature+mint+action."""
   105	    key = _attempt_key(tid, event)
   106	    now = int(time.time())
   107	    with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   108	        _ensure_live_safety_schema(conn)
   109	        cur = conn.execute(
   110	            """INSERT OR IGNORE INTO live_execution_attempts(
   111	                 attempt_key,telegram_id,leader_wallet,leader_signature,mint,action,status,created_at,updated_at
   112	               ) VALUES(?,?,?,?,?,?,?,?,?)""",
   113	            (key, str(tid), str(event.get("leader_wallet") or ""), str(event.get("signature") or ""),
   114	             str(event.get("mint") or ""), str(event.get("action") or "").upper(), "CLAIMED", now, now),
   115	        )
   116	        conn.commit()
   117	        return cur.rowcount == 1, key
   118	
   119	
   120	def _execution_fields(trade):
   121	    trade = dict(trade or {})
   122	    def s(key):
   123	        value = trade.get(key)
   124	        return "" if value is None else str(value)
   125	    return {
   126	        "tx_signature": s("signature"),
   127	        "input_raw": s("totalInputAmount") or s("inputAmountResult"),
   128	        "output_raw": s("totalOutputAmount") or s("outputAmountResult"),
   129	        "wallet_before_lamports": s("wallet_before_lamports"),
   130	        "wallet_after_lamports": s("wallet_after_lamports"),
   131	        "wallet_delta_lamports": s("wallet_delta_lamports"),
   132	    }
   133	
   134	
   135	def _update_attempt(app, key, status, trade=None, error=""):
   136	    fields = _execution_fields(trade)
   137	    with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   138	        _ensure_live_safety_schema(conn)
   139	        conn.execute(
   140	            """UPDATE live_execution_attempts
   141	               SET status=?,tx_signature=?,input_raw=?,output_raw=?,wallet_before_lamports=?,
   142	                   wallet_after_lamports=?,wallet_delta_lamports=?,error=?,updated_at=?
   143	               WHERE attempt_key=?""",
   144	            (str(status), fields["tx_signature"], fields["input_raw"], fields["output_raw"],
   145	             fields["wallet_before_lamports"], fields["wallet_after_lamports"], fields["wallet_delta_lamports"],
   146	             str(error or "")[:1200], int(time.time()), str(key)),
   147	        )
   148	        conn.commit()
   149	
