    30	def _append(path: Path, row: dict):
    31	    headers=["timestamp_epoch","telegram_id","wallet_id","chain_id","chain_slug","route_id","route_path","input_base","expected_gross_base","expected_gas_base","expected_net_base","realised_net_base","profit_fee_base","fee_tx_hash","tx_hash","status","note"]
    32	    rows=_rows(path);rows.append(row);rows=rows[-10000:];path.parent.mkdir(parents=True,exist_ok=True);tmp=path.with_suffix(path.suffix+".tmp")
    33	    with tmp.open("w",encoding="utf-8",newline="") as f:
    34	        w=csv.DictWriter(f,fieldnames=headers);w.writeheader();w.writerows([{h:r.get(h,"") for h in headers} for r in rows]);f.flush();os.fsync(f.fileno())
    35	    os.replace(tmp,path)
