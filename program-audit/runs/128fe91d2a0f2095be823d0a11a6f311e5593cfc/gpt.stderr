   264	    if getattr(_live, "_position_wallet_binding_patch_installed", False):
   265	        return
   266	    _exec.SolanaLiveExecutor.__init__ = _executor_init
   267	    _exec.SolanaLiveExecutor.swap = _swap_with_wallet_identity
   268	    _live.SolanaLiveExecutor = _exec.SolanaLiveExecutor
   269	    _live._insert_live_position = _insert_with_wallet_binding
   270	    _live._close_live = _close_bound_live
   271	    _live._position_wallet_binding_patch_installed = True
