    18	def _bool(v, default=False):
    19	    if v is None: return default
    20	    return str(v).strip().lower() in {"1","true","yes","on","y"}
    21	
    22	def _dec(v, default="0"):
    23	    try: return Decimal(str(v))
    24	    except Exception: return Decimal(str(default))
