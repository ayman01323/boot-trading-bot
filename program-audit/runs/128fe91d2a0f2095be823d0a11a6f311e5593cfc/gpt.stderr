     3	from .tokenmeta import get_token_meta
     4	
     5	TRANSFER_TOPIC = "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef"
     6	
     7	def _int(v, default=0):
     8	    if v in (None, ""):
     9	        return default
    10	    if isinstance(v, int):
    11	        return v
    12	    return int(v, 16) if isinstance(v, str) and v.startswith("0x") else int(v)
    13	
    14	def _topic_addr(topic: str) -> str:
    15	    return "0x" + topic[-40:].lower()
    16	
    17	def ingest_receipt(conn, rpc, tx_hash: str, settings=None) -> int:
    18	    receipt = rpc.receipt(tx_hash)
    19	    if not receipt:
    20	        return 0
    21	
    22	    status = _int(receipt.get("status"), None) if receipt.get("status") is not None else None
    23	    gas_used = _int(receipt.get("gasUsed"), 0)
    24	    effective = _int(receipt.get("effectiveGasPrice"), 0)
    25	    conn.execute(
    26	        """UPDATE transactions
    27	           SET status=?,gas_used=?,effective_gas_price_wei=?,receipt_scanned=1
    28	           WHERE tx_hash=?""",
    29	        (status, gas_used, str(effective), tx_hash),
    30	    )
    31	
    32	    inserted = 0
    33	    for log in receipt.get("logs", []):
    34	        topics = [str(x).lower() for x in log.get("topics", [])]
    35	        if len(topics) < 3 or topics[0] != TRANSFER_TOPIC:
    36	            continue
    37	        token = (log.get("address") or "").lower()
    38	        if not token:
    39	            continue
    40	        from_addr = _topic_addr(topics[1])
    41	        to_addr = _topic_addr(topics[2])
    42	        raw_amount = str(_int(log.get("data"), 0))
    43	        log_index = _int(log.get("logIndex"), 0)
    44	        conn.execute(
    45	            """INSERT OR IGNORE INTO token_transfers(
    46	                tx_hash,log_index,token,from_addr,to_addr,raw_amount
    47	            ) VALUES(?,?,?,?,?,?)""",
    48	            (tx_hash, log_index, token, from_addr, to_addr, raw_amount),
    49	        )
    50	        # Fetch metadata lazily. Failure is non-fatal.
    51	        try:
    52	            get_token_meta(conn, rpc, token, getattr(settings, "csv_dir", None), getattr(settings, "chain_id", None))
    53	        except Exception:
    54	            pass
    55	        inserted += 1
    56	    conn.commit()
    57	    return inserted

