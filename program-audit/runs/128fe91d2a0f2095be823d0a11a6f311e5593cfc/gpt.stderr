   185	def load_price_override(csv_dir:Path,chain_id:int,symbol:str):
   186	    for row in _rows(csv_dir/"price_overrides.csv"):
   187	        if not _bool(row.get("enabled"),False): continue
   188	        if (row.get("chain_id") or "").strip()!=str(chain_id): continue
   189	        if (row.get("symbol") or "").strip().upper()!=symbol.upper(): continue
   190	        try:return float(row.get("usd"))
   191	        except:return None
   192	    return None
