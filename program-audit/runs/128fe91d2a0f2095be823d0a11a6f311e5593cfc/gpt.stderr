    10	def fault_count(app, tid) -> int:
    11	    key = f"solana_live_landed_fault_count:{tid}"
    12	    with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
    13	        return max(0, _sol._int(_sol._state(conn, key, "0"), 0))
