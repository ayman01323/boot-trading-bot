   543	def swap_with_cost_receipt(self, input_mint: str, output_mint: str, amount_raw: int):
   544	    reuse_available = False
   545	    if str(input_mint) == str(_sol.WSOL_MINT) and str(output_mint) != str(_sol.WSOL_MINT):
   546	        reuse_available = _token_account_count(self, output_mint) > 0
   547	    try:
   548	        result = dict(_PREV_SWAP(self, input_mint, output_mint, amount_raw) or {})
   549	    except _exec.SolanaLivePostExecutionError as exc:
   550	        result = dict(getattr(exc, "result", {}) or {})
   551	        if result.get("signature"):
   552	            _persist_receipt(
   553	                self, result, input_mint, output_mint, amount_raw,
   554	                source="JUPITER_ORDER_LANDED_INVALID", reused_output_account=reuse_available,
   555	            )
   556	        raise
   557	    _persist_receipt(
   558	        self, result, input_mint, output_mint, amount_raw,
   559	        source="JUPITER_ORDER", reused_output_account=reuse_available,
   560	    )
   561	    if _action(input_mint, output_mint) == "BUY" and result.get("signature"):
   562	        _notify_receipt(self.app, self.telegram_id, str(result.get("signature")))
   563	    return result
   564	
   565	
   566	def _api_instruction(raw: dict) -> Instruction:
   567	    if not isinstance(raw, dict) or not raw.get("programId"):
   568	        raise _exec.SolanaLiveError("Jupiter /build returned an invalid instruction")
   569	    try:
   570	        data = base64.b64decode(str(raw.get("data") or ""), validate=True)
   571	        accounts = [
   572	            AccountMeta(
   573	                Pubkey.from_string(str(a.get("pubkey"))),
   574	                bool(a.get("isSigner")),
   575	                bool(a.get("isWritable")),
   576	            )
   577	            for a in (raw.get("accounts") or [])
   578	        ]
   579	        return Instruction(Pubkey.from_string(str(raw["programId"])), data, accounts)
   580	    except Exception as exc:
   581	        raise _exec.SolanaLiveError("Cannot decode Jupiter /build instruction") from exc
   582	
   583	
   584	def _lookup_tables(build: dict):
   585	    out = []
   586	    raw = build.get("addressesByLookupTableAddress") or {}
   587	    if not isinstance(raw, dict):
   588	        return out
   589	    for key, addresses in raw.items():
   590	        out.append(
   591	            AddressLookupTableAccount(
   592	                key=Pubkey.from_string(str(key)),
   593	                addresses=[Pubkey.from_string(str(a)) for a in (addresses or [])],
   594	            )
   595	        )
   596	    return out
   597	
   598	
   599	def _atomic_candidate(executor, mint: str, amount_raw: int):
   600	    actual = int(executor.token_balance_raw(mint))
   601	    if int(amount_raw) < actual:
   602	        return None
   603	    if actual <= 0 or int(amount_raw) != actual:
   604	        raise _exec.SolanaLiveError(f"Atomic full exit requires exact whole-token balance: have {actual}, requested {amount_raw}")
   605	
   606	    with closing(_sol.connect(executor.app)) as conn:
   607	        positions = [dict(r) for r in conn.execute(
   608	            """SELECT * FROM positions WHERE telegram_id=? AND mint=? AND mode='LIVE' AND status='OPEN' ORDER BY entry_ts""",
   609	            (str(executor.telegram_id), str(mint)),
   610	        ).fetchall()]
   611	    if len(positions) != 1:
   612	        raise _exec.SolanaLiveError(f"Atomic full exit requires exactly one OPEN LIVE position for mint; found {len(positions)}")
   613	    position = positions[0]
   614	    binding = _binding._binding(executor.app, position.get("position_id"))
   615	    if not binding or str(binding.get("wallet_address") or "") != str(executor.address):
   616	        raise _exec.SolanaLiveError("Atomic full exit wallet does not match the recorded entry-wallet binding")
   617	
   618	    current = _reclaim._token_accounts(executor, mint)
   619	    if current is None:
   620	        raise _exec.SolanaLiveError("Atomic full exit cannot prove token-account state")
   621	    positive = [row for row in current.values() if int(row.get("amount") or 0) > 0]
   622	    if len(positive) != 1 or int(positive[0].get("amount") or 0) != actual:
   623	        raise _exec.SolanaLiveError("Atomic full exit requires one unambiguous token account holding the entire position")
   624	    live_account = positive[0]
   625	
   626	    tracked = _reclaim._tracked_accounts(executor.app, position.get("position_id"))
   627	    matches = [r for r in tracked if str(r.get("account_pubkey") or "") == str(live_account.get("pubkey") or "")]
   628	    if len(matches) != 1:
   629	        raise _exec.SolanaLiveError("Atomic full exit refuses to close an account not proven to have been created by this bot")
   630	    row = matches[0]
   631	    if str(row.get("program_id") or "") not in _reclaim._ALLOWED_TOKEN_PROGRAMS:
   632	        raise _exec.SolanaLiveError("Atomic full exit token program is not approved")
   633	    if str(row.get("program_id") or "") != str(live_account.get("program_id") or ""):
   634	        raise _exec.SolanaLiveError("Atomic full exit token-program mismatch")
   635	    return position, row, live_account
   636	
   637	
   638	def _build_atomic_swap(executor, input_mint: str, amount_raw: int, slippage_bps: int) -> dict:
   639	    params = {
   640	        "inputMint": str(input_mint),
   641	        "outputMint": str(_sol.WSOL_MINT),
   642	        "amount": str(int(amount_raw)),
   643	        "taker": str(executor.address),
   644	        "slippageBps": str(int(slippage_bps)),
   645	        "wrapAndUnwrapSol": "true",
   646	        "nativeDestinationAccount": str(executor.address),
   647	        "maxAccounts": "64",
   648	    }
   649	    r = requests.get(JUPITER_BUILD_URL, params=params, headers=_headers(executor), timeout=30)
   650	    r.raise_for_status()
   651	    data = r.json()
   652	    if data.get("error") or data.get("errorCode") or _i(data.get("outAmount"), 0) <= 0 or not data.get("swapInstruction"):
   653	        raise _exec.SolanaLiveError(
   654	            "Jupiter /build failed: " + str(data.get("error") or data.get("errorMessage") or data.get("errorCode") or "invalid build")
   655	        )
   656	    return data
   657	
   658	
   659	def _compile_tx(owner: Pubkey, instructions: list[Instruction], lookups, blockhash: Hash, signer: Keypair):
   660	    message = MessageV0.try_compile(owner, instructions, lookups, blockhash)
   661	    return VersionedTransaction(message, [signer])
   662	
   663	
   664	def atomic_full_sell(self, input_mint: str, amount_raw: int, candidate) -> dict:
   665	    position, tracked_row, live_account = candidate
   666	    cfg = _cfg(self.app)
   667	    slippage_bps = max(1, min(10_000, _i(cfg.get("live_order_slippage_bps"), 50)))
   668	
   669	    # Guarded /order is used as a no-broadcast market/fee/congestion probe.  We
   670	    # deliberately discard its prebuilt transaction because it cannot be modified.
   671	    probe = self._order(input_mint, _sol.WSOL_MINT, int(amount_raw))
   672	    fee_cap = max(DEFAULT_BASE_FEE_LAMPORTS, _i(probe.get("_fee_cap_lamports"), 0))
   673	    trade_value = max(1, _i(probe.get("_trade_value_lamports"), probe.get("outAmount") or 0))
   674	    required_priority = max(0, _i(probe.get("prioritizationFeeLamports"), 0))
   675	
   676	    build = _build_atomic_swap(self, input_mint, amount_raw, slippage_bps)
   677	    build_out = max(1, _i(build.get("outAmount"), 0))
   678	    probe_out = max(1, _i(probe.get("outAmount") or probe.get("outputAmount"), build_out))
   679	    deterioration = max(Decimal(0), (Decimal(probe_out - build_out) * Decimal(10_000) / Decimal(probe_out)))
   680	    max_deterioration = max(Decimal(0), _d(cfg.get("live_atomic_route_deterioration_bps"), 50))
   681	    if deterioration > max_deterioration:
   682	        _reject(
   683	            self,
   684	            f"atomic /build route is {deterioration:.2f} bps worse than guarded /order quote (limit {max_deterioration:.0f})",
   685	            input_mint=input_mint, output_mint=_sol.WSOL_MINT, amount_raw=amount_raw,
   686	            trade_value_lamports=trade_value, fee_cap_lamports=fee_cap,
   687	        )
   688	    build_hops = _route_hops(build)
   689	    if build_hops > 1:
   690	        combined = deterioration + Decimal(slippage_bps)
   691	        multi_max = max(Decimal(1), _d(cfg.get("live_multihop_max_combined_bps"), 100))
   692	        if combined > multi_max:
   693	            _reject(
   694	                self,
   695	                f"multi-leg atomic route deterioration+slippage {combined:.2f} bps exceeds {multi_max:.0f} bps",
   696	                input_mint=input_mint, output_mint=_sol.WSOL_MINT, amount_raw=amount_raw,
   697	                trade_value_lamports=trade_value, fee_cap_lamports=fee_cap,
   698	            )
   699	
   700	    owner = Keypair.from_bytes(bytes(self.keypair))
   701	    if str(owner.pubkey()) != str(self.address):
   702	        raise _exec.SolanaLiveError("Atomic full-exit signer does not match execution wallet")
   703	    owner_pk = owner.pubkey()
   704	
   705	    close_ix = Instruction(
   706	        Pubkey.from_string(str(live_account["program_id"])),
   707	        bytes([9]),
   708	        [
   709	            AccountMeta(Pubkey.from_string(str(live_account["pubkey"])), False, True),
   710	            AccountMeta(owner_pk, False, True),
   711	            AccountMeta(owner_pk, True, False),
   712	        ],
   713	    )
   714	    core = []
   715	    core.extend(_api_instruction(ix) for ix in (build.get("setupInstructions") or []))
   716	    core.append(_api_instruction(build["swapInstruction"]))
   717	    core.append(close_ix)
   718	    if build.get("cleanupInstruction"):
   719	        core.append(_api_instruction(build["cleanupInstruction"]))
   720	    core.extend(_api_instruction(ix) for ix in (build.get("otherInstructions") or []))
   721	    lookups = _lookup_tables(build)
   722	
   723	    latest = _sol._rpc(self.app, "getLatestBlockhash", [{"commitment": "confirmed"}]) or {}
   724	    blockhash_text = str((latest.get("value") or {}).get("blockhash") or "")
   725	    if not blockhash_text:
   726	        raise _exec.SolanaLiveError("Atomic full exit cannot obtain a recent blockhash")
   727	    blockhash = Hash.from_string(blockhash_text)
   728	
   729	    sim_tx = _compile_tx(owner_pk, [set_compute_unit_limit(MAX_COMPUTE_UNITS), *core], lookups, blockhash, owner)
   730	    sim_b64 = base64.b64encode(bytes(sim_tx)).decode("ascii")
   731	    sim = _sol._rpc(
   732	        self.app,
   733	        "simulateTransaction",
   734	        [sim_b64, {"encoding": "base64", "sigVerify": True, "commitment": "confirmed"}],
   735	    ) or {}
   736	    value = sim.get("value") or {}
   737	    if value.get("err") is not None:
   738	        logs = value.get("logs") or []
   739	        raise _exec.SolanaLiveError(
   740	            "Atomic sell+CloseAccount simulation failed: " + str(value.get("err")) + " | " + " | ".join(map(str, logs[-5:]))[:600]
   741	        )
   742	    consumed = max(1, _i(value.get("unitsConsumed"), 0))
   743	    buffer_pct = max(0, min(50, _i(cfg.get("live_atomic_compute_buffer_pct"), 10)))
   744	    cu_limit = min(MAX_COMPUTE_UNITS, max(50_000, int(math.ceil(consumed * (100 + buffer_pct) / 100))))
   745	
   746	    priority_budget = max(0, fee_cap - DEFAULT_BASE_FEE_LAMPORTS)
   747	    if required_priority > priority_budget:
   748	        _reject(
   749	            self,
   750	            f"current managed-route priority/tip estimate {required_priority} exceeds atomic fee budget {priority_budget}",
   751	            input_mint=input_mint, output_mint=_sol.WSOL_MINT, amount_raw=amount_raw,
   752	            trade_value_lamports=trade_value, fee_cap_lamports=fee_cap,
   753	        )
   754	    target_priority = min(priority_budget, required_priority)
   755	    cu_price = 0 if target_priority <= 0 else max(1, (target_priority * 1_000_000) // cu_limit)
   756	    projected_priority = int(math.ceil(cu_price * cu_limit / 1_000_000))
   757	    if DEFAULT_BASE_FEE_LAMPORTS + projected_priority > fee_cap:
   758	        _reject(
   759	            self,
   760	            f"projected atomic network fee {DEFAULT_BASE_FEE_LAMPORTS + projected_priority} exceeds cap {fee_cap}",
   761	            input_mint=input_mint, output_mint=_sol.WSOL_MINT, amount_raw=amount_raw,
   762	            trade_value_lamports=trade_value, fee_cap_lamports=fee_cap,
   763	        )
   764	
   765	    final_instructions = [set_compute_unit_limit(cu_limit), set_compute_unit_price(cu_price), *core]
   766	    tx = _compile_tx(owner_pk, final_instructions, lookups, blockhash, owner)
   767	    raw = bytes(tx)
   768	    if len(raw) > MAX_TX_BYTES:
   769	        raise _exec.SolanaLiveError(f"Atomic sell+close transaction is {len(raw)} bytes, above Solana limit {MAX_TX_BYTES}")
   770	
   771	    wallet_before = int(self.native_balance_lamports())
   772	    token_before = int(self.token_balance_raw(input_mint))
   773	    signed_b64 = base64.b64encode(raw).decode("ascii")
   774	    signature = str(_sol._rpc(
   775	        self.app,
   776	        "sendTransaction",
   777	        [signed_b64, {"encoding": "base64", "skipPreflight": False, "preflightCommitment": "confirmed", "maxRetries": 3}],
   778	    ) or "")
   779	    if not signature:
   780	        raise _exec.SolanaLiveError("Atomic sell+close RPC returned no signature")
   781	
   782	    tx_json = _confirmed_transaction(self.app, signature, attempts=12)
   783	    if not tx_json:
   784	        raise _exec.SolanaLivePostExecutionError(
   785	            "Atomic sell+close was submitted but confirmation details are unavailable",
   786	            {"signature": signature, "wallet_before_lamports": wallet_before},
   787	        )
   788	    meta = dict(tx_json.get("meta") or {})
   789	    if meta.get("err") is not None:
   790	        raise _exec.SolanaLivePostExecutionError(
   791	            "Atomic sell+close landed with transaction error: " + str(meta.get("err")),
   792	            {"signature": signature, "wallet_before_lamports": wallet_before},
   793	        )
   794	
   795	    wallet_after = int(self.native_balance_lamports())
   796	    token_after = int(self.token_balance_raw(input_mint))
   797	    if token_before - token_after <= 0:
   798	        raise _exec.SolanaLivePostExecutionError(
   799	            "Atomic sell+close landed but input-token balance did not decrease",
   800	            {"signature": signature, "wallet_before_lamports": wallet_before, "wallet_after_lamports": wallet_after},
   801	        )
   802	    current_after = _reclaim._token_accounts(self, input_mint)
   803	    if current_after is None or str(live_account["pubkey"]) in current_after:
   804	        raise _exec.SolanaLivePostExecutionError(
   805	            "Atomic sell landed but the proven bot-created token account was not closed",
   806	            {"signature": signature, "wallet_before_lamports": wallet_before, "wallet_after_lamports": wallet_after},
   807	        )
   808	
   809	    rent_reclaimed = max(0, int(live_account.get("lamports") or tracked_row.get("entry_lamports") or 0))
   810	    try:
   811	        _reclaim._mark_reconciled(
   812	            self.app, str(position.get("position_id") or ""), signature, [tracked_row], rent_reclaimed
   813	        )
   814	    except Exception as exc:
   815	        print("[solana-atomic-close-reconcile]", type(exc).__name__, str(exc)[:300])
   816	
   817	    network_fee = max(0, _i(meta.get("fee"), DEFAULT_BASE_FEE_LAMPORTS + projected_priority))
   818	    wallet_delta = wallet_after - wallet_before
   819	    swap_received = max(1, wallet_delta + network_fee - rent_reclaimed)
   820	    order_for_receipt = dict(probe)
   821	    order_for_receipt["router"] = "metis-build-atomic"
   822	    order_for_receipt["platformFee"] = {"amount": "0", "feeBps": 0, "feeMint": ""}
   823	    order_for_receipt["feeBps"] = 0
   824	    order_for_receipt["prioritizationFeeLamports"] = projected_priority
