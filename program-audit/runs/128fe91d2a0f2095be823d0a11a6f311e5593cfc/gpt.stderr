     1	from __future__ import annotations
     2	
     3	import hashlib
     4	import time
     5	from contextlib import closing
     6	from decimal import Decimal
     7	
     8	from . import solana_sibot as _sol
     9	from .solana_live_executor import SolanaLiveError, SolanaLiveExecutor, SolanaLivePostExecutionError
    10	from .telegram import send_message
    11	from .user_registry import all_users, set_user_setting, user_bool, user_setting
    12	
    13	# LIVE execution defaults. These controls deliberately fail closed around landed
    14	# transactions whose economic result cannot be proved.
    15	_sol.DEFAULTS.update({
    16	    "live_trade_sol": ("0.005", "Real SOL amount per guarded Solana LIVE copied BUY"),
    17	    "live_min_sol_reserve": ("0.02", "SOL that must remain untouched for fees and emergency exits"),
    18	    "live_max_positions": ("1", "Maximum simultaneous Solana LIVE positions per Telegram user"),
    19	    "live_require_simulation": ("true", "Require successful Solana simulation before Jupiter execute"),
    20	    "live_require_execute_output": ("true", "Require positive Jupiter executed input and output after LIVE submission"),
    21	    "live_require_swap_events": ("true", "Require Jupiter swapEvents after a successful LIVE execution"),
    22	    "live_no_output_disable_after": ("2", "Disable Solana LIVE after this many landed-but-invalid executions"),
    23	    "live_min_economic_trade_sol": ("0.0005", "Reject configured LIVE buys below this economic minimum instead of silently upsizing"),
    24	    "live_max_observed_overhead_pct": ("35", "Reject new LIVE buys when recent actual SOL overhead exceeds this percentage of trade size"),
    25	})
    26	
    27	_LIVE_SAFETY_SCHEMA = r"""
    28	CREATE TABLE IF NOT EXISTS live_execution_attempts(
    29	  attempt_key TEXT PRIMARY KEY,
    30	  telegram_id TEXT NOT NULL,
    31	  leader_wallet TEXT NOT NULL,
    32	  leader_signature TEXT NOT NULL,
    33	  mint TEXT NOT NULL,
    34	  action TEXT NOT NULL,
    35	  status TEXT NOT NULL,
    36	  tx_signature TEXT,
    37	  input_raw TEXT,
    38	  output_raw TEXT,
    39	  wallet_before_lamports TEXT,
    40	  wallet_after_lamports TEXT,
    41	  wallet_delta_lamports TEXT,
    42	  error TEXT,
    43	  created_at INTEGER NOT NULL,
    44	  updated_at INTEGER NOT NULL
    45	);
    46	CREATE INDEX IF NOT EXISTS idx_sol_live_attempts_user ON live_execution_attempts(telegram_id,created_at DESC);
    47	CREATE INDEX IF NOT EXISTS idx_sol_live_attempts_status ON live_execution_attempts(telegram_id,status,created_at DESC);
    48	"""
    49	
    50	
    51	def live_enabled(app, telegram_id) -> bool:
    52	    return user_bool(app.csv_dir, telegram_id, _sol.SOLANA_CHAIN_ID, "solana_live_enabled", False)
    53	
    54	
    55	def live_limits(app, telegram_id, cfg=None):
    56	    """Return the effective per-user LIVE trade amount and untouched SOL reserve.
    57	
    58	    Platform defaults remain authoritative unless a user-specific override exists.
    59	    A user override may reduce the reserve for low-capital canary trading, but never
    60	    below 0.005 SOL. Trade size remains bounded to 0.0005-0.005 SOL.
    61	    """
    62	    cfg = dict(cfg or _sol.settings(app))
    63	    base_trade = _sol._dec(cfg.get("live_trade_sol"), ".005")
    64	    base_reserve = _sol._dec(cfg.get("live_min_sol_reserve"), ".02")
    65	    trade_override = user_setting(
    66	        app.csv_dir, telegram_id, _sol.SOLANA_CHAIN_ID, "solana_live_trade_sol", None
    67	    )
    68	    reserve_override = user_setting(
    69	        app.csv_dir, telegram_id, _sol.SOLANA_CHAIN_ID, "solana_live_min_reserve_sol", None
    70	    )
    71	    requested_trade = _sol._dec(trade_override, base_trade) if trade_override is not None else base_trade
    72	    trade = min(Decimal("0.005"), max(Decimal("0.0005"), requested_trade))
    73	    if reserve_override is None:
    74	        reserve = max(Decimal("0.01"), base_reserve)
    75	    else:
    76	        reserve = max(Decimal("0.005"), _sol._dec(reserve_override, base_reserve))
    77	    return trade, reserve
    78	
    79	
    80	def _notify(app, tid, text):
    81	    try:
    82	        if getattr(app, "telegram_bot_token", ""):
    83	            send_message(app.telegram_bot_token, str(tid), text, parse_mode="HTML", protect_content=True)
    84	    except Exception:
    85	        pass
