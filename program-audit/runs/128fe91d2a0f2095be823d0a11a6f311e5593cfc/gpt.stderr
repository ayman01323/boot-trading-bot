   175	def _code_hash(code: str) -> str:
   176	    return hashlib.sha256(str(code).strip().encode("utf-8")).hexdigest()
   177	
   178	
   179	def redeem_activation_code(csv_dir: Path, telegram_id, code: str) -> dict:
   180	    code = str(code or "").strip()
   181	    if not code:
   182	        raise ValueError("Activation code is empty")
   183	    path = activation_codes_path(csv_dir); rows = _rows(path); now = int(time.time()); target = None
   184	    h = _code_hash(code)
   185	    for row in rows:
   186	        if (row.get("code_hash") or "").strip().lower() != h:
   187	            continue
   188	        if not _bool(row.get("enabled"), True):
   189	            raise ValueError("Activation code is disabled")
   190	        expires = int(float(row.get("expires_epoch") or 0))
   191	        if expires and now > expires:
   192	            raise ValueError("Activation code has expired")
   193	        max_uses = int(float(row.get("max_uses") or 1)); uses = int(float(row.get("uses") or 0))
   194	        if max_uses > 0 and uses >= max_uses:
   195	            raise ValueError("Activation code has reached its usage limit")
   196	        row["uses"] = str(uses + 1); target = row; break
   197	    if target is None:
   198	        raise ValueError("Activation code is invalid")
   199	    _atomic_write(path, rows, ACTIVATION_HEADERS)
   200	    plan_id = target.get("plan_id") or "STANDARD"
   201	    plan_ok = any((r.get("plan_id") or "").strip() == plan_id and _bool(r.get("enabled"), True) for r in _rows(Path(csv_dir)/"fee_plans.csv"))
   202	    if not plan_ok:
   203	        raise ValueError("Activation code points to a missing or disabled fee plan")
   204	    if not get_user(csv_dir, telegram_id):
   205	        join_user(csv_dir, telegram_id, plan_id)
   206	    return activate_user(csv_dir, telegram_id, plan_id, "Activated by code")
