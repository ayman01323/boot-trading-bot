    73	    def _headers(self, json_body=False):
    74	        headers = {"User-Agent": "BOOT-SiBot-Solana-LIVE/1.1"}
    75	        if json_body:
    76	            headers["Content-Type"] = "application/json"
    77	        api_key = os.getenv("JUPITER_API_KEY", "").strip()
    78	        if api_key:
    79	            headers["x-api-key"] = api_key
    80	        return headers
