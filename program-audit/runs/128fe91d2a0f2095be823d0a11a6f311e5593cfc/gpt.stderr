   405	def monitor_positions(app):
   406	    cfg = _sol.settings(app)
   407	    now = int(time.time())
   408	    with closing(_sol.connect(app)) as conn:
   409	        rows = [dict(r) for r in conn.execute("SELECT * FROM positions WHERE status='OPEN' AND mode='LIVE' ORDER BY updated_at").fetchall()]
   410	    for p in rows:
   411	        tid = str(p.get("telegram_id") or "")
   412	        if not live_enabled(app, tid):
   413	            continue
   414	        try:
   415	            ev = _sol.evaluate_position(app, p)
   416	        except Exception:
   417	            continue
   418	        current = _sol._dec(ev["net_pct"])
   419	        peak = max(_sol._dec(p.get("peak_unrealised_pct"), 0), current)
   420	        with _sol._DB_LOCK, closing(_sol.connect(app)) as conn:
   421	            conn.execute(
   422	                "UPDATE positions SET current_exit_sol=?,unrealised_net_sol=?,unrealised_pct=?,peak_unrealised_pct=?,updated_at=? WHERE position_id=?",
   423	                (str(ev["proceeds_sol"]), str(ev["net_sol"]), float(current), float(peak), now, p["position_id"]),
   424	            )
   425	            conn.commit()
   426	        reason = None
   427	        if int(p.get("leader_exit_pending") or 0) and current <= -_sol._dec(cfg.get("leader_exit_loss_cap_pct"), "2.5"):
   428	            reason = "SOLANA_LEADER_EXIT_LOSS_CAP"
   429	        elif peak >= _sol._dec(cfg.get("break_even_trigger_pct"), 5) and current <= _sol._dec(cfg.get("break_even_floor_pct"), ".10"):
   430	            reason = "SOLANA_BREAK_EVEN_PROTECT"
   431	        elif peak >= _sol._dec(cfg.get("trailing_trigger_pct"), 10):
   432	            floor = max(_sol._dec(cfg.get("break_even_floor_pct"), ".10"), peak - _sol._dec(cfg.get("trailing_gap_pct"), 5))
   433	            if current <= floor:
   434	                reason = "SOLANA_TRAILING_PROFIT_PROTECT"
   435	        if reason is None and current <= -_sol._dec(cfg.get("stop_loss_pct"), 10):
   436	            reason = "SOLANA_STOP_LOSS"
   437	        if reason is None and current >= _sol._dec(cfg.get("take_profit_pct"), 25):
   438	            reason = "SOLANA_TAKE_PROFIT"
   439	        age_h = Decimal(max(0, now - _sol._int(p.get("entry_ts"), now))) / Decimal(3600)
   440	        if reason is None and age_h >= _sol._dec(cfg.get("max_hold_hours"), 24) and current > 0:
   441	            reason = "SOLANA_MAX_HOLD_PROFIT"
   442	        if reason:
   443	            try:
   444	                fresh = dict(p)
   445	                fresh["peak_unrealised_pct"] = float(peak)
   446	                _close_live(app, tid, fresh, Decimal(1), reason)
   447	            except SolanaLivePostExecutionError as exc:
   448	                # Monitor exits have no leader-signature dedupe key, so the global
   449	                # landed-fault circuit breaker is the backstop. Two such faults turn
   450	                # LIVE off and stop further monitor submissions for this user.
   451	                _record_execution_fault(app, tid, cfg, exc)
   452	                _notify(app, tid, f"🚨 <b>Solana LIVE emergency exit landed without valid economic output</b>\n<code>{str(exc)[:450]}</code>")
   453	            except Exception as exc:
   454	                _notify(app, tid, f"🚨 <b>Solana LIVE emergency-exit warning</b>\nReason: <code>{reason}</code>\n<code>{type(exc).__name__}: {str(exc)[:450]}</code>")
   455	    _sol.export_csv(app)
   456	
   457	
   458	def install():
   459	    _sol.process_leader_event = process_leader_event
   460	    _sol.monitor_positions = monitor_positions
   461	
   462	
   463	install()
   650	    r.raise_for_status()
   651	    data = r.json()
   652	    if data.get("error") or data.get("errorCode") or _i(data.get("outAmount"), 0) <= 0 or not data.get("swapInstruction"):
   653	        raise _exec.SolanaLiveError(
   654	            "Jupiter /build failed: " + str(data.get("error") or data.get("errorMessage") or data.get("errorCode") or "invalid build")
   655	        )
   656	    return data
