  1206	def monitor_positions(app) -> None:
  1207	    with closing(connect(app)) as conn:
  1208	        rows = [dict(r) for r in conn.execute("SELECT * FROM positions WHERE status='OPEN' ORDER BY updated_at").fetchall()]
  1209	    now = int(time.time())
  1210	    for p in rows:
  1211	        cfg = user_settings(app, p["telegram_id"], p["chain_id"])
  1212	        try:
  1213	            ev = evaluate_position(app, p)
  1214	        except Exception:
  1215	            continue
  1216	        peak = max(_float(p.get("peak_unrealised_pct"), 0), float(ev["net_pct"]))
  1217	        with _DB_LOCK, closing(connect(app)) as conn:
  1218	            conn.execute("UPDATE positions SET current_exit_native=?,unrealised_net_native=?,unrealised_pct=?,peak_unrealised_pct=?,updated_at=? WHERE position_id=?",
  1219	                         (str(ev["proceeds_native"]), str(ev["net_native"]), float(ev["net_pct"]), peak, now, p["position_id"]))
  1220	            conn.commit()
  1221	        stop = _dec(cfg.get("stop_loss_pct"), 10); take = _dec(cfg.get("take_profit_pct"), 25); min_exit = _dec(cfg.get("min_exit_profit_pct"), .10)
  1222	        age_hours = Decimal(max(0, now - _int(p.get("entry_ts"), now))) / Decimal(3600)
  1223	        max_hold = _dec(cfg.get("max_hold_hours"), 24)
  1224	        reason = None
  1225	        if _bool(p.get("leader_exit_pending"), False) and ev["net_pct"] >= min_exit:
  1226	            reason = "SIMO_EXIT_NOW_PROFITABLE"
  1227	        elif ev["net_pct"] <= -stop:
  1228	            reason = "STOP_LOSS"
  1229	        elif ev["net_pct"] >= take:
  1230	            reason = "TAKE_PROFIT"
  1231	        elif age_hours >= max_hold and ev["net_pct"] > 0:
  1232	            reason = "MAX_HOLD_PROFIT"
  1233	        if reason:
  1234	            try: close_position(app, p["position_id"], Decimal(1), reason)
  1235	            except Exception: pass
  1236	    export_positions(app)
