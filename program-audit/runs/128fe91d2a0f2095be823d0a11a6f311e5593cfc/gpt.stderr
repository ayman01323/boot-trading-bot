   210	        if balance < lamports + reserve:
   211	            have = Decimal(balance) / Decimal(1_000_000_000)
   212	            raise SolanaLiveError(f"Insufficient SOL: have {have:.9f}, need trade {amount_sol} + reserve {reserve_sol}")
   213	        return self.swap(_sol.WSOL_MINT, output_mint, lamports)
   214	
   215	    def sell(self, input_mint: str, amount_raw: int) -> dict:
   216	        actual = self.token_balance_raw(input_mint)
   217	        if actual < int(amount_raw):
   218	            raise SolanaLiveError(f"Insufficient token balance for exit: have {actual}, need {int(amount_raw)}")
   219	        return self.swap(input_mint, _sol.WSOL_MINT, int(amount_raw))
