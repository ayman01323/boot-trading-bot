    23	class SolanaLivePostExecutionError(SolanaLiveError):
    24	    """A transaction landed/reported success but failed economic-result validation."""
    25	
    26	    def __init__(self, message: str, result: dict | None = None):
    27	        super().__init__(message)
    28	        self.result = dict(result or {})
