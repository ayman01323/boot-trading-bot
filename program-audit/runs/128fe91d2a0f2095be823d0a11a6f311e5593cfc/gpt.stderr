    68	  workflow_dispatch:
    69	
    70	permissions:
    71	  contents: read
    72	
    73	jobs:
    74	  test:
    75	    runs-on: ubuntu-latest
    76	    timeout-minutes: 10
    77	    steps:
    78	      - uses: actions/checkout@v4
    79	      - uses: actions/setup-python@v5
    80	        with:
    81	          python-version: '3.11'
    82	          cache: pip
    83	      - run: python -m pip install --upgrade pip
    84	      - run: pip install -r requirements.txt pytest
    85	      - name: Compile strategy laboratory, canary and deployment attestation
    86	        run: |
    87	          python -m py_compile \
    88	            learnerbot/strategy_lab.py \
    89	            learnerbot/strategy_lab_research.py \
    90	            learnerbot/strategy_lab_audit_patch.py \
    91	            learnerbot/strategy_ai_proposals.py \
    92	            learnerbot/cross_chain_strategy_signals.py \
    93	            learnerbot/market_feature_adapter.py \
    94	            learnerbot/shadow_strategy_executor.py \
    95	            learnerbot/strategy_canary.py \
    96	            learnerbot/profit_control_audit_export_patch.py \
    97	            learnerbot/three_agent_strategy_contract.py \
    98	            scripts/extract_strategy_report.py \
    99	            scripts/vps_deploy_attestation.py \
   100	            tests/test_three_agent_strategy_contract.py \
   101	            tests/test_strategy_canary.py \
   102	            tests/test_vps_deploy_attestation.py
   103	      - name: Run Strategy Lab, canary and guarded three-agent strategy tests
   104	        run: |
   105	          pytest -x -vv \
   106	            tests/test_strategy_lab.py \
   107	            tests/test_strategy_ai_proposals.py \
   108	            tests/test_strategy_lab_cross_chain_research.py \
   109	            tests/test_cross_chain_strategy_signals.py \
   110	            tests/test_market_feature_shadow_executor.py \
   111	            tests/test_three_agent_strategy_contract.py \
   112	            tests/test_strategy_canary.py \
   113	            tests/test_vps_deploy_attestation.py
.github/workflows/three-agent-strategy-review.yml
     1	name: Three-Agent Strategy Review
     2	
     3	on:
     4	  workflow_run:
     5	    workflows: ["Weekly GPT Master Corrective Action"]
     6	    types: [completed]
     7	  workflow_dispatch:
     8	
     9	permissions:
    10	  contents: write
    11	  issues: write
    12	  pull-requests: read
    13	
    14	concurrency:
    15	  group: three-agent-strategy-review
    16	  cancel-in-progress: false
    17	
    18	jobs:
    19	  review:
    20	    if: github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success'
    21	    runs-on: ubuntu-latest
    22	    timeout-minutes: 90
    23	
    24	    steps:
    25	      - name: Check out current main for orchestration
    26	        uses: actions/checkout@v4
    27	        with:
    28	          ref: main
    29	          fetch-depth: 0
    30	
    31	      - name: Set up Python and Node
    32	        uses: actions/setup-python@v5
    33	        with:
    34	          python-version: '3.11'
    35	          cache: pip
    36	      - uses: actions/setup-node@v4
    37	        with:
    38	          node-version: '22'
    39	
    40	      - name: Install reviewer tooling
    41	        shell: bash
    42	        run: |
    43	          set -euo pipefail
    44	          python -m pip install --upgrade pip
    45	          pip install -r requirements.txt pytest
    46	          npm install -g @openai/codex@latest @google/gemini-cli@latest
    47	          codex --version
    48	          gemini --version
    49	
    50	      - name: Resolve engineering-complete strategy review base
    51	        id: base
    52	        env:
    53	          GH_TOKEN: ${{ github.token }}
    54	        shell: bash
    55	        run: |
    56	          set -euo pipefail
    57	          git fetch --force origin ai-reviews:refs/remotes/origin/ai-reviews
    58	          engineering_source="$(git show origin/ai-reviews:weekly/latest_completed_source_commit.txt | tr -d '\r\n')"
    59	          if [[ -z "$engineering_source" ]]; then
    60	            echo "No completed three-agent engineering audit is available; refusing to start strategy phase." >&2
    61	            exit 2
    62	          fi
    63	          short="${engineering_source:0:12}"
    64	          fix_pr="$(gh pr list --state open --base main --search "Weekly audited bot fixes ${short} in:title" --limit 1 --json number,url,headRefName,headRefOid,isDraft --jq '.[0] // empty')"
    65	          if [[ -n "$fix_pr" ]]; then
    66	            review_ref="$(printf '%s' "$fix_pr" | python -c 'import json,sys; print(json.load(sys.stdin)["headRefName"])')"
    67	            source_sha="$(printf '%s' "$fix_pr" | python -c 'import json,sys; print(json.load(sys.stdin)["headRefOid"])')"
    68	            fix_url="$(printf '%s' "$fix_pr" | python -c 'import json,sys; print(json.load(sys.stdin)["url"])')"
    69	            base_kind="ENGINEERING_CORRECTIVE_DRAFT"
    70	          else
    71	            git fetch --force origin main:refs/remotes/origin/main
    72	            review_ref="main"
    73	            source_sha="$(git rev-parse origin/main)"
    74	            fix_url=""
    75	            base_kind="CURRENT_MAIN_NO_CORRECTIVE_DRAFT"
    76	          fi
    77	          echo "engineering_source=${engineering_source}" >> "$GITHUB_OUTPUT"
    78	          echo "review_ref=${review_ref}" >> "$GITHUB_OUTPUT"
    79	          echo "source_sha=${source_sha}" >> "$GITHUB_OUTPUT"
    80	          echo "fix_url=${fix_url}" >> "$GITHUB_OUTPUT"
    81	          echo "base_kind=${base_kind}" >> "$GITHUB_OUTPUT"
    82	
    83	      - name: Check out exact strategy review source
    84	        shell: bash
    85	        env:
    86	          SOURCE_SHA: ${{ steps.base.outputs.source_sha }}
    87	        run: |
    88	          set -euo pipefail
    89	          git fetch --force origin "$SOURCE_SHA" || true
    90	          git checkout --detach "$SOURCE_SHA"
    91	          git clean -fdx
    92	
    93	      - name: Fetch latest sanitised Strategy Lab evidence
    94	        id: evidence
    95	        shell: bash
    96	        env:
    97	          SOURCE_SHA: ${{ steps.base.outputs.source_sha }}
    98	        run: |
    99	          set -euo pipefail
   100	          git fetch --force origin audit-status:refs/remotes/origin/audit-status
   101	          mkdir -p .strategy_cycle
   102	          git show origin/audit-status:latest_loss_forensics.json > .strategy_cycle/evidence.json
   103	          python - <<'PY' > /tmp/strategy-meta.env
   104	          import hashlib,json,os,time
   105	          raw=open('.strategy_cycle/evidence.json','rb').read()
   106	          report=json.loads(raw)
   107	          canonical=json.dumps(report,sort_keys=True,separators=(',',':'),default=str).encode()
   108	          evidence=hashlib.sha256(canonical).hexdigest()
   109	          source=os.environ['SOURCE_SHA']
   110	          cycle=source[:12]+'-'+evidence[:12]
   111	          print('EVIDENCE_SHA='+evidence)
   112	          print('CYCLE_ID='+cycle)
   113	          generated=int(report.get('generated_epoch') or 0)
   114	          print('EVIDENCE_AGE='+str(max(0,int(time.time())-generated) if generated else 10**9))
   115	          PY
   116	          source /tmp/strategy-meta.env
   117	          if [[ "$EVIDENCE_AGE" -gt 21600 ]]; then
   118	            echo "Strategy evidence is older than 6 hours; refusing stale optimisation." >&2
   119	            exit 3
   120	          fi
   121	          echo "evidence_sha=${EVIDENCE_SHA}" >> "$GITHUB_OUTPUT"
   122	          echo "cycle_id=${CYCLE_ID}" >> "$GITHUB_OUTPUT"
   123	          echo "age=${EVIDENCE_AGE}" >> "$GITHUB_OUTPUT"
   124	
   125	      - name: Prepare common strategy reviewer prompt
   126	        shell: bash
   127	        env:
   128	          CYCLE_ID: ${{ steps.evidence.outputs.cycle_id }}
   129	          SOURCE_SHA: ${{ steps.base.outputs.source_sha }}
   130	          EVIDENCE_SHA: ${{ steps.evidence.outputs.evidence_sha }}
   131	          BASE_KIND: ${{ steps.base.outputs.base_kind }}
   132	        run: |
   133	          cat > .strategy_cycle/common_prompt.txt <<'PROMPT'
   134	          You are one of three INDEPENDENT strategy-engineering reviewers for a multi-chain automated trading bot.
   135	          Review the ENTIRE checked-out source and the sanitised operational evidence in .strategy_cycle/evidence.json.
   136	          Pay special attention to strategy_lab, shadow_execution, realised net P&L, profit factor, loss magnitude,
   137	          eligible-opportunity participation, fees/slippage/latency, execution/exit failures, sample size, market regime,
   138	          learned profitable-wallet patterns and chain-specific Solana/EVM economics.
   139	
   140	          The objective is durable money-weighted NET P&L after costs, NOT raw win count or forced trading. Every active
   141	          strategy should seek eligible positive-edge opportunities, but never manufacture a trade when no edge exists.
   142	          Review the current common strategy families and propose evidence-supported improvements/new hypotheses where useful.
   143	          You may recommend research using Dune, DEX Screener, Etherscan V2, DefiLlama, Jupiter and public GitHub code search,
   144	          but public code is read-only idea research and must never be executed automatically. Asset discoveries are requests
   145	          only and must never be auto-enabled for LIVE trading.
   146	
   147	          Forecast strategies must target positive NET edge after costs and include uncertainty/abstention, time-ordered
   148	          validation and no look-ahead. The same strategy family may be tested on Solana and EVM only with chain-specific
   149	          quotes, liquidity, sellability, gas/priority fees, slippage, price impact and latency assumptions.
   150	
   151	          This phase is REPORT ONLY. Do not edit tracked code, trade, deploy, change capital/live settings, touch secrets,
   152	          wallets/signing, or weaken any risk/executability control. Every proposed code change must begin/continue in SHADOW.
   153	
   154	          Return a report with exactly:
   155	          {
   156	            "schema_version":1,
   157	            "provider":"PROVIDER_NAME",
   158	            "cycle_id":"CYCLE_ID_VALUE",
   159	            "source_commit":"SOURCE_SHA_VALUE",
   160	            "evidence_sha256":"EVIDENCE_SHA_VALUE",
   161	            "scope":"THREE_AGENT_STRATEGY_REVIEW",
   162	            "status":"HEALTHY|CHANGES_PROPOSED|INCOMPLETE",
   163	            "summary":"...",
   164	            "proposals":[{
   165	              "id":"stable short id",
   166	              "action":"KEEP|IMPROVE|REWORK|SHADOW_MORE|REPLACE|DORMANT|NEW_SHADOW|ASSET_REQUEST|RESEARCH_MORE",
   167	              "strategy":"strategy/family name",
   168	              "chain_scope":["SOLANA","EVM"],
   169	              "evidence":[{"path":"JSON path or repository path","detail":"measured/code support"}],
   170	              "rationale":"...",
   171	              "expected_effect":"...",
   172	              "downside_risk":"...",
   173	              "shadow_test":"falsifiable test including costs and failure condition",
   174	              "minimum_observation":"...",
   175	              "confidence":0.0,
   176	              "suggested_files":["only Strategy Lab/SHADOW files if code is suggested"]
   177	            }],
   178	            "rejected_ideas":[{"idea":"...","reason":"..."}],
   179	            "evidence_gaps":["..."],
   180	            "review_only":true,
   181	            "no_live_changes":true
   182	          }
   183	
   184	          Prefer no change when evidence is weak. Separate existing strategy defects from new research hypotheses.
   185	          PROMPT
   186	          sed -i \
   187	            -e "s/PROVIDER_NAME/PROVIDER_NAME/g" \
   188	            -e "s/CYCLE_ID_VALUE/${CYCLE_ID}/g" \
   189	            -e "s/SOURCE_SHA_VALUE/${SOURCE_SHA}/g" \
   190	            -e "s/EVIDENCE_SHA_VALUE/${EVIDENCE_SHA}/g" \
   191	            .strategy_cycle/common_prompt.txt
   192	          printf '\nReview base kind: %s\n' "$BASE_KIND" >> .strategy_cycle/common_prompt.txt
   193	
   194	      - name: GPT independent strategy review
   195	        id: gpt
   196	        continue-on-error: true
   197	        env:
   198	          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
   199	          OPENAI_STRATEGY_AUDIT_MODEL: ${{ vars.OPENAI_STRATEGY_AUDIT_MODEL }}
   200	          CYCLE_ID: ${{ steps.evidence.outputs.cycle_id }}
   201	          SOURCE_SHA: ${{ steps.base.outputs.source_sha }}
   202	          EVIDENCE_SHA: ${{ steps.evidence.outputs.evidence_sha }}
   203	        shell: bash
   204	        run: |
   205	          set -euo pipefail
   206	          test -n "${OPENAI_API_KEY:-}"
   207	          cp .strategy_cycle/common_prompt.txt /tmp/gpt-strategy-prompt.txt
   208	          sed -i 's/PROVIDER_NAME/gpt/g' /tmp/gpt-strategy-prompt.txt
   209	          cat >> /tmp/gpt-strategy-prompt.txt <<'PROMPT'
   210	          Inspect the repository deeply. Write exactly .strategy_cycle/gpt.json and .strategy_cycle/gpt.md.
   211	          Change no tracked file and do not implement recommendations in this independent-review phase.
   212	          PROMPT
   213	          model_args=()
   214	          if [[ -n "${OPENAI_STRATEGY_AUDIT_MODEL:-}" ]]; then model_args=(-m "$OPENAI_STRATEGY_AUDIT_MODEL"); fi
   215	          codex exec --sandbox workspace-write --ask-for-approval never --ephemeral "${model_args[@]}" - < /tmp/gpt-strategy-prompt.txt
   216	          python -m learnerbot.three_agent_strategy_contract validate-agent \
   217	            --input .strategy_cycle/gpt.json --provider gpt --cycle-id "$CYCLE_ID" \
   218	            --source-commit "$SOURCE_SHA" --evidence-sha256 "$EVIDENCE_SHA"
   219	          python - <<'PY'
   220	          import subprocess,sys
   221	          bad=[]
   222	          for line in subprocess.check_output(['git','status','--porcelain'],text=True).splitlines():
   223	              if line[:2]=='??' and line[3:].replace('\\','/').startswith('.strategy_cycle/'):
   224	                  continue
   225	              bad.append(line)
   226	          if bad:
   227	              print('GPT strategy reviewer changed tracked/out-of-scope files:',*bad,sep='\n',file=sys.stderr); raise SystemExit(3)
   228	          PY
   229	
   230	      - name: Recover GPT incomplete report
   231	        if: steps.gpt.outcome != 'success'
   232	        env:
   233	          CYCLE_ID: ${{ steps.evidence.outputs.cycle_id }}
   234	          SOURCE_SHA: ${{ steps.base.outputs.source_sha }}
   235	          EVIDENCE_SHA: ${{ steps.evidence.outputs.evidence_sha }}
   236	        run: |
   237	          git restore --source=HEAD --staged --worktree . || true
   238	          git clean -fd -e .strategy_cycle/ || true
   239	          python - <<'PY'
   240	          import json,os
   241	          p={"schema_version":1,"provider":"gpt","cycle_id":os.environ['CYCLE_ID'],"source_commit":os.environ['SOURCE_SHA'],
   242	             "evidence_sha256":os.environ['EVIDENCE_SHA'],"scope":"THREE_AGENT_STRATEGY_REVIEW","status":"INCOMPLETE",
   243	             "summary":"GPT strategy review did not complete.","proposals":[],"rejected_ideas":[],
   244	             "evidence_gaps":["Inspect workflow logs."],"review_only":True,"no_live_changes":True}
   245	          open('.strategy_cycle/gpt.json','w').write(json.dumps(p,indent=2,sort_keys=True)+'\n')
   246	          open('.strategy_cycle/gpt.md','w').write('# GPT strategy review\n\nINCOMPLETE\n')
   247	          PY
   248	
   249	      - name: Gemini independent strategy review
   250	        id: gemini
   251	        continue-on-error: true
   252	        env:
   253	          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
   254	          GEMINI_STRATEGY_MODEL: ${{ vars.GEMINI_STRATEGY_MODEL || 'pro' }}
   255	          GEMINI_CLI_TRUST_WORKSPACE: 'true'
   256	          CYCLE_ID: ${{ steps.evidence.outputs.cycle_id }}
   257	          SOURCE_SHA: ${{ steps.base.outputs.source_sha }}
   258	          EVIDENCE_SHA: ${{ steps.evidence.outputs.evidence_sha }}
   259	        shell: bash
   260	        run: |
.github/workflows/weekly-audit-ci.yml
     1	name: Weekly AI Audit Tests
     2	
     3	on:
     4	  pull_request:
     5	    paths:
     6	      - '.github/workflows/weekly-three-agent-bug-audit.yml'
     7	      - '.github/workflows/weekly-gpt-corrective-action.yml'
     8	      - '.github/workflows/ai-engineering-audit-trigger.yml'
     9	      - '.github/workflows/weekly-audit-ci.yml'
    10	      - '.github/copilot-instructions.md'
    11	      - 'learnerbot/weekly_bug_audit_contract.py'
    12	      - 'learnerbot/ai_ops_status.py'
    13	      - 'learnerbot/telegram_ai_ops_patch.py'
    14	      - 'learnerbot/telegram_account_roles_patch.py'
    15	      - 'scripts/weekly_bug_audit_baseline.py'
    16	      - 'tests/test_weekly_bug_audit_contract.py'
    17	      - 'tests/test_ai_ops_status.py'
    18	      - 'docs/WEEKLY_THREE_AGENT_BUG_AUDIT.md'
    19	  push:
    20	    branches:
    21	      - 'release/weekly-three-agent-bug-audit'
    22	      - 'release/ai-ops-telegram-and-trigger'
    23	    paths:
    24	      - '.github/workflows/weekly-three-agent-bug-audit.yml'
    25	      - '.github/workflows/weekly-gpt-corrective-action.yml'
    26	      - '.github/workflows/ai-engineering-audit-trigger.yml'
    27	      - '.github/workflows/weekly-audit-ci.yml'
    28	      - 'learnerbot/weekly_bug_audit_contract.py'
    29	      - 'learnerbot/ai_ops_status.py'
    30	      - 'learnerbot/telegram_ai_ops_patch.py'
    31	      - 'learnerbot/telegram_account_roles_patch.py'
    32	      - 'scripts/weekly_bug_audit_baseline.py'
    33	      - 'tests/test_weekly_bug_audit_contract.py'
    34	      - 'tests/test_ai_ops_status.py'
    35	  workflow_dispatch:
    36	
    37	permissions:
    38	  contents: read
    39	
    40	jobs:
    41	  test:
    42	    runs-on: ubuntu-latest
    43	    timeout-minutes: 10
    44	    steps:
    45	      - uses: actions/checkout@v4
    46	      - uses: actions/setup-python@v5
    47	        with:
    48	          python-version: '3.11'
    49	      - name: Install pytest
    50	        run: python -m pip install --disable-pip-version-check pytest
    51	      - name: Compile weekly audit and AI operations modules
    52	        run: |
    53	          python -m py_compile \
    54	            learnerbot/weekly_bug_audit_contract.py \
    55	            learnerbot/ai_ops_status.py \
    56	            learnerbot/telegram_ai_ops_patch.py \
    57	            learnerbot/telegram_account_roles_patch.py \
    58	            scripts/weekly_bug_audit_baseline.py \
    59	            tests/test_weekly_bug_audit_contract.py \
    60	            tests/test_ai_ops_status.py
    61	      - name: Run weekly audit policy and AI operations tests
    62	        run: pytest -x -vv tests/test_weekly_bug_audit_contract.py tests/test_ai_ops_status.py
    63	      - name: Dry-run deterministic repository baseline
    64	        shell: bash
    65	        run: |
    66	          : > /tmp/compile.log
    67	          : > /tmp/pytest.log
    68	          python scripts/weekly_bug_audit_baseline.py \
    69	            --root . \
    70	            --output /tmp/weekly-baseline.json \
    71	            --compile-log /tmp/compile.log \
    72	            --pytest-log /tmp/pytest.log \
    73	            --compile-rc 0 \
    74	            --pytest-rc 0
    75	          python - <<'PY'
    76	          import json
    77	          p=json.load(open('/tmp/weekly-baseline.json',encoding='utf-8'))
    78	          assert p['scope']=='FULL_REPOSITORY_BUG_AUDIT_BASELINE'
    79	          assert p['tracked_file_count'] > 0
    80	          assert p['source_commit']
    81	          assert p['privacy']['tracked_files_only'] is True
    82	          print('WEEKLY_AUDIT_BASELINE_OK')
    83	          PY
.github/workflows/weekly-gpt-corrective-action.yml
     1	name: Weekly GPT Master Corrective Action
     2	
     3	on:
     4	  pull_request:
     5	    types: [opened, synchronize, reopened]
     6	    branches: [main]
     7	    paths:
     8	      - '.ai/weekly/copilot/*.json'
     9	      - '.ai/weekly/copilot/*.md'
    10	  workflow_dispatch:
    11	    inputs:
    12	      copilot_pr_number:
    13	        description: "Copilot report PR number to process"
    14	        required: false
    15	        type: string
    16	
    17	permissions:
    18	  contents: write
    19	  pull-requests: write
    20	  issues: write
    21	
    22	concurrency:
    23	  group: weekly-gpt-master-corrective-action
    24	  cancel-in-progress: false
    25	
    26	jobs:
    27	  synthesize-and-act:
    28	    if: github.event_name == 'workflow_dispatch' || github.event.pull_request.head.repo.full_name == github.repository
    29	    runs-on: ubuntu-latest
    30	    timeout-minutes: 120
    31	
    32	    steps:
    33	      - name: Resolve Copilot report PR
    34	        id: pr
    35	        env:
    36	          GH_TOKEN: ${{ github.token }}
    37	          INPUT_PR: ${{ inputs.copilot_pr_number }}
    38	          EVENT_PR: ${{ github.event.pull_request.number }}
    39	        shell: bash
    40	        run: |
    41	          set -euo pipefail
    42	          pr="${EVENT_PR:-${INPUT_PR:-}}"
    43	          if [[ -z "$pr" ]]; then
    44	            echo "A Copilot report PR number is required." >&2
    45	            exit 2
    46	          fi
    47	          head_sha="$(gh pr view "$pr" --json headRefOid --jq '.headRefOid')"
    48	          cross_repo="$(gh pr view "$pr" --json isCrossRepository --jq '.isCrossRepository')"
    49	          if [[ "$cross_repo" == "true" ]]; then
    50	            echo "Refusing report PR from a fork because repository secrets must not be exposed." >&2
    51	            exit 3
    52	          fi
    53	          echo "number=${pr}" >> "$GITHUB_OUTPUT"
    54	          echo "head_sha=${head_sha}" >> "$GITHUB_OUTPUT"
    55	
    56	      - name: Check out Copilot report PR head
    57	        uses: actions/checkout@v4
    58	        with:
    59	          ref: ${{ steps.pr.outputs.head_sha }}
    60	          fetch-depth: 0
    61	
    62	      - name: Set up Python
    63	        uses: actions/setup-python@v5
    64	        with:
    65	          python-version: "3.11"
    66	          cache: pip
    67	
    68	      - name: Set up Node
    69	        uses: actions/setup-node@v4
    70	        with:
    71	          node-version: "22"
    72	
    73	      - name: Install synthesis and implementation tooling
    74	        shell: bash
    75	        run: |
    76	          set -euo pipefail
    77	          python -m pip install --upgrade pip
    78	          pip install -r requirements.txt pytest
    79	          npm install -g @openai/codex@latest
    80	          codex --version
    81	
    82	      - name: Refuse Copilot PR containing anything except weekly report files
    83	        env:
    84	          GH_TOKEN: ${{ github.token }}
    85	          PR_NUMBER: ${{ steps.pr.outputs.number }}
    86	        shell: bash
    87	        run: |
    88	          set -euo pipefail
    89	          gh pr diff "$PR_NUMBER" --name-only > /tmp/copilot-pr-files.txt
    90	          python - <<'PY'
    91	          import pathlib, sys
    92	          files=[x.strip().replace('\\','/') for x in pathlib.Path('/tmp/copilot-pr-files.txt').read_text().splitlines() if x.strip()]
    93	          if len(files) != 2:
    94	              print(f'Copilot report PR must contain exactly two files; found {len(files)}', file=sys.stderr)
    95	              print(*files, sep='\n', file=sys.stderr)
    96	              raise SystemExit(2)
    97	          if any(not p.startswith('.ai/weekly/copilot/') or pathlib.PurePosixPath(p).suffix not in {'.json','.md'} for p in files):
    98	              print('Copilot report PR contains a non-report file.', file=sys.stderr)
    99	              print(*files, sep='\n', file=sys.stderr)
   100	              raise SystemExit(3)
   101	          stems={str(pathlib.PurePosixPath(p).with_suffix('')) for p in files}
   102	          if len(stems) != 1:
   103	              print('Copilot JSON and Markdown reports do not share the same source-commit filename.', file=sys.stderr)
   104	              raise SystemExit(4)
   105	          PY
   106	
   107	      - name: Locate and validate Copilot report
   108	        id: report
   109	        shell: bash
   110	        run: |
   111	          set -euo pipefail
   112	          mapfile -t reports < <(find .ai/weekly/copilot -maxdepth 1 -type f -name '*.json' -print 2>/dev/null | sort)
   113	          if [[ "${#reports[@]}" -ne 1 ]]; then
   114	            echo "Expected exactly one Copilot weekly JSON report in this PR; found ${#reports[@]}." >&2
   115	            printf '%s\n' "${reports[@]}" >&2
   116	            exit 2
   117	          fi
   118	          report="${reports[0]}"
   119	          source_sha="$(python - <<PY
   120	          import json
   121	          print(json.load(open('$report',encoding='utf-8')).get('source_commit') or '')
   122	          PY
   123	          )"
   124	          if [[ -z "$source_sha" ]]; then
   125	            echo "Copilot report source_commit missing." >&2
   126	            exit 2
   127	          fi
   128	          expected_json=".ai/weekly/copilot/${source_sha}.json"
   129	          expected_md=".ai/weekly/copilot/${source_sha}.md"
   130	          if [[ "$report" != "$expected_json" || ! -f "$expected_md" ]]; then
   131	            echo "Copilot report filenames must exactly match source_commit." >&2
   132	            exit 3
   133	          fi
   134	          python -m learnerbot.weekly_bug_audit_contract validate-agent \
   135	            --input "$report" --provider copilot --source-commit "$source_sha" >/dev/null
   136	          cp "$report" /tmp/copilot.json
   137	          cp "$expected_md" /tmp/copilot.md
   138	          echo "source_sha=${source_sha}" >> "$GITHUB_OUTPUT"
   139	          echo "short=${source_sha:0:12}" >> "$GITHUB_OUTPUT"
   140	          echo "path=${report}" >> "$GITHUB_OUTPUT"
   141	
   142	      - name: Verify audit source belongs to current main history
   143	        shell: bash
   144	        env:
   145	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   146	        run: |
   147	          set -euo pipefail
   148	          git fetch --force origin main:refs/remotes/origin/main
   149	          if ! git cat-file -e "${SOURCE_SHA}^{commit}" 2>/dev/null; then
   150	            echo "Audit source commit does not exist locally." >&2
   151	            exit 2
   152	          fi
   153	          if ! git merge-base --is-ancestor "$SOURCE_SHA" origin/main; then
   154	            echo "Audit source is not an ancestor of current main; refusing stale/divergent automatic correction." >&2
   155	            exit 3
   156	          fi
   157	
   158	      - name: Fetch matching GPT Gemini and deterministic reports
   159	        shell: bash
   160	        env:
   161	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   162	        run: |
   163	          set -euo pipefail
   164	          git fetch --force origin ai-reviews:refs/remotes/origin/ai-reviews
   165	          for file in baseline.json gpt.json gemini.json; do
   166	            git show "origin/ai-reviews:weekly/runs/${SOURCE_SHA}/${file}" > "/tmp/${file}"
   167	          done
   168	          python -m learnerbot.weekly_bug_audit_contract validate-agent \
   169	            --input /tmp/gpt.json --provider gpt --source-commit "$SOURCE_SHA" >/dev/null
   170	          python -m learnerbot.weekly_bug_audit_contract validate-agent \
   171	            --input /tmp/gemini.json --provider gemini --source-commit "$SOURCE_SHA" >/dev/null
   172	
   173	      - name: Refuse synthesis if an independent report is incomplete
   174	        id: completeness
   175	        shell: bash
   176	        run: |
   177	          set -euo pipefail
   178	          python - <<'PY' > /tmp/completeness.env
   179	          import json
   180	          names=['gpt','gemini','copilot']
   181	          reports={
   182	            'gpt':json.load(open('/tmp/gpt.json',encoding='utf-8')),
   183	            'gemini':json.load(open('/tmp/gemini.json',encoding='utf-8')),
   184	            'copilot':json.load(open('/tmp/copilot.json',encoding='utf-8')),
   185	          }
   186	          incomplete=[name for name in names if reports[name].get('status')=='INCOMPLETE']
   187	          print('INCOMPLETE=' + ('true' if incomplete else 'false'))
   188	          print('NAMES=' + ','.join(incomplete))
   189	          PY
   190	          source /tmp/completeness.env
   191	          echo "incomplete=${INCOMPLETE}" >> "$GITHUB_OUTPUT"
   192	          echo "names=${NAMES}" >> "$GITHUB_OUTPUT"
   193	
   194	      - name: Stop automatic action when any agent report is incomplete
   195	        if: steps.completeness.outputs.incomplete == 'true'
   196	        env:
   197	          GH_TOKEN: ${{ github.token }}
   198	          PR_NUMBER: ${{ steps.pr.outputs.number }}
   199	          NAMES: ${{ steps.completeness.outputs.names }}
   200	        shell: bash
   201	        run: |
   202	          gh pr comment "$PR_NUMBER" --body "Weekly three-agent audit is incomplete (${NAMES}). GPT corrective action is blocked until all three independent reports complete. No code was changed."
   203	          exit 1
   204	
   205	      - name: Check out current main for GPT verification and any fix
   206	        shell: bash
   207	        run: |
   208	          set -euo pipefail
   209	          git switch --detach origin/main
   210	          git clean -fdx
   211	          mkdir -p .weekly_master
   212	          cp /tmp/baseline.json .weekly_master/baseline.json
   213	          cp /tmp/gpt.json .weekly_master/gpt.json
   214	          cp /tmp/gemini.json .weekly_master/gemini.json
   215	          cp /tmp/copilot.json .weekly_master/copilot.json
   216	
   217	      - name: GPT master synthesis with explicit accept reject defer ledger
   218	        id: synthesis
   219	        env:
   220	          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
   221	          OPENAI_WEEKLY_SYNTH_MODEL: ${{ vars.OPENAI_WEEKLY_SYNTH_MODEL }}
   222	          SOURCE_SHA: ${{ steps.report.outputs.source_sha }}
   223	        shell: bash
   224	        run: |
   225	          set -euo pipefail
   226	          if [[ -z "${OPENAI_API_KEY:-}" ]]; then
   227	            echo "OPENAI_API_KEY missing; master synthesis cannot run." >&2
   228	            exit 2
   229	          fi
   230	          cat > /tmp/master_prompt.txt <<'PROMPT'
   231	          You are the MASTER engineering adjudicator for a weekly three-agent bug audit of an automated multi-chain
   232	          trading bot. Read these first:
   233	            .weekly_master/baseline.json
   234	            .weekly_master/gpt.json
   235	            .weekly_master/gemini.json
   236	            .weekly_master/copilot.json
   237	          Then inspect the CURRENT checked-out main code to verify disputed or high-impact claims.
   238	
   239	          Consolidate equivalent root causes across agents. For EVERY materially distinct proposed bug/fix, record whether
   240	          you ACCEPT, REJECT, or DEFER it. Do not use majority vote blindly. Concrete code/test evidence outranks model
   241	          agreement. Reject hallucinated, stale, non-bug strategy tuning, or unsupported claims. Defer ambiguous or high-risk
   242	          changes needing runtime evidence/human judgement. P0 must be HUMAN REVIEW, never automatic.
   243	
   244	          An ACCEPT recommendation should be narrowly scoped and safe to implement only when confidence is high. List exact
   245	          allowed repository files (including exact test files) that an implementation agent may change. Do not authorize
   246	          secrets, private keys, wallet/signing material, deployment workflow changes, capital/risk increases, live-mode
   247	          activation, or removal/weakening of simulation, sellability, liquidity, slippage, positive-edge, nonce, atomicity,
   248	          stop-loss or circuit-breaker controls.
   249	
   250	          The master decision is an AUDIT LEDGER, not permission to deploy. Live auto-deploy is always false and any code fix
   251	          is draft-PR-only after mandatory tests.
   252	
   253	          Write exactly these two untracked files and change no tracked file:
   254	            .weekly_master/master_decision.json
   255	            .weekly_master/master_decision.md
   256	
   257	          JSON shape:
   258	          {
   259	            "schema_version":1,
   260	            "source_commit":"SOURCE_COMMIT",
.github/workflows/weekly-three-agent-bug-audit.yml
     1	name: Weekly Three-Agent Full-Bot Bug Audit
     2	
     3	on:
     4	  schedule:
     5	    - cron: "15 4 * * 1"
     6	  workflow_dispatch:
     7	
     8	permissions:
     9	  contents: write
    10	  issues: write
    11	  pull-requests: read
    12	
    13	concurrency:
    14	  group: weekly-three-agent-full-bot-bug-audit
    15	  cancel-in-progress: false
    16	
    17	jobs:
    18	  audit:
    19	    name: Freeze main, audit with GPT and Gemini, assign Copilot
    20	    runs-on: ubuntu-latest
    21	    timeout-minutes: 70
    22	
    23	    steps:
    24	      - name: Check out exact current main
    25	        uses: actions/checkout@v4
    26	        with:
    27	          ref: main
    28	          fetch-depth: 0
    29	
    30	      - name: Record frozen source commit
    31	        id: source
    32	        shell: bash
    33	        run: |
    34	          set -euo pipefail
    35	          sha="$(git rev-parse HEAD)"
    36	          echo "sha=${sha}" >> "$GITHUB_OUTPUT"
    37	          echo "short=${sha:0:12}" >> "$GITHUB_OUTPUT"
    38	          echo "Frozen weekly audit source: ${sha}"
    39	
    40	      - name: Set up Python
    41	        uses: actions/setup-python@v5
    42	        with:
    43	          python-version: "3.11"
    44	          cache: pip
    45	
    46	      - name: Set up Node
    47	        uses: actions/setup-node@v4
    48	        with:
    49	          node-version: "22"
    50	
    51	      - name: Install audit tooling
    52	        shell: bash
    53	        run: |
    54	          set -euo pipefail
    55	          python -m pip install --upgrade pip
    56	          pip install -r requirements.txt pytest
    57	          npm install -g @openai/codex@latest @google/gemini-cli@latest
    58	          codex --version
    59	          gemini --version
    60	
    61	      - name: Run deterministic compile and full pytest baseline
    62	        id: baseline_tests
    63	        shell: bash
    64	        run: |
    65	          set +e
    66	          python -m compileall -q learnerbot scripts tests > /tmp/weekly_compile.log 2>&1
    67	          compile_rc=$?
    68	          timeout 25m pytest -q > /tmp/weekly_pytest.log 2>&1
    69	          pytest_rc=$?
    70	          set -e
    71	          echo "compile_rc=${compile_rc}" >> "$GITHUB_OUTPUT"
    72	          echo "pytest_rc=${pytest_rc}" >> "$GITHUB_OUTPUT"
    73	          echo "Compile return code: ${compile_rc}"
    74	          echo "Pytest return code: ${pytest_rc}"
    75	
    76	      - name: Build deterministic audit context
    77	        shell: bash
    78	        env:
    79	          COMPILE_RC: ${{ steps.baseline_tests.outputs.compile_rc }}
    80	          PYTEST_RC: ${{ steps.baseline_tests.outputs.pytest_rc }}
    81	        run: |
    82	          set -euo pipefail
    83	          mkdir -p .weekly_audit
    84	          python scripts/weekly_bug_audit_baseline.py \
    85	            --root . \
    86	            --output .weekly_audit/baseline.json \
    87	            --compile-log /tmp/weekly_compile.log \
    88	            --pytest-log /tmp/weekly_pytest.log \
    89	            --compile-rc "$COMPILE_RC" \
    90	            --pytest-rc "$PYTEST_RC"
    91	
    92	      - name: Prepare common independent-audit prompt
    93	        shell: bash
    94	        env:
    95	          SOURCE_SHA: ${{ steps.source.outputs.sha }}
    96	        run: |
    97	          set -euo pipefail
    98	          cat > .weekly_audit/common_prompt.txt <<'PROMPT'
    99	          You are one of three INDEPENDENT weekly engineering auditors of a multi-chain automated trading bot.
   100	          Audit the ENTIRE checked-out repository at the exact source commit named below. Inspect code, workflows,
   101	          tests, configuration loaders, EVM and Solana execution paths, accounting/P&L, concurrency, databases,
   102	          retries/timeouts, Telegram/operator permissions, Strategy Lab/shadow systems, safety/circuit breakers,
   103	          deployment interactions, and failure handling. Read .weekly_audit/baseline.json first, then inspect the
   104	          repository deeply rather than stopping at the first issue.
   105	
   106	          Objective: find real software bugs, unsafe inconsistencies, data-corruption risks, execution/accounting
   107	          defects, race conditions, error-handling defects, test gaps and operational regressions. Do not tune a
   108	          trading strategy merely because recent profit is disappointing. Do not recommend named-asset trades.
   109	
   110	          Evidence rules:
   111	          - Every finding must cite concrete repository file(s) and preferably line/symbol/detail.
   112	          - Distinguish a proven defect from a hypothesis.
   113	          - Do not invent runtime facts that are absent from the repository/baseline.
   114	          - Duplicate symptoms sharing one root cause should be one finding.
   115	          - Prefer fewer high-quality findings over speculative volume.
   116	          - P0 = immediate capital/security/data-integrity catastrophe; P1 = serious correctness/safety defect;
   117	            P2 = material bug/reliability defect; P3 = lower-risk bug/test/maintainability issue.
   118	
   119	          This phase is REPORT ONLY. Do not change tracked repository files, deploy, trade, alter settings, edit
   120	          secrets, modify signing/wallet material, change capital, or weaken any safety gate.
   121	
   122	          Your JSON report MUST use this exact shape:
   123	          {
   124	            "schema_version": 1,
   125	            "provider": "PROVIDER_NAME",
   126	            "source_commit": "SOURCE_COMMIT",
   127	            "scope": "FULL_REPOSITORY_BUG_AUDIT",
   128	            "status": "CLEAN|ISSUES_FOUND|INCOMPLETE",
   129	            "summary": "concise summary",
   130	            "findings": [
   131	              {
   132	                "id": "stable short id",
   133	                "severity": "P0|P1|P2|P3",
   134	                "category": "CORRECTNESS|SAFETY|EXECUTION|ACCOUNTING|CONCURRENCY|DATA|NETWORK|CONFIG|SECURITY|TESTS|PERFORMANCE|MAINTAINABILITY",
   135	                "title": "...",
   136	                "evidence": [{"file":"path","line":0,"symbol":"optional","detail":"what in the code proves/suggests this"}],
   137	                "impact": "...",
   138	                "root_cause": "...",
   139	                "corrective_action": "bounded corrective action",
   140	                "tests_required": ["specific tests/checks"],
   141	                "confidence": 0.0,
   142	                "deterministic_evidence": false
   143	              }
   144	            ],
   145	            "refusals_or_limits": ["anything you deliberately could not verify"],
   146	            "report_only": true,
   147	            "no_live_changes": true
   148	          }
   149	          PROMPT
   150	          sed -i "s/SOURCE_COMMIT/${SOURCE_SHA}/g" .weekly_audit/common_prompt.txt
   151	
   152	      - name: GPT independent full-repository audit
   153	        id: gpt
   154	        continue-on-error: true
   155	        env:
   156	          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
   157	          OPENAI_WEEKLY_AUDIT_MODEL: ${{ vars.OPENAI_WEEKLY_AUDIT_MODEL }}
   158	          SOURCE_SHA: ${{ steps.source.outputs.sha }}
   159	        shell: bash
   160	        run: |
   161	          set -euo pipefail
   162	          if [[ -z "${OPENAI_API_KEY:-}" ]]; then
   163	            echo "OPENAI_API_KEY missing" >&2
   164	            exit 2
   165	          fi
   166	          cp .weekly_audit/common_prompt.txt /tmp/gpt_prompt.txt
   167	          sed -i 's/PROVIDER_NAME/gpt/g' /tmp/gpt_prompt.txt
   168	          cat >> /tmp/gpt_prompt.txt <<'PROMPT'
   169	
   170	          Use your repository tools to inspect the full codebase. When finished, create exactly:
   171	          - .weekly_audit/gpt.json containing ONLY the JSON object matching the contract above.
   172	          - .weekly_audit/gpt.md containing a human-readable version of the same findings.
   173	          Do not alter any tracked file. Do not commit, push, open a PR, or implement fixes in this phase.
   174	          PROMPT
   175	          model_args=()
   176	          if [[ -n "${OPENAI_WEEKLY_AUDIT_MODEL:-}" ]]; then
   177	            model_args=(-m "$OPENAI_WEEKLY_AUDIT_MODEL")
   178	          fi
   179	          codex exec --sandbox workspace-write --ask-for-approval never --ephemeral "${model_args[@]}" - < /tmp/gpt_prompt.txt
   180	          test -f .weekly_audit/gpt.json
   181	          python -m learnerbot.weekly_bug_audit_contract validate-agent \
   182	            --input .weekly_audit/gpt.json --provider gpt --source-commit "$SOURCE_SHA" > /dev/null
   183	          python - <<'PY'
   184	          import subprocess, sys
   185	          bad=[]
   186	          for line in subprocess.check_output(['git','status','--porcelain'],text=True).splitlines():
   187	              status=line[:2]; path=line[3:].replace('\\','/')
   188	              if status=='??' and path.startswith('.weekly_audit/'):
   189	                  continue
   190	              bad.append(line)
   191	          if bad:
   192	              print('GPT report-only audit changed files outside .weekly_audit:',*bad,sep='\n',file=sys.stderr)
   193	              raise SystemExit(3)
   194	          PY
   195	
   196	      - name: Recover safely if GPT audit was incomplete
   197	        if: steps.gpt.outcome != 'success'
   198	        env:
   199	          SOURCE_SHA: ${{ steps.source.outputs.sha }}
   200	        shell: bash
   201	        run: |
   202	          git restore --source=HEAD --staged --worktree . || true
   203	          git clean -fd -e .weekly_audit/ || true
   204	          python - <<'PY'
   205	          import json, os
   206	          p={
   207	            "schema_version":1,"provider":"gpt","source_commit":os.environ["SOURCE_SHA"],
   208	            "scope":"FULL_REPOSITORY_BUG_AUDIT","status":"INCOMPLETE",
   209	            "summary":"GPT weekly audit did not complete successfully.","findings":[],
   210	            "refusals_or_limits":["The GPT audit workflow step failed; inspect GitHub Actions logs."],
   211	            "report_only":True,"no_live_changes":True,
   212	          }
   213	          open('.weekly_audit/gpt.json','w',encoding='utf-8').write(json.dumps(p,indent=2,sort_keys=True)+'\n')
   214	          open('.weekly_audit/gpt.md','w',encoding='utf-8').write('# GPT weekly audit\n\nINCOMPLETE — inspect the workflow log.\n')
   215	          PY
   216	
   217	      - name: Gemini independent full-repository audit
   218	        id: gemini
   219	        continue-on-error: true
   220	        env:
   221	          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
   222	          GEMINI_AUDIT_MODEL: ${{ vars.GEMINI_AUDIT_MODEL || 'pro' }}
   223	          SOURCE_SHA: ${{ steps.source.outputs.sha }}
   224	          GEMINI_CLI_TRUST_WORKSPACE: "true"
   225	        shell: bash
   226	        run: |
   227	          set -euo pipefail
   228	          if [[ -z "${GEMINI_API_KEY:-}" ]]; then
   229	            echo "GEMINI_API_KEY missing" >&2
   230	            exit 2
   231	          fi
   232	          cp .weekly_audit/common_prompt.txt /tmp/gemini_prompt.txt
   233	          sed -i 's/PROVIDER_NAME/gemini/g' /tmp/gemini_prompt.txt
   234	          cat >> /tmp/gemini_prompt.txt <<'PROMPT'
   235	
   236	          Inspect the full repository using read-only tools. Do not edit any file. Your FINAL response must contain
   237	          exactly one machine-readable report between these markers and no other JSON object:
   238	          WEEKLY_AUDIT_JSON_BEGIN
   239	          { ...the required JSON object... }
   240	          WEEKLY_AUDIT_JSON_END
   241	          PROMPT
   242	          gemini --approval-mode plan --skip-trust --model "$GEMINI_AUDIT_MODEL" --output-format text \
   243	            -p "$(cat /tmp/gemini_prompt.txt)" > .weekly_audit/gemini_stdout.txt
   244	          python -m learnerbot.weekly_bug_audit_contract extract-agent \
   245	            --input .weekly_audit/gemini_stdout.txt \
   246	            --output .weekly_audit/gemini.json \
   247	            --provider gemini \
   248	            --source-commit "$SOURCE_SHA"
   249	          python - <<'PY'
   250	          import json, subprocess, sys
   251	          r=json.load(open('.weekly_audit/gemini.json',encoding='utf-8'))
   252	          lines=['# Gemini weekly audit','',r.get('summary','')]
   253	          for f in r.get('findings') or []:
   254	              lines += ['',f"## {f.get('severity')} — {f.get('title')}",f.get('impact',''),f"Corrective action: {f.get('corrective_action','')}"]
   255	          open('.weekly_audit/gemini.md','w',encoding='utf-8').write('\n'.join(lines)+'\n')
   256	          bad=[]
   257	          for line in subprocess.check_output(['git','status','--porcelain'],text=True).splitlines():
   258	              status=line[:2]; path=line[3:].replace('\\','/')
   259	              if status=='??' and path.startswith('.weekly_audit/'):
   260	                  continue
     1	from __future__ import annotations
     2	
     3	import csv
     4	import hashlib
     5	import json
     6	import os
     7	from dataclasses import dataclass
     8	from pathlib import Path
     9	from dotenv import load_dotenv
    10	
    11	BOT_ROOT = Path(__file__).resolve().parent.parent
    12	load_dotenv(BOT_ROOT / ".env")
    13	
    14	def _bool(v, default=False):
    15	    if v is None: return default
    16	    if isinstance(v, bool): return v
    17	    return str(v).strip().lower() in {"1","true","yes","on","y"}
    18	
    19	def _rows(path: Path):
    20	    if not path.exists(): return []
    21	    with path.open("r", encoding="utf-8-sig", newline="") as f:
    22	        return list(csv.DictReader(f))
    23	
    24	def _map(path: Path, key="setting", value="value"):
    25	    out={}
    26	    for row in _rows(path):
    27	        k=(row.get(key) or "").strip(); v=(row.get(value) or "").strip()
    28	        if k: out[k]=v
    29	    return out
    30	
    31	def _chat_ids():
    32	    raw=(os.getenv("TELEGRAM_CHAT_IDS","").strip() or os.getenv("TELEGRAM_CHAT_ID","").strip())
    33	    out=[]; seen=set()
    34	    for x in raw.split(","):
    35	        x=x.strip()
    36	        if x and x not in seen:
    37	            seen.add(x); out.append(x)
    38	    return out
    39	
    40	@dataclass(frozen=True)
    41	class AppSettings:
    42	    root: Path
    43	    csv_dir: Path
    44	    data_dir: Path
    45	    telegram_bot_token: str
    46	    telegram_chat_ids: list[str]
    47	    etherscan_api_key: str
    48	
    49	    @classmethod
    50	    def load(cls):
    51	        root=BOT_ROOT
    52	        csv_dir=Path(os.getenv("CSV_DIR", str(root/"CSVbot"))).expanduser().resolve()
    53	        data_dir=Path(os.getenv("DATA_DIR", str(root/"data"))).expanduser().resolve()
    54	        return cls(root,csv_dir,data_dir,os.getenv("TELEGRAM_BOT_TOKEN","").strip(),_chat_ids(),os.getenv("ETHERSCAN_API_KEY","").strip())
    55	
    56	    def general(self): return _map(self.csv_dir/"general_settings.csv")
    57	    def telegram_settings(self): return _map(self.csv_dir/"telegram_settings.csv")
    58	    def operator_settings(self): return _map(self.csv_dir/"operator_settings.csv")
    59	
    60	    def get(self, name, default, cast=str):
    61	        v=self.general().get(name, default)
