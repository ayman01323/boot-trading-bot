[Unit]
Description=Multi-Chain Learning Bot v2.2 Multi-User + Fast Graph-First Direct Market Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/multichain-learning-bot-v2.2-fast-direct-market
ExecStart=/root/multichain-learning-bot-v2.2-fast-direct-market/.venv/bin/python -m learnerbot run
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
