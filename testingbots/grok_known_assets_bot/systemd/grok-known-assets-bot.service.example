[Unit]
Description=Grok Known Assets Testing Bot (PAPER example)
After=network-online.target
ConditionPathExists=/home/ayman01323/BOOT/testingbots/grok_known_assets_bot/config.json

[Service]
Type=oneshot
User=ayman01323
WorkingDirectory=/home/ayman01323/BOOT/testingbots/grok_known_assets_bot
ExecStart=/home/ayman01323/BOOT/testingbots/grok_known_assets_bot/.venv/bin/grok-known-assets-bot --config config.json --db state.sqlite3 check
# Deliberately not a persistent trading service. Enable only after separate review.

[Install]
WantedBy=multi-user.target
