# Grok must use a Telegram bot token that is NOT used by SiRisky, Claude,
# LearnerBot, or any other getUpdates/webhook consumer.
GROK_TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to control Grok PAPER state.
GROK_TELEGRAM_CHAT_IDS=

# Long-poll timeout; bounded to 5..50 seconds by the receiver.
GROK_TELEGRAM_POLL_TIMEOUT=25
